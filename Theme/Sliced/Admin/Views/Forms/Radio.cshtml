
@{
    ViewBag.Title = "Froms";
    ViewBag.pTitle = "Radio";
    ViewBag.xData = "forms";
    ViewBag.ActiveItem = "radio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    <!-- Icon Css -->
    <link rel="stylesheet" href="~/assets/css/remixicon.css" />
}


<!-- Start All Card -->
<div class="flex flex-col gap-4 min-h-[calc(100vh-212px)]">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Radio Default</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex">
                    <input type="radio" name="default_radio" class="form-radio checked:bg-primary" checked />
                    <span>Primary</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="default_radio" class="form-radio checked:bg-info" checked />
                    <span>Info</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="default_radio" class="form-radio checked:bg-success" />
                    <span>Success</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="default_radio" class="form-radio checked:bg-warning" />
                    <span>Warning</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="default_radio" class="form-radio checked:bg-danger" />
                    <span>Danger</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="default_radio" class="checked:bg-black form-radio" />
                    <span>Black</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="default_radio" class="form-radio checked:bg-muted" />
                    <span>Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Radio Square</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex">
                    <input type="radio" name="square_radio" class="rounded-sm form-radio checked:bg-primary" checked />
                    <span>Primary</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_radio" class="rounded-sm form-radio checked:bg-info" />
                    <span>Info</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_radio" class="rounded-sm form-radio checked:bg-success" />
                    <span>Success</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_radio" class="rounded-sm form-radio checked:bg-warning" />
                    <span>Warning</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_radio" class="rounded-sm form-radio checked:bg-danger" />
                    <span>Danger</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_radio" class="checked:bg-black rounded-sm form-radio" />
                    <span>Black</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_radio" class="rounded-sm form-radio checked:bg-muted" />
                    <span>Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Outline</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex">
                    <input type="radio" name="outline_radio" class="form-radio outborder-primary" />
                    <span>Primary</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_radio" class="form-radio outborder-info" checked />
                    <span>Info</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_radio" class="form-radio outborder-success" />
                    <span>Success</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_radio" class="form-radio outborder-warning" />
                    <span>Warning</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_radio" class="form-radio outborder-danger" />
                    <span>Danger</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_radio" class="form-radio outborder-black" />
                    <span>Black</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_radio" class="form-radio outborder-muted" />
                    <span>Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Radio Outline Square</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex">
                    <input type="radio" name="outline_square_radio" class="rounded-sm form-radio outborder-primary" checked />
                    <span>Primary</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_square_radio" class="rounded-sm form-radio outborder-info" />
                    <span>Info</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_square_radio" class="rounded-sm form-radio outborder-success" />
                    <span>Success</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_square_radio" class="rounded-sm form-radio outborder-warning" />
                    <span>Warning</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_square_radio" class="rounded-sm form-radio outborder-danger" />
                    <span>Danger</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_square_radio" class="rounded-sm form-radio outborder-black" />
                    <span>Black</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="outline_square_radio" class="rounded-sm form-radio outborder-muted" />
                    <span>Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Radio Outline With Text Color</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex">
                    <input type="radio" name="rounded_color_radio" class="form-radio peer outborder-primary" />
                    <span class="peer-checked:text-primary">Primary</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="rounded_color_radio" class="form-radio peer outborder-info" checked />
                    <span class="peer-checked:text-info">Info</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="rounded_color_radio" class="form-radio peer outborder-success" />
                    <span class="peer-checked:text-success">Success</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="rounded_color_radio" class="form-radio peer outborder-warning" />
                    <span class="peer-checked:text-warning">Warning</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="rounded_color_radio" class="form-radio peer outborder-danger" />
                    <span class="peer-checked:text-danger">Danger</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="rounded_color_radio" class="form-radio peer outborder-black" />
                    <span class="peer-checked:text-black">Black</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="rounded_color_radio" class="form-radio peer outborder-muted" />
                    <span class="peer-checked:text-muted">Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Radio Outline With Text Color</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex">
                    <input type="radio" name="square_color_radio" class="rounded-sm form-radio peer outborder-primary" />
                    <span class="peer-checked:text-primary">Primary</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_color_radio" class="rounded-sm form-radio peer outborder-info" checked />
                    <span class="peer-checked:text-info">Info</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_color_radio" class="rounded-sm form-radio peer outborder-success" />
                    <span class="peer-checked:text-success">Success</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_color_radio" class="rounded-sm form-radio peer outborder-warning" />
                    <span class="peer-checked:text-warning">Warning</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_color_radio" class="rounded-sm form-radio peer outborder-danger" />
                    <span class="peer-checked:text-danger">Danger</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_color_radio" class="rounded-sm form-radio peer outborder-black" />
                    <span class="peer-checked:text-black">Black</span>
                </label>
                <label class="inline-flex">
                    <input type="radio" name="square_color_radio" class="rounded-sm form-radio peer outborder-muted" />
                    <span class="peer-checked:text-muted">Muted</span>
                </label>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/assets/js/pages/form-editor.js"></script>
    <script src="~/assets/js/main.js"></script>

}