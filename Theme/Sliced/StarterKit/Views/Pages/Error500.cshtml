
@{
    ViewBag.Title = "Error500";
    Layout = "~/Views/Shared/BlankLayout.cshtml";
}

<section class="min-h-[calc(100vh-134px)] flex items-center justify-center">
    <div class="max-w-[1440px] mx-auto text-center px-4">
        <div class="mt-10 space-y-4">
            <h2 class="text-3xl font-bold md:text-5xl dark:text-white">500 Not Found</h2>
            <p class="text-base text-muted">Sorry, we can’t find that page.</p>
            <img src="~/assets/images/500.svg" class="mx-auto sm:max-w-xs" alt="">
