
@{
    ViewBag.Title = "Froms";
    ViewBag.pTitle = "Checkbox";
    ViewBag.xData = "forms";
    ViewBag.ActiveItem = "checkbox";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Start All Card -->
<div class="flex flex-col gap-4 min-h-[calc(100vh-212px)]">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Checkbox Default</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox checked:bg-primary" checked />
                    <span>Primary</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox checked:bg-info" checked />
                    <span>Info</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox checked:bg-success" />
                    <span>Success</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox checked:bg-warning" />
                    <span>Warning</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox checked:bg-danger" />
                    <span>Danger</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="checked:bg-black form-checkbox" />
                    <span>Black</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox checked:bg-muted" />
                    <span>Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Checkbox Rounded</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox rounded-full checked:bg-primary" checked />
                    <span>Primary</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox rounded-full checked:bg-info" checked />
                    <span>Info</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox rounded-full checked:bg-success" />
                    <span>Success</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox rounded-full checked:bg-warning" />
                    <span>Warning</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox rounded-full checked:bg-danger" />
                    <span>Danger</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="checked:bg-black form-checkbox rounded-full" />
                    <span>Black</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox rounded-full checked:bg-muted" />
                    <span>Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Outline</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox outborder-primary" checked />
                    <span>Primary</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox outborder-info" checked />
                    <span>Info</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox outborder-success" />
                    <span>Success</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox outborder-warning" />
                    <span>Warning</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox outborder-danger" />
                    <span>Danger</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox outborder-black" />
                    <span>Black</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox outborder-muted" />
                    <span>Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Outline Rounded</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="rounded-full form-checkbox outborder-primary" checked />
                    <span>Primary</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="rounded-full form-checkbox outborder-info" checked />
                    <span>Info</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="rounded-full form-checkbox outborder-success" />
                    <span>Success</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="rounded-full form-checkbox outborder-warning" />
                    <span>Warning</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="rounded-full form-checkbox outborder-danger" />
                    <span>Danger</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="rounded-full form-checkbox outborder-black" />
                    <span>Black</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="rounded-full form-checkbox outborder-muted" />
                    <span>Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Checkbox With Text Color</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer checked:bg-primary" checked />
                    <span class="peer-checked:text-primary">Primary</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer checked:bg-info" checked />
                    <span class="peer-checked:text-info">Info</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer checked:bg-success" />
                    <span class="peer-checked:text-success">Success</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer checked:bg-warning" />
                    <span class="peer-checked:text-warning">Warning</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer checked:bg-danger" />
                    <span class="peer-checked:text-danger">Danger</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="checked:bg-black form-checkbox peer" />
                    <span class="peer-checked:text-black">Black</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer checked:bg-muted" />
                    <span class="peer-checked:text-muted">Muted</span>
                </label>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Outline Checkbox With Text Color</h2>
            <div class="grid grid-cols-1 gap-3">
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer outborder-primary" checked />
                    <span class="peer-checked:text-primary">Primary</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer outborder-info" checked />
                    <span class="peer-checked:text-info">Info</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer outborder-success" />
                    <span class="peer-checked:text-success">Success</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer outborder-warning" />
                    <span class="peer-checked:text-warning">Warning</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer outborder-danger" />
                    <span class="peer-checked:text-danger">Danger</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer outborder-black" />
                    <span class="peer-checked:text-black">Black</span>
                </label>
                <label class="inline-flex cursor-pointer">
                    <input type="checkbox" class="form-checkbox peer outborder-muted" />
                    <span class="peer-checked:text-muted">Muted</span>
                </label>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/assets/js/pages/form-editor.js"></script>
    <script src="~/assets/js/main.js"></script>
}