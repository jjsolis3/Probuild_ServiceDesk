
@{
    ViewBag.Title = "Sliced";
    ViewBag.pTitle = "Chart";
    ViewBag.xData = "chart";
    ViewBag.ActiveItem = "chart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex flex-col gap-4 min-h-[calc(100vh-212px)]">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="p-5 bg-white border rounded-sm border-black/10 dark:bg-darklight dark:border-darkborder">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Line Chart</h2>
            <div id="linechart" dir="ltr"></div>
        </div>
        <div class="p-5 bg-white border rounded-sm border-black/10 dark:bg-darklight dark:border-darkborder">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Area Chart</h2>
            <div id="areachart" dir="ltr"></div>
        </div>
        <div class="p-5 bg-white border rounded-sm border-black/10 dark:bg-darklight dark:border-darkborder">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Bar Chart</h2>
            <div id="barchart" dir="ltr"></div>
        </div>
        <div class="p-5 bg-white border rounded-sm border-black/10 dark:bg-darklight dark:border-darkborder">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Simple Bar</h2>
            <div id="simplebarchart" dir="ltr"></div>
        </div>
        <div class="p-5 bg-white border rounded-sm border-black/10 dark:bg-darklight dark:border-darkborder">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Bar Chart</h2>
            <div id="barchartcenter" dir="ltr"></div>
        </div>
        <div class="p-5 bg-white border rounded-sm border-black/10 dark:bg-darklight dark:border-darkborder">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Spline Area Charts</h2>
            <div id="apex_area1" dir="ltr"></div>
        </div>
        <div class="p-5 bg-white border rounded-sm border-black/10 dark:bg-darklight dark:border-darkborder">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Basic Donut</h2>
            <div id="basicbonut" dir="ltr"></div>
        </div>
        <div class="p-5 bg-white border rounded-sm border-black/10 dark:bg-darklight dark:border-darkborder">
            <h2 class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Doughnut chart</h2>
            <div id="doughnutchart" dir="ltr"></div>
        </div>
    </div>
</div>

@section scripts{

    <script src="~/assets/libs/apexcharts/apexcharts.js"></script>
    <script src="~/assets/js/pages/apex.init.js"></script>

    <script src="~/assets/js/main.js"></script>
}
