@{
    ViewData["Title"] = "Store Unavailable";
    Layout = "_PortalLayout";
    var message = ViewBag.Message as string ?? "The store is currently unavailable.";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0"><i class="bi bi-shop me-2 text-secondary"></i>Company Store</h2>
    <a asp-action="MyOrders" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-clock-history me-1"></i>My Orders
    </a>
</div>

<div class="card shadow-sm text-center py-5">
    <div class="card-body">
        <i class="bi bi-lock display-1 text-secondary opacity-50 d-block mb-4"></i>
        <h4 class="fw-bold text-secondary mb-2">Store Unavailable</h4>
        <p class="text-muted mb-4" style="max-width:480px;margin:0 auto;">@message</p>
        <a asp-action="MyOrders" class="btn btn-outline-primary me-2">
            <i class="bi bi-clock-history me-1"></i>View Past Orders
        </a>
        <a asp-controller="Portal" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-house me-1"></i>Back to Portal
        </a>
    </div>
</div>
