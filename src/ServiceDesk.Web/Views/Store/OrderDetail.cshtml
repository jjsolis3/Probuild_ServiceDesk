@using ServiceDesk.Core.Models
@model StoreOrder
@{
    ViewData["Title"]      = $"Order {Model.OrderNumber}";
    ViewData["ActivePage"] = "Store";
    Layout = "_PortalLayout";

    string StatusBadge(string status) => status switch
    {
        "Pending"   => "bg-warning text-dark",
        "Confirmed" => "bg-info text-dark",
        "Fulfilled" => "bg-success",
        "Cancelled" => "bg-danger",
        _           => "bg-secondary"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Store</a></li>
        <li class="breadcrumb-item"><a asp-action="MyOrders">My Orders</a></li>
        <li class="breadcrumb-item active">@Model.OrderNumber</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-receipt me-2 text-primary"></i>@Model.OrderNumber
    </h2>
    <span class="badge fs-6 @StatusBadge(Model.Status)">@Model.Status</span>
</div>

@{
    // Build the order progression timeline. "Cancelled" is a terminal off-path
    // state and is shown as its own stepper instead of mixed with the happy path.
    var statusFlow = new[] { "Pending", "Confirmed", "Fulfilled" };
    var isCancelled = Model.Status == "Cancelled";
    int currentIdx  = Array.IndexOf(statusFlow, Model.Status);
    if (isCancelled) currentIdx = -1;

    string StepIconFor(string s) => s switch
    {
        "Pending"   => "bi-hourglass-split",
        "Confirmed" => "bi-check2-circle",
        "Fulfilled" => "bi-box-seam",
        "Cancelled" => "bi-x-circle",
        _           => "bi-circle"
    };

    string FormatTs(DateTime dt) =>
        dt.ToOrgDisplay((string?)ViewBag.OrgTz, "MMM d, yyyy 'at' h:mm tt");
}

<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        @if (isCancelled)
        {
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center"
                     style="width:42px;height:42px;flex-shrink:0;">
                    <i class="bi bi-x-circle fs-5"></i>
                </div>
                <div>
                    <div class="fw-semibold text-danger">Order Cancelled</div>
                    <div class="text-muted small">
                        @if (Model.LastStatusChangedDate.HasValue)
                        {
                            <span>Cancelled on @FormatTs(Model.LastStatusChangedDate.Value)</span>
                        }
                        else
                        {
                            <span>Contact your operations team if you have questions.</span>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="order-timeline d-flex align-items-start justify-content-between position-relative px-2 px-md-4 py-2">
                @for (int i = 0; i < statusFlow.Length; i++)
                {
                    var step       = statusFlow[i];
                    var isComplete = i < currentIdx;
                    var isCurrent  = i == currentIdx;
                    var dotClass   = isComplete ? "bg-success text-white"
                                   : isCurrent  ? "bg-primary text-white"
                                                : "bg-light text-muted border";
                    var lineClass  = i < currentIdx ? "bg-success" : "bg-light";
                    var labelClass = isCurrent ? "fw-bold text-primary"
                                   : isComplete ? "fw-semibold text-success"
                                                : "text-muted";

                    <div class="text-center position-relative flex-fill" style="z-index:1;">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center @dotClass"
                             style="width:36px;height:36px;">
                            <i class="bi @StepIconFor(step)"></i>
                        </div>
                        <div class="mt-2 small @labelClass">@step</div>
                        @if (isCurrent && step == "Pending")
                        {
                            <div class="text-muted" style="font-size:.7rem;">@FormatTs(Model.OrderDate)</div>
                        }
                        else if (isCurrent && Model.LastStatusChangedDate.HasValue)
                        {
                            <div class="text-muted" style="font-size:.7rem;">@FormatTs(Model.LastStatusChangedDate.Value)</div>
                        }
                        else if (isComplete && step == "Pending")
                        {
                            <div class="text-muted" style="font-size:.7rem;">@FormatTs(Model.OrderDate)</div>
                        }
                    </div>

                    @if (i < statusFlow.Length - 1)
                    {
                        <div class="flex-grow-1 @lineClass" style="height:3px;margin-top:18px;border-radius:2px;"></div>
                    }
                }
            </div>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Order Details</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Order #</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.OrderNumber</dd>

                    <dt class="col-sm-5">Date Placed</dt>
                    <dd class="col-sm-7">@Model.OrderDate.ToOrgDisplay((string?)ViewBag.OrgTz, "MMMM d, yyyy 'at' h:mm tt")</dd>

                    <dt class="col-sm-5">Quarter</dt>
                    <dd class="col-sm-7">Q@(Model.Quarter) @Model.Year</dd>

                    @{
                        var branchDisplay = Model.Branch?.Name ?? Model.BranchNameSnapshot;
                    }
                    @if (!string.IsNullOrEmpty(branchDisplay))
                    {
                        <dt class="col-sm-5">Branch / Location</dt>
                        <dd class="col-sm-7"><i class="bi bi-geo-alt me-1 text-muted"></i>@branchDisplay</dd>
                    }

                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">
                        <span class="badge @StatusBadge(Model.Status)">@Model.Status</span>
                    </dd>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <dt class="col-sm-5">Notes</dt>
                        <dd class="col-sm-7 text-muted">@Model.Notes</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    Items Ordered
                    <span class="badge bg-secondary ms-1">@Model.Items.Count</span>
                </h5>
            </div>
            <div class="table-responsive">
                @{
                    var hasPriced = Model.Items.Any(i => i.UnitPriceSnapshot.HasValue);
                }
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;"></th>
                            <th>Product</th>
                            <th>Variants</th>
                            <th class="text-end">Qty</th>
                            @if (hasPriced)
                            {
                                <th class="text-end">Price</th>
                                <th class="text-end">Subtotal</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var vparts = new List<string>();
                            if (!string.IsNullOrEmpty(item.SelectedGender)) vparts.Add(item.SelectedGender);
                            if (!string.IsNullOrEmpty(item.SelectedSize))   vparts.Add(item.SelectedSize);
                            if (!string.IsNullOrEmpty(item.SelectedColor))  vparts.Add(item.SelectedColor);
                            if (!string.IsNullOrWhiteSpace(item.CustomSelectionsJson))
                            {
                                try
                                {
                                    using var _d = System.Text.Json.JsonDocument.Parse(item.CustomSelectionsJson);
                                    foreach (var _p in _d.RootElement.EnumerateObject())
                                        vparts.Add($"{_p.Name}: {_p.Value.GetString()}");
                                }
                                catch { }
                            }

                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.StoreProduct?.ImagePath))
                                    {
                                        <img src="@item.StoreProduct.ImagePath" alt="@item.ProductNameSnapshot"
                                             style="width:40px;height:40px;object-fit:cover;border-radius:6px;" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                             style="width:40px;height:40px;">
                                            <i class="bi bi-box text-muted small"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.ProductNameSnapshot</div>
                                    @if (!string.IsNullOrEmpty(item.ProductCategorySnapshot))
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size:.7rem;">@item.ProductCategorySnapshot</span>
                                    }
                                </td>
                                <td>
                                    @if (vparts.Count > 0)
                                    {
                                        <span class="text-muted small">@string.Join(" / ", vparts)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end fw-bold">@item.Quantity</td>
                                @if (hasPriced)
                                {
                                    <td class="text-end">@(item.UnitPriceSnapshot?.ToString("C") ?? "—")</td>
                                    <td class="text-end fw-semibold">@((item.UnitPriceSnapshot * item.Quantity)?.ToString("C") ?? "—")</td>
                                }
                            </tr>
                        }
                        <tr class="table-light">
                            <td colspan="3" class="text-end fw-semibold">Total Qty</td>
                            <td class="text-end fw-bold">@Model.Items.Sum(i => i.Quantity)</td>
                            @if (hasPriced)
                            {
                                <td></td>
                                <td class="text-end fw-bold text-success">
                                    @Model.Items.Sum(i => (i.UnitPriceSnapshot ?? 0) * i.Quantity).ToString("C")
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <a asp-action="MyOrders" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to My Orders
            </a>
        </div>
    </div>
</div>
