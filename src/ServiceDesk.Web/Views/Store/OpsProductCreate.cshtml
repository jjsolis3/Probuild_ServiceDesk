@using ServiceDesk.Core.Models
@using ServiceDesk.Web.Models.ViewModels
@model StoreProduct
@{
    ViewData["Title"]      = "Add Product";
    ViewData["ActivePage"] = "OpsHub";
    Layout = "_PortalLayout";

    ViewData["FormContext"] = new StoreProductFormContext
    {
        Product             = Model,
        ExistingCategories  = ViewBag.ExistingCategories as List<string> ?? new List<string>(),
        ControllerName      = "Store",
        ListAction          = "OpsProducts",
        CreateAction        = "OpsProductCreate",
        EditAction          = "OpsProductEdit",
        DeleteAction        = "OpsProductDelete",
        ImageDeleteAction   = "OpsProductImageDelete",
        DuplicateAction     = "OpsProductDuplicate",
        BulkSetActiveAction = "OpsProductBulkSetActive"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="OperationsHub">Operations Hub</a></li>
        <li class="breadcrumb-item"><a asp-action="OpsProducts">Products</a></li>
        <li class="breadcrumb-item active">Add Product</li>
    </ol>
</nav>

<h2 class="fw-bold mb-4"><i class="bi bi-plus-circle text-primary me-2"></i>Add Product</h2>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                @await Html.PartialAsync("StoreProducts/_ProductForm", Model)
            </div>
        </div>
    </div>
</div>
