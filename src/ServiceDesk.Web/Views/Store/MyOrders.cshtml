@using ServiceDesk.Core.Models
@model List<StoreOrder>
@{
    ViewData["Title"]      = "My Store Orders";
    ViewData["ActivePage"] = "Store";
    Layout = "_PortalLayout";

    var currentUser = ViewBag.CurrentUser as PortalUser;

    string StatusBadge(string status) => status switch
    {
        "Pending"   => "bg-warning text-dark",
        "Confirmed" => "bg-info text-dark",
        "Fulfilled" => "bg-success",
        "Cancelled" => "bg-danger",
        _           => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>My Store Orders</h2>
        <p class="text-muted small mb-0">Hello, @currentUser?.FirstName — order history from all quarters.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-shop me-1"></i>Go to Store
    </a>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm text-center py-5 text-muted">
        <i class="bi bi-bag display-3 d-block mb-3 opacity-25"></i>
        <p class="mb-2">You haven't placed any orders yet.</p>
        <a asp-action="Index" class="btn btn-primary btn-sm">
            <i class="bi bi-shop me-1"></i>Browse the Store
        </a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Quarter</th>
                        <th>Items</th>
                        <th>Status</th>
                        <th class="text-end">Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@order.OrderNumber</td>
                            <td class="text-muted small">@order.OrderDate.ToString("MMM d, yyyy")</td>
                            <td class="text-muted small">Q@(order.Quarter) @order.Year</td>
                            <td>
                                @{
                                    var totalQty = order.Items.Sum(i => i.Quantity);
                                    var itemCount = order.Items.Count;
                                }
                                @itemCount item@(itemCount == 1 ? "" : "s")
                                <span class="text-muted small">(qty @totalQty)</span>
                            </td>
                            <td>
                                <span class="badge @StatusBadge(order.Status)">@order.Status</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="OrderDetail" asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
