@model IEnumerable<ServiceDesk.Core.Models.PayrollNotificationRecipient>
@{
    ViewData["Title"] = "Payroll Settings";
    var candidates = ViewBag.PortalCandidates as IEnumerable<ServiceDesk.Core.Models.PortalUser> ?? Enumerable.Empty<ServiceDesk.Core.Models.PortalUser>();
    var active   = Model.Count(r => r.IsActive);
    var paused   = Model.Count(r => !r.IsActive);

    var notifySubmit   = (bool)(ViewBag.NotifyOnSubmit   ?? true);
    var notifyApproved = (bool)(ViewBag.NotifyOnApproved ?? true);
    var notifyRejected = (bool)(ViewBag.NotifyOnRejected ?? true);
    var notifyPaid     = (bool)(ViewBag.NotifyOnPaid     ?? true);
}

<div class="container-fluid px-4 py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
        <div>
            <h2 class="mb-1"><i class="bi bi-gear me-2 text-primary"></i>Payroll Settings</h2>
            <p class="text-muted mb-0">
                Control which lifecycle events send emails, who receives the submit / payment-confirmed
                alerts, and when to nudge admins about stale receipts.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Payroll
        </a>
    </div>

    <!-- ── Per-event notification toggles ── -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-envelope-check me-2 text-primary"></i>Lifecycle Email Toggles</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Master switches for each of the four lifecycle emails. Turn one off and that
                particular event will silently skip — useful if (for example) the contractor
                doesn't want a Paid confirmation because they get one from their bank already.
            </p>
            <form asp-action="SaveNotificationToggles" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6 col-lg-3">
                        <div class="p-3 border rounded h-100" style="background:#fff7ed;">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="notifyOnSubmit" name="notifyOnSubmit" value="true" @(notifySubmit ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="notifyOnSubmit">
                                    Receipt Submitted
                                </label>
                            </div>
                            <div class="text-muted small mt-1">
                                Notifies the recipients below when a contractor submits a receipt for review.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="p-3 border rounded h-100" style="background:#ecfdf5;">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="notifyOnApproved" name="notifyOnApproved" value="true" @(notifyApproved ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="notifyOnApproved">
                                    Receipt Approved
                                </label>
                            </div>
                            <div class="text-muted small mt-1">
                                Notifies the contractor when their receipt is approved.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="p-3 border rounded h-100" style="background:#fffbeb;">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="notifyOnRejected" name="notifyOnRejected" value="true" @(notifyRejected ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="notifyOnRejected">
                                    Receipt Returned
                                </label>
                            </div>
                            <div class="text-muted small mt-1">
                                Notifies the contractor when admin returns a receipt for revision.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="p-3 border rounded h-100" style="background:#ecfeff;">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="notifyOnPaid" name="notifyOnPaid" value="true" @(notifyPaid ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="notifyOnPaid">
                                    Payment Issued
                                </label>
                            </div>
                            <div class="text-muted small mt-1">
                                Notifies the contractor when admin marks the receipt Paid.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-3 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save Toggles
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            <strong>No recipients configured.</strong>
            While this list is empty, the alert falls back to every active <em>Admin</em> user.
            Add at least one recipient below to take control.
        </div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-auto">
                <div class="border rounded p-2 px-3 bg-light">
                    <div class="small text-muted">Active</div>
                    <div class="fs-4 fw-bold text-success">@active</div>
                </div>
            </div>
            <div class="col-auto">
                <div class="border rounded p-2 px-3 bg-light">
                    <div class="small text-muted">Paused</div>
                    <div class="fs-4 fw-bold text-secondary">@paused</div>
                </div>
            </div>
        </div>
    }

    @* ── Delivery mode toggle ─────────────────────────────────────────── *@
    @{
        var deliveryMode = (ViewBag.DeliveryMode as string) ?? "Individual";
        var isCombined   = string.Equals(deliveryMode, "Combined", StringComparison.OrdinalIgnoreCase);
    }
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-send me-2 text-info"></i>Delivery Mode</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                How payroll alerts are addressed to the recipients below.
                Submitted, payment-confirmed, and stale-reminder emails all
                follow this setting. Per-contractor emails (approved, paid,
                returned) are always sent only to that contractor.
            </p>
            <form asp-action="SaveDeliveryMode" method="post" class="row g-3 align-items-stretch">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label class="d-block h-100 border rounded p-3" style="cursor:pointer;background:@(!isCombined ? "#e7f1ff" : "#fff");border-color:@(!isCombined ? "#0d6efd" : "#dee2e6") !important;">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="deliveryMode" id="dmIndividual" value="Individual" @(!isCombined ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="dmIndividual">
                                Individual <span class="badge bg-secondary ms-1">Default</span>
                            </label>
                        </div>
                        <div class="text-muted small mt-2">
                            One email per recipient. Privacy-safe — recipients don't see each other.
                            A single bounce or rate-limit on one address doesn't block the others.
                            Each delivery is logged separately.
                        </div>
                    </label>
                </div>
                <div class="col-md-5">
                    <label class="d-block h-100 border rounded p-3" style="cursor:pointer;background:@(isCombined ? "#e7f1ff" : "#fff");border-color:@(isCombined ? "#0d6efd" : "#dee2e6") !important;">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="deliveryMode" id="dmCombined" value="Combined" @(isCombined ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="dmCombined">
                                Combined
                            </label>
                        </div>
                        <div class="text-muted small mt-2">
                            One email — first recipient in <code>To:</code>, the rest in <code>Cc:</code>.
                            Recipients see each other and can <em>Reply-All</em> to discuss.
                            Best for tight internal teams; not recommended when external
                            (AP / vendor) addresses are mixed in.
                        </div>
                    </label>
                </div>
                <div class="col-md-2 d-flex align-items-end justify-content-end">
                    <button type="submit" class="btn btn-info text-white">
                        <i class="bi bi-save me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Recipients table -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-people me-2"></i>Current Recipients</h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">
                    Nothing here yet — add a portal user or external email below.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Source</th>
                                <th>Added</th>
                                <th class="text-center">Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var name = r.PortalUser != null
                                    ? $"{r.PortalUser.FirstName} {r.PortalUser.LastName}"
                                    : (r.DisplayName ?? "—");
                                var emailDisplay = r.PortalUser?.Email ?? r.Email;
                                <tr class="@(r.IsActive ? "" : "table-secondary")">
                                    <td>
                                        <strong>@name</strong>
                                    </td>
                                    <td><code class="small">@emailDisplay</code></td>
                                    <td>
                                        @if (r.PortalUser != null)
                                        {
                                            <span class="badge bg-primary-subtle text-primary">
                                                <i class="bi bi-person-badge me-1"></i>Portal User
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info">
                                                <i class="bi bi-envelope me-1"></i>External
                                            </span>
                                        }
                                    </td>
                                    <td class="small text-muted">@r.CreatedDate.ToString("MMM d, yyyy")</td>
                                    <td class="text-center">
                                        @if (r.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Paused</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <form asp-action="ToggleNotificationRecipient" asp-route-id="@r.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-secondary" type="submit"
                                                    title="@(r.IsActive ? "Pause notifications" : "Resume notifications")">
                                                <i class="bi bi-@(r.IsActive ? "pause" : "play")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="RemoveNotificationRecipient" asp-route-id="@r.Id" method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Remove @name from the notification list?');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit" title="Remove">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Add recipient panels -->
    <div class="row g-3">

        <!-- Pick from portal users -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-person-plus me-2 text-primary"></i>Add a Portal User</h6>
                </div>
                <div class="card-body">
                    @if (!candidates.Any())
                    {
                        <p class="text-muted small mb-0">
                            Every active portal user with an email is already on the list.
                        </p>
                    }
                    else
                    {
                        <form asp-action="AddNotificationRecipient" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label">Portal User</label>
                                <select name="portalUserId" class="form-select" required>
                                    <option value="">— Choose a user —</option>
                                    @foreach (var u in candidates)
                                    {
                                        var role = u.Role?.Name ?? "User";
                                        <option value="@u.Id">@u.FirstName @u.LastName  ·  @u.Email  ·  @role</option>
                                    }
                                </select>
                                <div class="form-text">
                                    Email and name auto-update if the user is renamed later.
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-lg me-1"></i>Add User
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Add external email -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-envelope-plus me-2 text-info"></i>Add an External Email</h6>
                </div>
                <div class="card-body">
                    <form asp-action="AddNotificationRecipient" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label">Display Name <span class="text-muted small fw-normal">(optional)</span></label>
                            <input type="text" name="displayName" class="form-control" placeholder="e.g. Accounts Payable" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control" required placeholder="ap@vendor.com" />
                            <div class="form-text">For HR, AP, or payroll vendors who don't have portal access.</div>
                        </div>
                        <button type="submit" class="btn btn-info btn-sm text-white">
                            <i class="bi bi-plus-lg me-1"></i>Add Email
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Forward-on-Approve defaults — addresses the Approve modal
       pre-fills the "Send to HR" / "Send to AP" fields with. The
       admin can still type a one-off override at approval time;
       overrides automatically become the new default on save (in
       the controller). This card is the place to configure them
       ahead of time so they're already in the modal on the first
       approval. *@
    @{
        var hrEmail = (string?)ViewBag.HrEmail ?? "";
        var apEmail = (string?)ViewBag.ApEmail ?? "";
        var hrConfigured = !string.IsNullOrWhiteSpace(hrEmail);
        var apConfigured = !string.IsNullOrWhiteSpace(apEmail);
    }
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-send-arrow-up me-2 text-success"></i>Forward-on-Approval Defaults (HR / AP)</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                When an admin approves a receipt, the approval modal asks whether to forward
                a copy to HR or AP for payment processing. The addresses below pre-fill
                that modal. If an address is blank, the modal shows an empty editable
                field; whatever the admin types there becomes the new default automatically.
            </p>
            <form asp-action="SaveForwardDefaults" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label class="form-label fw-semibold">
                        HR email
                        @if (hrConfigured)
                        {
                            <span class="badge bg-success-subtle text-success ms-1">Configured</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning ms-1">Not set</span>
                        }
                    </label>
                    <input type="email" name="hrEmail" class="form-control"
                           value="@hrEmail"
                           placeholder="hr@yourcompany.com" />
                    <div class="form-text">Pre-fills the HR field in the Approve modal.</div>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">
                        Accounts Payable email
                        @if (apConfigured)
                        {
                            <span class="badge bg-success-subtle text-success ms-1">Configured</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning ms-1">Not set</span>
                        }
                    </label>
                    <input type="email" name="apEmail" class="form-control"
                           value="@apEmail"
                           placeholder="ap@yourcompany.com" />
                    <div class="form-text">Pre-fills the AP field in the Approve modal.</div>
                </div>
                <div class="col-md-2 d-flex justify-content-end">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-save me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reminder cadence -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-clock-history me-2 text-warning"></i>Stale Receipt Reminders</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                When enabled, the system will email the recipients above (or all admins, if the list is empty)
                whenever a <strong>Submitted</strong> receipt has been waiting for approval past the grace period.
                The grace period counts <strong>business days only</strong> — Saturdays, Sundays, and dates in
                <a asp-controller="Settings" asp-action="Holidays">Company Holidays</a> are skipped.
                Each receipt is reminded at most once per 24 hours until it's approved or rejected.
            </p>
            <form asp-action="SaveReminderSettings" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Enable reminders</label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="reminderEnabled" name="reminderEnabled" value="true" @(((bool?)ViewBag.ReminderEnabled ?? false) ? "checked" : "") />
                        <label class="form-check-label" for="reminderEnabled">
                            @(((bool?)ViewBag.ReminderEnabled ?? false) ? "Active" : "Paused")
                        </label>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Grace period (business days)</label>
                    <input type="number" class="form-control" name="reminderDays" min="1" max="30"
                           value="@(ViewBag.ReminderDays ?? 3)" />
                    <div class="form-text">Weekends and company holidays don't count toward this total.</div>
                </div>
                <div class="col-md-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save me-1"></i>Save Reminder Settings
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="alert alert-secondary mt-4 small mb-0">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Tip:</strong> The submit notification itself is still gated by the global
        <em>NotifyOnPayrollSubmit</em> setting — keep that on if you want any of these
        recipients to receive emails.
    </div>
</div>
