@model IEnumerable<ServiceDesk.Core.Models.PayrollReceipt>
@{
    var contractors        = ViewBag.Contractors as IEnumerable<ServiceDesk.Core.Models.Employee> ?? Enumerable.Empty<ServiceDesk.Core.Models.Employee>();
    var filterStatus       = ViewBag.FilterStatus as string;
    var filterContractorId = (int?)ViewBag.FilterContractorId;

    var countSubmitted  = (int)(ViewBag.CountSubmitted  ?? 0);
    var countApproved   = (int)(ViewBag.CountApproved   ?? 0);
    var countPaidMonth  = (int)(ViewBag.CountPaidMonth  ?? 0);
    var amtSubmitted    = (decimal)(ViewBag.AmountSubmitted   ?? 0m);
    var amtApproved     = (decimal)(ViewBag.AmountApproved    ?? 0m);
    var amtPaidMonth    = (decimal)(ViewBag.AmountPaidMonth   ?? 0m);
    var amtPaidAllTime  = (decimal)(ViewBag.AmountPaidAllTime ?? 0m);

    bool isFiltered = !string.IsNullOrEmpty(filterStatus)
                    || filterContractorId.HasValue
                    || !string.IsNullOrEmpty(ViewBag.FilterRateType as string);
}

@section Styles {
<style>
    :root {
        --ap-navy:   #1a3a5c;
        --ap-blue:   #0d6efd;
        --ap-green:  #198754;
        --ap-amber:  #fd7e14;
        --ap-red:    #dc3545;
        --ap-muted:  #6c757d;
        --ap-border: #dee2e6;
        --ap-bg:     #f8f9fb;
    }

    /* Page header */
    .ap-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        gap: 16px;
    }
    .ap-title { font-size: 1.45rem; font-weight: 700; color: var(--ap-navy); margin: 0; }
    .ap-sub   { font-size: .85rem; color: var(--ap-muted); margin: 2px 0 0; }

    /* KPI grid */
    .ap-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }
    .ap-kpi {
        background: #fff;
        border: 1px solid var(--ap-border);
        border-radius: 8px;
        padding: 18px 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
        position: relative;
        overflow: hidden;
        transition: transform .15s, box-shadow .15s;
    }
    .ap-kpi:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.09); }
    .ap-kpi-bar {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        border-radius: 8px 8px 0 0;
    }
    .ap-kpi-label {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
        color: var(--ap-muted);
        margin-bottom: 6px;
        margin-top: 4px;
    }
    .ap-kpi-value { font-size: 1.8rem; font-weight: 700; line-height: 1; color: var(--ap-navy); }
    .ap-kpi-amount { font-size: .9rem; font-weight: 600; margin-top: 4px; }
    .ap-kpi-badge {
        position: absolute;
        top: 14px; right: 14px;
        width: 36px; height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    /* Card shell */
    .ap-card {
        background: #fff;
        border: 1px solid var(--ap-border);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        margin-bottom: 20px;
    }
    .ap-card-accent {
        height: 5px;
        background: linear-gradient(90deg, var(--ap-navy) 0%, var(--ap-blue) 100%);
    }
    .ap-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 20px;
        border-bottom: 1px solid var(--ap-border);
        background: var(--ap-bg);
    }
    .ap-card-header-title {
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ap-navy);
        display: flex;
        align-items: center;
        gap: 7px;
    }
    .ap-card-body { padding: 18px 20px; }

    /* Filter bar */
    .ap-filter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr auto auto;
        gap: 12px;
        align-items: end;
    }
    .ap-filter-label {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--ap-navy);
        margin-bottom: 5px;
    }
    .ap-filter-select {
        border: 1px solid var(--ap-border);
        border-radius: 6px;
        padding: 7px 10px;
        font-size: .875rem;
        width: 100%;
        background: #fff;
        color: #212529;
        outline: none;
    }
    .ap-filter-select:focus { border-color: var(--ap-blue); box-shadow: 0 0 0 3px rgba(13,110,253,.1); }
    .ap-btn-filter {
        background: var(--ap-navy);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 18px;
        font-size: .85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        cursor: pointer;
        transition: background .15s;
    }
    .ap-btn-filter:hover { background: #0f2440; }
    .ap-btn-clear {
        background: #fff;
        color: var(--ap-muted);
        border: 1px solid var(--ap-border);
        border-radius: 6px;
        padding: 8px 18px;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        transition: all .15s;
    }
    .ap-btn-clear:hover { border-color: var(--ap-navy); color: var(--ap-navy); }

    /* Active filter chips */
    .filter-active-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        background: #eef4ff;
        border-bottom: 1px solid #b6cfff;
        font-size: .8rem;
    }
    .filter-chip {
        background: var(--ap-navy);
        color: #fff;
        border-radius: 50px;
        padding: 2px 10px;
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .03em;
    }

    /* Table */
    .ap-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
    .ap-table thead tr { background: var(--ap-navy); color: #fff; }
    .ap-table thead th {
        padding: 10px 14px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .ap-table tbody tr { border-bottom: 1px solid #f0f0f0; }
    .ap-table tbody tr:nth-child(even) { background: #f8f9fb; }
    .ap-table tbody tr:hover { background: #eef4ff; }
    .ap-table tbody td { padding: 11px 14px; color: #212529; vertical-align: middle; }

    /* Status pills */
    .sp {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 50px;
        font-size: .71rem;
        font-weight: 700;
        letter-spacing: .04em;
        white-space: nowrap;
    }
    .sp-draft     { background: #e9ecef; color: #495057; }
    .sp-submitted { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
    .sp-approved  { background: #cfe2ff; color: #084298; border: 1px solid #9ec5fe; }
    .sp-paid      { background: #d1e7dd; color: #0a5c36; border: 1px solid #a3cfbb; }

    /* Action buttons */
    .ap-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: .78rem;
        font-weight: 600;
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s;
        white-space: nowrap;
    }
    .ap-btn-approve { background: #d1e7dd; color: #0a5c36; border-color: #a3cfbb; }
    .ap-btn-approve:hover { background: var(--ap-green); color: #fff; border-color: var(--ap-green); }
    .ap-btn-paid    { background: #cfe2ff; color: #084298; border-color: #9ec5fe; }
    .ap-btn-paid:hover { background: var(--ap-blue); color: #fff; border-color: var(--ap-blue); }
    .ap-btn-view    { background: #f8f9fa; color: #495057; border-color: var(--ap-border); }
    .ap-btn-view:hover { background: #eef4ff; color: var(--ap-blue); border-color: var(--ap-blue); }
    .ap-btn-reject  { background: #f8d7da; color: #842029; border-color: #f5c2c7; }
    .ap-btn-reject:hover { background: var(--ap-red); color: #fff; border-color: var(--ap-red); }

    /* Contractor avatar */
    .contractor-avatar {
        width: 30px; height: 30px;
        border-radius: 50%;
        background: var(--ap-navy);
        color: #fff;
        font-size: .75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Empty state */
    .ap-empty { text-align: center; padding: 52px 24px; }
    .ap-empty-icon  { font-size: 3.2rem; color: #dee2e6; margin-bottom: 12px; }
    .ap-empty-title { font-size: 1.05rem; font-weight: 600; color: #495057; margin-bottom: 6px; }
    .ap-empty-sub   { font-size: .88rem; color: var(--ap-muted); }

    @@media (max-width: 767px) {
        .ap-kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .ap-filter-grid { grid-template-columns: 1fr 1fr; }
    }
</style>
}

@* ── Page header ─────────────────────────────────────────────────────── *@
<div class="ap-header d-flex justify-content-between align-items-start">
    <div>
        <h1 class="ap-title"><i class="bi bi-briefcase-fill me-2" style="color:var(--ap-blue);"></i>Contractor Payroll</h1>
        <p class="ap-sub">Review, approve and mark payment for submitted contractor invoices</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (User.IsInRole("Admin"))
        {
            <div class="dropdown">
                <button class="btn btn-outline-success dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        title="Download Paid-receipt CSV for 1099 / bookkeeping">
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i>Annual Export
                </button>
                <ul class="dropdown-menu">
                    @{
                        var thisYear = DateTime.UtcNow.Year;
                        for (var y = thisYear; y >= thisYear - 4; y--)
                        {
                            <li><a class="dropdown-item" asp-action="AnnualExport" asp-route-year="@y">@y (CSV)</a></li>
                        }
                    }
                </ul>
            </div>
            <a asp-action="NotificationRecipients" class="btn btn-outline-secondary"
               title="Lifecycle email toggles, recipients, reminder cadence">
                <i class="bi bi-gear me-1"></i>Payroll Settings
            </a>
        }
        <button type="button" class="btn btn-outline-primary"
                data-bs-toggle="modal" data-bs-target="#weeklyDigestModal" title="Email each contractor their last 7 days of logged hours">
            <i class="bi bi-envelope-paper me-1"></i> Send Weekly Digest
        </button>
    </div>
</div>

@* ── KPI tiles ───────────────────────────────────────────────────────── *@
<div class="ap-kpi-grid">
    <div class="ap-kpi">
        <div class="ap-kpi-bar" style="background:#fd7e14;"></div>
        <div class="ap-kpi-badge" style="background:#fff3e0;color:#fd7e14;"><i class="bi bi-hourglass-split"></i></div>
        <div class="ap-kpi-label">Awaiting Approval</div>
        <div class="ap-kpi-value">@countSubmitted</div>
        <div class="ap-kpi-amount" style="color:#fd7e14;">$@amtSubmitted.ToString("N2")</div>
    </div>
    <div class="ap-kpi">
        <div class="ap-kpi-bar" style="background:var(--ap-blue);"></div>
        <div class="ap-kpi-badge" style="background:#e8f0fe;color:var(--ap-blue);"><i class="bi bi-check-circle"></i></div>
        <div class="ap-kpi-label">Approved / Pending Payment</div>
        <div class="ap-kpi-value">@countApproved</div>
        <div class="ap-kpi-amount" style="color:var(--ap-blue);">$@amtApproved.ToString("N2")</div>
    </div>
    <div class="ap-kpi">
        <div class="ap-kpi-bar" style="background:var(--ap-green);"></div>
        <div class="ap-kpi-badge" style="background:#d1e7dd;color:var(--ap-green);"><i class="bi bi-patch-check-fill"></i></div>
        <div class="ap-kpi-label">Paid This Month</div>
        <div class="ap-kpi-value">@countPaidMonth</div>
        <div class="ap-kpi-amount" style="color:var(--ap-green);">$@amtPaidMonth.ToString("N2")</div>
    </div>
    <div class="ap-kpi">
        <div class="ap-kpi-bar" style="background:var(--ap-navy);"></div>
        <div class="ap-kpi-badge" style="background:#e8edf3;color:var(--ap-navy);"><i class="bi bi-bank"></i></div>
        <div class="ap-kpi-label">Total Paid All Time</div>
        <div class="ap-kpi-value" style="font-size:1.4rem;">$@amtPaidAllTime.ToString("N2")</div>
        <div class="ap-kpi-amount" style="color:var(--ap-muted);">cumulative</div>
    </div>
</div>

@* ── Filter card ─────────────────────────────────────────────────────── *@
<div class="ap-card">
    <div class="ap-card-accent"></div>
    <div class="ap-card-body">
        <form method="get">
            <div class="ap-filter-grid">
                <div>
                    <div class="ap-filter-label">Contractor</div>
                    <select name="contractorId" class="ap-filter-select">
                        <option value="">All Contractors</option>
                        @foreach (var c in contractors)
                        {
                            if (filterContractorId == c.Id) {
                                <option value = "@c.Id" selected="selected">@c.FullName</option>
                            }
                            else
                            {
                                <option value = "@c.Id">@c.FullName</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <div class="ap-filter-label">Status</div>
                    <select name="status" class="ap-filter-select">
                        <option value="">All Statuses</option>
                        @foreach (var s in new[] { "Draft", "Submitted", "Approved", "Paid" })
                        {
                            if ( filterStatus == s ) {
                                <option value="@s" selected="selected">@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    @{ var filterRateType = ViewBag.FilterRateType as string; }
                    <div class="ap-filter-label">Rate Type</div>
                    <select name="rateType" class="ap-filter-select">
                        <option value="">All</option>
                        <option value="StandardOnly" selected="@(filterRateType == "StandardOnly")">Standard only</option>
                        <option value="HasEmergency" selected="@(filterRateType == "HasEmergency")">Has Emergency hours</option>
                        <option value="HasRetainer"  selected="@(filterRateType == "HasRetainer")">Has Retainer applied</option>
                    </select>
                </div>
                <button type="submit" class="ap-btn-filter">
                    <i class="bi bi-funnel-fill"></i>Apply Filter
                </button>
                <a asp-action="Index" class="ap-btn-clear">
                    <i class="bi bi-x-circle"></i>Clear
                </a>
            </div>
        </form>
    </div>
    @if (isFiltered)
    {
        <div class="filter-active-bar">
            <i class="bi bi-funnel-fill" style="color:var(--ap-blue);"></i>
            <span style="color:var(--ap-muted);font-weight:600;">Active filters:</span>
            @if (!string.IsNullOrEmpty(filterStatus))
            { <span class="filter-chip">Status: @filterStatus</span> }
            @if (filterContractorId.HasValue)
            {
                var name = contractors.FirstOrDefault(c => c.Id == filterContractorId)?.FullName ?? $"#{filterContractorId}";
                <span class="filter-chip">Contractor: @name</span>
            }
            @{
                var rateTypeChip = ViewBag.FilterRateType as string;
            }
            @if (!string.IsNullOrEmpty(rateTypeChip))
            {
                var label = rateTypeChip switch {
                    "StandardOnly" => "Standard only",
                    "HasEmergency" => "Has Emergency",
                    "HasRetainer"  => "Has Retainer",
                    _              => rateTypeChip
                };
                <span class="filter-chip">Rate type: @label</span>
            }
            <span style="color:var(--ap-muted);margin-left:4px;">· @Model.Count() result@(Model.Count() == 1 ? "" : "s")</span>
        </div>
    }
</div>

@* ── Receipts table ──────────────────────────────────────────────────── *@
<div class="ap-card">
    <div class="ap-card-accent"></div>
    <div class="ap-card-header">
        <span class="ap-card-header-title">
            <i class="bi bi-collection" style="color:var(--ap-blue);"></i>
            Payroll Receipts
        </span>
        @if (Model.Any())
        {
            <span style="font-size:.78rem;color:var(--ap-muted);">
                @Model.Count() @(Model.Count() == 1 ? "receipt" : "receipts")
            </span>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="ap-empty">
            <div class="ap-empty-icon"><i class="bi bi-file-earmark-x"></i></div>
            <div class="ap-empty-title">No receipts found</div>
            <div class="ap-empty-sub">
                @(isFiltered ? "No receipts match the current filter. Try clearing the filters." : "No contractor receipts have been submitted yet.")
            </div>
            @if (isFiltered)
            {
                <a asp-action="Index" class="ap-btn-clear mt-3 mx-auto" style="width:fit-content;">
                    <i class="bi bi-x-circle"></i>Clear Filters
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="ap-table" id="adminPayrollTable">
                <thead>
                    <tr>
                        <th style="width:36px;">
                            <input type="checkbox" id="chkAll" title="Select all"
                                   style="accent-color:var(--ap-blue);cursor:pointer;"
                                   onchange="toggleAllRows(this.checked)" />
                        </th>
                        <th>#</th>
                        <th>Contractor</th>
                        <th>Period</th>
                        <th class="text-center">Total Hrs</th>
                        <th class="text-center">Std / Emerg</th>
                        <th class="text-center">Retainer</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Approved</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var receipt in Model)
                    {
                        var pillClass = receipt.Status switch {
                            "Draft"     => "sp-draft",
                            "Submitted" => "sp-submitted",
                            "Approved"  => "sp-approved",
                            "Paid"      => "sp-paid",
                            _           => "sp-draft"
                        };
                        var fn = receipt.Contractor?.FirstName ?? "?";
                        var ln = receipt.Contractor?.LastName  ?? "?";
                        var initials = $"{fn[0]}{ln[0]}";
                        <tr data-status="@receipt.Status">
                            <td>
                                <input type="checkbox" class="row-chk" value="@receipt.Id"
                                       style="accent-color:var(--ap-blue);cursor:pointer;"
                                       onchange="updateBulkBar()" />
                            </td>
                            <td>
                                <a asp-controller="Contractor" asp-action="ReceiptDetail" asp-route-id="@receipt.Id"
                                   class="fw-bold text-decoration-none" style="color:var(--ap-blue);">#@receipt.Id</a>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="contractor-avatar">@initials</div>
                                    <div>
                                        <div class="fw-semibold" style="font-size:.875rem;">@receipt.Contractor?.FullName</div>
                                        <div class="text-muted" style="font-size:.75rem;">@receipt.Contractor?.JobTitle</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-nowrap small">
                                @receipt.PeriodStart.ToString("MMM d") – @receipt.PeriodEnd.ToString("MMM d, yyyy")
                            </td>
                            <td class="text-center">@receipt.TotalHours.ToString("0.##")</td>
                            <td class="text-center small">
                                <span class="text-muted">@receipt.TotalStandardHours.ToString("0.##")</span>
                                <span class="mx-1 text-muted">/</span>
                                @if (receipt.TotalEmergencyHours > 0)
                                {
                                    <span class="fw-bold text-danger" title="Emergency hours billed at @(receipt.EmergencyRateSnapshot?.ToString("C") ?? "—")">
                                        @receipt.TotalEmergencyHours.ToString("0.##")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center small">
                                @if (receipt.TotalRetainerAmountApplied > 0)
                                {
                                    <span class="fw-semibold text-success"
                                          title="@receipt.TotalRetainerHoursApplied.ToString("0.##") h absorbed by retainer">
                                        $@receipt.TotalRetainerAmountApplied.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end fw-bold" style="color:var(--ap-navy);">$@receipt.TotalAmount.ToString("N2")</td>
                            <td><span class="sp @pillClass">@receipt.Status</span></td>
                            <td class="small text-muted text-nowrap">@(receipt.SubmittedDate?.ToString("MMM d, yyyy") ?? "—")</td>
                            <td class="small text-nowrap">
                                @if (receipt.ApprovedDate.HasValue)
                                {
                                    <div class="text-muted">@receipt.ApprovedDate.Value.ToString("MMM d, yyyy")</div>
                                    @if (receipt.ApprovedBy != null)
                                    {
                                        <div style="font-size:.7rem;color:var(--ap-muted);">by @receipt.ApprovedBy.FullName</div>
                                    }
                                    @if (!string.IsNullOrEmpty(receipt.ApprovalNote))
                                    {
                                        <i class="bi bi-chat-square-text-fill text-info"
                                           data-bs-toggle="tooltip"
                                           title="@receipt.ApprovalNote"
                                           style="font-size:.78rem; cursor:help;"></i>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (receipt.Status == "Submitted" && User.IsInRole("Admin"))
                                    {
                                        <button type="button" class="ap-btn ap-btn-approve"
                                                onclick="openApproveModal(@receipt.Id, '@Html.Raw((receipt.Contractor?.FullName ?? "").Replace("'","\\'" ))')">
                                            <i class="bi bi-check-lg"></i>Approve
                                        </button>
                                        <button type="button" class="ap-btn ap-btn-reject"
                                                onclick="openRejectModal(@receipt.Id, '@Html.Raw((receipt.Contractor?.FullName ?? "").Replace("'","\\'" ))')">
                                            <i class="bi bi-x-lg"></i>Reject
                                        </button>
                                    }
                                    @if (receipt.Status == "Approved" && User.IsInRole("Admin"))
                                    {
                                        <button type="button" class="ap-btn ap-btn-paid"
                                                onclick="openMarkPaidModal(@receipt.Id, '@Html.Raw((receipt.Contractor?.FullName ?? "").Replace("'","\\'" ))', '@receipt.TotalAmount.ToString("C")')">
                                            <i class="bi bi-currency-dollar"></i>Mark Paid
                                        </button>
                                    }
                                    <a asp-controller="Contractor" asp-action="ReceiptDetail" asp-route-id="@receipt.Id"
                                       class="ap-btn ap-btn-view">
                                        <i class="bi bi-eye"></i>View
                                    </a>
                                    @if (receipt.Status != "Draft")
                                    {
                                        <button type="button" class="ap-btn ap-btn-view"
                                                onclick="openShareModal(@receipt.Id, '@Html.Raw((receipt.Contractor?.FullName ?? "").Replace("'","\\'" ))', '@receipt.PeriodStart.ToString("MMM d")', '@receipt.PeriodEnd.ToString("MMM d, yyyy")')"
                                                title="Email this receipt">
                                            <i class="bi bi-send"></i>Share
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Bulk Action Floating Bar ─────────────────────────────────────────────── *@
<div id="bulkBar" style="display:none;position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
     background:var(--ap-navy);color:#fff;border-radius:10px;padding:12px 24px;
     box-shadow:0 8px 32px rgba(0,0,0,.25);z-index:1050;display:none;
     align-items:center;gap:12px;font-size:.875rem;font-weight:600;white-space:nowrap;">
    <span id="bulkCount"></span>
    <button type="button" data-bs-toggle="modal" data-bs-target="#bulkApproveModal"
            style="background:#198754;color:#fff;border:none;border-radius:6px;padding:6px 16px;font-size:.82rem;font-weight:700;cursor:pointer;">
        <i class="bi bi-check-lg me-1"></i>Approve Selected
    </button>
    <form asp-action="BulkMarkPaid" method="post" id="bulkPaidForm" class="d-inline">
        @Html.AntiForgeryToken()
        <span id="bulkPaidIds"></span>
        <button type="submit" style="background:#0d6efd;color:#fff;border:none;border-radius:6px;padding:6px 16px;font-size:.82rem;font-weight:700;cursor:pointer;">
            <i class="bi bi-currency-dollar me-1"></i>Mark Paid Selected
        </button>
    </form>
    <button type="button" onclick="clearSelection()"
            style="background:transparent;color:#adb5bd;border:none;font-size:1rem;cursor:pointer;line-height:1;">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

@* ── Approve Modal ────────────────────────────────────────────────────────── *@
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:var(--ap-green);color:#fff;">
                <h5 class="modal-title" id="approveModalLabel">
                    <i class="bi bi-check-circle me-2"></i>Approve Receipt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="approveForm" asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="approveReceiptId" />
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Approving <strong id="approveContractorName"></strong>'s receipt records you
                        as the approver and stamps the timestamp. The contractor will be notified
                        by email.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Approval note <span class="text-muted fw-normal">(optional — included in the email)</span></label>
                        <textarea name="approvalNote" class="form-control" rows="3" maxlength="1000"
                                  placeholder="e.g. Matches PO #142 — approved for payment in next cycle"></textarea>
                    </div>

                    @{
                        var defaultHrEmail = (string?)ViewBag.DefaultHrEmail ?? "";
                        var defaultApEmail = (string?)ViewBag.DefaultApEmail ?? "";
                    }
                    @* Forward-on-approve workflow.
                       Two-row mini form that lets the admin push the
                       approved receipt straight to HR / AP without
                       leaving the modal. Email fields are always
                       editable — any change the admin makes here is
                       persisted as the new default for next time. *@
                    <div class="border rounded p-3" style="background:#f8fafc;">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-send-arrow-up me-2 text-primary"></i>
                            <span class="fw-semibold">Forward a copy on approval</span>
                            <span class="text-muted small ms-2">(optional)</span>
                        </div>
                        <div class="text-muted small mb-3">
                            Sends the receipt (PDF + Excel) to the addresses below as soon as approval lands.
                            The email you type here becomes the default the next time you approve a receipt.
                        </div>

                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-auto" style="min-width:140px;">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="approveSendHr" name="sendToHr" value="true" />
                                    <label class="form-check-label fw-semibold" for="approveSendHr">
                                        Send to HR
                                    </label>
                                </div>
                            </div>
                            <div class="col">
                                <input type="email" name="hrEmail" id="approveHrEmail" class="form-control form-control-sm"
                                       value="@defaultHrEmail"
                                       placeholder="hr@yourcompany.com" />
                            </div>
                        </div>

                        <div class="row g-2 align-items-center">
                            <div class="col-auto" style="min-width:140px;">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="approveSendAp" name="sendToAp" value="true" />
                                    <label class="form-check-label fw-semibold" for="approveSendAp">
                                        Send to AP
                                    </label>
                                </div>
                            </div>
                            <div class="col">
                                <input type="email" name="apEmail" id="approveApEmail" class="form-control form-control-sm"
                                       value="@defaultApEmail"
                                       placeholder="ap@yourcompany.com" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>Approve Receipt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Weekly Digest Modal ──────────────────────────────────────────────────── *@
<div class="modal fade" id="weeklyDigestModal" tabindex="-1" aria-labelledby="weeklyDigestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:var(--ap-blue);color:#fff;">
                <h5 class="modal-title" id="weeklyDigestModalLabel">
                    <i class="bi bi-envelope-paper me-2"></i>Send Weekly Hours Digest
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SendWeeklyDigest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Emails every active contractor with their last 7 days of logged hours
                        (Standard / Emergency split, billable totals, per-day rows). Useful as
                        a nudge before a submission window closes.
                    </p>
                    <label class="form-label fw-semibold">Week ends on</label>
                    <input type="date" name="weekEnd" class="form-control"
                           value="@DateTime.UtcNow.Date.ToString("yyyy-MM-dd")" />
                    <div class="form-text">The 7-day window ends on this date (inclusive). Defaults to today.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>Send Now
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Bulk Approve Modal ───────────────────────────────────────────────────── *@
<div class="modal fade" id="bulkApproveModal" tabindex="-1" aria-labelledby="bulkApproveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#198754;color:#fff;">
                <h5 class="modal-title" id="bulkApproveModalLabel">
                    <i class="bi bi-check2-all me-2"></i>Approve <span id="bulkApproveCount">0</span> Receipt(s)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="BulkApprove" method="post" id="bulkApproveForm">
                @Html.AntiForgeryToken()
                <span id="bulkApproveIds"></span>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        All selected receipts will be approved in one batch. Each contractor receives the
                        same approval note in their email.
                    </p>
                    <div>
                        <label class="form-label fw-semibold">Approval note <span class="text-muted fw-normal">(optional — included in every email)</span></label>
                        <textarea name="approvalNote" class="form-control" rows="3" maxlength="1000"
                                  placeholder="e.g. Q2 batch — approved for next pay cycle"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>Approve All Selected
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Mark Paid Modal ─────────────────────────────────────────────────────── *@
<div class="modal fade" id="markPaidModal" tabindex="-1" aria-labelledby="markPaidModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#198754;color:#fff;">
                <h5 class="modal-title" id="markPaidModalLabel">
                    <i class="bi bi-currency-dollar me-2"></i>Mark Paid <span id="markPaidReceiptNum"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="markPaidForm" asp-action="MarkPaid" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="markPaidReceiptId" />
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Marking <strong id="markPaidContractor"></strong>'s receipt for
                        <strong id="markPaidAmount" class="text-success"></strong> as Paid.
                        Capture how the payment was issued so the contractor can reconcile.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Method <span class="text-muted fw-normal">(optional)</span></label>
                        <select name="paymentMethod" class="form-select">
                            <option value="">— Not specified —</option>
                            <option value="Check">Check</option>
                            <option value="ACH">ACH</option>
                            <option value="Zelle">Zelle</option>
                            <option value="Wire">Wire Transfer</option>
                            <option value="Cash">Cash</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reference <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="text" name="paymentReference" class="form-control"
                               placeholder="e.g. Check #1234, ACH-2X9KQ, Zelle confirmation" />
                        <div class="form-text">
                            Shown to the contractor in the payment-issued email and on the receipt detail.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check2-circle me-1"></i>Mark Paid
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Share Receipt Modal ──────────────────────────────────────────────────── *@
<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#0d6efd;color:#fff;">
                <h5 class="modal-title" id="shareModalLabel">
                    <i class="bi bi-send me-2"></i>Share Receipt <span id="shareReceiptNum"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="shareForm" asp-action="ShareReceipt" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="shareReceiptId" />
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Forward <strong id="shareContractorName"></strong>'s receipt to Accounts Payable
                        or any other recipient. The PDF and/or XLSX is attached automatically.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">To <span class="text-danger">*</span></label>
                        <input type="email" name="toEmail" class="form-control" required placeholder="ap@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cc <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="text" name="ccEmail" class="form-control" placeholder="payroll@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject</label>
                        <input type="text" name="subject" id="shareSubject" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message <span class="text-muted fw-normal">(optional)</span></label>
                        <textarea name="message" class="form-control" rows="3"
                                  placeholder="e.g. Approved this morning — please process in the next pay run."></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold d-block">Attach</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="format" id="shareFmtPdf" value="pdf" />
                            <label class="form-check-label" for="shareFmtPdf">PDF</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="format" id="shareFmtXlsx" value="xlsx" />
                            <label class="form-check-label" for="shareFmtXlsx">Excel</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="format" id="shareFmtBoth" value="both" checked />
                            <label class="form-check-label" for="shareFmtBoth">Both</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>Send
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Reject Modal ─────────────────────────────────────────────────────────── *@
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:var(--ap-red);color:#fff;">
                <h5 class="modal-title" id="rejectModalLabel">
                    <i class="bi bi-x-circle me-2"></i>Return Receipt for Revision
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="rejectForm" asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectReceiptId" />
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        This will return the receipt from <strong id="rejectContractorName"></strong> to
                        <span class="badge" style="background:#e9ecef;color:#495057;">Draft</span> status
                        so the contractor can revise and resubmit.
                    </p>
                    <div>
                        <label class="form-label fw-semibold">Reason for return <span class="text-muted fw-normal">(optional but recommended)</span></label>
                        <textarea name="rejectionNote" class="form-control" rows="3" maxlength="1000"
                                  placeholder="e.g. Please correct the date range or add missing descriptions..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Return for Revision
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openMarkPaidModal(id, name, amount) {
    document.getElementById('markPaidReceiptId').value = id;
    document.getElementById('markPaidReceiptNum').textContent = '#' + id;
    document.getElementById('markPaidContractor').textContent = name;
    document.getElementById('markPaidAmount').textContent = amount;
    var form = document.getElementById('markPaidForm');
    form.action = form.action.replace(/\/MarkPaid(\/\d+)?$/, '/MarkPaid/' + id);
    new bootstrap.Modal(document.getElementById('markPaidModal')).show();
}
function openShareModal(id, name, periodStart, periodEnd) {
    document.getElementById('shareReceiptId').value = id;
    document.getElementById('shareReceiptNum').textContent = '#' + id;
    document.getElementById('shareContractorName').textContent = name;
    document.getElementById('shareSubject').value =
        'Contractor Receipt #' + id + ' — ' + name + ' — ' + periodStart + ' to ' + periodEnd;
    // The asp-action="ShareReceipt" tag-helper renders /AdminPayroll/ShareReceipt
    // and the hidden 'id' is sent in the form body. Refresh the form's action
    // url so the receipt id is also in the route for clarity.
    var form = document.getElementById('shareForm');
    form.action = form.action.replace(/\/ShareReceipt(\/\d+)?$/, '/ShareReceipt/' + id);
    new bootstrap.Modal(document.getElementById('shareModal')).show();
}
function openApproveModal(id, name) {
    document.getElementById('approveReceiptId').value = id;
    document.getElementById('approveContractorName').textContent = name;
    new bootstrap.Modal(document.getElementById('approveModal')).show();
}

// Auto-tick the matching checkbox the moment the admin types in either
// forward-on-approve field. Saves the "I typed the address but forgot to
// flip the toggle" footgun.
(function () {
    function bindAutoCheck(emailId, checkId) {
        var emailEl = document.getElementById(emailId);
        var checkEl = document.getElementById(checkId);
        if (!emailEl || !checkEl) return;
        emailEl.addEventListener('input', function () {
            if (emailEl.value.trim().length > 0) checkEl.checked = true;
        });
    }
    document.addEventListener('DOMContentLoaded', function () {
        bindAutoCheck('approveHrEmail', 'approveSendHr');
        bindAutoCheck('approveApEmail', 'approveSendAp');
    });
})();

function openRejectModal(id, name) {
    document.getElementById('rejectReceiptId').value = id;
    document.getElementById('rejectContractorName').textContent = name;
    new bootstrap.Modal(document.getElementById('rejectModal')).show();
}

// Bootstrap tooltips for the approval-note icons + any other [data-bs-toggle=tooltip] elements.
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });
});

function toggleAllRows(checked) {
    document.querySelectorAll('.row-chk').forEach(cb => cb.checked = checked);
    updateBulkBar();
}

function updateBulkBar() {
    const checked = [...document.querySelectorAll('.row-chk:checked')];
    const bar = document.getElementById('bulkBar');
    if (checked.length === 0) { bar.style.display = 'none'; return; }

    bar.style.display = 'flex';
    document.getElementById('bulkCount').textContent = checked.length + ' selected';

    // Build hidden inputs for each form
    ['bulkApproveIds','bulkPaidIds'].forEach(spanId => {
        const span = document.getElementById(spanId);
        if (span) span.innerHTML = checked.map(cb => `<input type="hidden" name="ids" value="${cb.value}">`).join('');
    });
    document.getElementById('bulkApproveCount').textContent = checked.length;

    document.getElementById('chkAll').indeterminate =
        checked.length > 0 && checked.length < document.querySelectorAll('.row-chk').length;
    document.getElementById('chkAll').checked = checked.length === document.querySelectorAll('.row-chk').length;
}

function clearSelection() {
    document.querySelectorAll('.row-chk').forEach(cb => cb.checked = false);
    document.getElementById('chkAll').checked = false;
    updateBulkBar();
}
</script>
}
