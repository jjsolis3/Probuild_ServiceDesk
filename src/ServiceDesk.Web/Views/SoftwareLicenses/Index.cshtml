@using ServiceDesk.Core.Enums
@model IEnumerable<ServiceDesk.Core.Models.SoftwareLicense>
@{
    ViewData["Title"] = "Software Licenses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-box-seam"></i> Software Licenses</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>New License
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-primary">@ViewBag.TotalLicenses</div>
                <div class="small text-muted">Licenses</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold">@ViewBag.SeatsInUse / @ViewBag.TotalSeats</div>
                <div class="small text-muted">Seats Used</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm @(((int)ViewBag.ExpiringCount) > 0 ? "border-warning" : "")">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold @(((int)ViewBag.ExpiringCount) > 0 ? "text-warning" : "")">@ViewBag.ExpiringCount</div>
                <div class="small text-muted">Expiring ≤30d</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm @(((int)ViewBag.ExpiredCount) > 0 ? "border-danger" : "")">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold @(((int)ViewBag.ExpiredCount) > 0 ? "text-danger" : "")">@ViewBag.ExpiredCount</div>
                <div class="small text-muted">Expired</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-success">@(((decimal)ViewBag.TotalAnnualCost).ToString("C0"))</div>
                <div class="small text-muted">Total License Cost</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
    <div class="input-group input-group-sm" style="max-width:260px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="licQ" class="form-control" placeholder="Search..." value="@ViewBag.Query">
        <button type="button" class="btn btn-outline-primary" onclick="applyFilters()">Search</button>
    </div>
    <a asp-action="Index" asp-route-expiring="true" class="btn btn-sm @(ViewBag.Expiring == true ? "btn-warning" : "btn-outline-warning")">
        <i class="bi bi-clock-history me-1"></i>Expiring Soon
    </a>
    <a asp-action="Index" asp-route-expired="true" class="btn btn-sm @(ViewBag.Expired == true ? "btn-danger" : "btn-outline-danger")">
        <i class="bi bi-x-circle me-1"></i>Expired
    </a>
    <a asp-action="Index" asp-route-activeOnly="true" class="btn btn-sm @(ViewBag.ActiveOnly == true ? "btn-primary" : "btn-outline-primary")">
        Active Only
    </a>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-x me-1"></i>Clear
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable">
        <thead class="table-dark">
            <tr>
                <th>Product</th>
                <th>Publisher</th>
                <th>Type</th>
                <th>Seats</th>
                <th>Available</th>
                <th>Cost/Seat</th>
                <th>Expiry</th>
                <th>Status</th>
                <th class="no-sort">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lic in Model)
            {
                var rowClass = lic.IsExpired ? "table-danger" : lic.IsExpiringSoon ? "table-warning" : "";
                <tr class="@rowClass">
                    <td>
                        <a asp-action="Details" asp-route-id="@lic.Id" class="fw-semibold">@lic.ProductName</a>
                        @if (!string.IsNullOrEmpty(lic.PurchaseOrderNumber))
                        { <span class="text-muted small ms-1">PO#@lic.PurchaseOrderNumber</span> }
                    </td>
                    <td>@(lic.Publisher ?? "—")</td>
                    <td><span class="badge bg-info text-dark">@lic.LicenseType</span></td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height:6px;min-width:60px;">
                                @{ var pct = lic.TotalSeats > 0 ? (lic.SeatsInUse * 100 / lic.TotalSeats) : 0; }
                                <div class="progress-bar @(pct >= 90 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-success")"
                                     style="width:@pct%"></div>
                            </div>
                            <span class="small">@lic.SeatsInUse/@lic.TotalSeats</span>
                        </div>
                    </td>
                    <td>
                        <span class="badge @(lic.AvailableSeats == 0 ? "bg-danger" : lic.AvailableSeats <= 2 ? "bg-warning text-dark" : "bg-success")">
                            @lic.AvailableSeats
                        </span>
                    </td>
                    <td>@(lic.CostPerSeat?.ToString("C") ?? "—")</td>
                    <td class="text-nowrap">
                        @if (lic.ExpiryDate.HasValue)
                        {
                            <span class="@(lic.IsExpired ? "text-danger fw-semibold" : lic.IsExpiringSoon ? "text-warning fw-semibold" : "")">
                                @lic.ExpiryDate.Value.ToString("MMM d, yyyy")
                                @if (lic.IsExpired) { <i class="bi bi-exclamation-triangle-fill ms-1"></i> }
                                else if (lic.IsExpiringSoon) { <i class="bi bi-clock-history ms-1"></i> }
                            </span>
                        }
                        else { <span class="text-muted">—</span> }
                    </td>
                    <td>
                        @if (lic.IsActive)
                        { <span class="badge bg-success">Active</span> }
                        else
                        { <span class="badge bg-secondary">Inactive</span> }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@lic.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@lic.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this license?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-box-seam display-1 opacity-25"></i>
        <p class="mt-3">No software licenses found.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add License</a>
    </div>
}

@section Scripts {
<script>
function applyFilters() {
    const q = document.getElementById('licQ').value.trim();
    const url = new URL(window.location.href);
    if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
    window.location.href = url.toString();
}
document.getElementById('licQ')?.addEventListener('keydown', e => { if (e.key === 'Enter') applyFilters(); });
</script>
}
