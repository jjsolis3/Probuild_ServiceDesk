@using ServiceDesk.Core.Enums
@model ServiceDesk.Core.Models.SoftwareLicense
@{
    ViewData["Title"] = "New Software License";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Software Licenses</a></li>
        <li class="breadcrumb-item active">New</li>
    </ol>
</nav>

<h2 class="mb-4"><i class="bi bi-box-seam me-2"></i>New Software License</h2>

<div class="card shadow-sm" style="max-width:720px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_LicenseForm", Model)
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
