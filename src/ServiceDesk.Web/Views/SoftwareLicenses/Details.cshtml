@model ServiceDesk.Core.Models.SoftwareLicense
@{
    ViewData["Title"] = Model.ProductName;
    var pct = Model.TotalSeats > 0 ? (Model.SeatsInUse * 100 / Model.TotalSeats) : 0;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Software Licenses</a></li>
        <li class="breadcrumb-item active">@Model.ProductName</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="fs-3 fw-bold mb-1">
            <i class="bi bi-box-seam text-primary me-2"></i>@Model.ProductName
        </h1>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="badge bg-info text-dark">@Model.LicenseType</span>
            @if (Model.IsExpired)    { <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Expired</span> }
            else if (Model.IsExpiringSoon) { <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Expiring Soon</span> }
            @if (!Model.IsActive)   { <span class="badge bg-secondary">Inactive</span> }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="bi bi-card-list me-2"></i>License Details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Publisher</dt>
                    <dd class="col-sm-7">@(Model.Publisher ?? "—")</dd>
                    <dt class="col-sm-5 text-muted small">Vendor</dt>
                    <dd class="col-sm-7">@(Model.Vendor ?? "—")</dd>
                    <dt class="col-sm-5 text-muted small">PO Number</dt>
                    <dd class="col-sm-7">@(Model.PurchaseOrderNumber ?? "—")</dd>
                    <dt class="col-sm-5 text-muted small">Purchase Date</dt>
                    <dd class="col-sm-7">@(Model.PurchaseDate?.ToString("MMM d, yyyy") ?? "—")</dd>
                    <dt class="col-sm-5 text-muted small">Expiry Date</dt>
                    <dd class="col-sm-7">
                        <span class="@(Model.IsExpired ? "text-danger fw-semibold" : Model.IsExpiringSoon ? "text-warning fw-semibold" : "")">
                            @(Model.ExpiryDate?.ToString("MMM d, yyyy") ?? "—")
                        </span>
                    </dd>
                    <dt class="col-sm-5 text-muted small">License Key</dt>
                    <dd class="col-sm-7">
                        @if (!string.IsNullOrEmpty(Model.LicenseKey))
                        {
                            <code id="licKey" class="small">••••••••••••••••</code>
                            <button class="btn btn-link btn-sm p-0 ms-1" onclick="toggleKey()">
                                <i class="bi bi-eye" id="keyIcon"></i>
                            </button>
                        }
                        else { <span class="text-muted">—</span> }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="bi bi-people me-2"></i>Seat Usage</div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>@Model.SeatsInUse used of @Model.TotalSeats total</span>
                        <span>@pct%</span>
                    </div>
                    <div class="progress" style="height:12px;">
                        <div class="progress-bar @(pct >= 90 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-success")"
                             style="width:@pct%"></div>
                    </div>
                </div>
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="fs-4 fw-bold text-primary">@Model.TotalSeats</div>
                        <div class="small text-muted">Total</div>
                    </div>
                    <div class="col-4">
                        <div class="fs-4 fw-bold">@Model.SeatsInUse</div>
                        <div class="small text-muted">In Use</div>
                    </div>
                    <div class="col-4">
                        <div class="fs-4 fw-bold @(Model.AvailableSeats == 0 ? "text-danger" : "text-success")">
                            @Model.AvailableSeats
                        </div>
                        <div class="small text-muted">Available</div>
                    </div>
                </div>
                @if (Model.CostPerSeat.HasValue)
                {
                    <hr />
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Cost / Seat</span><span>@Model.CostPerSeat.Value.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Total Cost</span><span class="fw-semibold">@Model.TotalCost?.ToString("C")</span>
                    </div>
                }
            </div>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold"><i class="bi bi-sticky me-2"></i>Notes</div>
                <div class="card-body"><p class="mb-0" style="white-space:pre-wrap;">@Model.Notes</p></div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
var _keyVisible = false;
var _key = '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LicenseKey ?? ""))';
function toggleKey() {
    _keyVisible = !_keyVisible;
    document.getElementById('licKey').textContent = _keyVisible ? _key.replace(/^"|"$/g,'') : '••••••••••••••••';
    document.getElementById('keyIcon').className = _keyVisible ? 'bi bi-eye-slash' : 'bi bi-eye';
}
</script>
}
