@using ServiceDesk.Core.Enums
@model ServiceDesk.Core.Models.SoftwareLicense

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="ProductName" class="form-label fw-semibold"></label>
        <input asp-for="ProductName" class="form-control" placeholder="e.g. Microsoft 365 Business" />
        <span asp-validation-for="ProductName" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="LicenseType" class="form-label fw-semibold"></label>
        <select asp-for="LicenseType" class="form-select"
                asp-items="Html.GetEnumSelectList<LicenseType>()"></select>
    </div>
    <div class="col-md-6">
        <label asp-for="Publisher" class="form-label fw-semibold"></label>
        <input asp-for="Publisher" class="form-control" placeholder="e.g. Microsoft" />
    </div>
    <div class="col-md-6">
        <label asp-for="Vendor" class="form-label fw-semibold"></label>
        <input asp-for="Vendor" class="form-control" placeholder="Reseller or store" />
    </div>
    <div class="col-12">
        <label asp-for="LicenseKey" class="form-label fw-semibold"></label>
        <input asp-for="LicenseKey" class="form-control font-monospace"
               placeholder="XXXXX-XXXXX-XXXXX-XXXXX" />
    </div>
    <div class="col-md-3">
        <label asp-for="TotalSeats" class="form-label fw-semibold"></label>
        <input asp-for="TotalSeats" class="form-control" type="number" min="1" />
    </div>
    <div class="col-md-3">
        <label asp-for="SeatsInUse" class="form-label fw-semibold"></label>
        <input asp-for="SeatsInUse" class="form-control" type="number" min="0" />
    </div>
    <div class="col-md-3">
        <label asp-for="CostPerSeat" class="form-label fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="CostPerSeat" class="form-control" type="number" step="0.01" min="0" />
        </div>
    </div>
    <div class="col-md-3">
        <label asp-for="PurchaseOrderNumber" class="form-label fw-semibold"></label>
        <input asp-for="PurchaseOrderNumber" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="PurchaseDate" class="form-label fw-semibold"></label>
        <input asp-for="PurchaseDate" class="form-control" type="date" />
    </div>
    <div class="col-md-6">
        <label asp-for="ExpiryDate" class="form-label fw-semibold"></label>
        <input asp-for="ExpiryDate" class="form-control" type="date" />
    </div>
    <div class="col-md-8">
        <label asp-for="Notes" class="form-label fw-semibold"></label>
        <textarea asp-for="Notes" class="form-control" rows="2" maxlength="1000"></textarea>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
        </div>
    </div>
</div>
