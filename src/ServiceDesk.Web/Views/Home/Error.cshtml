@{
    ViewData["Title"] = "An Error Occurred";
    var requestId = ViewBag.RequestId as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="mb-4">
            <i class="fas fa-exclamation-circle fa-5x text-danger"></i>
        </div>
        <h2 class="fw-bold mb-2">Something went wrong</h2>
        <p class="text-muted mb-4">
            An unexpected error occurred while processing your request.
            Please try again, or contact IT support if the problem persists.
        </p>

        @if (!string.IsNullOrEmpty(requestId))
        {
            <p class="text-muted small mb-4">
                Reference ID: <code>@requestId</code>
            </p>
        }

        <div class="d-flex gap-2 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-home me-1"></i> Go to Dashboard
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Go Back
            </button>
        </div>
    </div>
</div>
