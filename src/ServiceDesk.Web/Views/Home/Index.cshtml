@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-speedometer2"></i> Dashboard</h1>
    <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Ticket
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
        <div class="card dashboard-card tickets h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Open Tickets</div>
                    <div class="fs-2 fw-bold text-primary">@Model.OpenTickets</div>
                </div>
                <i class="bi bi-ticket-detailed card-icon text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card dashboard-card progress h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">In Progress</div>
                    <div class="fs-2 fw-bold text-warning">@Model.InProgressTickets</div>
                </div>
                <i class="bi bi-arrow-repeat card-icon text-warning"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card dashboard-card resolved h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Resolved (Month)</div>
                    <div class="fs-2 fw-bold text-success">@Model.ResolvedThisMonth</div>
                </div>
                <i class="bi bi-check-circle card-icon text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card dashboard-card assets h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Assets</div>
                    <div class="fs-2 fw-bold text-purple">@Model.TotalAssets</div>
                    <div class="text-muted small">@Model.AssignedAssets assigned</div>
                </div>
                <i class="bi bi-laptop card-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card dashboard-card employees h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Employees</div>
                    <div class="fs-2 fw-bold text-info">@Model.ActiveEmployees</div>
                </div>
                <i class="bi bi-people card-icon text-info"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card dashboard-card subscriptions h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Subscriptions</div>
                    <div class="fs-2 fw-bold" style="color: #fd7e14;">@Model.ActiveSubscriptions</div>
                    <div class="text-muted small">@Model.MonthlySubscriptionCost.ToString("C")/mo</div>
                </div>
                <i class="bi bi-credit-card card-icon" style="color: #fd7e14;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Critical Tickets -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle"></i> Critical Tickets
            </div>
            <div class="card-body p-0">
                @if (Model.CriticalTickets.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Submitted By</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model.CriticalTickets)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                            @ticket.Title
                                        </a>
                                    </td>
                                    <td>@ticket.SubmittedBy?.FullName</td>
                                    <td>@(ticket.AssignedTo?.FullName ?? "Unassigned")</td>
                                    <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted text-center">No critical tickets</div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Tickets -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> Recent Tickets
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.RecentTickets)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td>@ticket.Category</td>
                                <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                                <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                <td>@ticket.CreatedDate.ToString("MMM dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-center">
                <a asp-controller="Tickets" asp-action="Index">View All Tickets</a>
            </div>
        </div>
    </div>
</div>
