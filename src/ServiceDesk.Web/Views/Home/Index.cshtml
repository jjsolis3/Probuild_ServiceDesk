@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-speedometer2"></i> Dashboard</h1>
    <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Ticket
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-3">
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card tickets h-75 kpi-clickable" data-kpi-type="open" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Open Tickets</div>
                    <div class="fs-2 fw-bold text-primary">@Model.OpenTickets</div>
                </div>
                <i class="bi bi-clipboard-data card-icon text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card progress h-75 kpi-clickable" data-kpi-type="inprogress" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">In Progress</div>
                    <div class="fs-2 fw-bold text-warning">@Model.InProgressTickets</div>
                </div>
                <i class="bi bi-arrow-repeat card-icon text-warning"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card resolved h-75 kpi-clickable" data-kpi-type="resolved" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Resolved (Month)</div>
                    <div class="fs-2 fw-bold text-success">@Model.ResolvedThisMonth</div>
                </div>
                <i class="bi bi-check-circle card-icon text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card assets h-75 kpi-clickable" data-kpi-type="assets" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Assets</div>
                    <div class="fs-2 fw-bold text-purple">@Model.TotalAssets</div>
                    <div class="text-muted small">@Model.AssignedAssets assigned</div>
                </div>
                <i class="bi bi-laptop card-icon"></i>
            </div>
        </div>
    </div>
    @* <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card employees h-75 kpi-clickable" data-kpi-type="employees" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Employees</div>
                    <div class="fs-2 fw-bold text-info">@Model.ActiveEmployees</div>
                </div>
                <i class="bi bi-people card-icon text-info"></i>
            </div>
        </div>
    </div> *@
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card subscriptions h-75 kpi-clickable" data-kpi-type="subscriptions" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Subscriptions</div>
                    <div class="fs-2 fw-bold" style="color: #fd7e14;">@Model.ActiveSubscriptions</div>
                    <div class="text-muted small">@Model.MonthlySubscriptionCost.ToString("C")/mo</div>
                </div>
                <i class="bi bi-credit-card card-icon" style="color: #fd7e14;"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-2">
        <a asp-controller="Tickets" asp-action="Index" asp-route-status="Open" class="text-decoration-none">
            <div class="card h-75 @(Model.SlaBreachCount > 0 ? "border-danger" : "border-0")">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase">SLA Breached</div>
                        <div class="fs-2 fw-bold @(Model.SlaBreachCount > 0 ? "text-danger" : "text-success")">@Model.SlaBreachCount</div>
                        <div class="text-muted small">overdue tickets</div>
                    </div>
                    <i class="bi bi-alarm card-icon @(Model.SlaBreachCount > 0 ? "text-danger" : "text-success")"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Warranty Expiry Alerts (shown only when there are assets expiring within 90 days) -->
@if (Model.ExpiringWarranties.Any())
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning text-dark fw-semibold">
            <i class="bi bi-shield-exclamation me-1"></i> Warranty Expiry Alerts
            <span class="badge bg-dark ms-2">@Model.ExpiringWarranties.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Asset</th>
                        <th>Tag</th>
                        <th>Assigned To</th>
                        <th>Warranty Expires</th>
                        <th>Days Left</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asset in Model.ExpiringWarranties)
                    {
                        var daysLeft = (int)(asset.WarrantyExpiry!.Value.Date - DateTime.UtcNow.Date).TotalDays;
                        var rowClass = daysLeft <= 14 ? "table-danger" : daysLeft <= 30 ? "table-warning" : "";
                        <tr class="@rowClass">
                            <td>
                                <a asp-controller="Assets" asp-action="Details" asp-route-id="@asset.Id">@asset.Name</a>
                            </td>
                            <td>@asset.AssetTag</td>
                            <td>@(asset.AssignedTo?.FullName ?? "Unassigned")</td>
                            <td>@asset.WarrantyExpiry.Value.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge @(daysLeft <= 14 ? "bg-danger" : daysLeft <= 30 ? "bg-warning text-dark" : "bg-secondary")">
                                    @daysLeft days
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="row g-3">
    <!-- Critical Tickets -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle"></i> Critical Tickets
            </div>
            <div class="card-body p-0">
                @if (Model.CriticalTickets.Any())
                {
                    <table class="table table-hover mb-0 ss-datatable-compact">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Submitted By</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model.CriticalTickets)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                            @ticket.Title
                                        </a>
                                    </td>
                                    <td>@ticket.SubmittedBy?.FullName</td>
                                    <td>@(ticket.AssignedTo?.FullName ?? "Unassigned")</td>
                                    <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted text-center">No critical tickets</div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Tickets -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> Recent Tickets
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 ss-datatable-compact">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.RecentTickets)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td>@ticket.Category</td>
                                <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                                <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                <td>@ticket.CreatedDate.ToString("MMM dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-center">
                <a asp-controller="Tickets" asp-action="Index">View All Tickets</a>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <!-- 7-Day Ticket Volume Bar Chart -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-bar-chart me-1"></i> Ticket Volume (Last 7 Days)
            </div>
            <div class="card-body">
                <div id="chartTicketVolume"></div>
            </div>
        </div>
    </div>
    <!-- Status Donut + Priority Bar -->
    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-pie-chart me-1"></i> Status Distribution
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="chartStatusDonut" style="width:100%;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-exclamation-diamond me-1"></i> Open by Priority
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="chartPriorityBar" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>


<!-- KPI Detail Modal -->
<div class="modal fade" id="kpiDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kpiModalTitle">...</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="kpiModalBody">
                <div class="text-center py-4" id="kpiModalLoading">
                    <div class="spinner-border text-primary"></div><p class="mt-2">Loading...</p>
                </div>
                <div class="table-responsive" id="kpiModalTable" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <a id="kpiModalLink" href="#" class="btn btn-primary"><i class="bi bi-box-arrow-up-right"></i> View Full Details</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.css" />
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    // ---- Ticket Volume Bar Chart ----
    var volEl = document.getElementById('chartTicketVolume');
    if (volEl) {
        new ApexCharts(volEl, {
            series: [{ name: 'Tickets', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketVolumeCounts)) }],
            chart: { type: 'bar', height: 200, toolbar: { show: false } },
            plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
            dataLabels: { enabled: false },
            xaxis: { categories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketVolumeDates)), labels: { style: { fontSize: '11px' } } },
            yaxis: { min: 0, tickAmount: 3, labels: { style: { fontSize: '11px' } } },
            colors: ['#2f4cdd'],
            grid: { borderColor: '#f1f1f1' },
            tooltip: { y: { formatter: function(val) { return val + ' tickets'; } } }
        }).render();
    }

    // ---- Status Donut Chart ----
    var donutEl = document.getElementById('chartStatusDonut');
    if (donutEl) {
        var statusSeries = [@Model.StatusOpen, @Model.StatusInProgress, @Model.StatusOnHold, @Model.StatusResolved, @Model.StatusClosed];
        // ApexCharts donut requires at least one non-zero value
        var hasData = statusSeries.some(function(v) { return v > 0; });
        if (hasData) {
            new ApexCharts(donutEl, {
                series: statusSeries,
                chart: { type: 'donut', height: 220 },
                labels: ['Open', 'In Progress', 'On Hold', 'Resolved', 'Closed'],
                colors: ['#3d85c8', '#f6a821', '#6c757d', '#28a745', '#343a40'],
                legend: { position: 'bottom', fontSize: '11px' },
                dataLabels: { enabled: false },
                plotOptions: { pie: { donut: { size: '65%' } } },
                tooltip: { y: { formatter: function(val) { return val + ' tickets'; } } }
            }).render();
        } else {
            donutEl.innerHTML = '<p class="text-muted text-center py-4 small">No ticket data yet.</p>';
        }
    }

    // ---- Priority Horizontal Bar Chart ----
    var prioEl = document.getElementById('chartPriorityBar');
    if (prioEl) {
        new ApexCharts(prioEl, {
            series: [{
                name: 'Open',
                data: [@Model.PriorityLow, @Model.PriorityMedium, @Model.PriorityHigh, @Model.PriorityCritical]
            }],
            chart: { type: 'bar', height: 220, toolbar: { show: false } },
            plotOptions: { bar: { horizontal: true, borderRadius: 3, barHeight: '60%', distributed: true } },
            dataLabels: { enabled: false },
            xaxis: { categories: ['Low', 'Medium', 'High', 'Critical'], labels: { style: { fontSize: '11px' } } },
            colors: ['#28a745', '#f6a821', '#fd7e14', '#dc3545'],
            legend: { show: false },
            grid: { borderColor: '#f1f1f1' },
            tooltip: { y: { formatter: function(val) { return val + ' open'; } } }
        }).render();
    }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const kpiModal = new bootstrap.Modal(document.getElementById('kpiDetailModal'));
    const modalTitle = document.getElementById('kpiModalTitle');
    const modalBody = document.getElementById('kpiModalBody');
    const modalLoading = document.getElementById('kpiModalLoading');
    const modalTable = document.getElementById('kpiModalTable');
    const modalLink = document.getElementById('kpiModalLink');

    const kpiConfig = {
        open: {
            title: 'Open Tickets',
            link: '/Tickets',
            category: 'tickets'
        },
        inprogress: {
            title: 'In Progress Tickets',
            link: '/Tickets',
            category: 'tickets'
        },
        resolved: {
            title: 'Resolved Tickets (This Month)',
            link: '/Tickets',
            category: 'tickets'
        },
        assets: {
            title: 'Assets',
            link: '/Assets',
            category: 'assets'
        },
        employees: {
            title: 'Active Employees',
            link: '/Employees',
            category: 'employees'
        },
        subscriptions: {
            title: 'Subscriptions',
            link: '/Subscriptions',
            category: 'subscriptions'
        }
    };

    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(text));
        return div.innerHTML;
    }

    function buildTicketTable(data) {
        var html = '<table class="table table-sm table-hover mb-0 kpi-table-clickable">';
        html += '<thead class="table-light"><tr>';
        html += '<th>ID</th><th>Title</th><th>Priority</th><th>Status</th><th>Submitted By</th><th>Assigned To</th><th>Date</th>';
        html += '</tr></thead><tbody>';
        if (data.length === 0) {
            html += '<tr><td colspan="7" class="text-center text-muted py-3">No tickets found</td></tr>';
        } else {
            data.forEach(function (item) {
                html += '<tr class="row-clickable" data-href="/Tickets/Details/' + escapeHtml(String(item.id)) + '" title="Click to open ticket" style="cursor:pointer;">';
                html += '<td><strong>#' + escapeHtml(String(item.id)) + '</strong></td>';
                html += '<td>' + escapeHtml(item.title) + '</td>';
                html += '<td><span class="badge badge-' + escapeHtml((item.priority || '').toLowerCase()) + '">' + escapeHtml(item.priority) + '</span></td>';
                html += '<td><span class="badge badge-' + escapeHtml((item.status || '').toLowerCase()) + '">' + escapeHtml(item.status) + '</span></td>';
                html += '<td>' + escapeHtml(item.submittedBy) + '</td>';
                html += '<td>' + escapeHtml(item.assignedTo || 'Unassigned') + '</td>';
                html += '<td>' + escapeHtml(item.date || item.created || item.resolved || '') + '</td>';
                html += '</tr>';
            });
        }
        html += '</tbody></table>';
        return html;
    }

    function buildAssetTable(data) {
        var html = '<table class="table table-sm table-hover mb-0">';
        html += '<thead class="table-light"><tr>';
        html += '<th>Name</th><th>Asset Tag</th><th>Type</th><th>Status</th><th>Assigned To</th>';
        html += '</tr></thead><tbody>';
        if (data.length === 0) {
            html += '<tr><td colspan="5" class="text-center text-muted py-3">No assets found</td></tr>';
        } else {
            data.forEach(function (item) {
                html += '<tr class="row-clickable" data-href="/Assets/Details/' + escapeHtml(String(item.id)) + '" style="cursor:pointer;">';
                html += '<td>' + escapeHtml(item.name) + '</td>';
                html += '<td>' + escapeHtml(item.assetTag) + '</td>';
                html += '<td>' + escapeHtml(item.type) + '</td>';
                html += '<td><span class="badge badge-' + escapeHtml((item.status || '').toLowerCase()) + '">' + escapeHtml(item.status) + '</span></td>';
                html += '<td>' + escapeHtml(item.assignedTo || 'Unassigned') + '</td>';
                html += '</tr>';
            });
        }
        html += '</tbody></table>';
        return html;
    }

    function buildEmployeeTable(data) {
        var html = '<table class="table table-sm table-hover mb-0">';
        html += '<thead class="table-light"><tr>';
        html += '<th>Name</th><th>Email</th><th>Department</th><th>Job Title</th>';
        html += '</tr></thead><tbody>';
        if (data.length === 0) {
            html += '<tr><td colspan="4" class="text-center text-muted py-3">No employees found</td></tr>';
        } else {
            data.forEach(function (item) {
                html += '<tr class="row-clickable" data-href="/Employees/Details/' + escapeHtml(String(item.id)) + '" style="cursor:pointer;">';
                html += '<td>' + escapeHtml(item.name) + '</td>';
                html += '<td>' + escapeHtml(item.email) + '</td>';
                html += '<td>' + escapeHtml(item.department) + '</td>';
                html += '<td>' + escapeHtml(item.jobTitle) + '</td>';
                html += '</tr>';
            });
        }
        html += '</tbody></table>';
        return html;
    }

    function buildSubscriptionTable(data) {
        var html = '<table class="table table-sm table-hover mb-0">';
        html += '<thead class="table-light"><tr>';
        html += '<th>Name</th><th>Provider</th><th>Monthly Cost</th><th>Status</th><th>Renewal Date</th>';
        html += '</tr></thead><tbody>';
        if (data.length === 0) {
            html += '<tr><td colspan="5" class="text-center text-muted py-3">No subscriptions found</td></tr>';
        } else {
            data.forEach(function (item) {
                html += '<tr class="row-clickable" data-href="/Subscriptions/Details/' + escapeHtml(String(item.id)) + '" style="cursor:pointer;">';
                html += '<td>' + escapeHtml(item.name) + '</td>';
                html += '<td>' + escapeHtml(item.provider) + '</td>';
                html += '<td>' + escapeHtml(item.cost || item.monthlyCost || '') + '</td>';
                html += '<td><span class="badge badge-' + escapeHtml((item.status || '').toLowerCase()) + '">' + escapeHtml(item.status) + '</span></td>';
                html += '<td>' + escapeHtml(item.renewal || item.renewalDate || '') + '</td>';
                html += '</tr>';
            });
        }
        html += '</tbody></table>';
        return html;
    }

    function buildTable(category, data) {
        switch (category) {
            case 'tickets': return buildTicketTable(data);
            case 'assets': return buildAssetTable(data);
            case 'employees': return buildEmployeeTable(data);
            case 'subscriptions': return buildSubscriptionTable(data);
            default: return '<p class="text-muted text-center py-3">Unknown data type</p>';
        }
    }

    document.querySelectorAll('.kpi-clickable').forEach(function (card) {
        card.addEventListener('click', function () {
            var kpiType = this.getAttribute('data-kpi-type');
            var config = kpiConfig[kpiType];
            if (!config) return;

            // Set modal title and link
            modalTitle.textContent = config.title;
            modalLink.setAttribute('href', config.link);

            // Show loading, hide table
            modalLoading.style.display = '';
            modalTable.style.display = 'none';
            modalTable.innerHTML = '';

            // Show modal
            kpiModal.show();

            // Fetch data via AJAX
            fetch('/Home/KpiDetail?type=' + encodeURIComponent(kpiType))
                .then(function (response) {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(function (data) {
                    modalLoading.style.display = 'none';
                    modalTable.innerHTML = buildTable(config.category, data);
                    modalTable.style.display = '';
                    // Make rows clickable
                    modalTable.querySelectorAll('tr.row-clickable').forEach(function (row) {
                        row.addEventListener('click', function () {
                            window.location.href = this.getAttribute('data-href');
                        });
                    });
                })
                .catch(function (error) {
                    modalLoading.style.display = 'none';
                    modalTable.innerHTML = '<div class="text-center text-danger py-4"><i class="bi bi-exclamation-circle fs-3"></i><p class="mt-2">Failed to load data. Please try again.</p></div>';
                    modalTable.style.display = '';
                });
        });
    });
});
</script>
}
