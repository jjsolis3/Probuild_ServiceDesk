@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var catById = ViewBag.CategoriesById as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-speedometer2"></i> Dashboard</h1>
    <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Ticket
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-3">
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card tickets h-75 kpi-clickable" data-kpi-type="open" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Open Tickets</div>
                    <div class="fs-2 fw-bold text-primary">@Model.OpenTickets</div>
                </div>
                <i class="bi bi-clipboard-data card-icon text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card inprogress h-75 kpi-clickable" data-kpi-type="inprogress" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">In Progress</div>
                    <div class="fs-2 fw-bold text-warning">@Model.InProgressTickets</div>
                </div>
                <i class="bi bi-arrow-repeat card-icon text-warning"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card resolved h-75 kpi-clickable" data-kpi-type="resolved" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Resolved (Month)</div>
                    <div class="fs-2 fw-bold text-success">@Model.ResolvedThisMonth</div>
                </div>
                <i class="bi bi-check-circle card-icon text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card assets h-75 kpi-clickable" data-kpi-type="assets" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Assets</div>
                    <div class="fs-2 fw-bold text-purple">@Model.TotalAssets</div>
                    <div class="text-muted small">@Model.AssignedAssets assigned</div>
                </div>
                <i class="bi bi-laptop card-icon"></i>
            </div>
        </div>
    </div>
    @* <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card employees h-75 kpi-clickable" data-kpi-type="employees" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Employees</div>
                    <div class="fs-2 fw-bold text-info">@Model.ActiveEmployees</div>
                </div>
                <i class="bi bi-people card-icon text-info"></i>
            </div>
        </div>
    </div> *@
    <div class="col-sm-6 col-md-4 col-lg-2">
        <div class="card dashboard-card subscriptions h-75 kpi-clickable" data-kpi-type="subscriptions" role="button">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Subscriptions</div>
                    <div class="fs-2 fw-bold" style="color: #fd7e14;">@Model.ActiveSubscriptions</div>
                    <div class="text-muted small">@Model.MonthlySubscriptionCost.ToString("C")/mo</div>
                </div>
                <i class="bi bi-credit-card card-icon" style="color: #fd7e14;"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-2">
        <a asp-controller="Tickets" asp-action="Index" asp-route-status="Open" class="text-decoration-none">
            <div class="card h-75 @(Model.SlaBreachCount > 0 ? "border-danger" : "border-0")">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase">SLA Breached</div>
                        <div class="fs-2 fw-bold @(Model.SlaBreachCount > 0 ? "text-danger" : "text-success")">@Model.SlaBreachCount</div>
                        <div class="text-muted small">overdue tickets</div>
                    </div>
                    <i class="bi bi-alarm card-icon @(Model.SlaBreachCount > 0 ? "text-danger" : "text-success")"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Warranty Expiry Alerts (shown only when there are assets expiring within 90 days) -->
@if (Model.ExpiringWarranties.Any())
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning text-dark fw-semibold">
            <i class="bi bi-shield-exclamation me-1"></i> Warranty Expiry Alerts
            <span class="badge bg-dark ms-2">@Model.ExpiringWarranties.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Asset</th>
                        <th>Tag</th>
                        <th>Assigned To</th>
                        <th>Warranty Expires</th>
                        <th>Days Left</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asset in Model.ExpiringWarranties)
                    {
                        var daysLeft = (int)(asset.WarrantyExpiry!.Value.Date - DateTime.UtcNow.Date).TotalDays;
                        var rowClass = daysLeft <= 14 ? "table-danger" : daysLeft <= 30 ? "table-warning" : "";
                        <tr class="@rowClass">
                            <td>
                                <a asp-controller="Assets" asp-action="Details" asp-route-id="@asset.Id">@asset.Name</a>
                            </td>
                            <td>@asset.AssetTag</td>
                            <td>@(asset.AssignedTo?.FullName ?? "Unassigned")</td>
                            <td>@asset.WarrantyExpiry.Value.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge @(daysLeft <= 14 ? "bg-danger" : daysLeft <= 30 ? "bg-warning text-dark" : "bg-secondary")">
                                    @daysLeft days
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.SlaAtRiskTickets.Any())
{
    <div class="card border-warning shadow-sm mb-3">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <span><i class="bi bi-stopwatch me-1"></i> SLA At Risk — @Model.SlaAtRiskTickets.Count ticket@(Model.SlaAtRiskTickets.Count == 1 ? "" : "s") need attention</span>
            <a asp-controller="Tickets" asp-action="Index" class="btn btn-sm btn-outline-dark py-0">View all tickets</a>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket</th>
                        <th>Priority</th>
                        <th>Risk</th>
                        <th>Due</th>
                        <th>Assigned To</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.SlaAtRiskTickets)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Tickets" asp-action="Edit" asp-route-id="@t.Id"
                                   class="fw-medium">#@t.Id — @(t.Title.Length > 45 ? t.Title[..45] + "…" : t.Title)</a>
                            </td>
                            <td><span class="badge badge-@t.Priority.ToLower()">@t.Priority</span></td>
                            <td><span class="badge bg-@t.RiskBadge">@t.RiskLabel</span></td>
                            <td class="small text-muted">@(t.DueLabel ?? "—")</td>
                            <td class="small">@(t.AssigneeName ?? "Unassigned")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="row g-3">
    <!-- Urgent Tickets (High + Critical) -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-exclamation-triangle me-1"></i> Urgent Tickets</span>
                <a asp-controller="Tickets" asp-action="Index"
                   asp-route-priorities="High" asp-route-priorities="Critical"
                   class="btn btn-sm btn-outline-light py-0">View all</a>
            </div>
            <div class="card-body p-0">
                @if (Model.CriticalTickets.Any())
                {
                    <table class="table table-hover mb-0 ss-datatable-compact">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Priority</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model.CriticalTickets)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                            @ticket.Title
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge badge-@ticket.Priority.ToString().ToLower()">
                                            @ticket.Priority
                                        </span>
                                    </td>
                                    <td>
                                        @if (ticket.AssignedTo != null)
                                        { @ticket.AssignedTo.FullName }
                                        else
                                        { <span class="text-muted">Unassigned</span> }
                                    </td>
                                    <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted text-center">No high-priority or critical tickets</div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Tickets -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> Recent Tickets
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 ss-datatable-compact">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.RecentTickets)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td>@(catById.TryGetValue(ticket.Category, out var cn) ? cn : $"Cat {ticket.Category}")</td>
                                <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                                <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                <td>@ticket.CreatedDate.ToString("MMM dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-center">
                <a asp-controller="Tickets" asp-action="Index">View All Tickets</a>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <!-- 7-Day Ticket Volume Bar Chart -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-bar-chart me-1"></i> Ticket Volume (Last 7 Days)
            </div>
            <div class="card-body">
                <div id="chartTicketVolume"></div>
            </div>
        </div>
    </div>
    <!-- Status Donut + Priority Bar -->
    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-pie-chart me-1"></i> Status Distribution
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="chartStatusDonut" style="width:100%;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-exclamation-diamond me-1"></i> Open by Priority
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="chartPriorityBar" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>


<!-- KPI Detail Modal -->
<div class="modal fade" id="kpiDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kpiModalTitle">...</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-4" id="kpiModalLoading">
                    <div class="spinner-border text-primary"></div><p class="mt-2">Loading...</p>
                </div>
                <div id="kpiModalTableWrap" style="display:none;">
                    <table id="kpiDataTable" class="table table-sm table-hover w-100"></table>
                </div>
            </div>
            <div class="modal-footer">
                <a id="kpiModalLink" href="#" class="btn btn-primary"><i class="bi bi-box-arrow-up-right"></i> View Full Details</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.css" />
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.min.js"></script>
<script type="application/json" id="volCountsData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketVolumeCounts))</script>
<script type="application/json" id="volDatesData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketVolumeDates))</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    // ---- Ticket Volume Bar Chart ----
    var volEl = document.getElementById('chartTicketVolume');
    if (volEl) {
        var volCounts = JSON.parse(document.getElementById('volCountsData').textContent);
        var volDates  = JSON.parse(document.getElementById('volDatesData').textContent);
        new ApexCharts(volEl, {
            series: [{ name: 'Tickets', data: volCounts }],
            chart: { type: 'bar', height: 200, toolbar: { show: false } },
            plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
            dataLabels: { enabled: false },
            xaxis: { categories: volDates, labels: { style: { fontSize: '11px' } } },
            yaxis: { min: 0, tickAmount: 3, labels: { style: { fontSize: '11px' } } },
            colors: ['#2f4cdd'],
            grid: { borderColor: '#f1f1f1' },
            tooltip: { y: { formatter: function(val) { return val + ' tickets'; } } }
        }).render();
    }

    // ---- Status Donut Chart ----
    var donutEl = document.getElementById('chartStatusDonut');
    if (donutEl) {
        var statusSeries = [@Model.StatusOpen, @Model.StatusInProgress, @Model.StatusOnHold, @Model.StatusResolved, @Model.StatusClosed];
        // ApexCharts donut requires at least one non-zero value
        var hasData = statusSeries.some(function(v) { return v > 0; });
        if (hasData) {
            new ApexCharts(donutEl, {
                series: statusSeries,
                chart: { type: 'donut', height: 220 },
                labels: ['Open', 'In Progress', 'On Hold', 'Resolved', 'Closed'],
                colors: ['#3d85c8', '#f6a821', '#6c757d', '#28a745', '#343a40'],
                legend: { position: 'bottom', fontSize: '11px' },
                dataLabels: { enabled: false },
                plotOptions: { pie: { donut: { size: '65%' } } },
                tooltip: { y: { formatter: function(val) { return val + ' tickets'; } } }
            }).render();
        } else {
            donutEl.innerHTML = '<p class="text-muted text-center py-4 small">No ticket data yet.</p>';
        }
    }

    // ---- Priority Horizontal Bar Chart ----
    var prioEl = document.getElementById('chartPriorityBar');
    if (prioEl) {
        new ApexCharts(prioEl, {
            series: [{
                name: 'Open',
                data: [@Model.PriorityLow, @Model.PriorityMedium, @Model.PriorityHigh, @Model.PriorityCritical]
            }],
            chart: { type: 'bar', height: 220, toolbar: { show: false } },
            plotOptions: { bar: { horizontal: true, borderRadius: 3, barHeight: '60%', distributed: true } },
            dataLabels: { enabled: false },
            xaxis: { categories: ['Low', 'Medium', 'High', 'Critical'], labels: { style: { fontSize: '11px' } } },
            colors: ['#28a745', '#f6a821', '#fd7e14', '#dc3545'],
            legend: { show: false },
            grid: { borderColor: '#f1f1f1' },
            tooltip: { y: { formatter: function(val) { return val + ' open'; } } }
        }).render();
    }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var _kpiDt = null;

    var columnConfigs = {
        tickets: {
            columns: [
                { title: 'ID', data: 'id', width: '65px',
                  render: function(d, type) { return type === 'display' ? '<strong>#' + d + '</strong>' : d; }},
                { title: 'Title', data: 'title', defaultContent: '' },
                { title: 'Priority', data: 'priority', defaultContent: '',
                  render: function(d, type) {
                      if (type === 'display') return '<span class="badge badge-' + (d||'').toLowerCase() + '">' + (d||'') + '</span>';
                      return d || '';
                  }},
                { title: 'Status', data: 'status', defaultContent: '',
                  render: function(d, type) {
                      if (type === 'display') return '<span class="badge badge-' + (d||'').toLowerCase() + '">' + (d||'') + '</span>';
                      return d || '';
                  }},
                { title: 'Submitted By', data: 'submittedBy', defaultContent: '' },
                { title: 'Assigned To', data: 'assignedTo', defaultContent: 'Unassigned' },
                { title: 'Date', data: null, defaultContent: '',
                  render: function(d, type, row) { return row.created || row.resolved || ''; }}
            ],
            order: [[0, 'desc']]
        },
        assets: {
            columns: [
                { title: 'Name', data: 'name', defaultContent: '' },
                { title: 'Asset Tag', data: 'assetTag', defaultContent: '' },
                { title: 'Type', data: 'type', defaultContent: '' },
                { title: 'Status', data: 'status', defaultContent: '',
                  render: function(d, type) {
                      if (type === 'display') return '<span class="badge badge-' + (d||'').toLowerCase() + '">' + (d||'') + '</span>';
                      return d || '';
                  }},
                { title: 'Assigned To', data: 'assignedTo', defaultContent: 'Unassigned' }
            ],
            order: [[0, 'asc']]
        },
        employees: {
            columns: [
                { title: 'Name', data: 'name', defaultContent: '' },
                { title: 'Email', data: 'email', defaultContent: '' },
                { title: 'Department', data: 'department', defaultContent: '' },
                { title: 'Job Title', data: 'jobTitle', defaultContent: '' }
            ],
            order: [[0, 'asc']]
        },
        subscriptions: {
            columns: [
                { title: 'Name', data: 'name', defaultContent: '' },
                { title: 'Provider', data: 'provider', defaultContent: '' },
                { title: 'Monthly Cost', data: 'cost', defaultContent: '' },
                { title: 'Status', data: 'status', defaultContent: '',
                  render: function(d, type) {
                      if (type === 'display') return '<span class="badge badge-' + (d||'').toLowerCase() + '">' + (d||'') + '</span>';
                      return d || '';
                  }},
                { title: 'Renewal Date', data: 'renewal', defaultContent: 'N/A' }
            ],
            order: [[0, 'asc']]
        }
    };

    var kpiConfig = {
        open:          { title: 'Open Tickets',                   link: '/Tickets',       category: 'tickets' },
        inprogress:    { title: 'In Progress Tickets',            link: '/Tickets',       category: 'tickets' },
        resolved:      { title: 'Resolved Tickets (This Month)',  link: '/Tickets',       category: 'tickets' },
        assets:        { title: 'Assets',                         link: '/Assets',        category: 'assets' },
        employees:     { title: 'Active Employees',               link: '/Employees',     category: 'employees' },
        subscriptions: { title: 'Subscriptions',                  link: '/Subscriptions', category: 'subscriptions' }
    };

    var kpiModal     = new bootstrap.Modal(document.getElementById('kpiDetailModal'));
    var modalTitle   = document.getElementById('kpiModalTitle');
    var modalLoading = document.getElementById('kpiModalLoading');
    var modalWrap    = document.getElementById('kpiModalTableWrap');
    var modalLink    = document.getElementById('kpiModalLink');

    document.querySelectorAll('.kpi-clickable').forEach(function (card) {
        card.addEventListener('click', function () {
            var kpiType = this.getAttribute('data-kpi-type');
            var config  = kpiConfig[kpiType];
            if (!config) return;

            modalTitle.textContent = config.title;
            modalLink.setAttribute('href', config.link);
            modalLoading.style.display = '';
            modalWrap.style.display = 'none';
            kpiModal.show();

            fetch('/Home/KpiDetail?type=' + encodeURIComponent(kpiType))
                .then(function (r) {
                    if (!r.ok) throw new Error('Network error');
                    return r.json();
                })
                .then(function (data) {
                    modalLoading.style.display = 'none';

                    if (_kpiDt) {
                        _kpiDt.destroy();
                        _kpiDt = null;
                        document.getElementById('kpiDataTable').innerHTML = '';
                    }

                    var cfg = columnConfigs[config.category];
                    _kpiDt = $('#kpiDataTable').DataTable({
                        data: data,
                        columns: cfg.columns,
                        order: cfg.order,
                        pageLength: 15,
                        lengthMenu: [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                        dom: '<"row align-items-center mb-2"<"col-sm-6"l><"col-sm-6"f>>rtip',
                        language: {
                            info:        'Showing _START_ to _END_ of _TOTAL_ records',
                            infoEmpty:   'No records available',
                            emptyTable:  'No data found',
                            search:      'Search:',
                            lengthMenu:  'Show _MENU_ rows'
                        },
                        rowCallback: function (row, rowData) {
                            var url = config.category === 'tickets'       ? '/Tickets/Details/'       + rowData.id
                                    : config.category === 'assets'        ? '/Assets/Details/'        + rowData.id
                                    : config.category === 'employees'     ? '/Employees/Details/'     + rowData.id
                                    : config.category === 'subscriptions' ? '/Subscriptions/Details/' + rowData.id
                                    : null;
                            if (url) {
                                $(row).css('cursor', 'pointer').on('click', function () {
                                    window.location.href = url;
                                });
                            }
                        }
                    });

                    modalWrap.style.display = '';
                })
                .catch(function () {
                    modalLoading.style.display = 'none';
                    modalWrap.innerHTML = '<div class="text-center text-danger py-4"><i class="bi bi-exclamation-circle fs-3"></i><p class="mt-2">Failed to load data. Please try again.</p></div>';
                    modalWrap.style.display = '';
                });
        });
    });
});
</script>
}
