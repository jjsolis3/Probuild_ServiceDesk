@model IEnumerable<Asset>
@{
    ViewData["Title"] = "Assets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-laptop"></i> Assets</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Asset
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label small">Asset Type</label>
            <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Types</option>
                @foreach (var t in Enum.GetValues<AssetType>())
                {
                    @{ var assetTypeSel = ViewBag.CurrentType != null && (AssetType)ViewBag.CurrentType == t; }
                    <option value="@t" selected="@(assetTypeSel ? "selected" : null)">@t</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small">Status</label>
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<AssetStatus>())
                {
                    @{ var assetStatusSel = ViewBag.CurrentStatus != null && (AssetStatus)ViewBag.CurrentStatus == s; }
                    <option value="@s" selected="@(assetStatusSel ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Assets Report">
        <thead class="table-dark">
            <tr>
                <th>Asset Tag</th>
                <th>Name</th>
                <th>Type</th>
                <th>Status</th>
                <th>Manufacturer</th>
                <th>Model</th>
                <th>Assigned To</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@asset.Id">@asset.AssetTag</a>
                    </td>
                    <td>@asset.Name</td>
                    <td>@asset.AssetType</td>
                    <td><span class="badge badge-@asset.Status.ToString().ToLower()">@asset.Status</span></td>
                    <td>@asset.Manufacturer</td>
                    <td>@asset.Model</td>
                    <td>@(asset.AssignedTo?.FullName ?? "Unassigned")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-1"></i>
        <p class="mt-3">No assets found matching the current filters.</p>
    </div>
}
