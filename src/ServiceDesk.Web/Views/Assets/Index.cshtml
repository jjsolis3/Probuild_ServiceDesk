@model IEnumerable<Asset>
@{
    ViewData["Title"] = "Assets";
    var curType = ViewBag.CurrentType as AssetType?;
    var curStatus = ViewBag.CurrentStatus as AssetStatus?;
    var curManufacturer = ViewBag.CurrentManufacturer as string;
    var curAssigned = ViewBag.CurrentAssigned as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-laptop"></i> Assets</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Asset
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <div class="form-label small mb-1">Asset Type</div>
            <input type="hidden" id="assetTypeInput" name="type" value="@(curType?.ToString() ?? "")" />
            <div class="dropdown">
                <button type="button" id="assetTypeBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curType != null ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(curType?.ToString() ?? "All Types")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    <button type="button" class="dropdown-item small single-filter-option @(curType == null ? "active" : "")" data-input-id="assetTypeInput" data-button-id="assetTypeBtn" data-value="" data-label="All Types">All Types</button>
                    @foreach (var t in Enum.GetValues<AssetType>())
                    {
                        <button type="button" class="dropdown-item small single-filter-option @(curType == t ? "active" : "")"
                                data-input-id="assetTypeInput" data-button-id="assetTypeBtn" data-value="@t" data-label="@t">@t</button>
                    }
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div>
            <div class="form-label small mb-1">Status</div>
            <input type="hidden" id="assetStatusInput" name="status" value="@(curStatus?.ToString() ?? "")" />
            <div class="dropdown">
                <button type="button" id="assetStatusBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curStatus != null ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(curStatus?.ToString() ?? "All Statuses")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    <button type="button" class="dropdown-item small single-filter-option @(curStatus == null ? "active" : "")" data-input-id="assetStatusInput" data-button-id="assetStatusBtn" data-value="" data-label="All Statuses">All Statuses</button>
                    @foreach (var s in Enum.GetValues<AssetStatus>())
                    {
                        <button type="button" class="dropdown-item small single-filter-option @(curStatus == s ? "active" : "")"
                                data-input-id="assetStatusInput" data-button-id="assetStatusBtn" data-value="@s" data-label="@s">@s</button>
                    }
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div>
            <div class="form-label small mb-1">Manufacturer</div>
            <input type="hidden" id="assetManufacturerInput" name="manufacturer" value="@(curManufacturer ?? "")" />
            <div class="dropdown">
                <button type="button" id="assetManufacturerBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(!string.IsNullOrWhiteSpace(curManufacturer) ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(string.IsNullOrWhiteSpace(curManufacturer) ? "All Manufacturers" : curManufacturer)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:200px;max-height:280px;overflow-y:auto;">
                    <button type="button" class="dropdown-item small single-filter-option @(string.IsNullOrWhiteSpace(curManufacturer) ? "active" : "")" data-input-id="assetManufacturerInput" data-button-id="assetManufacturerBtn" data-value="" data-label="All Manufacturers">All Manufacturers</button>
                    @if (ViewBag.Manufacturers != null)
                    {
                        foreach (var m in (List<string>)ViewBag.Manufacturers)
                        {
                            <button type="button" class="dropdown-item small single-filter-option @(curManufacturer == m ? "active" : "")"
                                    data-input-id="assetManufacturerInput" data-button-id="assetManufacturerBtn" data-value="@m" data-label="@m">@m</button>
                        }
                    }
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div>
            <div class="form-label small mb-1">Assignment</div>
            <input type="hidden" id="assetAssignedInput" name="assigned" value="@(curAssigned?.ToString().ToLower() ?? "")" />
            <div class="dropdown">
                <button type="button" id="assetAssignedBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curAssigned != null ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(curAssigned == null ? "All" : curAssigned.Value ? "Assigned" : "Unassigned")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    <button type="button" class="dropdown-item small single-filter-option @(curAssigned == null ? "active" : "")" data-input-id="assetAssignedInput" data-button-id="assetAssignedBtn" data-value="" data-label="All">All</button>
                    <button type="button" class="dropdown-item small single-filter-option @(curAssigned == true ? "active" : "")" data-input-id="assetAssignedInput" data-button-id="assetAssignedBtn" data-value="true" data-label="Assigned">Assigned</button>
                    <button type="button" class="dropdown-item small single-filter-option @(curAssigned == false ? "active" : "")" data-input-id="assetAssignedInput" data-button-id="assetAssignedBtn" data-value="false" data-label="Unassigned">Unassigned</button>
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Clear Filters</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener('click', function (e) {
    const opt = e.target.closest('.single-filter-option');
    if (!opt) return;
    e.preventDefault();
    const input = document.getElementById(opt.dataset.inputId);
    const btn = document.getElementById(opt.dataset.buttonId);
    if (!input || !btn) return;
    input.value = opt.dataset.value ?? '';
    btn.textContent = opt.dataset.label ?? '';
    btn.classList.toggle('active', input.value !== '');
    opt.closest('.dropdown-menu')?.querySelectorAll('.single-filter-option').forEach(x => x.classList.remove('active'));
    opt.classList.add('active');
});
</script>
}

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Assets Report">
        <thead class="table-dark">
            <tr>
                <th>Asset Tag</th>
                <th>Name</th>
                <th>Type</th>
                <th>Status</th>
                <th>Manufacturer</th>
                <th>Model</th>
                <th>Assigned To</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@asset.Id">@asset.AssetTag</a>
                    </td>
                    <td>@asset.Name</td>
                    <td>@asset.AssetType</td>
                    <td><span class="badge badge-@asset.Status.ToString().ToLower()">@asset.Status</span></td>
                    <td>@asset.Manufacturer</td>
                    <td>@asset.Model</td>
                    <td>@(asset.AssignedTo?.FullName ?? "Unassigned")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-1"></i>
        <p class="mt-3 mb-3">No assets found matching the current filters.</p>
        <a asp-action="Create" class="btn btn-primary me-2"><i class="bi bi-plus-lg me-1"></i> Add Asset</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
    </div>
}
