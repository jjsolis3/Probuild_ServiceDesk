@model IEnumerable<Asset>
@{
    ViewData["Title"] = "Assets";
    var selTypes         = (AssetType[])(ViewBag.SelectedTypes         ?? Array.Empty<AssetType>());
    var selStatuses      = (AssetStatus[])(ViewBag.SelectedStatuses    ?? Array.Empty<AssetStatus>());
    var selManufacturers = (string[])(ViewBag.SelectedManufacturers    ?? Array.Empty<string>());
    var curAssigned      = ViewBag.CurrentAssigned as bool?;

    string FilterLabel(string singular, string plural, int count) =>
        count == 0 ? $"All {plural}" : count == 1 ? $"1 {singular}" : $"{count} {plural}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-laptop"></i> Assets</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Asset
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <div class="d-flex flex-wrap gap-2 align-items-end">

        <!-- Asset Type -->
        <div>
            <div class="form-label small mb-1">Asset Type</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selTypes.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Type", "Types", selTypes.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    @foreach (var t in Enum.GetValues<AssetType>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="types"
                                   value="@t" id="ft_@t" @(selTypes.Contains(t) ? "checked" : "")>
                            <label class="form-check-label small" for="ft_@t">@t</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Status -->
        <div>
            <div class="form-label small mb-1">Status</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selStatuses.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Status", "Statuses", selStatuses.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    @foreach (var s in Enum.GetValues<AssetStatus>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="statuses"
                                   value="@s" id="fs_@s" @(selStatuses.Contains(s) ? "checked" : "")>
                            <label class="form-check-label small" for="fs_@s">@s</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Manufacturer -->
        <div>
            <div class="form-label small mb-1">Manufacturer</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selManufacturers.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Manufacturer", "Manufacturers", selManufacturers.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:190px; max-height:260px; overflow-y:auto;">
                    @if (ViewBag.Manufacturers != null)
                    {
                        foreach (var m in (List<string>)ViewBag.Manufacturers)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="manufacturers"
                                       value="@m" id="fm_@m" @(selManufacturers.Contains(m) ? "checked" : "")>
                                <label class="form-check-label small" for="fm_@m">@m</label>
                            </div>
                        }
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Assignment -->
        <div>
            <div class="form-label small mb-1">Assignment</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curAssigned != null ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(curAssigned == null ? "All" : curAssigned == true ? "Assigned" : "Unassigned")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:160px;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="assigned" value="true"
                               id="fa_assigned" @(curAssigned == true ? "checked" : "")
                               onchange="if(this.checked) document.getElementById('fa_unassigned').checked=false;">
                        <label class="form-check-label small" for="fa_assigned">Assigned</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="assigned" value="false"
                               id="fa_unassigned" @(curAssigned == false ? "checked" : "")
                               onchange="if(this.checked) document.getElementById('fa_assigned').checked=false;">
                        <label class="form-check-label small" for="fa_unassigned">Unassigned</label>
                    </div>
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </a>
        </div>

        <div class="align-self-end ms-auto">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="assetKeywordSearch" class="form-control" placeholder="Search assets..."
                       value="@((string?)ViewBag.CurrentQuery ?? "")">
                <button type="button" class="btn btn-outline-primary" onclick="applyFilters()">Search</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('click', function (e) {
    const opt = e.target.closest('.single-filter-option');
    if (!opt) return;
    e.preventDefault();
    const input = document.getElementById(opt.dataset.inputId);
    const btn = document.getElementById(opt.dataset.buttonId);
    if (!input || !btn) return;
    input.value = opt.dataset.value ?? '';
    btn.textContent = opt.dataset.label ?? '';
    btn.classList.toggle('active', input.value !== '');
    opt.closest('.dropdown-menu')?.querySelectorAll('.single-filter-option').forEach(x => x.classList.remove('active'));
    opt.classList.add('active');
});
</script>
}

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Assets Report">
        <thead class="table-dark">
            <tr>
                <th>Asset Tag</th>
                <th>Name</th>
                <th>Type</th>
                <th>Status</th>
                <th>Manufacturer</th>
                <th>Model</th>
                <th>Assigned To</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@asset.Id">@asset.AssetTag</a>
                    </td>
                    <td>@asset.Name</td>
                    <td>@asset.AssetType</td>
                    <td><span class="badge badge-@asset.Status.ToString().ToLower()">@asset.Status</span></td>
                    <td>@asset.Manufacturer</td>
                    <td>@asset.Model</td>
                    <td>@(asset.AssignedTo?.FullName ?? "Unassigned")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-1"></i>
        <p class="mt-3 mb-3">No assets found matching the current filters.</p>
        <a asp-action="Create" class="btn btn-primary me-2"><i class="bi bi-plus-lg me-1"></i> Add Asset</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
    </div>
}

<script>
function applyFilters() {
    const params = new URLSearchParams();
    document.querySelectorAll('input[name="types"]:checked').forEach(cb => params.append('types', cb.value));
    document.querySelectorAll('input[name="statuses"]:checked').forEach(cb => params.append('statuses', cb.value));
    document.querySelectorAll('input[name="manufacturers"]:checked').forEach(cb => params.append('manufacturers', cb.value));
    const assignedCb = document.querySelector('input[name="assigned"]:checked');
    if (assignedCb) params.set('assigned', assignedCb.value);
    const q = document.getElementById('assetKeywordSearch').value.trim();
    if (q) params.set('q', q);
    window.location.href = '@Url.Action("Index", "Assets")?' + params.toString();
}
document.getElementById('assetKeywordSearch')?.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); applyFilters(); }
});
</script>
