@model IEnumerable<Asset>
@{
    ViewData["Title"] = "Assets";
    var selTypes         = (AssetType[])(ViewBag.SelectedTypes         ?? Array.Empty<AssetType>());
    var selStatuses      = (AssetStatus[])(ViewBag.SelectedStatuses    ?? Array.Empty<AssetStatus>());
    var selManufacturers = (string[])(ViewBag.SelectedManufacturers    ?? Array.Empty<string>());
    var curAssigned      = ViewBag.CurrentAssigned as bool?;

    string FilterLabel(string singular, string plural, int count) =>
        count == 0 ? $"All {plural}" : count == 1 ? $"1 {singular}" : $"{count} {plural}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-laptop"></i> Assets</h1>
    <div class="d-flex gap-2 flex-wrap">
        <!-- View toggle -->
        <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
            <button type="button" class="btn btn-outline-secondary" id="btnTableView" onclick="setView('table')" title="Table view">
                <i class="bi bi-table"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary" id="btnCardView" onclick="setView('card')" title="Card view">
                <i class="bi bi-grid-3x3-gap"></i>
            </button>
        </div>

        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importModal">
            <i class="bi bi-upload me-1"></i>Import CSV
        </button>
        <a asp-action="ExportCsv" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Export CSV
        </a>
        <button onclick="ssExport.show('ss-export-target','Asset Inventory')" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-pdf me-1"></i>Print / PDF
        </button>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> New Asset
        </a>
    </div>
</div>

<!-- Bulk Action Bar (visible when items selected) -->
<div id="bulkBar" class="alert alert-primary d-none d-flex align-items-center gap-3 mb-3 py-2 px-3">
    <span class="fw-semibold"><span id="bulkCount">0</span> selected</span>
    <form id="bulkForm" asp-action="BulkUpdate" method="post" class="d-flex align-items-center gap-2 flex-wrap">
        @Html.AntiForgeryToken()
        <div id="bulkIds"></div>
        <input type="hidden" name="action" id="bulkAction" />
        <select name="status" class="form-select form-select-sm" style="width:auto;">
            @foreach (var s in Enum.GetValues<AssetStatus>())
            { <option value="@s">@s</option> }
        </select>
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="submitBulk('status')">Set Status</button>
        <button type="button" class="btn btn-sm btn-outline-danger" onclick="submitBulk('delete')"
                data-confirm="Delete all selected assets?">Delete Selected</button>
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="printSelectedLabels()">
            <i class="bi bi-qr-code me-1"></i>Print QR Labels
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSelection()">Clear</button>
    </form>
</div>

<!-- Filters -->
<div class="filter-bar mb-3">
    <div class="d-flex flex-wrap gap-2 align-items-end">

        <!-- Asset Type -->
        <div>
            <div class="form-label small mb-1">Asset Type</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selTypes.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Type", "Types", selTypes.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    @foreach (var t in Enum.GetValues<AssetType>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="types"
                                   value="@t" id="ft_@t" @(selTypes.Contains(t) ? "checked" : "")>
                            <label class="form-check-label small" for="ft_@t">@t</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Status -->
        <div>
            <div class="form-label small mb-1">Status</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selStatuses.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Status", "Statuses", selStatuses.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    @foreach (var s in Enum.GetValues<AssetStatus>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="statuses"
                                   value="@s" id="fs_@s" @(selStatuses.Contains(s) ? "checked" : "")>
                            <label class="form-check-label small" for="fs_@s">@s</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Manufacturer -->
        <div>
            <div class="form-label small mb-1">Manufacturer</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selManufacturers.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Manufacturer", "Manufacturers", selManufacturers.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:190px; max-height:260px; overflow-y:auto;">
                    @if (ViewBag.Manufacturers != null)
                    {
                        foreach (var m in (List<string>)ViewBag.Manufacturers)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="manufacturers"
                                       value="@m" id="fm_@m" @(selManufacturers.Contains(m) ? "checked" : "")>
                                <label class="form-check-label small" for="fm_@m">@m</label>
                            </div>
                        }
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Assignment -->
        <div>
            <div class="form-label small mb-1">Assignment</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curAssigned != null ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(curAssigned == null ? "All" : curAssigned == true ? "Assigned" : "Unassigned")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:160px;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="assigned" value="true"
                               id="fa_assigned" @(curAssigned == true ? "checked" : "")
                               onchange="if(this.checked) document.getElementById('fa_unassigned').checked=false;">
                        <label class="form-check-label small" for="fa_assigned">Assigned</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="assigned" value="false"
                               id="fa_unassigned" @(curAssigned == false ? "checked" : "")
                               onchange="if(this.checked) document.getElementById('fa_assigned').checked=false;">
                        <label class="form-check-label small" for="fa_unassigned">Unassigned</label>
                    </div>
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </a>
        </div>

        <div class="align-self-end ms-auto">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="assetKeywordSearch" class="form-control" placeholder="Search assets..."
                       value="@((string?)ViewBag.CurrentQuery ?? "")">
                <button type="button" class="btn btn-outline-primary" onclick="applyFilters()">Search</button>
            </div>
        </div>
    </div>
</div>

<!-- QR Code Modal -->
<div class="modal fade" id="qrModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="bi bi-qr-code me-2"></i>Asset QR Code</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="qrCodeContainer" class="mb-2"></div>
                <div id="qrAssetTag" class="fw-semibold small mb-2"></div>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="printQr()">
                    <i class="bi bi-printer me-1"></i>Print
                </button>
            </div>
        </div>
    </div>
</div>

<!-- CSV Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-upload me-2"></i>Import Assets (CSV)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ImportCsv" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="text-muted small mb-2">
                        Upload a CSV with columns: <code>AssetTag, Name, Type, Status, Manufacturer, Model, SerialNumber, Location</code>.
                        Existing asset tags will be updated; new ones will be created.
                    </p>
                    <p class="text-muted small mb-3">
                        Valid types: @string.Join(", ", Enum.GetNames<AssetType>())<br/>
                        Valid statuses: @string.Join(", ", Enum.GetNames<AssetStatus>())
                    </p>
                    <input type="file" name="file" class="form-control" accept=".csv" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="ss-export-target">

<!-- ── TABLE VIEW ─────────────────────────────────────────────────────────── -->
<div id="tableView" class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Assets Report">
        <thead class="table-dark">
            <tr>
                <th class="no-sort no-export" style="width:36px;">
                    <input type="checkbox" class="form-check-input" id="selectAll" onclick="toggleSelectAll(this)">
                </th>
                <th>Asset Tag</th>
                <th>Name</th>
                <th>Type</th>
                <th>Status</th>
                <th>Manufacturer</th>
                <th>Model</th>
                <th>Assigned To</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="form-check-input asset-cb" value="@asset.Id"
                               onchange="updateBulkBar()">
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@asset.Id">@asset.AssetTag</a>
                    </td>
                    <td>@asset.Name</td>
                    <td>@asset.AssetType</td>
                    <td><span class="badge badge-@asset.Status.ToString().ToLower()">@asset.Status</span></td>
                    <td>@asset.Manufacturer</td>
                    <td>@asset.Model</td>
                    <td>@(asset.AssignedTo?.FullName ?? "Unassigned")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" title="QR Code"
                                onclick='showQr(@asset.Id, "@asset.AssetTag")'>
                            <i class="bi bi-qr-code"></i>
                        </button>
                        <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ── CARD VIEW ─────────────────────────────────────────────────────────── -->
<div id="cardView" class="d-none">
    <div class="row g-3">
        @foreach (var asset in Model)
        {
            var statusClass = asset.Status switch {
                AssetStatus.Available => "success",
                AssetStatus.Assigned  => "primary",
                AssetStatus.InRepair  => "warning",
                AssetStatus.Retired   => "secondary",
                AssetStatus.Lost      => "danger",
                _                     => "dark"
            };
            var typeIcon = asset.AssetType switch {
                AssetType.Laptop          => "bi-laptop",
                AssetType.Desktop         => "bi-pc-display",
                AssetType.Monitor         => "bi-display",
                AssetType.Printer         => "bi-printer",
                AssetType.Phone           => "bi-phone",
                AssetType.Tablet          => "bi-tablet",
                AssetType.Server          => "bi-server",
                AssetType.NetworkEquipment=> "bi-router",
                AssetType.Software        => "bi-box",
                _                         => "bi-device-hdd"
            };
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 shadow-sm border-0" style="border-top:3px solid var(--bs-@statusClass) !important;">
                    <div class="card-body pb-2">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <i class="bi @typeIcon fs-4 text-muted"></i>
                            </div>
                            <div class="d-flex gap-1">
                                <input type="checkbox" class="form-check-input asset-cb" value="@asset.Id"
                                       onchange="updateBulkBar()">
                                <span class="badge bg-@statusClass">@asset.Status</span>
                            </div>
                        </div>
                        <h6 class="card-title mb-1 text-truncate" title="@asset.Name">@asset.Name</h6>
                        <div class="text-muted small mb-2">
                            <code class="small">@asset.AssetTag</code>
                            <span class="ms-1">· @asset.AssetType</span>
                        </div>
                        @if (!string.IsNullOrEmpty(asset.Manufacturer) || !string.IsNullOrEmpty(asset.Model))
                        {
                            <div class="text-muted small">@asset.Manufacturer @asset.Model</div>
                        }
                        @if (asset.AssignedTo != null)
                        {
                            <div class="small mt-1"><i class="bi bi-person me-1 text-primary"></i>@asset.AssignedTo.FullName</div>
                        }
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary flex-fill">
                            View
                        </a>
                        <button class="btn btn-sm btn-outline-secondary" title="QR Code"
                                onclick='showQr(@asset.Id, "@asset.AssetTag")'>
                            <i class="bi bi-qr-code"></i>
                        </button>
                        <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-1"></i>
        <p class="mt-3 mb-3">No assets found matching the current filters.</p>
        <a asp-action="Create" class="btn btn-primary me-2"><i class="bi bi-plus-lg me-1"></i> Add Asset</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
    </div>
}
</div><!-- /ss-export-target -->

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
// ── View toggle ────────────────────────────────────────────────────────────
const PREF_KEY = 'assetViewMode';
function setView(mode) {
    localStorage.setItem(PREF_KEY, mode);
    document.getElementById('tableView').classList.toggle('d-none', mode !== 'table');
    document.getElementById('cardView').classList.toggle('d-none', mode !== 'card');
    document.getElementById('btnTableView').classList.toggle('active', mode === 'table');
    document.getElementById('btnCardView').classList.toggle('active', mode === 'card');
}
(function() { setView(localStorage.getItem(PREF_KEY) || 'table'); })();

// ── Filters ────────────────────────────────────────────────────────────────
function applyFilters() {
    const params = new URLSearchParams();
    document.querySelectorAll('input[name="types"]:checked').forEach(cb => params.append('types', cb.value));
    document.querySelectorAll('input[name="statuses"]:checked').forEach(cb => params.append('statuses', cb.value));
    document.querySelectorAll('input[name="manufacturers"]:checked').forEach(cb => params.append('manufacturers', cb.value));
    const assignedCb = document.querySelector('input[name="assigned"]:checked');
    if (assignedCb) params.set('assigned', assignedCb.value);
    const q = document.getElementById('assetKeywordSearch').value.trim();
    if (q) params.set('q', q);
    window.location.href = '@Url.Action("Index", "Assets")?' + params.toString();
}
document.getElementById('assetKeywordSearch')?.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); applyFilters(); }
});

// ── Bulk select ────────────────────────────────────────────────────────────
function toggleSelectAll(master) {
    document.querySelectorAll('.asset-cb').forEach(cb => cb.checked = master.checked);
    updateBulkBar();
}
function updateBulkBar() {
    const checked = document.querySelectorAll('.asset-cb:checked');
    const bar = document.getElementById('bulkBar');
    document.getElementById('bulkCount').textContent = checked.length;
    bar.classList.toggle('d-none', checked.length === 0);
}
function clearSelection() {
    document.querySelectorAll('.asset-cb, #selectAll').forEach(cb => cb.checked = false);
    updateBulkBar();
}
function submitBulk(action) {
    const confirmed = document.querySelector(`[data-confirm]`)?.dataset.confirm;
    if (action === 'delete' && !confirm('Delete all selected assets? This cannot be undone.')) return;

    const form = document.getElementById('bulkForm');
    document.getElementById('bulkAction').value = action;
    const container = document.getElementById('bulkIds');
    container.innerHTML = '';
    document.querySelectorAll('.asset-cb:checked').forEach(cb => {
        const inp = document.createElement('input');
        inp.type = 'hidden'; inp.name = 'ids'; inp.value = cb.value;
        container.appendChild(inp);
    });
    form.submit();
}
function printSelectedLabels() {
    const ids = Array.from(document.querySelectorAll('.asset-cb:checked')).map(cb => cb.value);
    if (ids.length === 0) { alert('No assets selected.'); return; }
    const url = '@Url.Action("QrLabelSheet", "Assets")?' + ids.map(i => 'ids=' + encodeURIComponent(i)).join('&');
    window.open(url, '_blank');
}

// ── QR Code ────────────────────────────────────────────────────────────────
var _qrInstance = null;
function showQr(assetId, assetTag) {
    const url = window.location.origin + '@Url.Action("Details", "Assets", new { id = 0 })'.replace('/0', '/' + assetId);
    document.getElementById('qrAssetTag').textContent = assetTag;
    const container = document.getElementById('qrCodeContainer');
    container.innerHTML = '';
    _qrInstance = new QRCode(container, { text: url, width: 180, height: 180, correctLevel: QRCode.CorrectLevel.M });
    new bootstrap.Modal(document.getElementById('qrModal')).show();
}
function printQr() {
    const img = document.querySelector('#qrCodeContainer img') || document.querySelector('#qrCodeContainer canvas');
    const tag = document.getElementById('qrAssetTag').textContent;
    const win = window.open('', '_blank', 'width=300,height=350');
    const src = img.tagName === 'IMG' ? img.src : img.toDataURL();
    win.document.write(`<html><body style="text-align:center;font-family:Arial">
        <img src="${src}" style="width:200px"><br><strong>${tag}</strong>
        <script>window.print();window.close();<\/script></body></html>`);
}
</script>
}
