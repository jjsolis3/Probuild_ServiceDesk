@model IEnumerable<Asset>
@{
    ViewData["Title"] = "Assets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-laptop"></i> Assets</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Asset
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label class="form-label small mb-1">Asset Type</label>
            <select name="type" class="form-select form-select-sm selectpicker ss-form-select" data-style="btn-outline-secondary btn-sm" data-width="fit" onchange="this.form.submit()">
                <option value="">All Types</option>
                @foreach (var t in Enum.GetValues<AssetType>())
                {
                    var assetTypeSel = ViewBag.CurrentType != null && (AssetType)ViewBag.CurrentType == t;
                    <option value="@t" selected="@(assetTypeSel ? "selected" : null)">@t</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Status</label>
            <select name="status" class="form-select form-select-sm selectpicker ss-form-select" data-style="btn-outline-secondary btn-sm" data-width="fit" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<AssetStatus>())
                {
                    var assetStatusSel = ViewBag.CurrentStatus != null && (AssetStatus)ViewBag.CurrentStatus == s;
                    <option value="@s" selected="@(assetStatusSel ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Manufacturer</label>
            <select name="manufacturer" class="form-select form-select-sm selectpicker ss-form-select" data-style="btn-outline-secondary btn-sm" data-width="fit" onchange="this.form.submit()">
                <option value="">All Manufacturers</option>
                @if (ViewBag.Manufacturers != null)
                {
                    foreach (var m in (List<string>)ViewBag.Manufacturers)
                    {
                        <option value="@m" selected="@((string?)ViewBag.CurrentManufacturer == m ? "selected" : null)">@m</option>
                    }
                }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Assignment</label>
            <select name="assigned" class="form-select form-select-sm selectpicker ss-form-select" data-style="btn-outline-secondary btn-sm" data-width="fit" onchange="this.form.submit()">
                <option value="">All</option>
                <option value="true"  selected="@(ViewBag.CurrentAssigned != null && (bool)ViewBag.CurrentAssigned == true  ? "selected" : null)">Assigned</option>
                <option value="false" selected="@(ViewBag.CurrentAssigned != null && (bool)ViewBag.CurrentAssigned == false ? "selected" : null)">Unassigned</option>
            </select>
        </div>
        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Clear Filters</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Assets Report">
        <thead class="table-dark">
            <tr>
                <th>Asset Tag</th>
                <th>Name</th>
                <th>Type</th>
                <th>Status</th>
                <th>Manufacturer</th>
                <th>Model</th>
                <th>Assigned To</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@asset.Id">@asset.AssetTag</a>
                    </td>
                    <td>@asset.Name</td>
                    <td>@asset.AssetType</td>
                    <td><span class="badge badge-@asset.Status.ToString().ToLower()">@asset.Status</span></td>
                    <td>@asset.Manufacturer</td>
                    <td>@asset.Model</td>
                    <td>@(asset.AssignedTo?.FullName ?? "Unassigned")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-1"></i>
        <p class="mt-3 mb-3">No assets found matching the current filters.</p>
        <a asp-action="Create" class="btn btn-primary me-2"><i class="bi bi-plus-lg me-1"></i> Add Asset</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
    </div>
}
