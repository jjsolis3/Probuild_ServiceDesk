@model Asset
@{
    ViewData["Title"] = $"Edit Asset - {Model.AssetTag}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Assets</a></li>
        <li class="breadcrumb-item active">Edit @Model.AssetTag</li>
    </ol>
</nav>

<h1><i class="bi bi-pencil"></i> Edit Asset - @Model.AssetTag</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" data-loading-btn="btnSaveAsset">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssetTag" class="form-label"></label>
                    <input asp-for="AssetTag" class="form-control" />
                    <span asp-validation-for="AssetTag" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="AssetType" class="form-label"></label>
                    <select asp-for="AssetType" asp-items="Html.GetEnumSelectList<AssetType>()" class="form-select"></select>
                    <span asp-validation-for="AssetType" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetStatus>()" class="form-select"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AssignedToId" class="form-label">Assigned To</label>
                    <select asp-for="AssignedToId" class="form-select" asp-items="@ViewBag.Employees">
                        <option value="">-- Unassigned --</option>
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Manufacturer" class="form-label"></label>
                    <input asp-for="Manufacturer" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="SerialNumber" class="form-label"></label>
                    <input asp-for="SerialNumber" class="form-control" />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="PurchaseDate" class="form-label"></label>
                    <input asp-for="PurchaseDate" class="form-control" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PurchaseCost" class="form-label"></label>
                    <input asp-for="PurchaseCost" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="WarrantyExpiry" class="form-label"></label>
                    <input asp-for="WarrantyExpiry" class="form-control" type="date" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="card border-0 bg-light p-3 mb-3">
                <h6 class="fw-semibold mb-3"><i class="bi bi-router me-2"></i>Network &amp; System</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="IpAddress" class="form-label"></label>
                        <input asp-for="IpAddress" class="form-control" placeholder="e.g. 192.168.1.100" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MacAddress" class="form-label"></label>
                        <input asp-for="MacAddress" class="form-control" placeholder="e.g. AA:BB:CC:DD:EE:FF" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Hostname" class="form-label"></label>
                        <input asp-for="Hostname" class="form-control" placeholder="e.g. DESKTOP-ABC123" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OsVersion" class="form-label"></label>
                        <input asp-for="OsVersion" class="form-control" placeholder="e.g. Windows 11 Pro" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OsBuild" class="form-label"></label>
                        <input asp-for="OsBuild" class="form-control" placeholder="e.g. 22H2" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>

            <div class="mt-4">
                <button type="submit" id="btnSaveAsset" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
