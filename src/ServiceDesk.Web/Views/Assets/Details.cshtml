        @if (!Model.Checkouts.Any())
        {
            <p class="text-muted text-center py-3">No checkout history for this asset.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Checked Out</th>
                            <th>To</th>
                            <th>Due Date</th>
                            <th>Returned</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var co in Model.Checkouts)
                        {
                            <tr class="@(co.IsActive && co.IsOverdue ? "table-danger" : co.IsActive ? "table-warning" : "")">
                                <td class="text-nowrap text-muted small">@co.CheckoutDate.ToString("MMM d, yyyy")</td>
                                <td>@(co.CheckedOutTo?.FullName ?? "— External —")</td>
                                <td class="text-nowrap">
                                    <span class="@(co.IsOverdue ? "text-danger fw-semibold" : "")">
                                        @co.DueDate.ToString("MMM d, yyyy")
                                        @if (co.IsOverdue) { <i class="bi bi-exclamation-triangle-fill ms-1"></i> }
                                    </span>
                                </td>
                                <td class="text-nowrap text-muted small">
                                    @if (co.ReturnedDate.HasValue)
                                    { @co.ReturnedDate.Value.ToString("MMM d, yyyy") }
                                    else
                                    { <span class="badge bg-warning text-dark">Out</span> }
                                </td>
                                <td class="text-muted small">@co.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
