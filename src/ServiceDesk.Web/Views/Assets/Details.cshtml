@section Scripts {
<script>
(function () {
    // Reveal password via AJAX
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    window.revealPwd = function (credId, btn) {
        var input = document.getElementById('pwd_' + credId);
        if (input.type === 'text') {
            input.type = 'password';
            input.value = '••••••••';
            btn.innerHTML = '<i class="bi bi-eye"></i>';
            return;
        }
        fetch('@Url.Action("RevealPassword", "Assets")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'credentialId=' + credId
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                input.type = 'text';
                input.value = d.password;
                btn.innerHTML = '<i class="bi bi-eye-slash"></i>';
            } else {
                alert('Error: ' + d.message);
            }
        });
    };

    window.copyPwd = function (credId) {
        var input = document.getElementById('pwd_' + credId);
        if (input.type !== 'text') {
            // Reveal first, then copy
            fetch('@Url.Action("RevealPassword", "Assets")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'credentialId=' + credId
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) navigator.clipboard.writeText(d.password);
            });
        } else {
            navigator.clipboard.writeText(input.value);
        }
    };

    window.toggleNewPwd = function () {
        var inp = document.getElementById('newCredPwd');
        var ico = document.getElementById('newPwdIcon');
        inp.type = inp.type === 'password' ? 'text' : 'password';
        ico.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
    };
})();
</script>

<script>
// ── AJAX typeaheads for employee/asset search ─────────────────────────────
(function () {
    var assetId = @a.Id;

    function makeTypeahead(inputId, dropId, hiddenId, fetchUrl, labelKey) {
        var input  = document.getElementById(inputId);
        var drop   = document.getElementById(dropId);
        var hidden = document.getElementById(hiddenId);
        if (!input) return;

        var timer;
        input.addEventListener('input', function () {
            clearTimeout(timer);
            var q = input.value.trim();
            if (q.length < 1) { drop.style.display = 'none'; return; }
            timer = setTimeout(function () {
                fetch(fetchUrl + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        drop.innerHTML = '';
                        if (!items.length) {
                            drop.innerHTML = '<span class="list-group-item list-group-item-action disabled small text-muted">No results</span>';
                        } else {
                            items.forEach(function (item) {
                                var btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'list-group-item list-group-item-action small py-1';
                                btn.textContent = item[labelKey] || item.name || item.label;
                                btn.addEventListener('mousedown', function (e) {
                                    e.preventDefault();
                                    hidden.value = item.id;
                                    input.value  = btn.textContent;
                                    drop.style.display = 'none';
                                });
                                drop.appendChild(btn);
                            });
                        }
                        drop.style.display = '';
                    });
            }, 220);
        });

        input.addEventListener('blur', function () {
            setTimeout(function () { drop.style.display = 'none'; }, 200);
        });
        input.addEventListener('focus', function () {
            if (drop.innerHTML && input.value.trim()) drop.style.display = '';
        });
    }

    makeTypeahead('assignEmpSearch',   'assignEmpDrop',   'assignEmpId',
                  '/Employees/Search?q=', 'name');
    makeTypeahead('checkoutEmpSearch', 'checkoutEmpDrop', 'checkoutEmpId',
                  '/Employees/Search?q=', 'name');
    makeTypeahead('relTargetSearch',   'relTargetDrop',   'relTargetId',
                  '/Assets/Search?excludeId=' + assetId + '&q=', 'label');
})();
</script>

<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
(function() {
    var _qr = null;
    var assetUrl = window.location.origin + window.location.pathname;

    document.getElementById('assetQrModal').addEventListener('shown.bs.modal', function() {
        var container = document.getElementById('detailQrCode');
        if (!_qr) {
            _qr = new QRCode(container, {
                text: assetUrl, width: 180, height: 180,
                correctLevel: QRCode.CorrectLevel.M
            });
        }
    });

    window.downloadDetailQr = function() {
        var img = document.querySelector('#detailQrCode img');
        var canvas = document.querySelector('#detailQrCode canvas');
        var src = img ? img.src : (canvas ? canvas.toDataURL() : null);
        if (!src) return;
        var a = document.createElement('a');
        a.href = src;
        a.download = 'asset-qr-@a.AssetTag.Replace(" ", "-").Replace("/", "-").Replace("\\", "-").ToLower().Trim()' + '.png';
        a.click();
    };
})();
</script>
