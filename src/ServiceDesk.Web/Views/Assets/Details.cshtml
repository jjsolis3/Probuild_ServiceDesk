    <!-- ═══ HISTORY ══════════════════════════════════════════════════════════ -->
    <div class="@PaneClass("history")">
        <ul class="nav nav-pills mb-3" id="historySubTabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#histAssign">
                    Custody Chain (@Model.AssignmentHistory.Count)
