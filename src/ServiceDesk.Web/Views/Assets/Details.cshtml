                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success small">Current</span>
                                    }
                                    @if (!string.IsNullOrEmpty(h.Notes))
                                    {
                                        <div class="text-muted small fst-italic">@h.Notes</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Audit/Change Log -->
            <div class="tab-pane fade" id="histAudit">
                @if (!Model.AuditLog.Any())
                {
                    <p class="text-muted text-center py-4">No changes recorded yet.</p>
                }
