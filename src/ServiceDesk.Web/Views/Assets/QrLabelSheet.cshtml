@model IEnumerable<Asset>
@{
    Layout = null;
    var assets = Model.ToList();
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>QR Label Sheet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        @@page { size: Letter; margin: 0.5in; }
        body { font-family: Arial, sans-serif; color: #212529; }
        .toolbar { margin-bottom: 16px; }
        .sheet { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .label {
            border: 1px dashed #999;
            padding: 10px 8px;
            text-align: center;
            break-inside: avoid;
            page-break-inside: avoid;
            min-height: 180px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .label .tag { font-weight: bold; font-size: 13px; margin-top: 6px; word-break: break-all; }
        .label .name { font-size: 11px; color: #555; max-width: 100%; word-break: break-word; }
        .label canvas, .label img { width: 110px !important; height: 110px !important; }
        @@media print {
            .no-print { display: none !important; }
            .label { border-color: #bbb; }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="toolbar d-flex justify-content-between align-items-center no-print">
            <div>
                <h1 class="fs-4 fw-bold mb-0"><i class="bi bi-qr-code me-2"></i>QR Label Sheet</h1>
                <small class="text-muted">@assets.Count labels</small>
            </div>
            <div>
                <button class="btn btn-primary btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>Print
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>

        @if (!assets.Any())
        {
            <div class="alert alert-warning">No assets to display. Go back and select assets first.</div>
        }
        else
        {
            <div class="sheet">
                @foreach (var a in assets)
                {
                    <div class="label">
                        <div class="qr" data-url="@baseUrl@Url.Action("Details", "Assets", new { id = a.Id })"></div>
                        <div class="tag">@a.AssetTag</div>
                        <div class="name">@a.Name</div>
                    </div>
                }
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        document.querySelectorAll('.qr').forEach(function (el) {
            new QRCode(el, {
                text: el.getAttribute('data-url'),
                width: 110,
                height: 110,
                correctLevel: QRCode.CorrectLevel.M
            });
        });
    </script>
</body>
</html>
