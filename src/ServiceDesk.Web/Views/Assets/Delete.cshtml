@model Asset
@{
    ViewData["Title"] = "Delete Asset";
}

<h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Asset</h1>
<h3>Are you sure you want to delete this asset?</h3>

<div class="card mt-3" style="max-width: 600px;">
    <div class="card-body">
        <dl>
            <dt>Asset Tag</dt>
            <dd>@Model.AssetTag</dd>
            <dt>Name</dt>
            <dd>@Model.Name</dd>
            <dt>Type</dt>
            <dd>@Model.AssetType</dd>
            <dt>Status</dt>
            <dd>@Model.Status</dd>
            <dt>Manufacturer</dt>
            <dd>@(Model.Manufacturer ?? "N/A")</dd>
            <dt>Model</dt>
            <dd>@(Model.Model ?? "N/A")</dd>
            <dt>Assigned To</dt>
            <dd>@(Model.AssignedTo?.FullName ?? "Unassigned")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
