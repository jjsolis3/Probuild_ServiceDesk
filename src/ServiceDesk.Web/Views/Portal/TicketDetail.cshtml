@model PortalTicketDetailViewModel
@{
    ViewData["Title"] = $"Ticket #{Model.Ticket.Id}";
    Layout = "_PortalLayout";
    var ticket = Model.Ticket;
    var statusClass = ticket.Status.ToString().ToLower() switch
    {
        "open" => "badge-open",
        "inprogress" => "badge-inprogress",
        "resolved" => "badge-resolved",
        "closed" => "badge-closed",
        "onhold" => "badge-onhold",
        "cancelled" => "badge-cancelled",
        _ => "bg-secondary"
    };
    var priorityClass = ticket.Priority.ToString().ToLower() switch
    {
        "critical" => "badge-critical",
        "high" => "badge-high",
        "medium" => "badge-medium",
        _ => "badge-low"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">My Tickets</a></li>
        <li class="breadcrumb-item active">Ticket #@ticket.Id</li>
    </ol>
</nav>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 align-items-start">
    <!-- Main content -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="text-muted small">#@ticket.Id</span>
                            <span class="badge @statusClass">@ticket.Status</span>
                            <span class="badge @priorityClass">@ticket.Priority</span>
                            @if (ticket.IsOverdue)
                            {
                                <span class="badge bg-danger">OVERDUE</span>
                            }
                        </div>
                        <h4 class="fw-bold mb-1">@ticket.Title</h4>
                        <div class="text-muted small">
                            Submitted @ticket.CreatedDate.ToString("MMMM dd, yyyy 'at' h:mm tt")
                            @if (ticket.AssignedTo != null)
                            {
                                <span>&nbsp;·&nbsp;Assigned to IT Team</span>
                            }
                            else
                            {
                                <span>&nbsp;·&nbsp;<em>Awaiting assignment</em></span>
                            }
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 bg-light mb-0">
                    <div class="fw-semibold small text-muted text-uppercase mb-2">
                        <i class="fas fa-align-left me-1"></i>Description
                    </div>
                    <p class="mb-0" style="white-space:pre-line;">@ticket.Description.Trim()</p>
                </div>
            </div>
        </div>

        <!-- Resolution Notes (if resolved) -->
        @if (!string.IsNullOrEmpty(ticket.ResolutionNotes))
        {
            <div class="card border-0 shadow-sm border-start border-success border-3 mb-3">
                <div class="card-body p-3">
                    <div class="fw-semibold text-success mb-2">
                        <i class="fas fa-check-circle me-1"></i>Resolution
                    </div>
                    <p class="mb-0">@ticket.ResolutionNotes</p>
                </div>
            </div>
        }

        <!-- Conversation Thread -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex align-items-center gap-2">
                <i class="fas fa-comments text-primary"></i>
                <span class="fw-semibold">Conversation</span>
                @if (ticket.Notes.Any(n => !n.IsInternal))
                {
                    <span class="badge bg-secondary ms-1">@ticket.Notes.Count(n => !n.IsInternal)</span>
                }
            </div>
            <div class="card-body p-4">
                <!-- Existing notes -->
                <div id="conversationThread">
                    @if (!ticket.Notes.Any(n => !n.IsInternal))
                    {
                        <div class="text-center text-muted py-4 mb-3" id="noNotesMsg">
                            <i class="fas fa-comment-slash fa-2x mb-2 d-block opacity-25"></i>
                            No replies yet. Add a reply below to provide more information or ask a question.
                        </div>
                    }
                    @foreach (var note in ticket.Notes.Where(n => !n.IsInternal))
                    {
                        var isAgent = note.Source == "Agent" || note.Source == "Email";
                        <div class="d-flex gap-3 mb-4 @(isAgent ? "" : "flex-row-reverse")">
                            <div class="flex-shrink-0">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                     style="width:38px;height:38px;font-size:0.85rem;background:@(isAgent ? "#2f4cdd" : "#10b981");">
                                    @note.AuthorName.Substring(0, Math.Min(2, note.AuthorName.Length)).ToUpper()
                                </div>
                            </div>
                            <div class="flex-grow-1 @(isAgent ? "" : "text-end")">
                                <div class="d-flex align-items-center gap-2 mb-1 @(isAgent ? "" : "justify-content-end")">
                                    <span class="fw-semibold small">@note.AuthorName</span>
                                    @if (isAgent)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary">IT Team</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">You</span>
                                    }
                                    <span class="text-muted small">@note.CreatedDate.ToString("MMM dd 'at' h:mm tt")</span>
                                </div>
                                <div class="rounded p-3 d-inline-block text-start"
                                     style="background:@(isAgent ? "#f0f4ff" : "#f0fdf4");max-width:90%;">
                                    @note.Content
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Reply form (only if ticket is not closed/cancelled) -->
                @if (ticket.Status != TicketStatus.Closed && ticket.Status != TicketStatus.Cancelled)
                {
                    <div class="border-top pt-4 mt-2">
                        <form asp-action="AddReply" method="post">
                            <input type="hidden" name="ticketId" value="@ticket.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">
                                    <i class="fas fa-reply me-1 text-muted"></i>Add a Reply
                                </label>
                                <textarea name="content" class="form-control" rows="4"
                                          placeholder="Type your reply, add more details, or ask a question..."></textarea>
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane me-2"></i>Send Reply
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="border-top pt-3 mt-2 text-center text-muted small">
                        <i class="fas fa-lock me-1"></i>
                        This ticket is @ticket.Status.ToString().ToLower() and cannot receive new replies.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3">
                <span class="fw-semibold"><i class="fas fa-info-circle me-1 text-muted"></i>Ticket Details</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted">Status</dt>
                    <dd class="col-7"><span class="badge @statusClass">@ticket.Status</span></dd>

                    <dt class="col-5 text-muted">Priority</dt>
                    <dd class="col-7"><span class="badge @priorityClass">@ticket.Priority</span></dd>

                    <dt class="col-5 text-muted">Category</dt>
                    <dd class="col-7">@ticket.Category</dd>

                    @if (ticket.CompanyService != null)
                    {
                        <dt class="col-5 text-muted">Service</dt>
                        <dd class="col-7">@ticket.CompanyService.Name</dd>
                    }

                    <dt class="col-5 text-muted">Submitted</dt>
                    <dd class="col-7">@ticket.CreatedDate.ToString("MMM dd, yyyy")</dd>

                    @if (ticket.DueDate.HasValue)
                    {
                        <dt class="col-5 text-muted">Due Date</dt>
                        <dd class="col-7 @(ticket.IsOverdue ? "text-danger fw-bold" : "")">
                            @ticket.DueDate.Value.ToString("MMM dd, yyyy")
                            @if (ticket.IsOverdue) { <span>(Overdue)</span> }
                        </dd>
                    }

                    @if (ticket.ResolvedDate.HasValue)
                    {
                        <dt class="col-5 text-muted">Resolved</dt>
                        <dd class="col-7 text-success">@ticket.ResolvedDate.Value.ToString("MMM dd, yyyy")</dd>
                    }
                </dl>
            </div>
        </div>

        @if (ticket.Attachments.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <span class="fw-semibold"><i class="fas fa-paperclip me-1 text-muted"></i>Attachments</span>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var att in ticket.Attachments)
                    {
                        <a href="/uploads/tickets/@ticket.Id/@att.StoredFileName"
                           class="list-group-item list-group-item-action small d-flex align-items-center gap-2"
                           download="@att.FileName" target="_blank">
                            <i class="fas fa-file text-muted"></i>
                            <span class="text-truncate flex-grow-1">@att.FileName</span>
                            <span class="text-muted">@att.FileSizeDisplay</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
