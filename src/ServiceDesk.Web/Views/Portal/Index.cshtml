@model PortalDashboardViewModel
@{
    ViewData["Title"] = "My Support Tickets";
    Layout = "_PortalLayout";

    var catById = ViewBag.CategoriesById as Dictionary<int, string> ?? new Dictionary<int, string>();
    var sf = Model.StatusFilter?.ToLower();

    string KpiCardClass(string key) =>
        sf == key ? "card text-center border-2 shadow-sm border-primary" : "card text-center border-0 shadow-sm";

    string KpiNumClass(string key, string colour) =>
        sf == key ? $"fs-3 fw-bold text-{colour}" : $"fs-3 fw-bold text-{colour}";

    string FilterUrl(string key) =>
        sf == key ? Url.Action("Index", "Portal")! : Url.Action("Index", "Portal", new { status = key })!;

    string ListLabel = sf switch
    {
        "open"       => "Open Tickets",
        "inprogress" => "In Progress Tickets",
        "resolved"   => "Resolved & Closed Tickets",
        _            => "All My Tickets"
    };
}

<!-- Quick Stats (clickable KPIs) -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">My Support Tickets</h2>
        <p class="text-muted small mb-0">Hello, @Model.CurrentUser.FirstName — @(ViewBag.PortalWelcomeMessage as string ?? "track and manage your IT requests")</p>
    </div>
    <a asp-action="SubmitTicket" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> New Ticket
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-4">
        <a href="@FilterUrl("open")" class="text-decoration-none">
            <div class="@KpiCardClass("open") h-100" style="cursor:pointer;transition:box-shadow .15s;">
                <div class="card-body py-3">
                    <div class="@KpiNumClass("open","primary")">@Model.OpenCount</div>
                    <div class="text-muted small">Open</div>
                    @if (sf == "open")
                    {
                        <div class="mt-1"><span class="badge bg-primary bg-opacity-10 text-primary small">Active filter</span></div>
                    }
                </div>
            </div>
        </a>
    </div>
    <div class="col-4">
        <a href="@FilterUrl("inprogress")" class="text-decoration-none">
            <div class="@KpiCardClass("inprogress") h-100" style="cursor:pointer;transition:box-shadow .15s;">
                <div class="card-body py-3">
                    <div class="@KpiNumClass("inprogress","warning")">@Model.InProgressCount</div>
                    <div class="text-muted small">In Progress</div>
                    @if (sf == "inprogress")
                    {
                        <div class="mt-1"><span class="badge bg-warning bg-opacity-25 text-warning small">Active filter</span></div>
                    }
                </div>
            </div>
        </a>
    </div>
    <div class="col-4">
        <a href="@FilterUrl("resolved")" class="text-decoration-none">
            <div class="@KpiCardClass("resolved") h-100" style="cursor:pointer;transition:box-shadow .15s;">
                <div class="card-body py-3">
                    <div class="@KpiNumClass("resolved","success")">@Model.ResolvedCount</div>
                    <div class="text-muted small">Resolved</div>
                    @if (sf == "resolved")
                    {
                        <div class="mt-1"><span class="badge bg-success bg-opacity-10 text-success small">Active filter</span></div>
                    }
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Ticket List -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 fw-semibold">
            <i class="fas fa-list me-2 text-muted"></i>@ListLabel
            @if (!string.IsNullOrEmpty(Model.StatusFilter))
            {
                <a href="@Url.Action("Index","Portal")" class="ms-2 text-muted small fw-normal">
                    <i class="fas fa-times-circle me-1"></i>Clear
                </a>
            }
        </h6>
        <span class="badge bg-secondary">@Model.TotalFiltered total</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.MyTickets.Any() && Model.TotalFiltered == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-inbox fa-3x mb-3 d-block opacity-25"></i>
                @if (!string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <p class="mb-1">No @ListLabel.ToLower() found.</p>
                    <a href="@Url.Action("Index","Portal")" class="btn btn-outline-secondary mt-2 btn-sm">
                        <i class="fas fa-times me-1"></i> Clear Filter
                    </a>
                }
                else
                {
                    <p class="mb-1">You haven't submitted any tickets yet.</p>
                    <a asp-action="SubmitTicket" class="btn btn-primary mt-2">
                        <i class="fas fa-plus me-1"></i> Submit Your First Ticket
                    </a>
                }
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var ticket in Model.MyTickets)
                {
                    var statusClass = ticket.Status.ToString().ToLower() switch
                    {
                        "open" => "badge-open",
                        "inprogress" => "badge-inprogress",
                        "resolved" => "badge-resolved",
                        "closed" => "badge-closed",
                        "onhold" => "badge-onhold",
                        _ => "bg-secondary"
                    };
                    var lastActivity = ticket.Notes.Any()
                        ? ticket.Notes.Max(n => n.CreatedDate)
                        : ticket.CreatedDate;
                    <a asp-action="TicketDetail" asp-route-id="@ticket.Id"
                       class="list-group-item list-group-item-action px-4 py-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1 me-3">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="text-muted small">#@ticket.Id</span>
                                    <span class="badge @statusClass">@ticket.Status</span>
                                    @if (ticket.IsOverdue)
                                    {
                                        <span class="badge bg-danger">OVERDUE</span>
                                    }
                                </div>
                                <div class="fw-semibold mb-1">@ticket.Title</div>
                                <div class="text-muted small">
                                    <i class="fas fa-tag me-1"></i>@(catById.TryGetValue(ticket.Category, out var catName) ? catName : $"Category {ticket.Category}")
                                    &nbsp;·&nbsp;
                                    <i class="fas fa-flag me-1"></i>@ticket.Priority
                                    @if (ticket.AssignedTo != null)
                                    {
                                        <span>&nbsp;·&nbsp;<i class="fas fa-user-tie me-1"></i>Assigned to IT Team</span>
                                    }
                                </div>
                            </div>
                            <div class="text-end flex-shrink-0">
                                <div class="text-muted small">@lastActivity.ToString("MMM dd")</div>
                                @if (ticket.Notes.Any(n => !n.IsInternal))
                                {
                                    <span class="badge bg-light text-dark border mt-1">
                                        <i class="fas fa-comment me-1"></i>@ticket.Notes.Count(n => !n.IsInternal)
                                    </span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top bg-light">
                    <div class="text-muted small">
                        Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalFiltered))
                        of @Model.TotalFiltered
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPrev ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index","Portal", new { status = Model.StatusFilter, page = Model.Page - 1 })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index","Portal", new { status = Model.StatusFilter, page = p })">@p</a>
                                </li>
                            }
                            <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index","Portal", new { status = Model.StatusFilter, page = Model.Page + 1 })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
