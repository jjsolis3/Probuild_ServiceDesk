@model IEnumerable<KbArticle>
@{
    ViewData["Title"] = "Knowledge Base";
    Layout = "_PortalLayout";
    var q = ViewBag.SearchQuery as string ?? "";
    var selectedCat = ViewBag.SelectedCategory as int?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1"><i class="bi bi-book-half me-2 text-primary"></i>Knowledge Base</h2>
        <p class="text-muted mb-0">Browse IT solutions and how-to guides.</p>
    </div>
</div>

<!-- Search bar -->
<form method="get" asp-controller="Portal" asp-action="KnowledgeBase" class="mb-4">
    <div class="input-group input-group-lg shadow-sm" style="max-width:700px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" name="q" value="@q" class="form-control border-start-0 ps-0"
               placeholder="Search for a solution or error..." autofocus />
        <button class="btn btn-primary" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <a asp-controller="Portal" asp-action="KnowledgeBase" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

<!-- Category filter pills -->
<div class="mb-4 d-flex flex-wrap gap-2 align-items-center">
    <span class="text-muted small fw-semibold me-1">Filter:</span>
    <a asp-controller="Portal" asp-action="KnowledgeBase" asp-route-q="@q"
       class="badge @(selectedCat == null ? "bg-primary" : "bg-secondary") text-decoration-none" style="font-size:0.85rem;padding:.35em .7em;">
        All
    </a>
    @foreach (var cat in Enum.GetValues<ServiceDesk.Core.Enums.TicketCategory>())
    {
        <a asp-controller="Portal" asp-action="KnowledgeBase" asp-route-q="@q" asp-route-category="@((int)cat)"
           class="badge @(selectedCat == (int)cat ? "bg-primary" : "bg-light text-dark border") text-decoration-none" style="font-size:0.85rem;padding:.35em .7em;">
            @cat.GetDisplayName()
        </a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(q))
{
    <div class="mb-3 text-muted small">
        <i class="bi bi-search me-1"></i>
        <strong>@Model.Count()</strong> result(s) for "<strong>@q</strong>"
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-journal-x display-1 d-block mb-3"></i>
        <h5>No articles found</h5>
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <p>Try a different search term or <a asp-controller="Portal" asp-action="KnowledgeBase">browse all articles</a>.</p>
        }
        else
        {
            <p>No Knowledge Base articles have been published yet. <a asp-action="SubmitTicket">Submit a ticket</a> and our IT team will help you.</p>
        }
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var article in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 kb-card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <span class="badge bg-light text-dark border">@article.Category</span>
                            <span class="ms-auto text-muted small"><i class="bi bi-eye me-1"></i>@article.ViewCount</span>
                        </div>
                        <h6 class="card-title mb-2">
                            <a asp-controller="Kb" asp-action="Details" asp-route-id="@article.Id"
                               class="text-decoration-none stretched-link">@article.Title</a>
                        </h6>
                        <p class="card-text text-muted small text-truncate-3">@article.Problem</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 pt-0">
                        <div class="text-muted small">
                            <i class="bi bi-person me-1"></i>@article.CreatedBy
                            <span class="ms-2"><i class="bi bi-calendar3 me-1"></i>@article.CreatedDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Styles {
<style>
    .kb-card { transition: box-shadow 0.2s, transform 0.15s; cursor: pointer; }
    .kb-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.12) !important; transform: translateY(-2px); }
    .text-truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
}
