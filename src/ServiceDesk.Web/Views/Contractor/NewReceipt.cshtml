@model IEnumerable<ServiceDesk.Core.Models.TicketTimeEntry>
@{
    var contractor  = ViewBag.Contractor as ServiceDesk.Core.Models.Employee;
    var periodStart = ViewBag.PeriodStart as string;
    var periodEnd   = ViewBag.PeriodEnd   as string;
    var calc        = ViewBag.PayrollCalc as ServiceDesk.Web.Services.PayrollCalculatorService.PayrollCalculation;
    var stdRate     = contractor?.HourlyRate ?? 0m;
    var emerRate    = contractor?.EmergencyHourlyRate ?? 0m;
    var hasEmerRate = emerRate > 0m;
}

<div class="row page-titles">
    <div class="col-sm-6">
        <h4>New Payroll Receipt</h4>
        <p class="text-muted mb-0">Preview unclaimed billable time entries for the selected period</p>
    </div>
    <div class="col-sm-6 text-end">
        <a asp-action="Payroll" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Payroll
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header"><i class="fas fa-calendar-alt me-1"></i>Select Period</div>
    <div class="card-body">
        <form method="get" asp-action="NewReceipt" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Period Start</label>
                <input type="date" name="periodStart" class="form-control" value="@periodStart" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Period End</label>
                <input type="date" name="periodEnd" class="form-control" value="@periodEnd" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i>Preview
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>
        No unclaimed billable time entries found for <strong>@periodStart</strong> to <strong>@periodEnd</strong>.
        <br><span class="small text-muted">Already-claimed entries (in a submitted/approved/paid receipt) are excluded.</span>
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list me-1"></i>Time Entries Preview</span>
            <span class="badge bg-primary">@Model.Count() entries</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Work Date</th>
                            <th>Ticket</th>
                            <th>Description</th>
                            <th class="text-center">Hours</th>
                            <th class="text-center">Rate Type</th>
                            <th class="text-center">Billable</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model)
                        {
                            var isEmer    = entry.RateType == ServiceDesk.Core.Enums.PayRateType.Emergency;
                            var rateForRow = isEmer ? emerRate : stdRate;
                            var amount     = entry.IsBillable ? entry.Hours * rateForRow : 0m;
                            <tr>
                                <td class="small">@entry.WorkDate.ToString("MMM d, yyyy")</td>
                                <td class="small">
                                    @if (entry.Ticket != null)
                                    {
                                        <a asp-controller="Tickets" asp-action="Edit" asp-route-id="@entry.Ticket.Id">#@entry.Ticket.Id</a>
                                    }
                                </td>
                                <td class="small text-muted">@(entry.Description ?? entry.Ticket?.Title ?? "—")</td>
                                <td class="text-center small">@entry.Hours.ToString("0.##")</td>
                                <td class="text-center">
                                    @if (isEmer)
                                    { <span class="badge bg-danger">Emergency</span> }
                                    else
                                    { <span class="badge bg-secondary">Standard</span> }
                                </td>
                                <td class="text-center">
                                    @if (entry.IsBillable)
                                    { <span class="badge bg-success">Yes</span> }
                                    else
                                    { <span class="badge bg-secondary">No</span> }
                                </td>
                                <td class="text-end small">@(entry.IsBillable ? "$" + amount.ToString("N2") : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header"><i class="fas fa-file-invoice-dollar me-1"></i>Estimated Payout Summary</div>
        <div class="card-body">
            @if (calc != null)
            {
                <table class="table table-sm align-middle mb-3">
                    <tbody>
                        <tr>
                            <td class="fw-semibold">Standard hours</td>
                            <td class="text-end">@calc.TotalStandardHours.ToString("0.##") h</td>
                            <td colspan="2"></td>
                        </tr>
                        @if (calc.TotalRetainerHoursApplied > 0)
                        {
                            <tr class="text-muted small">
                                <td class="ps-4"><i class="fas fa-level-down-alt fa-rotate-90 me-1"></i>Covered by retainer</td>
                                <td class="text-end">@calc.TotalRetainerHoursApplied.ToString("0.##") h</td>
                                <td class="text-end">$0.00</td>
                                <td class="text-end">$0.00</td>
                            </tr>
                        }
                        <tr class="small">
                            <td class="ps-4"><i class="fas fa-level-down-alt fa-rotate-90 me-1"></i>Billable at standard rate</td>
                            <td class="text-end">@calc.StandardBillableHours.ToString("0.##") h</td>
                            <td class="text-end">@($"${stdRate:N2}")</td>
                            <td class="text-end fw-semibold">@($"${calc.StandardBillableAmount:N2}")</td>
                        </tr>
                        @if (calc.TotalEmergencyHours > 0)
                        {
                            <tr>
                                <td class="fw-semibold">Emergency hours</td>
                                <td class="text-end">@calc.TotalEmergencyHours.ToString("0.##") h</td>
                                <td class="text-end">@($"${emerRate:N2}")</td>
                                <td class="text-end fw-semibold">@($"${calc.EmergencyBillableAmount:N2}")</td>
                            </tr>
                        }
                        @foreach (var m in calc.Months.Where(b => b.RetainerAmountThisReceipt > 0))
                        {
                            <tr>
                                <td class="fw-semibold">
                                    Monthly retainer — @m.Label
                                    <span class="text-muted small">
                                        (covers up to @((contractor?.MonthlyRetainerHoursIncluded ?? 0m).ToString("0.##")) h)
                                    </span>
                                </td>
                                <td colspan="2"></td>
                                <td class="text-end fw-semibold">@($"${m.RetainerAmountThisReceipt:N2}")</td>
                            </tr>
                        }
                        @foreach (var m in calc.Months.Where(b =>
                            !b.IsFirstReceiptOfMonth
                            && (contractor?.MonthlyRetainerAmount ?? 0m) > 0))
                        {
                            <tr class="text-muted small">
                                <td>
                                    <i class="fas fa-info-circle me-1"></i>@m.Label retainer already applied to a prior receipt
                                    @if (m.RetainerHoursApplied > 0)
                                    { <text>(@m.RetainerHoursApplied.ToString("0.##") h absorbed from this receipt's pool)</text> }
                                </td>
                                <td colspan="3"></td>
                            </tr>
                        }
                        <tr style="border-top:2px solid #333;">
                            <td class="fw-bold pt-2">Estimated total</td>
                            <td class="text-end pt-2">
                                <span class="text-muted small">@calc.TotalHours.ToString("0.##") h logged</span>
                            </td>
                            <td></td>
                            <td class="text-end fw-bold pt-2" style="font-size:1.1rem; color:#0d6efd;">$@calc.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            }
            <form asp-action="NewReceipt" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="periodStart" value="@periodStart" />
                <input type="hidden" name="periodEnd" value="@periodEnd" />
                <div class="col-md-8">
                    <label class="form-label">Notes (optional)</label>
                    <input type="text" name="notes" class="form-control" placeholder="e.g. May 2026 invoice" maxlength="2000" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-save me-1"></i>Save as Draft
                    </button>
                </div>
            </form>
        </div>
    </div>
}
