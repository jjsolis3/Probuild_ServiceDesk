@model ServiceDesk.Core.Models.PayrollReceipt
@{
    var companyName = ViewBag.CompanyName as string ?? "ServiceSphere";
    var statusColor = Model.Status switch {
        "Draft"     => "#6c757d",
        "Submitted" => "#fd7e14",
        "Approved"  => "#0d6efd",
        "Paid"      => "#198754",
        _           => "#6c757d"
    };
    var statusIcon = Model.Status switch {
        "Draft"     => "bi-pencil-square",
        "Submitted" => "bi-send",
        "Approved"  => "bi-check-circle",
        "Paid"      => "bi-patch-check-fill",
        _           => "bi-circle"
    };
}

@section Styles {
<style>
    .receipt-page { max-width: 960px; margin: 0 auto; }

    /* Invoice card shell */
    .invoice-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,.08);
        background: #fff;
    }

    /* Coloured top accent bar */
    .invoice-accent {
        height: 6px;
        background: linear-gradient(90deg, #1a3a5c 0%, #0d6efd 100%);
    }

    /* Header section */
    .invoice-header {
        padding: 28px 32px 20px;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
    }
    .invoice-company-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a3a5c;
        margin-bottom: 2px;
        letter-spacing: -.3px;
    }
    .invoice-doc-type {
        font-size: .78rem;
        font-weight: 600;
        color: #6c757d;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .invoice-meta-table td {
        padding: 2px 0 2px 16px;
        font-size: .88rem;
        color: #495057;
        vertical-align: top;
    }
    .invoice-meta-table td:first-child {
        font-weight: 600;
        color: #1a3a5c;
        padding-left: 0;
        white-space: nowrap;
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 14px;
        border-radius: 50px;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .04em;
        color: #fff;
        background: @statusColor;
        margin-top: 4px;
    }

    /* Bill-to / summary section */
    .invoice-body { padding: 24px 32px; }

    .bill-section {
        display: flex;
        gap: 32px;
        margin-bottom: 24px;
    }
    .bill-box { flex: 1; }
    .bill-label {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: 6px;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 4px;
    }
    .bill-value { font-size: .92rem; color: #212529; line-height: 1.6; }
    .bill-value strong { color: #1a3a5c; font-size: 1rem; }

    /* Summary tiles */
    .summary-tiles {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 28px;
    }
    .tile {
        border-radius: 8px;
        padding: 16px 18px;
        text-align: center;
        border: 1px solid transparent;
    }
    .tile-label {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .07em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }
    .tile-value { font-size: 1.7rem; font-weight: 700; line-height: 1; }
    .tile-neutral  { background: #f8f9fa; border-color: #e9ecef; }
    .tile-neutral  .tile-label { color: #6c757d; }
    .tile-neutral  .tile-value { color: #343a40; }
    .tile-blue     { background: #e8f0fe; border-color: #b6cfff; }
    .tile-blue     .tile-label { color: #0a58ca; }
    .tile-blue     .tile-value { color: #084298; }
    .tile-total    { background: #1a3a5c; border-color: #1a3a5c; }
    .tile-total    .tile-label { color: #a8c4e0; }
    .tile-total    .tile-value { color: #fff; }

    /* Table */
    .invoice-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
    .invoice-table thead tr {
        background: #1a3a5c;
        color: #fff;
    }
    .invoice-table thead th {
        padding: 10px 14px;
        font-weight: 600;
        font-size: .78rem;
        letter-spacing: .06em;
        text-transform: uppercase;
    }
    .invoice-table tbody tr { border-bottom: 1px solid #f0f0f0; }
    .invoice-table tbody tr:nth-child(even) { background: #f8f9fb; }
    .invoice-table tbody tr:hover { background: #eef4ff; }
    .invoice-table tbody td { padding: 10px 14px; color: #212529; vertical-align: middle; }
    .invoice-table tfoot tr { background: #eef4ff; border-top: 2px solid #1a3a5c; }
    .invoice-table tfoot td {
        padding: 12px 14px;
        font-weight: 700;
        color: #1a3a5c;
        font-size: .92rem;
    }
    .badge-billable-yes {
        background: #d1e7dd; color: #0a5c36;
        padding: 3px 10px; border-radius: 50px;
        font-size: .72rem; font-weight: 700;
    }
    .badge-billable-no {
        background: #e9ecef; color: #6c757d;
        padding: 3px 10px; border-radius: 50px;
        font-size: .72rem; font-weight: 700;
    }

    /* Status timeline */
    .status-trail {
        display: flex;
        gap: 0;
        margin-top: 28px;
        border-top: 1px solid #e9ecef;
        padding-top: 20px;
    }
    .status-step {
        flex: 1;
        text-align: center;
        position: relative;
    }
    .status-step:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 16px; right: 0;
        width: 100%; height: 2px;
        background: #dee2e6;
        z-index: 0;
    }
    .status-dot {
        width: 32px; height: 32px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        position: relative;
        z-index: 1;
    }
    .status-dot-done  { background: #198754; color: #fff; }
    .status-dot-pend  { background: #dee2e6; color: #adb5bd; }
    .status-trail-label { font-size: .72rem; font-weight: 600; color: #6c757d; margin-top: 6px; text-transform: uppercase; letter-spacing: .06em; }
    .status-trail-date  { font-size: .78rem; color: #495057; margin-top: 2px; }
    .status-trail-by    { font-size: .72rem; color: #adb5bd; }

    /* Notes */
    .invoice-notes {
        background: #fffbeb;
        border-left: 4px solid #fbbf24;
        border-radius: 0 6px 6px 0;
        padding: 12px 16px;
        font-size: .88rem;
        color: #78350f;
        margin-top: 24px;
    }

    /* Print */
    @@media print {
        .no-print { display: none !important; }
        body { background: #fff !important; }
        .invoice-card { box-shadow: none !important; border: 1px solid #ccc !important; }
        .invoice-table tbody tr:hover { background: inherit; }
    }
</style>
}

<div class="receipt-page">

    <!-- Action bar (hidden on print) -->
    <div class="d-flex align-items-center justify-content-between mb-3 no-print">
        <div>
            <h5 class="mb-0 fw-bold">Receipt #@Model.Id</h5>
            <div class="text-muted small">@Model.PeriodStart.ToString("MMMM d, yyyy") – @Model.PeriodEnd.ToString("MMMM d, yyyy")</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Payroll" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
            <button onclick="window.print()" class="btn btn-sm btn-outline-dark">
                <i class="bi bi-printer me-1"></i>Print / PDF
            </button>
            <a asp-action="ReceiptExcel" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success">
                <i class="bi bi-file-earmark-excel me-1"></i>Download Excel
            </a>
            @if (Model.Status == "Draft")
            {
                <form asp-action="SubmitReceipt" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-send me-1"></i>Submit to HR
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Invoice card -->
    <div class="invoice-card">

        <!-- Colour accent bar -->
        <div class="invoice-accent"></div>

        <!-- Header -->
        <div class="invoice-header">
            <div>
                <div class="invoice-company-name">@companyName</div>
                <div class="invoice-doc-type">Contractor Payroll Receipt</div>
                <div class="status-pill mt-2">
                    <i class="bi @statusIcon"></i>@Model.Status
                </div>
            </div>
            <div style="text-align:right; min-width:220px;">
                <table class="invoice-meta-table ms-auto">
                    <tr>
                        <td>Receipt #</td>
                        <td style="font-size:1.1rem; font-weight:700; color:#1a3a5c;">#@Model.Id</td>
                    </tr>
                    <tr>
                        <td>Created</td>
                        <td>@Model.CreatedDate.ToString("MMMM d, yyyy")</td>
                    </tr>
                    <tr>
                        <td>Period</td>
                        <td>@Model.PeriodStart.ToString("MMM d") – @Model.PeriodEnd.ToString("MMM d, yyyy")</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Body -->
        <div class="invoice-body">

            <!-- Bill-to / contractor info -->
            <div class="bill-section">
                <div class="bill-box">
                    <div class="bill-label">Contractor</div>
                    <div class="bill-value">
                        <strong>@Model.Contractor?.FullName</strong><br />
                        @Model.Contractor?.Email<br />
                        @(Model.Contractor?.JobTitle ?? Model.Contractor?.Department)
                    </div>
                </div>
                <div class="bill-box">
                    <div class="bill-label">Billing Period</div>
                    <div class="bill-value">
                        <strong>@Model.PeriodStart.ToString("MMMM d, yyyy")</strong><br />
                        to @Model.PeriodEnd.ToString("MMMM d, yyyy")
                    </div>
                </div>
                <div class="bill-box">
                    <div class="bill-label">Rate</div>
                    <div class="bill-value">
                        <strong>$@Model.HourlyRateSnapshot.ToString("N2")</strong><br />
                        per hour
                    </div>
                </div>
            </div>

            <!-- Summary tiles -->
            <div class="summary-tiles">
                <div class="tile tile-neutral">
                    <div class="tile-label">Total Hours</div>
                    <div class="tile-value">@Model.TotalHours.ToString("0.##")</div>
                </div>
                <div class="tile tile-blue">
                    <div class="tile-label">Billable Hours</div>
                    <div class="tile-value">@Model.TotalBillableHours.ToString("0.##")</div>
                </div>
                <div class="tile tile-neutral">
                    <div class="tile-label">Rate / hr</div>
                    <div class="tile-value" style="font-size:1.3rem;">$@Model.HourlyRateSnapshot.ToString("N2")</div>
                </div>
                <div class="tile tile-total">
                    <div class="tile-label">Total Due</div>
                    <div class="tile-value">$@Model.TotalAmount.ToString("N2")</div>
                </div>
            </div>

            <!-- Time entries table -->
            <div class="bill-label mb-2">Time Entries</div>
            <div class="table-responsive mb-2">
                <table class="invoice-table">
                    <thead>
                        <tr>
                            <th>Work Date</th>
                            <th>Ticket #</th>
                            <th style="width:35%">Description</th>
                            <th class="text-center">Hours</th>
                            <th class="text-center">Billable</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.TimeEntries.OrderBy(e => e.WorkDate))
                        {
                            var amount = entry.IsBillable ? entry.Hours * Model.HourlyRateSnapshot : 0m;
                            <tr>
                                <td class="text-nowrap">@entry.WorkDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    @if (entry.Ticket != null)
                                    {
                                        <span class="fw-semibold text-primary">#@entry.Ticket.Id</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-muted">@(entry.Description ?? entry.Ticket?.Title ?? "—")</td>
                                <td class="text-center fw-semibold">@entry.Hours.ToString("0.##")</td>
                                <td class="text-center">
                                    @if (entry.IsBillable)
                                    { <span class="badge-billable-yes">Billable</span> }
                                    else
                                    { <span class="badge-billable-no">Non-billable</span> }
                                </td>
                                <td class="text-end">
                                    @(entry.IsBillable ? "$" + Model.HourlyRateSnapshot.ToString("N2") : "—")
                                </td>
                                <td class="text-end fw-semibold">
                                    @(entry.IsBillable ? "$" + amount.ToString("N2") : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">TOTAL</td>
                            <td class="text-center">@Model.TotalHours.ToString("0.##")</td>
                            <td></td>
                            <td></td>
                            <td class="text-end">$@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="invoice-notes">
                    <i class="bi bi-sticky me-1"></i><strong>Notes:</strong> @Model.Notes
                </div>
            }

            @if (Model.Status == "Draft" && !string.IsNullOrEmpty(Model.RejectionNote))
            {
                <div style="background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:14px 18px;margin-bottom:18px;display:flex;gap:12px;align-items:flex-start;">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#856404;font-size:1.1rem;flex-shrink:0;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;color:#856404;font-size:.88rem;margin-bottom:3px;">Returned by HR for Revision</div>
                        <div style="color:#533f03;font-size:.875rem;">@Model.RejectionNote</div>
                    </div>
                </div>
            }

            <!-- Status timeline -->
            <div class="status-trail">
                @{
                    bool submitted = Model.SubmittedDate.HasValue;
                    bool approved  = Model.ApprovedDate.HasValue;
                    bool paid      = Model.PaidDate.HasValue;
                }
                <div class="status-step">
                    <div class="status-dot status-dot-done"><i class="bi bi-pencil-square"></i></div>
                    <div class="status-trail-label">Created</div>
                    <div class="status-trail-date">@Model.CreatedDate.ToString("MMM d, yyyy")</div>
                </div>
                <div class="status-step">
                    <div class="status-dot @(submitted ? "status-dot-done" : "status-dot-pend")">
                        <i class="bi bi-send"></i>
                    </div>
                    <div class="status-trail-label">Submitted</div>
                    <div class="status-trail-date">@(submitted ? Model.SubmittedDate!.Value.ToString("MMM d, yyyy") : "Pending")</div>
                </div>
                <div class="status-step">
                    <div class="status-dot @(approved ? "status-dot-done" : "status-dot-pend")">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="status-trail-label">Approved</div>
                    <div class="status-trail-date">@(approved ? Model.ApprovedDate!.Value.ToString("MMM d, yyyy") : "Pending")</div>
                    @if (approved && Model.ApprovedBy != null)
                    {
                        <div class="status-trail-by">by @Model.ApprovedBy.FullName</div>
                    }
                </div>
                <div class="status-step">
                    <div class="status-dot @(paid ? "status-dot-done" : "status-dot-pend")"
                         style="@(paid ? "background:#198754;" : "")">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <div class="status-trail-label">Paid</div>
                    <div class="status-trail-date">@(paid ? Model.PaidDate!.Value.ToString("MMM d, yyyy") : "Pending")</div>
                </div>
            </div>

        </div>
    </div>
</div>
