@model ServiceDesk.Core.Models.PayrollReceipt
@{
    // Single source of truth for "is this page being viewed by an
    // admin?" — referenced by both the Back button at the top and the
    // comment-post form lower down. Declared once at file scope so a
    // duplicate `var isAdminViewer` doesn't shadow / conflict.
    var isAdminViewer = User.IsInRole("Admin") || User.IsInRole("IT Agent");

    // Dual-role support: true when the logged-in account is the contractor
    // who owns THIS receipt — regardless of whether it also holds the
    // Admin/IT Agent role. An owner-operator account (Admin + IsContractor)
    // needs BOTH the admin-only actions (Record/Delete Payment) AND the
    // contractor-only ones (Confirm payment, Request Payment) on their own
    // receipts, so this is checked independently of isAdminViewer rather
    // than being its logical opposite.
    var isOwningContractor = (bool)(ViewBag.IsOwningContractor ?? false);

    var companyName = ViewBag.CompanyName as string ?? "ServiceSphere";
    var statusColor = Model.Status switch {
        "Draft"          => "#6c757d",
        "Submitted"      => "#fd7e14",
        "Approved"       => "#0d6efd",
        "PartiallyPaid"  => "#f59e0b",
        "Paid"           => "#198754",
        _                => "#6c757d"
    };
    var statusIcon = Model.Status switch {
        "Draft"          => "bi-pencil-square",
        "Submitted"      => "bi-send",
        "Approved"       => "bi-check-circle",
        "PartiallyPaid"  => "bi-cash",
        "Paid"           => "bi-patch-check-fill",
        _                => "bi-circle"
    };
}

@section Styles {
<style>
    .receipt-page { max-width: 960px; margin: 0 auto; }

    /* Invoice card shell */
    .invoice-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,.08);
        background: #fff;
    }

    /* Coloured top accent bar */
    .invoice-accent {
        height: 6px;
        background: linear-gradient(90deg, #1a3a5c 0%, #0d6efd 100%);
    }

    /* Header section */
    .invoice-header {
        padding: 28px 32px 20px;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
    }
    .invoice-company-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a3a5c;
        margin-bottom: 2px;
        letter-spacing: -.3px;
    }
    .invoice-doc-type {
        font-size: .78rem;
        font-weight: 600;
        color: #6c757d;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .invoice-meta-table td {
        padding: 2px 0 2px 16px;
        font-size: .88rem;
        color: #495057;
        vertical-align: top;
    }
    .invoice-meta-table td:first-child {
        font-weight: 600;
        color: #1a3a5c;
        padding-left: 0;
        white-space: nowrap;
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 14px;
        border-radius: 50px;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .04em;
        color: #fff;
        background: var(--status-color);
        margin-top: 4px;
    }

    /* Bill-to / summary section */
    .invoice-body { padding: 24px 32px; }

    .bill-section {
        display: flex;
        gap: 32px;
        margin-bottom: 24px;
    }
    .bill-box { flex: 1; }
    .bill-label {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: 6px;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 4px;
    }
    .bill-value { font-size: .92rem; color: #212529; line-height: 1.6; }
    .bill-value strong { color: #1a3a5c; font-size: 1rem; }

    /* Summary tiles */
    .summary-tiles {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 28px;
    }
    .tile {
        border-radius: 8px;
        padding: 16px 18px;
        text-align: center;
        border: 1px solid transparent;
    }
    .tile-label {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .07em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }
    .tile-value { font-size: 1.7rem; font-weight: 700; line-height: 1; }
    .tile-neutral  { background: #f8f9fa; border-color: #e9ecef; }
    .tile-neutral  .tile-label { color: #6c757d; }
    .tile-neutral  .tile-value { color: #343a40; }
    .tile-blue     { background: #e8f0fe; border-color: #b6cfff; }
    .tile-blue     .tile-label { color: #0a58ca; }
    .tile-blue     .tile-value { color: #084298; }
    .tile-total    { background: #1a3a5c; border-color: #1a3a5c; }
    .tile-total    .tile-label { color: #a8c4e0; }
    .tile-total    .tile-value { color: #fff; }

    /* Table */
    .invoice-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
    .invoice-table thead tr {
        background: #1a3a5c;
        color: #fff;
    }
    .invoice-table thead th {
        padding: 10px 14px;
        font-weight: 600;
        font-size: .78rem;
        letter-spacing: .06em;
        text-transform: uppercase;
    }
    .invoice-table tbody tr { border-bottom: 1px solid #f0f0f0; }
    .invoice-table tbody tr:nth-child(even) { background: #f8f9fb; }
    .invoice-table tbody tr:hover { background: #eef4ff; }
    .invoice-table tbody td { padding: 10px 14px; color: #212529; vertical-align: middle; }
    .invoice-table tfoot tr { background: #eef4ff; border-top: 2px solid #1a3a5c; }
    .invoice-table tfoot td {
        padding: 12px 14px;
        font-weight: 700;
        color: #1a3a5c;
        font-size: .92rem;
    }
    .badge-billable-yes {
        background: #d1e7dd; color: #0a5c36;
        padding: 3px 10px; border-radius: 50px;
        font-size: .72rem; font-weight: 700;
    }
    .badge-billable-no {
        background: #e9ecef; color: #6c757d;
        padding: 3px 10px; border-radius: 50px;
        font-size: .72rem; font-weight: 700;
    }

    /* Status timeline */
    .status-trail {
        display: flex;
        gap: 0;
        margin-top: 28px;
        border-top: 1px solid #e9ecef;
        padding-top: 20px;
    }
    .status-step {
        flex: 1;
        text-align: center;
        position: relative;
    }
    .status-step:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 16px; right: 0;
        width: 100%; height: 2px;
        background: #dee2e6;
        z-index: 0;
    }
    .status-dot {
        width: 32px; height: 32px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        position: relative;
        z-index: 1;
    }
    .status-dot-done  { background: #198754; color: #fff; }
    .status-dot-pend  { background: #dee2e6; color: #adb5bd; }
    .status-trail-label { font-size: .72rem; font-weight: 600; color: #6c757d; margin-top: 6px; text-transform: uppercase; letter-spacing: .06em; }
    .status-trail-date  { font-size: .78rem; color: #495057; margin-top: 2px; }
    .status-trail-by    { font-size: .72rem; color: #adb5bd; }

    /* Notes */
    .invoice-notes {
        background: #fffbeb;
        border-left: 4px solid #fbbf24;
        border-radius: 0 6px 6px 0;
        padding: 12px 16px;
        font-size: .88rem;
        color: #78350f;
        margin-top: 24px;
    }

    /* Print */
    @@media print {
        /* Hide the Jobick admin chrome that bleeds into the print output
           when the user hits the browser Print button. The page uses
           _Layout.cshtml whose top-level structure is:
             .nav-header (brand bar)
             .header     (search/profile bar)
             .dlabnav    (left sidebar nav)
             .content-body (main content — what we want)
             .footer     (footer strip)
           Only .content-body should survive, and even there we strip
           padding/background so the receipt card sits flush on the page. */
        .nav-header, .header, .dlabnav, .footer,
        .modal-backdrop,
        .no-print {
            display: none !important;
        }
        body, html {
            background: #fff !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        /* The Jobick wrapper indents .content-body to make room for the
           sidebar — once the sidebar is hidden, drop the indent so the
           receipt uses the full printable width. */
        #main-wrapper, .content-body, .container-fluid, .container {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }
        .receipt-page {
            margin: 0 !important;
            padding: 8px !important;
        }
        .invoice-card {
            box-shadow: none !important;
            border: 1px solid #ccc !important;
            page-break-inside: avoid;
        }
        .invoice-table tbody tr:hover { background: inherit; }
        /* Force colour on the status badge / accents in print — Chrome
           strips background colours otherwise. */
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        /* Avoid splitting a single time-entry row across pages. */
        .invoice-table tr { page-break-inside: avoid; }
        @@page { margin: 0.5in; }
    }
</style>
}

<div class="receipt-page">

    <!-- Action bar (hidden on print) -->
    <div class="d-flex align-items-center justify-content-between mb-3 no-print">
        <div>
            <h5 class="mb-0 fw-bold">Receipt #@Model.Id</h5>
            <div class="text-muted small">@Model.PeriodStart.ToString("MMMM d, yyyy") – @Model.PeriodEnd.ToString("MMMM d, yyyy")</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @{
                // Back button routes by audience: admins / IT agents land
                // on the AdminPayroll queue they came from; contractors
                // go to their own My Payroll page. Avoids the "your
                // employee profile is not flagged as a contractor"
                // bounce when an admin clicks Back from a contractor's
                // receipt.
                var backController = isAdminViewer ? "AdminPayroll" : "Contractor";
                var backAction     = isAdminViewer ? "Index"        : "Payroll";
                var backLabel      = isAdminViewer ? "Back to Payroll Queue" : "Back";
            }
            <a asp-controller="@backController" asp-action="@backAction" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>@backLabel
            </a>
            <button onclick="window.print()" class="btn btn-sm btn-outline-dark">
                <i class="bi bi-printer me-1"></i>Print
            </button>
            <a asp-action="ReceiptPdf" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
            </a>
            <a asp-action="ReceiptExcel" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success">
                <i class="bi bi-file-earmark-excel me-1"></i>Download Excel
            </a>
            @if (Model.Status != "Draft")
            {
                <button type="button" class="btn btn-sm btn-outline-info"
                        data-bs-toggle="modal" data-bs-target="#shareReceiptModal"
                        title="Email this receipt to AP, Payroll, or anyone else">
                    <i class="bi bi-send me-1"></i>Share via Email
                </button>
            }
            @if (Model.Status == "Draft" && !User.IsInRole("Admin") && !User.IsInRole("IT Agent"))
            {
                <form asp-action="SubmitReceipt" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-send me-1"></i>Submit to HR
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.Status != "Draft")
    {
        <!-- Share Receipt modal — only rendered for Submitted+ receipts -->
        <div class="modal fade no-print" id="shareReceiptModal" tabindex="-1" aria-labelledby="shareReceiptModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header" style="background:#0d6efd;color:#fff;">
                        <h5 class="modal-title" id="shareReceiptModalLabel">
                            <i class="bi bi-send me-2"></i>Share Receipt #@Model.Id
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="ShareReceipt" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">To <span class="text-danger">*</span></label>
                                <input type="email" name="toEmail" class="form-control" required
                                       placeholder="ap@example.com" />
                                <div class="form-text">Where to send the receipt (single email).</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Cc <span class="text-muted fw-normal">(optional)</span></label>
                                <input type="text" name="ccEmail" class="form-control"
                                       placeholder="payroll@example.com, you@example.com" />
                                <div class="form-text">Comma-separated if multiple.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Subject <span class="text-muted fw-normal">(optional)</span></label>
                                <input type="text" name="subject" class="form-control"
                                       value="Contractor Receipt #@Model.Id — @Model.PeriodStart.ToString("MMM d") to @Model.PeriodEnd.ToString("MMM d, yyyy")" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Message <span class="text-muted fw-normal">(optional)</span></label>
                                <textarea name="message" class="form-control" rows="3"
                                          placeholder="e.g. Hi AP — receipt for the May 16–31 window, approved by Jane. Please process this pay cycle."></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-semibold d-block">Attach</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="format" id="fmtPdf" value="pdf" />
                                    <label class="form-check-label" for="fmtPdf">PDF</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="format" id="fmtXlsx" value="xlsx" />
                                    <label class="form-check-label" for="fmtXlsx">Excel (XLSX)</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="format" id="fmtBoth" value="both" checked />
                                    <label class="form-check-label" for="fmtBoth">Both</label>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1"></i>Send
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Invoice card -->
    <div class="invoice-card">

        <!-- Colour accent bar -->
        <div class="invoice-accent"></div>

        <!-- Header -->
        <div class="invoice-header">
            <div>
                <div class="invoice-company-name">@companyName</div>
                <div class="invoice-doc-type">Contractor Payroll Receipt</div>
                <div class="status-pill mt-2" style="--status-color:@statusColor;">
                    <i class="bi @statusIcon"></i>@Model.Status
                </div>
            </div>
            <div style="text-align:right; min-width:220px;">
                <table class="invoice-meta-table ms-auto">
                    <tr>
                        <td>Receipt #</td>
                        <td style="font-size:1.1rem; font-weight:700; color:#1a3a5c;">#@Model.Id</td>
                    </tr>
                    <tr>
                        <td>Created</td>
                        <td>@Model.CreatedDate.ToString("MMMM d, yyyy")</td>
                    </tr>
                    <tr>
                        <td>Period</td>
                        <td>@Model.PeriodStart.ToString("MMM d") – @Model.PeriodEnd.ToString("MMM d, yyyy")</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Body -->
        <div class="invoice-body">

            <!-- Bill-to / contractor info -->
            <div class="bill-section">
                <div class="bill-box">
                    <div class="bill-label">Contractor</div>
                    <div class="bill-value">
                        <strong>@Model.Contractor?.FullName</strong><br />
                        @Model.Contractor?.Email<br />
                        @(Model.Contractor?.JobTitle ?? Model.Contractor?.Department)
                    </div>
                </div>
                <div class="bill-box">
                    <div class="bill-label">Billing Period</div>
                    <div class="bill-value">
                        <strong>@Model.PeriodStart.ToString("MMMM d, yyyy")</strong><br />
                        to @Model.PeriodEnd.ToString("MMMM d, yyyy")
                    </div>
                </div>
                <div class="bill-box">
                    <div class="bill-label">Rates</div>
                    <div class="bill-value">
                        <strong>@($"{Model.HourlyRateSnapshot:C2}/hr")</strong><text> standard</text>
                        @if (Model.EmergencyRateSnapshot.HasValue)
                        {
                            <br /><strong class="text-danger">@($"{Model.EmergencyRateSnapshot.Value:C2}/hr")</strong><text> emergency</text>
                        }
                        @if (Model.MonthlyRetainerAmountSnapshot.HasValue && Model.MonthlyRetainerAmountSnapshot.Value > 0)
                        {
                            <br /><span class="text-muted small">@($"+ {Model.MonthlyRetainerAmountSnapshot.Value:C2}/mo retainer")</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Summary tiles -->
            <div class="summary-tiles">
                <div class="tile tile-neutral">
                    <div class="tile-label">Total Hours</div>
                    <div class="tile-value">@Model.TotalHours.ToString("0.##")</div>
                </div>
                <div class="tile tile-blue">
                    <div class="tile-label">Billable Hours</div>
                    <div class="tile-value">@Model.TotalBillableHours.ToString("0.##")</div>
                </div>
                <div class="tile tile-neutral">
                    <div class="tile-label">@(Model.TotalEmergencyHours > 0 ? "Standard / Emergency" : "Rate / hr")</div>
                    <div class="tile-value" style="font-size:1.3rem;">
                        @if (Model.TotalEmergencyHours > 0)
                        {
                            <text>@Model.TotalStandardHours.ToString("0.##") / @Model.TotalEmergencyHours.ToString("0.##") h</text>
                        }
                        else
                        {
                            <text>$@Model.HourlyRateSnapshot.ToString("N2")</text>
                        }
                    </div>
                </div>
                <div class="tile tile-total">
                    <div class="tile-label">Total Due</div>
                    <div class="tile-value">$@Model.TotalAmount.ToString("N2")</div>
                </div>
            </div>

            <!-- Time entries table -->
            <div class="bill-label mb-2">Time Entries</div>
            @{
                // Per-row rate display. Emergency entries always bill at the
                // emergency rate. Standard entries bill at the standard rate
                // EXCEPT for the portion absorbed by the retainer — but we
                // can't know which individual entry "ran out of pool" without
                // tracking running totals here; the per-month breakdown box
                // below shows the aggregate so per-row just renders the
                // entry's gross rate.
                var calc = ViewBag.PayrollCalc as ServiceDesk.Web.Services.PayrollCalculatorService.PayrollCalculation;
                var stdRate  = Model.HourlyRateSnapshot;
                var emerRate = Model.EmergencyRateSnapshot ?? 0m;
            }
            <div class="table-responsive mb-2">
                <table class="invoice-table">
                    <thead>
                        <tr>
                            <th>Work Date</th>
                            <th>Ticket #</th>
                            <th style="width:30%">Description</th>
                            <th class="text-center">Hours</th>
                            <th class="text-center">Rate Type</th>
                            <th class="text-center">Billable</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.TimeEntries.OrderBy(e => e.WorkDate))
                        {
                            var isEmer = entry.RateType == ServiceDesk.Core.Enums.PayRateType.Emergency;
                            var rateForRow = isEmer ? emerRate : stdRate;
                            var amount     = entry.IsBillable ? entry.Hours * rateForRow : 0m;
                            <tr>
                                <td class="text-nowrap">@entry.WorkDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    @if (entry.Ticket != null)
                                    {
                                        <span class="fw-semibold text-primary">#@entry.Ticket.Id</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-muted">@(entry.Description ?? entry.Ticket?.Title ?? "—")</td>
                                <td class="text-center fw-semibold">@entry.Hours.ToString("0.##")</td>
                                <td class="text-center">
                                    @if (isEmer)
                                    { <span class="badge bg-danger">Emergency</span> }
                                    else
                                    { <span class="badge bg-secondary">Standard</span> }
                                </td>
                                <td class="text-center">
                                    @if (entry.IsBillable)
                                    { <span class="badge-billable-yes">Billable</span> }
                                    else
                                    { <span class="badge-billable-no">Non-billable</span> }
                                </td>
                                <td class="text-end">
                                    @(entry.IsBillable ? "$" + rateForRow.ToString("N2") : "—")
                                </td>
                                <td class="text-end fw-semibold">
                                    @(entry.IsBillable ? "$" + amount.ToString("N2") : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ── Payroll breakdown — Standard / Emergency / Retainer subtotals ── *@
            @if (calc != null)
            {
                <div class="card border-0 shadow-sm mb-3" style="background:#fafbfc;">
                    <div class="card-body py-3">
                        <h6 class="fw-bold mb-3 text-uppercase small text-muted">Payroll Breakdown</h6>
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                                @{
                                    var stdAbsorbed = calc.TotalRetainerHoursApplied;
                                    var stdHours    = calc.TotalStandardHours;
                                    var stdBill     = calc.StandardBillableHours;
                                    var emerHours   = calc.TotalEmergencyHours;
                                }
                                <tr>
                                    <td class="fw-semibold">Standard hours</td>
                                    <td class="text-end">@stdHours.ToString("0.##") h</td>
                                    <td colspan="2"></td>
                                </tr>
                                @if (stdAbsorbed > 0)
                                {
                                    <tr class="text-muted small">
                                        <td class="ps-4"><i class="bi bi-arrow-return-right me-1"></i>Covered by retainer</td>
                                        <td class="text-end">@stdAbsorbed.ToString("0.##") h</td>
                                        <td class="text-end">$0.00</td>
                                        <td class="text-end">$0.00</td>
                                    </tr>
                                }
                                <tr class="small">
                                    <td class="ps-4"><i class="bi bi-arrow-return-right me-1"></i>Billable at standard rate</td>
                                    <td class="text-end">@stdBill.ToString("0.##") h</td>
                                    <td class="text-end">@stdRate.ToString("C2")</td>
                                    <td class="text-end fw-semibold">@calc.StandardBillableAmount.ToString("C2")</td>
                                </tr>
                                @if (emerHours > 0)
                                {
                                    <tr>
                                        <td class="fw-semibold">Emergency hours</td>
                                        <td class="text-end">@emerHours.ToString("0.##") h</td>
                                        <td class="text-end">@emerRate.ToString("C2")</td>
                                        <td class="text-end fw-semibold">@calc.EmergencyBillableAmount.ToString("C2")</td>
                                    </tr>
                                }
                                @foreach (var m in calc.Months.Where(b => b.RetainerAmountThisReceipt > 0))
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            Monthly retainer — @m.Label
                                            <span class="text-muted small">
                                                (covers up to @((Model.MonthlyRetainerHoursSnapshot ?? 0m).ToString("0.##")) h)
                                            </span>
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td class="text-end fw-semibold">@m.RetainerAmountThisReceipt.ToString("C2")</td>
                                    </tr>
                                }
                                @foreach (var m in calc.Months.Where(b =>
                                    !b.IsFirstReceiptOfMonth
                                    && (Model.MonthlyRetainerAmountSnapshot ?? 0m) > 0))
                                {
                                    <tr class="text-muted small">
                                        <td>
                                            <i class="bi bi-info-circle me-1"></i>@m.Label retainer
                                            already applied to a prior receipt
                                            @if (m.RetainerHoursApplied > 0)
                                            { <text>(@m.RetainerHoursApplied.ToString("0.##") h absorbed from this receipt's pool)</text> }
                                        </td>
                                        <td colspan="3"></td>
                                    </tr>
                                }
                                @foreach (var charge in calc.RecurringCharges)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @charge.LabelSnapshot
                                            <span class="text-muted small">— @charge.OccurrenceCount × @charge.UnitAmountSnapshot.ToString("C2")</span>
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td class="text-end fw-semibold">@charge.TotalAmount.ToString("C2")</td>
                                    </tr>
                                }
                                <tr style="border-top:2px solid #333;">
                                    <td class="fw-bold pt-2">Total</td>
                                    <td class="text-end pt-2">
                                        <span class="text-muted small">@Model.TotalHours.ToString("0.##") h logged</span>
                                    </td>
                                    <td></td>
                                    <td class="text-end fw-bold pt-2" style="font-size:1.05rem;">$@Model.TotalAmount.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                @* Fallback when ViewBag.PayrollCalc isn't set (older receipts re-rendered without breakdown). *@
                <div class="text-end fw-bold mb-3" style="font-size:1.1rem;">
                    Total: $@Model.TotalAmount.ToString("N2")
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="invoice-notes">
                    <i class="bi bi-sticky me-1"></i><strong>Notes:</strong> @Model.Notes
                </div>
            }

            @if (Model.Status == "Draft" && !string.IsNullOrEmpty(Model.RejectionNote))
            {
                <div style="background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:14px 18px;margin-bottom:18px;display:flex;gap:12px;align-items:flex-start;">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#856404;font-size:1.1rem;flex-shrink:0;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;color:#856404;font-size:.88rem;margin-bottom:3px;">Returned by HR for Revision</div>
                        <div style="color:#533f03;font-size:.875rem;">@Model.RejectionNote</div>
                    </div>
                </div>
            }

            @if ((Model.Status == "Approved" || Model.Status == "Paid") && Model.ApprovedDate.HasValue)
            {
                <div style="background:#d1e7dd;border:1px solid #198754;border-radius:8px;padding:14px 18px;margin-bottom:18px;display:flex;gap:12px;align-items:flex-start;">
                    <i class="bi bi-check-circle-fill" style="color:#0f5132;font-size:1.1rem;flex-shrink:0;margin-top:2px;"></i>
                    <div style="flex-grow:1;">
                        <div style="font-weight:700;color:#0f5132;font-size:.88rem;margin-bottom:3px;">
                            Approved on @Model.ApprovedDate.Value.ToString("MMMM d, yyyy 'at' h:mm tt") UTC
                            @if (Model.ApprovedBy != null)
                            { <span class="fw-normal">by @Model.ApprovedBy.FullName</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(Model.ApprovalNote))
                        {
                            <div style="color:#0a3622;font-size:.875rem;">
                                <strong>Note:</strong> @Model.ApprovalNote
                            </div>
                        }
                    </div>
                </div>
            }

            @{
                var payments             = ViewBag.Payments as List<ServiceDesk.Core.Models.PayrollReceiptPayment>
                                             ?? new List<ServiceDesk.Core.Models.PayrollReceiptPayment>();
                var totalPaidVal         = (decimal)(ViewBag.TotalPaid ?? 0m);
                var outstandingVal       = (decimal)(ViewBag.OutstandingBalance ?? 0m);
                var canRecordPayment     = isAdminViewer
                                            && (Model.Status == "Approved"
                                                || Model.Status == "PartiallyPaid"
                                                || (Model.Status == "Paid" && outstandingVal > 0m));
                // Contractor-side: can nudge admins when there's an
                // outstanding balance on an Approved / PartiallyPaid receipt.
                // Gated on ownership, not "not an admin" — a dual-role
                // account (Admin + IsContractor) still needs this on their
                // own receipts.
                var canRequestPayment    = isOwningContractor
                                            && outstandingVal > 0m
                                            && (Model.Status == "Approved" || Model.Status == "PartiallyPaid");
                // Admin-side: send an explicit paid/outstanding status
                // update to HR/AP/anyone — distinct from the contractor's
                // "nudge" above (no rate limit, admin picks recipients).
                var canNotifyPaymentStatus = isAdminViewer
                                            && payments.Count > 0
                                            && outstandingVal > 0m;
                var showPaymentsCard     = payments.Count > 0 || canRecordPayment || canRequestPayment;
                var paymentPct           = Model.TotalAmount > 0m
                                             ? (int)Math.Min(100, Math.Round(totalPaidVal / Model.TotalAmount * 100m))
                                             : 0;
            }
            @if (showPaymentsCard)
            {
                <div class="card shadow-sm border-0 mb-3 no-print">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="mb-0"><i class="bi bi-cash-stack me-2 text-primary"></i>Payments Received</h6>
                            <div class="text-muted small mt-1">
                                <strong>@totalPaidVal.ToString("C2")</strong> of @Model.TotalAmount.ToString("C2")
                                @if (outstandingVal > 0m)
                                {
                                    <span class="text-warning fw-semibold">· @outstandingVal.ToString("C2") outstanding</span>
                                }
                                else if (payments.Count > 0)
                                {
                                    <span class="text-success fw-semibold">· fully paid</span>
                                }
                            </div>
                        </div>
                        @if (canRecordPayment)
                        {
                            <button type="button" class="btn btn-sm btn-success"
                                    data-bs-toggle="modal" data-bs-target="#recordPaymentModal">
                                <i class="bi bi-plus-lg me-1"></i>Record Payment
                            </button>
                        }
                        @if (canRequestPayment)
                        {
                            var lastReq  = Model.LastPaymentRequestDate;
                            var cooldown = TimeSpan.FromHours(24);
                            var onCooldown = lastReq.HasValue && (DateTime.UtcNow - lastReq.Value) < cooldown;
                            var nextEligible = lastReq.HasValue ? lastReq.Value + cooldown : DateTime.UtcNow;
                            if (onCooldown)
                            {
                                var hoursLeft = Math.Max(1, (int)Math.Ceiling((nextEligible - DateTime.UtcNow).TotalHours));
                                <button type="button" class="btn btn-sm btn-outline-warning" disabled
                                        title="You can send another request in @hoursLeft hour(s) — 24 h cooldown">
                                    <i class="bi bi-clock-history me-1"></i>Request Payment (in ~@hoursLeft h)
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-warning"
                                        data-bs-toggle="modal" data-bs-target="#requestPaymentModal">
                                    <i class="bi bi-cash-coin me-1"></i>Request Payment
                                </button>
                            }
                        }
                        @if (canNotifyPaymentStatus)
                        {
                            <button type="button" class="btn btn-sm btn-outline-warning"
                                    data-bs-toggle="modal" data-bs-target="#notifyPaymentStatusModal"
                                    title="Email HR/AP or anyone else the current paid/outstanding breakdown">
                                <i class="bi bi-megaphone me-1"></i>Notify Payment Status
                            </button>
                        }
                    </div>
                    <div class="progress" style="height:6px;border-radius:0;">
                        <div class="progress-bar @(outstandingVal <= 0m ? "bg-success" : "bg-warning")"
                             role="progressbar"
                             style="width:@paymentPct%;"
                             aria-valuenow="@paymentPct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="card-body p-0">
                        @if (payments.Count == 0)
                        {
                            <div class="text-muted small text-center py-3">No payments recorded yet.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:110px;">Date</th>
                                            <th style="width:100px;">Method</th>
                                            <th>Reference</th>
                                            <th class="text-end">Amount</th>
                                            <th>Confirmed?</th>
                                            <th class="text-end no-export">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pay in payments)
                                        {
                                            var refDisplay = pay.CheckNumber != null && pay.Reference != null
                                                             ? $"#{pay.CheckNumber} · {pay.Reference}"
                                                             : (pay.CheckNumber != null ? $"#{pay.CheckNumber}"
                                                                 : pay.Reference ?? "—");
                                            <tr>
                                                <td class="small text-nowrap">@pay.PaymentDate.ToString("MMM d, yyyy")</td>
                                                <td class="small">
                                                    <span class="badge bg-secondary bg-opacity-25 text-dark">@pay.PaymentMethod</span>
                                                </td>
                                                <td class="small text-muted">
                                                    <code class="text-muted">@refDisplay</code>
                                                    @if (!string.IsNullOrWhiteSpace(pay.Note))
                                                    {
                                                        <div class="text-muted small fst-italic mt-1">@pay.Note</div>
                                                    }
                                                </td>
                                                <td class="text-end fw-semibold text-nowrap">@pay.Amount.ToString("C2")</td>
                                                <td class="small">
                                                    @if (pay.ContractorConfirmedDate.HasValue)
                                                    {
                                                        <span class="text-success">
                                                            <i class="bi bi-check2-all me-1"></i>@pay.ContractorConfirmedDate.Value.ToString("MMM d, yyyy")
                                                        </span>
                                                    }
                                                    else if (isOwningContractor)
                                                    {
                                                        <form asp-controller="Contractor" asp-action="ConfirmPayment"
                                                              asp-route-paymentId="@pay.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-outline-success btn-sm py-0">
                                                                <i class="bi bi-check2-circle me-1"></i>Confirm
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Awaiting</span>
                                                    }
                                                </td>
                                                <td class="text-end no-export">
                                                    @if (isAdminViewer)
                                                    {
                                                        <form asp-controller="AdminPayroll" asp-action="DeletePayment"
                                                              method="post" class="d-inline"
                                                              onsubmit="return confirm('Delete this @pay.Amount.ToString("C2") @pay.PaymentMethod payment? The receipt status will be recalculated.');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="paymentId" value="@pay.Id" />
                                                            <input type="hidden" name="returnUrl" value="@Url.Action("ReceiptDetail", "Contractor", new { id = Model.Id })" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0" title="Delete payment">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="3" class="text-end fw-semibold">Total paid</td>
                                            <td class="text-end fw-bold">@totalPaidVal.ToString("C2")</td>
                                            <td colspan="2" class="small text-muted">
                                                @if (outstandingVal > 0m)
                                                {
                                                    <text>Outstanding: <strong class="text-warning">@outstandingVal.ToString("C2")</strong></text>
                                                }
                                                else
                                                {
                                                    <text><i class="bi bi-check-circle text-success me-1"></i>Fully paid</text>
                                                }
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Record Payment modal — admin only. Pre-fills Amount with the
               outstanding balance so single-shot full payments are one click. *@
            @if (canRecordPayment)
            {
                <div class="modal fade no-print" id="recordPaymentModal" tabindex="-1" aria-labelledby="recordPaymentModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-controller="AdminPayroll" asp-action="RecordPayment" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Url.Action("ReceiptDetail", "Contractor", new { id = Model.Id })" />
                                <div class="modal-header" style="background:#0d6efd;color:#fff;">
                                    <h5 class="modal-title" id="recordPaymentModalLabel">
                                        <i class="bi bi-cash-stack me-2"></i>Record Payment on Receipt #@Model.Id
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Payment Date</label>
                                            <input type="date" name="paymentDate" class="form-control" required
                                                   value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Amount</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input type="number" name="amount" class="form-control" required
                                                       step="0.01" min="0.01"
                                                       value="@outstandingVal.ToString("F2")"
                                                       id="recordPaymentAmount" />
                                                <button type="button" class="btn btn-outline-secondary" title="Fill outstanding balance"
                                                        onclick="document.getElementById('recordPaymentAmount').value='@outstandingVal.ToString("F2")';">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                </button>
                                            </div>
                                            <div class="form-text small">Outstanding: @outstandingVal.ToString("C2")</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Method</label>
                                            <select name="paymentMethod" class="form-select" id="recordPaymentMethod" required>
                                                <option value="Check">Check</option>
                                                <option value="ACH">ACH</option>
                                                <option value="Zelle">Zelle</option>
                                                <option value="Wire">Wire</option>
                                                <option value="Cash">Cash</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6" id="recordPaymentCheckWrapper">
                                            <label class="form-label fw-semibold">Check #</label>
                                            <input type="text" name="checkNumber" class="form-control" placeholder="e.g. 4521" maxlength="50" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Reference <span class="text-muted fw-normal small">(optional)</span></label>
                                            <input type="text" name="reference" class="form-control"
                                                   placeholder="ACH id, Zelle confirmation, wire ref, etc." maxlength="200" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Note <span class="text-muted fw-normal small">(optional)</span></label>
                                            <input type="text" name="note" class="form-control"
                                                   placeholder="e.g. First installment" maxlength="1000" />
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check-lg me-1"></i>Record Payment
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <script>
                    // Only show the "Check #" field when Method = Check — the
                    // rest of the methods use the Reference field instead.
                    (function () {
                        var sel = document.getElementById('recordPaymentMethod');
                        var wrap = document.getElementById('recordPaymentCheckWrapper');
                        if (!sel || !wrap) return;
                        var sync = function () { wrap.style.display = sel.value === 'Check' ? '' : 'none'; };
                        sel.addEventListener('change', sync);
                        sync();
                    })();
                </script>
            }

            @* Request Payment modal — contractor only. Optional note goes
               into the email + activity log so admins have context. *@
            @if (canRequestPayment && !(Model.LastPaymentRequestDate.HasValue
                    && (DateTime.UtcNow - Model.LastPaymentRequestDate.Value) < TimeSpan.FromHours(24)))
            {
                <div class="modal fade no-print" id="requestPaymentModal" tabindex="-1" aria-labelledby="requestPaymentModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-controller="Contractor" asp-action="RequestPayment" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Url.Action("ReceiptDetail", "Contractor", new { id = Model.Id })" />
                                <div class="modal-header" style="background:#f59e0b;color:#fff;">
                                    <h5 class="modal-title" id="requestPaymentModalLabel">
                                        <i class="bi bi-cash-coin me-2"></i>Request Payment on Receipt #@Model.Id
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-warning small mb-3">
                                        <i class="bi bi-info-circle me-1"></i>
                                        This will email your payroll admins that <strong>@outstandingVal.ToString("C2")</strong>
                                        is still outstanding on this receipt. To keep the queue calm, another request can only be sent
                                        <strong>24 hours</strong> from now.
                                    </div>
                                    <div>
                                        <label class="form-label fw-semibold">Optional note</label>
                                        <textarea name="note" class="form-control" rows="3" maxlength="500"
                                                  placeholder="e.g. Month-end closing pressure, or asking for a status update."></textarea>
                                        <div class="form-text small">The note is shown to admins in the email and stored in the receipt's activity thread.</div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-send me-1"></i>Send Payment Request
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @* Notify Payment Status modal — admin only. Unlike Request Payment
               (contractor-side, rate-limited, fixed recipient list), this lets
               an admin pick recipients explicitly and send right away — no
               cooldown, since it's a deliberate action rather than a nudge. *@
            @if (canNotifyPaymentStatus)
            {
                var defaultHr = ViewBag.DefaultHrEmail as string ?? "";
                var defaultAp = ViewBag.DefaultApEmail as string ?? "";
                var defaultTo = !string.IsNullOrWhiteSpace(defaultHr) ? defaultHr : defaultAp;
                var defaultCc = (!string.IsNullOrWhiteSpace(defaultHr) && !string.IsNullOrWhiteSpace(defaultAp)
                                  && defaultHr != defaultAp) ? defaultAp : "";
                <div class="modal fade no-print" id="notifyPaymentStatusModal" tabindex="-1" aria-labelledby="notifyPaymentStatusModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-controller="AdminPayroll" asp-action="NotifyPaymentStatus" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Url.Action("ReceiptDetail", "Contractor", new { id = Model.Id })" />
                                <div class="modal-header" style="background:#b45309;color:#fff;">
                                    <h5 class="modal-title" id="notifyPaymentStatusModalLabel">
                                        <i class="bi bi-megaphone me-2"></i>Notify Payment Status — Receipt #@Model.Id
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-light border small mb-3">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Sends a breakdown of what's been paid and what's still outstanding —
                                        <strong>@totalPaidVal.ToString("C2")</strong> paid,
                                        <strong class="text-warning">@outstandingVal.ToString("C2")</strong> outstanding
                                        of <strong>@Model.TotalAmount.ToString("C2")</strong> total.
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">To <span class="text-danger">*</span></label>
                                        <input type="email" name="toEmail" class="form-control" required
                                               value="@defaultTo" placeholder="ap@example.com" />
                                        <div class="form-text small">Pre-filled from Settings → Payroll HR/AP defaults — change as needed.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Cc <span class="text-muted fw-normal">(optional)</span></label>
                                        <input type="text" name="ccEmail" class="form-control"
                                               value="@defaultCc" placeholder="Comma-separated if multiple" />
                                    </div>
                                    <div>
                                        <label class="form-label fw-semibold">Note <span class="text-muted fw-normal">(optional)</span></label>
                                        <textarea name="note" class="form-control" rows="3" maxlength="500"
                                                  placeholder="e.g. Contractor asked about this — remaining amount goes out with next check run."></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn" style="background:#b45309;color:#fff;">
                                        <i class="bi bi-send me-1"></i>Send Status Update
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (Model.Status == "Paid" && Model.PaidDate.HasValue)
            {
                <!-- Payment details + Confirm Received -->
                <div style="background:#cff4fc;border:1px solid #0aa2c0;border-radius:8px;padding:14px 18px;margin-bottom:18px;">
                    <div style="display:flex;gap:12px;align-items:flex-start;">
                        <i class="bi bi-cash-coin" style="color:#055160;font-size:1.2rem;flex-shrink:0;margin-top:2px;"></i>
                        <div style="flex-grow:1;">
                            <div style="font-weight:700;color:#055160;font-size:.95rem;margin-bottom:6px;">
                                Payment Issued on @Model.PaidDate.Value.ToString("MMMM d, yyyy")
                            </div>
                            @if (!string.IsNullOrEmpty(Model.PaymentMethod) || !string.IsNullOrEmpty(Model.PaymentReference))
                            {
                                <div style="color:#055160;font-size:.875rem;display:flex;gap:18px;flex-wrap:wrap;">
                                    @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                                    {
                                        <span><strong>Method:</strong> @Model.PaymentMethod</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.PaymentReference))
                                    {
                                        <span><strong>Reference:</strong> <code style="background:#fff;padding:1px 6px;border-radius:3px;">@Model.PaymentReference</code></span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="color:#055160;font-size:.85rem;font-style:italic;">No payment method or reference was recorded.</div>
                            }
                        </div>
                    </div>

                    @if (Model.PaymentConfirmedDate.HasValue)
                    {
                        <div class="mt-3 pt-3" style="border-top:1px dashed #0aa2c0;">
                            <div style="color:#0f5132;font-weight:600;display:flex;align-items:center;gap:6px;">
                                <i class="bi bi-check2-all"></i>
                                You confirmed receipt of this payment on @Model.PaymentConfirmedDate.Value.ToString("MMM d, yyyy")
                            </div>
                            @if (!string.IsNullOrEmpty(Model.PaymentConfirmedNote))
                            {
                                <div class="text-muted mt-1 small">Note: @Model.PaymentConfirmedNote</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mt-3 pt-3 no-print" style="border-top:1px dashed #0aa2c0;">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div style="color:#055160;font-size:.875rem;">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @if (User.IsInRole("Admin") || User.IsInRole("IT Agent"))
                                    { <span>Awaiting contractor confirmation.</span> }
                                    else
                                    { <span>Once the funds land in your account, please confirm receipt.</span> }
                                </div>
                                @if (!User.IsInRole("Admin") && !User.IsInRole("IT Agent"))
                                {
                                    <button type="button" class="btn btn-sm btn-success"
                                            data-bs-toggle="modal" data-bs-target="#confirmReceivedModal">
                                        <i class="bi bi-check2-circle me-1"></i>Confirm Received
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Status timeline -->
            <div class="status-trail">
                @{
                    bool submitted = Model.SubmittedDate.HasValue;
                    bool approved  = Model.ApprovedDate.HasValue;
                    bool paid      = Model.PaidDate.HasValue;
                }
                <div class="status-step">
                    <div class="status-dot status-dot-done"><i class="bi bi-pencil-square"></i></div>
                    <div class="status-trail-label">Created</div>
                    <div class="status-trail-date">@Model.CreatedDate.ToString("MMM d, yyyy")</div>
                </div>
                <div class="status-step">
                    <div class="status-dot @(submitted ? "status-dot-done" : "status-dot-pend")">
                        <i class="bi bi-send"></i>
                    </div>
                    <div class="status-trail-label">Submitted</div>
                    <div class="status-trail-date">@(submitted ? Model.SubmittedDate!.Value.ToString("MMM d, yyyy") : "Pending")</div>
                </div>
                <div class="status-step">
                    <div class="status-dot @(approved ? "status-dot-done" : "status-dot-pend")">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="status-trail-label">Approved</div>
                    <div class="status-trail-date">@(approved ? Model.ApprovedDate!.Value.ToString("MMM d, yyyy") : "Pending")</div>
                    @if (approved && Model.ApprovedBy != null)
                    {
                        <div class="status-trail-by">by @Model.ApprovedBy.FullName</div>
                    }
                </div>
                <div class="status-step">
                    <div class="status-dot @(paid ? "status-dot-done" : "status-dot-pend")"
                         style="@(paid ? "background:#198754;" : "")">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <div class="status-trail-label">Paid</div>
                    <div class="status-trail-date">@(paid ? Model.PaidDate!.Value.ToString("MMM d, yyyy") : "Pending")</div>
                </div>
                @if (Model.PaymentConfirmedDate.HasValue)
                {
                    <div class="status-step">
                        <div class="status-dot status-dot-done" style="background:#0aa2c0;">
                            <i class="bi bi-check2-all"></i>
                        </div>
                        <div class="status-trail-label">Confirmed</div>
                        <div class="status-trail-date">@Model.PaymentConfirmedDate.Value.ToString("MMM d, yyyy")</div>
                    </div>
                }
            </div>

        </div>
    </div>

    @{
        var comments = ViewBag.Comments as IList<ServiceDesk.Core.Models.PayrollReceiptComment>
                       ?? new List<ServiceDesk.Core.Models.PayrollReceiptComment>();
    }

    @* ── Activity / Discussion thread ────────────────────────────────────── *@
    @if (Model.Status != "Draft" || comments.Any())
    {
        <div class="card shadow-sm mt-4 no-print">
            <div class="card-header bg-white d-flex align-items-center">
                <h5 class="mb-0"><i class="bi bi-chat-square-text me-2 text-primary"></i>Activity &amp; Discussion</h5>
                <span class="badge bg-secondary ms-2">@comments.Count</span>
            </div>
            <div class="card-body">
                @if (!comments.Any())
                {
                    <p class="text-muted small mb-0">No activity yet.</p>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var c in comments)
                        {
                            var isAdmin      = c.AuthorRole == "Admin";
                            var isContractor = c.AuthorRole == "Contractor";
                            var bg           = isAdmin ? "#eef4ff" : (isContractor ? "#f0fdf4" : "#f8f9fa");
                            var bar          = isAdmin ? "#0d6efd" : (isContractor ? "#16a34a" : "#9ca3af");
                            var icon         = isAdmin ? "bi-person-badge" : (isContractor ? "bi-person-circle" : "bi-gear");
                            <div class="mb-3" style="background:@bg;border-left:4px solid @bar;padding:10px 14px;border-radius:6px;">
                                <div class="d-flex justify-content-between align-items-start flex-wrap">
                                    <div class="fw-semibold small">
                                        <i class="bi @icon me-1" style="color:@bar;"></i>
                                        @c.AuthorName
                                        <span class="text-muted fw-normal">· @c.AuthorRole</span>
                                    </div>
                                    <div class="text-muted small">@c.CreatedDate.ToString("MMM d, yyyy h:mm tt")</div>
                                </div>
                                <div class="mt-1 small" style="white-space:pre-wrap;">@c.Body</div>
                            </div>
                        }
                    </div>
                }

                @if (Model.Status != "Draft")
                {
                    // Who is "speaking" when this comment posts? Default to
                    // isAdminViewer, EXCEPT when the viewer owns this receipt
                    // as its contractor — then route through the contractor
                    // endpoint so a dual-role account's own comment is
                    // correctly attributed as themselves, not as "Admin".
                    var speakAsContractor = isOwningContractor;
                    var postController = speakAsContractor ? "Contractor" : "AdminPayroll";
                    var postAction     = speakAsContractor ? "PostReceiptComment" : "PostComment";
                    var promptText     = speakAsContractor
                        ? "Ask a clarifying question, add context, or leave a note for the admin team."
                        : "Reply to the contractor, ask for clarification, or leave an internal note.";

                    @* Comment form — server validates emptiness so we drop the
                       HTML5 `required` attribute (which was causing an invisible
                       validation tooltip when the form is scrolled off screen)
                       and disable autosave here (short comments belong sent,
                       not stashed as drafts). The Post button stays disabled
                       until the textarea has non-whitespace content so users
                       get immediate visible feedback. *@
                    <form asp-controller="@postController" asp-action="@postAction" asp-route-id="@Model.Id"
                          method="post" class="mt-3" id="receiptCommentForm-@Model.Id">
                        @Html.AntiForgeryToken()
                        @if (!speakAsContractor)
                        {
                            <input type="hidden" name="returnUrl" value="@Url.Action("ReceiptDetail", "Contractor", new { id = Model.Id })" />
                        }
                        <label class="form-label small fw-semibold" for="receiptCommentBody-@Model.Id">Add a comment</label>
                        <textarea name="body" id="receiptCommentBody-@Model.Id"
                                  class="form-control" rows="2"
                                  placeholder="@promptText"></textarea>
                        <div class="mt-2 d-flex justify-content-end">
                            <button type="submit" class="btn btn-sm btn-primary" id="receiptCommentPost-@Model.Id" disabled>
                                <i class="bi bi-send me-1"></i>Post
                            </button>
                        </div>
                    </form>
                    <script>
                        (function () {
                            var ta  = document.getElementById('receiptCommentBody-@Model.Id');
                            var btn = document.getElementById('receiptCommentPost-@Model.Id');
                            if (!ta || !btn) return;
                            var sync = function () { btn.disabled = ta.value.trim().length === 0; };
                            ta.addEventListener('input', sync);
                            sync();
                        })();
                    </script>
                }
            </div>
        </div>
    }
</div>

@if (Model.Status == "Paid" && !Model.PaymentConfirmedDate.HasValue)
{
    <!-- Confirm Received modal -->
    <div class="modal fade no-print" id="confirmReceivedModal" tabindex="-1" aria-labelledby="confirmReceivedModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#198754;color:#fff;">
                    <h5 class="modal-title" id="confirmReceivedModalLabel">
                        <i class="bi bi-check2-circle me-2"></i>Confirm Payment Received
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="ConfirmPaymentReceived" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p>
                            By confirming, you're acknowledging that you've received payment of
                            <strong class="text-success">$@Model.TotalAmount.ToString("N2")</strong>
                            for receipt #@Model.Id.
                        </p>
                        @if (!string.IsNullOrEmpty(Model.PaymentReference))
                        {
                            <p class="small text-muted">
                                Match against reference: <code>@Model.PaymentReference</code>
                            </p>
                        }
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Note <span class="text-muted fw-normal">(optional)</span></label>
                            <textarea name="confirmationNote" class="form-control" rows="2"
                                      placeholder="e.g. Received via Zelle on May 30 — thanks!"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check2-circle me-1"></i>Confirm Received
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
