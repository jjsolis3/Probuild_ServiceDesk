@model IEnumerable<ServiceDesk.Core.Models.PayrollReceipt>
@using ServiceDesk.Core.Models
@{
    var contractor       = ViewBag.Contractor as Employee;
    var unclaimed        = ViewBag.UnclaimedEntries as List<TicketTimeEntry> ?? new();
    var unclaimedBillHrs = (decimal)(ViewBag.UnclaimedBillableHrs ?? 0m);
    var unclaimedAmt     = (decimal)(ViewBag.UnclaimedAmount ?? 0m);
    var unclaimedTotal   = unclaimed.Sum(e => e.Hours);
    var earliestDate     = unclaimed.Count > 0 ? unclaimed.Min(e => e.WorkDate) : (DateTime?)null;
}

<div class="row page-titles">
    <div class="col-sm-6">
        <h4>My Payroll</h4>
        <p class="text-muted mb-0">Track billable hours and generate invoices for the work you've done</p>
    </div>
    <div class="col-sm-6 text-end">
        <a asp-action="NewReceipt" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>New Receipt
        </a>
    </div>
</div>

@* ── Outstanding Hours Card (A) ─────────────────────────────────────── *@
<div class="card shadow-sm mb-4 border-@(unclaimedBillHrs > 0 ? "warning" : "success")">
    <div class="card-header d-flex align-items-center justify-content-between
                bg-@(unclaimedBillHrs > 0 ? "warning bg-opacity-10" : "success bg-opacity-10")">
        <span class="fw-semibold">
            <i class="fas fa-clock me-1"></i>Outstanding Billable Hours
        </span>
        @if (unclaimed.Count > 0)
        {
            <button class="btn btn-sm btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#unclaimedEntries">
                <i class="fas fa-list me-1"></i>View Entries
            </button>
        }
    </div>
    <div class="card-body">
        <div class="row g-4 text-center">
            <div class="col-sm-3">
                <div class="fs-2 fw-bold text-primary">@unclaimedBillHrs.ToString("0.##")</div>
                <div class="text-muted small">Billable hrs unpaid</div>
            </div>
            <div class="col-sm-3">
                <div class="fs-2 fw-bold text-success">$@unclaimedAmt.ToString("N2")</div>
                <div class="text-muted small">Estimated amount</div>
            </div>
            <div class="col-sm-3">
                <div class="fs-2 fw-bold text-secondary">@unclaimedTotal.ToString("0.##")</div>
                <div class="text-muted small">Total hrs (all entries)</div>
            </div>
            <div class="col-sm-3">
                <div class="fs-2 fw-bold text-muted">
                    @(earliestDate.HasValue ? earliestDate.Value.ToString("MMM d") : "—")
                </div>
                <div class="text-muted small">Earliest unclaimed</div>
            </div>
        </div>
        @if (unclaimed.Count == 0)
        {
            <p class="text-success text-center mb-0 mt-3">
                <i class="fas fa-check-circle me-1"></i>All logged hours have been claimed in a receipt. Nothing outstanding.
            </p>
        }
        else
        {
            <div class="text-center mt-3">
                <a asp-action="NewReceipt" class="btn btn-warning">
                    <i class="fas fa-file-invoice-dollar me-1"></i>Generate Receipt for These Hours
                </a>
            </div>
        }
    </div>
</div>

@* ── Unclaimed Entries Table (B) ────────────────────────────────────── *@
@if (unclaimed.Count > 0)
{
    <div class="collapse mb-4" id="unclaimedEntries">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">
                <i class="fas fa-list-ul me-1"></i>Unclaimed Time Entries (@unclaimed.Count)
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Ticket</th>
                                <th class="text-end">Hours</th>
                                <th class="text-center">Billable</th>
                                <th class="text-end">Est. Amount</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in unclaimed)
                            {
                                var entryAmt = entry.IsBillable ? entry.Hours * (contractor?.HourlyRate ?? 0) : 0;
                                <tr>
                                    <td class="text-nowrap small">@entry.WorkDate.ToString("MMM d, yyyy")</td>
                                    <td>
                                        @if (entry.Ticket != null)
                                        {
                                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@entry.TicketId"
                                               class="fw-semibold text-decoration-none">#@entry.TicketId</a>
                                            <span class="text-muted small ms-1">@entry.Ticket.Title</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Ticket #@entry.TicketId</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">@entry.Hours.ToString("0.##")</td>
                                    <td class="text-center">
                                        @if (entry.IsBillable)
                                        {
                                            <span class="badge bg-success">Billable</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Non-billable</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @(entry.IsBillable ? "$" + entryAmt.ToString("N2") : "—")
                                    </td>
                                    <td class="small text-muted">@(entry.Description ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <td colspan="2" class="text-end">Totals</td>
                                <td class="text-end">@unclaimedTotal.ToString("0.##")</td>
                                <td class="text-center text-success">@unclaimedBillHrs.ToString("0.##") billable</td>
                                <td class="text-end text-success">$@unclaimedAmt.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@* New Receipt Quick Form *@
<div class="card shadow-sm mb-4" id="newReceiptPanel" style="display:none;">
    <div class="card-header"><i class="fas fa-file-invoice-dollar me-1"></i>New Payroll Receipt</div>
    <div class="card-body">
        <form asp-action="NewReceipt" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Period Start</label>
                    <input type="date" name="periodStart" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Period End</label>
                    <input type="date" name="periodEnd" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Notes (optional)</label>
                    <input type="text" name="notes" class="form-control" placeholder="e.g. May 2026 invoice" maxlength="2000" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-save me-1"></i>Create Draft
                    </button>
                </div>
            </div>
            <p class="small text-muted mt-2 mb-0">
                Pulls all unclaimed billable time entries you logged (on any ticket) within the selected period at your rate of
                <strong>$@contractor?.HourlyRate?.ToString("0.00") / hr</strong>.
                Already-claimed entries are excluded — you can never bill the same hour twice.
                Work in progress? Log time as you go; future receipts will pick up any hours not yet claimed.
            </p>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No payroll receipts yet.
        Log billable time on your tickets as usual, then click <strong>New Receipt</strong> to bundle those hours into an invoice.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="payrollTable">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Period</th>
                            <th class="text-end">Total Hrs</th>
                            <th class="text-end">Billable Hrs</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var receipt in Model)
                        {
                            var badgeClass = receipt.Status switch {
                                "Draft"     => "secondary",
                                "Submitted" => "warning text-dark",
                                "Approved"  => "info text-dark",
                                "Paid"      => "success",
                                _           => "secondary"
                            };
                            <tr>
                                <td><a asp-action="ReceiptDetail" asp-route-id="@receipt.Id">#@receipt.Id</a></td>
                                <td>@receipt.PeriodStart.ToString("MMM d") – @receipt.PeriodEnd.ToString("MMM d, yyyy")</td>
                                <td class="text-end">@receipt.TotalHours.ToString("0.##")</td>
                                <td class="text-end">@receipt.TotalBillableHours.ToString("0.##")</td>
                                <td class="text-end fw-semibold">$@receipt.TotalAmount.ToString("N2")</td>
                                <td><span class="badge bg-@badgeClass">@receipt.Status</span></td>
                                <td class="small text-muted">@(receipt.SubmittedDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                <td>
                                    <a asp-action="ReceiptDetail" asp-route-id="@receipt.Id"
                                       class="btn btn-sm btn-outline-primary me-1" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (receipt.Status == "Draft")
                                    {
                                        <form asp-action="SubmitReceipt" asp-route-id="@receipt.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Submit">
                                                <i class="fas fa-paper-plane"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteReceipt" asp-route-id="@receipt.Id" method="post" class="d-inline"
                                              data-confirm-title="Delete Draft Receipt"
                                              data-confirm-message="Delete this draft receipt? The time entries will be released.">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelector('a[href*="NewReceipt"]')?.addEventListener('click', function (e) {
            var panel = document.getElementById('newReceiptPanel');
            if (panel) {
                e.preventDefault();
                panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
            }
        });

        // Set default date range to current month
        (function () {
            var now = new Date();
            var y = now.getFullYear(), m = now.getMonth();
            var start = new Date(y, m, 1);
            var end   = new Date(y, m + 1, 0);
            var fmt = d => d.toISOString().split('T')[0];
            var s = document.querySelector('input[name="periodStart"]');
            var e = document.querySelector('input[name="periodEnd"]');
            if (s) s.value = fmt(start);
            if (e) e.value = fmt(end);
        })();
    </script>
}
