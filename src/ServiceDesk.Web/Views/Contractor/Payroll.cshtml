@model IEnumerable<ServiceDesk.Core.Models.PayrollReceipt>
@using ServiceDesk.Core.Models
@{
    var contractor       = ViewBag.Contractor as Employee;
    var unclaimed        = ViewBag.UnclaimedEntries as List<TicketTimeEntry> ?? new();
    var unclaimedBillHrs = (decimal)(ViewBag.UnclaimedBillableHrs ?? 0m);
    var unclaimedAmt     = (decimal)(ViewBag.UnclaimedAmount ?? 0m);
    var unclaimedTotal   = unclaimed.Sum(e => e.Hours);
    var earliestDate     = unclaimed.Count > 0 ? unclaimed.Min(e => e.WorkDate) : (DateTime?)null;
    var hasOutstanding   = unclaimedBillHrs > 0;
    // Hoisted out of the unclaimed-entries @{ } block so the Edit modal at
    // the bottom of the file can read it. The modal is in a separate scope
    // from the table loop and can't see locals declared there.
    var hasEmergencyRate = (contractor?.EmergencyHourlyRate ?? 0m) > 0;
}

@section Styles {
<style>
    /* ── Shared palette (mirrors ReceiptDetail) ── */
    :root {
        --pay-navy:   #1a3a5c;
        --pay-blue:   #0d6efd;
        --pay-green:  #198754;
        --pay-amber:  #fd7e14;
        --pay-muted:  #6c757d;
        --pay-border: #dee2e6;
        --pay-bg:     #f8f9fb;
    }

    /* Page header */
    .pay-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        gap: 16px;
    }
    .pay-page-title   { font-size: 1.45rem; font-weight: 700; color: var(--pay-navy); margin: 0; }
    .pay-page-sub     { font-size: .85rem; color: var(--pay-muted); margin: 2px 0 0; }

    /* Card shell (matches invoice-card) */
    .pay-card {
        background: #fff;
        border: 1px solid var(--pay-border);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        margin-bottom: 20px;
    }
    .pay-card-accent {
        height: 5px;
        background: linear-gradient(90deg, var(--pay-navy) 0%, var(--pay-blue) 100%);
    }
    .pay-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        border-bottom: 1px solid var(--pay-border);
        background: var(--pay-bg);
    }
    .pay-card-header-title {
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--pay-navy);
        display: flex;
        align-items: center;
        gap: 7px;
    }
    .pay-card-body { padding: 20px; }

    /* KPI tiles */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }
    .kpi-tile {
        border-radius: 8px;
        padding: 18px 20px;
        text-align: center;
        border: 1px solid transparent;
        transition: transform .15s;
    }
    .kpi-tile:hover { transform: translateY(-2px); }
    .kpi-label {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }
    .kpi-value { font-size: 1.9rem; font-weight: 700; line-height: 1; }
    .kpi-sub   { font-size: .72rem; margin-top: 5px; }

    .kpi-neutral { background: #f1f3f5; border-color: #dee2e6; }
    .kpi-neutral .kpi-label { color: var(--pay-muted); }
    .kpi-neutral .kpi-value { color: #343a40; }
    .kpi-neutral .kpi-sub   { color: var(--pay-muted); }

    .kpi-blue { background: #e8f0fe; border-color: #b6cfff; }
    .kpi-blue .kpi-label { color: #0a58ca; }
    .kpi-blue .kpi-value { color: #084298; }
    .kpi-blue .kpi-sub   { color: #0a58ca; }

    .kpi-green { background: #d1e7dd; border-color: #a3cfbb; }
    .kpi-green .kpi-label { color: #0a5c36; }
    .kpi-green .kpi-value { color: #0a5c36; }
    .kpi-green .kpi-sub   { color: #146c43; }

    .kpi-navy { background: var(--pay-navy); border-color: var(--pay-navy); }
    .kpi-navy .kpi-label { color: #a8c4e0; }
    .kpi-navy .kpi-value { color: #fff; }
    .kpi-navy .kpi-sub   { color: #7fb3d3; }

    .kpi-amber { background: #fff3e0; border-color: #ffcc80; }
    .kpi-amber .kpi-label { color: #b45309; }
    .kpi-amber .kpi-value { color: #92400e; }
    .kpi-amber .kpi-sub   { color: #b45309; }

    /* Status pills */
    .status-pill-sm {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 50px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .04em;
        color: #fff;
    }
    .sp-draft     { background: var(--pay-muted); }
    .sp-submitted { background: var(--pay-amber); color: #fff; }
    .sp-approved  { background: var(--pay-blue); }
    .sp-paid      { background: var(--pay-green); }

    /* Tables */
    .pay-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
    .pay-table thead tr { background: var(--pay-navy); color: #fff; }
    .pay-table thead th {
        padding: 10px 14px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
    }
    .pay-table tbody tr { border-bottom: 1px solid #f0f0f0; }
    .pay-table tbody tr:nth-child(even) { background: #f8f9fb; }
    .pay-table tbody tr:hover { background: #eef4ff; }
    .pay-table tbody td { padding: 11px 14px; color: #212529; vertical-align: middle; }
    .pay-table tfoot tr { background: #eef4ff; border-top: 2px solid var(--pay-navy); }
    .pay-table tfoot td { padding: 11px 14px; font-weight: 700; color: var(--pay-navy); }

    .badge-bill-yes { background: #d1e7dd; color: #0a5c36; padding: 3px 10px; border-radius: 50px; font-size: .7rem; font-weight: 700; }
    .badge-bill-no  { background: #e9ecef; color: #6c757d; padding: 3px 10px; border-radius: 50px; font-size: .7rem; font-weight: 700; }

    /* Action buttons */
    .pay-btn-icon {
        width: 30px; height: 30px;
        border-radius: 6px;
        border: 1px solid var(--pay-border);
        background: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        color: var(--pay-muted);
        text-decoration: none;
        transition: all .15s;
    }
    .pay-btn-icon:hover { border-color: var(--pay-blue); color: var(--pay-blue); background: #eef4ff; }
    .pay-btn-icon.danger:hover { border-color: #dc3545; color: #dc3545; background: #fff0f0; }
    .pay-btn-icon.success:hover { border-color: var(--pay-green); color: var(--pay-green); background: #f0faf4; }

    /* Empty state */
    .pay-empty {
        text-align: center;
        padding: 48px 24px;
    }
    .pay-empty-icon { font-size: 3rem; color: #dee2e6; margin-bottom: 12px; }
    .pay-empty-title { font-size: 1.1rem; font-weight: 600; color: #495057; margin-bottom: 6px; }
    .pay-empty-sub   { font-size: .88rem; color: var(--pay-muted); }

    @@media (max-width: 767px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
}

@* ── Page header ─────────────────────────────────────────────────────── *@
<div class="pay-page-header">
    <div>
        <h1 class="pay-page-title"><i class="bi bi-file-invoice-fill me-2" style="color:var(--pay-blue);"></i>My Payroll</h1>
        <p class="pay-page-sub">
            Track billable hours and generate invoices ·
            <strong>Standard: $@(contractor?.HourlyRate?.ToString("N2") ?? "—")/hr</strong>
            @if (contractor?.EmergencyHourlyRate.HasValue == true)
            {
                <text> · <strong class="text-danger">Emergency: $@contractor.EmergencyHourlyRate.Value.ToString("N2")/hr</strong></text>
            }
            @if (contractor?.MonthlyRetainerAmount.HasValue == true)
            {
                <text> · <strong>Retainer: $@contractor.MonthlyRetainerAmount.Value.ToString("N2")/mo</strong>
                    <span class="text-muted">(covers up to @((contractor.MonthlyRetainerHoursIncluded ?? 0m).ToString("0.##")) h)</span></text>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Analytics" class="btn btn-outline-primary">
            <i class="bi bi-graph-up-arrow me-1"></i>Analytics
        </a>
        <a asp-action="NewReceipt" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Receipt
        </a>
    </div>
</div>

@* ── Year-to-Date Summary card ────────────────────────────────────────── *@
@{
    var ytdYear        = (int)(ViewBag.YtdYear ?? DateTime.UtcNow.Year);
    var ytdPaidAmt     = (decimal)(ViewBag.YtdPaidAmount ?? 0m);
    var ytdPaidHrs     = (decimal)(ViewBag.YtdPaidHours ?? 0m);
    var ytdPendingAmt  = (decimal)(ViewBag.YtdPendingAmount ?? 0m);
    var ytdPendingHrs  = (decimal)(ViewBag.YtdPendingHours ?? 0m);
    var ytdReceiptCnt  = (int)(ViewBag.YtdReceiptCount ?? 0);
    var ytdHasPaid     = ytdPaidAmt > 0;
    var ytdHasPending  = ytdPendingAmt > 0;
}
<div class="pay-card">
    <div class="pay-card-accent"></div>
    <div class="pay-card-header">
        <span class="pay-card-header-title">
            <i class="bi bi-calendar3" style="color:var(--pay-blue);"></i>
            @ytdYear Year-to-Date Summary
        </span>
        <span class="text-muted small">@ytdReceiptCnt receipt@(ytdReceiptCnt == 1 ? "" : "s")</span>
    </div>
    <div class="pay-card-body">
        <div class="kpi-grid">
            <div class="kpi-tile @(ytdHasPaid ? "kpi-green" : "kpi-neutral")">
                <div class="kpi-label">Paid YTD</div>
                <div class="kpi-value" style="font-size:1.55rem;">$@ytdPaidAmt.ToString("N2")</div>
                <div class="kpi-sub">@ytdPaidHrs.ToString("0.##") hours</div>
            </div>
            <div class="kpi-tile @(ytdHasPending ? "kpi-amber" : "kpi-neutral")">
                <div class="kpi-label">Pending</div>
                <div class="kpi-value" style="font-size:1.55rem;">$@ytdPendingAmt.ToString("N2")</div>
                <div class="kpi-sub">submitted + approved</div>
            </div>
            <div class="kpi-tile kpi-blue">
                <div class="kpi-label">Total Hours YTD</div>
                <div class="kpi-value">@((ytdPaidHrs + ytdPendingHrs).ToString("0.##"))</div>
                <div class="kpi-sub">paid + pending</div>
            </div>
            <div class="kpi-tile kpi-navy">
                <div class="kpi-label">Gross YTD</div>
                <div class="kpi-value" style="font-size:1.55rem;">$@((ytdPaidAmt + ytdPendingAmt).ToString("N2"))</div>
                <div class="kpi-sub">all non-draft receipts</div>
            </div>
        </div>
    </div>
</div>

@* ── Outstanding Hours KPI card ──────────────────────────────────────── *@
<div class="pay-card">
    <div class="pay-card-accent"></div>
    <div class="pay-card-header">
        <span class="pay-card-header-title">
            <i class="bi bi-hourglass-split" style="color:@(hasOutstanding ? "#fd7e14" : "#198754");"></i>
            Outstanding Billable Hours
        </span>
        @if (unclaimed.Count > 0)
        {
            <button class="btn btn-sm" style="border:1px solid var(--pay-navy);color:var(--pay-navy);background:#fff;font-size:.78rem;"
                    type="button" data-bs-toggle="collapse" data-bs-target="#unclaimedEntries">
                <i class="bi bi-list-ul me-1"></i>View @unclaimed.Count @(unclaimed.Count == 1 ? "Entry" : "Entries")
            </button>
        }
    </div>
    <div class="pay-card-body">
        <div class="kpi-grid">
            <div class="kpi-tile @(hasOutstanding ? "kpi-amber" : "kpi-neutral")">
                <div class="kpi-label">Billable Hrs Unpaid</div>
                <div class="kpi-value">@unclaimedBillHrs.ToString("0.##")</div>
                <div class="kpi-sub">hours</div>
            </div>
            <div class="kpi-tile @(hasOutstanding ? "kpi-navy" : "kpi-neutral")">
                <div class="kpi-label">Estimated Amount</div>
                <div class="kpi-value" style="font-size:1.5rem;">$@unclaimedAmt.ToString("N2")</div>
                <div class="kpi-sub">
                    @if (contractor?.EmergencyHourlyRate.HasValue == true)
                    { <text>per-entry rate (retainer not yet applied)</text> }
                    else
                    { <text>at $@(contractor?.HourlyRate?.ToString("N2") ?? "—")/hr</text> }
                </div>
            </div>
            <div class="kpi-tile kpi-neutral">
                <div class="kpi-label">Total Hrs Logged</div>
                <div class="kpi-value">@unclaimedTotal.ToString("0.##")</div>
                <div class="kpi-sub">billable + non-billable</div>
            </div>
            <div class="kpi-tile @(earliestDate.HasValue ? "kpi-blue" : "kpi-neutral")">
                <div class="kpi-label">Earliest Unclaimed</div>
                <div class="kpi-value" style="font-size:1.35rem;">
                    @(earliestDate.HasValue ? earliestDate.Value.ToString("MMM d") : "—")
                </div>
                <div class="kpi-sub">@(earliestDate.HasValue ? earliestDate.Value.ToString("yyyy") : "nothing pending")</div>
            </div>
        </div>

        @if (!hasOutstanding)
        {
            <div style="text-align:center;padding:8px 0 4px;color:var(--pay-green);font-size:.9rem;font-weight:600;">
                <i class="bi bi-check-circle-fill me-1"></i>
                All logged hours have been claimed in a receipt. Nothing outstanding.
            </div>
        }
        else
        {
            <div style="text-align:center;margin-top:4px;">
                <a asp-action="NewReceipt" class="btn btn-sm" style="background:var(--pay-navy);color:#fff;">
                    <i class="bi bi-file-invoice-fill me-1"></i>Generate Receipt for These Hours
                </a>
            </div>
        }
    </div>
</div>

@* ── Unclaimed entries detail table ─────────────────────────────────── *@
@if (unclaimed.Count > 0)
{
    <div class="collapse mb-4" id="unclaimedEntries">
        <div class="pay-card">
            <div class="pay-card-accent"></div>
            <div class="pay-card-header">
                <span class="pay-card-header-title">
                    <i class="bi bi-clock-history" style="color:var(--pay-blue);"></i>
                    Unclaimed Time Entries
                </span>
                <span style="font-size:.78rem;color:var(--pay-muted);">@unclaimed.Count @(unclaimed.Count == 1 ? "entry" : "entries") · $@unclaimedAmt.ToString("N2") billable</span>
            </div>
            <div class="table-responsive">
                <table class="pay-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Ticket</th>
                            <th>Description</th>
                            <th class="text-center">Hours</th>
                            <th class="text-center">Rate Type</th>
                            <th class="text-center">Billable</th>
                            <th class="text-end">Est. Amount</th>
                            <th class="text-center no-export">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var emerRateDash = contractor?.EmergencyHourlyRate ?? 0m;
                            var stdRateDash  = contractor?.HourlyRate ?? 0m;
                        }
                        @foreach (var entry in unclaimed)
                        {
                            var isEmerDash = entry.RateType == ServiceDesk.Core.Enums.PayRateType.Emergency;
                            var rateDash   = isEmerDash ? emerRateDash : stdRateDash;
                            var entryAmt   = entry.IsBillable ? entry.Hours * rateDash : 0;
                            var escDesc    = (entry.Description ?? "").Replace("\\", "\\\\").Replace("'", "\\'").Replace("\r", "").Replace("\n", "\\n");
                            <tr>
                                <td class="text-nowrap">@entry.WorkDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    @if (entry.Ticket != null)
                                    {
                                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@entry.TicketId"
                                           class="fw-semibold text-decoration-none" style="color:var(--pay-blue);">#@entry.TicketId</a>
                                        <span class="text-muted small ms-1">@entry.Ticket.Title</span>
                                    }
                                    else
                                    { <span class="text-muted">#@entry.TicketId</span> }
                                </td>
                                <td class="text-muted small">
                                    @(entry.Description ?? "—")
                                    @if (entry.ModificationCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark ms-1" style="font-size:.6rem;cursor:help;"
                                              data-bs-toggle="tooltip"
                                              title="Last edited @entry.ModifiedDate?.ToString("MMM d, yyyy h:mm tt") · @entry.ModificationReason">edited</span>
                                    }
                                </td>
                                <td class="text-center fw-semibold">@entry.Hours.ToString("0.##")</td>
                                <td class="text-center">
                                    @if (isEmerDash)
                                    { <span class="badge bg-danger">Emergency</span> }
                                    else
                                    { <span class="badge bg-secondary">Standard</span> }
                                </td>
                                <td class="text-center">
                                    @if (entry.IsBillable)
                                    { <span class="badge-bill-yes">Billable</span> }
                                    else
                                    { <span class="badge-bill-no">Non-billable</span> }
                                </td>
                                <td class="text-end fw-semibold">
                                    @(entry.IsBillable ? "$" + entryAmt.ToString("N2") : "—")
                                </td>
                                <td class="text-center text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit entry"
                                            onclick="openEditEntryModal(@entry.Id, @entry.Hours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture), '@escDesc', @(entry.IsBillable ? "true" : "false"), @(isEmerDash ? "true" : "false"))">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="DeleteUnclaimedEntry" method="post" class="d-inline ms-1"
                                          onsubmit="return confirm('Delete this time entry from Ticket #@entry.TicketId?\\nThis cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="entryId" value="@entry.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete entry">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">TOTAL</td>
                            <td class="text-center">@unclaimedTotal.ToString("0.##")</td>
                            <td></td>
                            <td class="text-end">$@unclaimedAmt.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

@* ── Receipts list ───────────────────────────────────────────────────── *@
<div class="pay-card">
    <div class="pay-card-accent"></div>
    <div class="pay-card-header">
        <span class="pay-card-header-title">
            <i class="bi bi-collection" style="color:var(--pay-blue);"></i>
            Payroll Receipts
        </span>
        @if (Model.Any())
        {
            <span style="font-size:.78rem;color:var(--pay-muted);">@Model.Count() @(Model.Count() == 1 ? "receipt" : "receipts")</span>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="pay-empty">
            <div class="pay-empty-icon"><i class="bi bi-file-earmark-text"></i></div>
            <div class="pay-empty-title">No receipts yet</div>
            <div class="pay-empty-sub mb-3">Log billable time on your tickets, then click <strong>New Receipt</strong> to generate your first invoice.</div>
            <a asp-action="NewReceipt" class="btn btn-sm" style="background:var(--pay-navy);color:#fff;">
                <i class="bi bi-plus-lg me-1"></i>Create First Receipt
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pay-table">
                <thead>
                    <tr>
                        <th style="width:60px;">Receipt</th>
                        <th>Period</th>
                        <th class="text-center">Total Hrs</th>
                        <th class="text-center">Billable Hrs</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th style="width:100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var receipt in Model)
                    {
                        var pillClass = receipt.Status switch {
                            "Draft"     => "sp-draft",
                            "Submitted" => "sp-submitted",
                            "Approved"  => "sp-approved",
                            "Paid"      => "sp-paid",
                            _           => "sp-draft"
                        };
                        <tr>
                            <td>
                                <a asp-action="ReceiptDetail" asp-route-id="@receipt.Id"
                                   class="fw-bold text-decoration-none" style="color:var(--pay-blue);">#@receipt.Id</a>
                            </td>
                            <td class="text-nowrap">
                                @receipt.PeriodStart.ToString("MMM d") – @receipt.PeriodEnd.ToString("MMM d, yyyy")
                            </td>
                            <td class="text-center">@receipt.TotalHours.ToString("0.##")</td>
                            <td class="text-center fw-semibold" style="color:var(--pay-navy);">@receipt.TotalBillableHours.ToString("0.##")</td>
                            <td class="text-end fw-bold" style="color:var(--pay-navy);">$@receipt.TotalAmount.ToString("N2")</td>
                            <td><span class="status-pill-sm @pillClass">@receipt.Status</span></td>
                            <td class="small text-muted">@(receipt.SubmittedDate?.ToString("MMM d, yyyy") ?? "—")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="ReceiptDetail" asp-route-id="@receipt.Id"
                                       class="pay-btn-icon" title="View Receipt">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (receipt.Status == "Draft")
                                    {
                                        <form asp-action="SubmitReceipt" asp-route-id="@receipt.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="pay-btn-icon success" title="Submit to HR">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteReceipt" asp-route-id="@receipt.Id" method="post" class="d-inline"
                                              data-confirm-title="Delete Draft Receipt"
                                              data-confirm-message="Delete this draft receipt? The time entries will be released.">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="pay-btn-icon danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Edit Unclaimed Entry Modal ──────────────────────────────────────── *@
<div class="modal fade" id="editEntryModal" tabindex="-1" aria-labelledby="editEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:var(--pay-blue);color:#fff;">
                <h5 class="modal-title" id="editEntryModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Edit Time Entry
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditUnclaimedEntry" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="entryId" id="editEntryId" />
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Correct any of the fields below. The change is recorded with your email,
                        a timestamp, and your reason so payroll can audit the edit.
                    </p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Hours</label>
                            <input type="number" name="hours" id="editEntryHours"
                                   step="0.25" min="0.25" max="999"
                                   class="form-control" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Description</label>
                            <input type="text" name="description" id="editEntryDescription"
                                   class="form-control" maxlength="1000" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="isBillable" value="true" id="editEntryBillable" />
                                <label class="form-check-label" for="editEntryBillable">Billable</label>
                            </div>
                        </div>
                        @if (hasEmergencyRate)
                        {
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="isEmergency" value="true" id="editEntryEmergency" />
                                    <label class="form-check-label text-danger" for="editEntryEmergency">
                                        Emergency rate
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Reason for edit <span class="text-danger">*</span></label>
                        <input type="text" name="modificationReason" class="form-control"
                               maxlength="500" required
                               placeholder="e.g. Should have been Emergency — Saturday work" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Bootstrap tooltips for "edited" pills
    document.addEventListener('DOMContentLoaded', function () {
        var els = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        els.forEach(function (el) { try { new bootstrap.Tooltip(el); } catch (e) {} });
    });

    // Pre-fill and open the edit modal from a row's pencil button
    function openEditEntryModal(id, hours, desc, billable, isEmergency) {
        document.getElementById('editEntryId').value          = id;
        document.getElementById('editEntryHours').value       = hours;
        document.getElementById('editEntryDescription').value = desc;
        document.getElementById('editEntryBillable').checked  = !!billable;
        var emerEl = document.getElementById('editEntryEmergency');
        if (emerEl) emerEl.checked = !!isEmergency;
        var modal = new bootstrap.Modal(document.getElementById('editEntryModal'));
        modal.show();
    }
</script>
}
