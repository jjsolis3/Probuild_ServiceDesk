@model IEnumerable<ServiceDesk.Core.Models.Ticket>
@{
    var contractor = ViewBag.Contractor as ServiceDesk.Core.Models.Employee;
}

<div class="row page-titles">
    <div class="col-sm-6">
        <h4>My Projects</h4>
        <p class="text-muted mb-0">Tickets assigned to you as a contractor</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No tickets are currently assigned to you. Contact your administrator if you expect to see projects here.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var ticket in Model)
        {
            var totalHours    = ticket.TimeEntries.Sum(e => e.Hours);
            var billableHours = ticket.TimeEntries.Where(e => e.IsBillable).Sum(e => e.Hours);
            var stateBadge = ticket.Status switch {
                ServiceDesk.Core.Enums.TicketStatus.Open       => "primary",
                ServiceDesk.Core.Enums.TicketStatus.InProgress => "warning",
                ServiceDesk.Core.Enums.TicketStatus.OnHold     => "secondary",
                ServiceDesk.Core.Enums.TicketStatus.Resolved   => "success",
                ServiceDesk.Core.Enums.TicketStatus.Closed     => "dark",
                ServiceDesk.Core.Enums.TicketStatus.Cancelled  => "danger",
                _                                              => "secondary"
            };
            var stateName = ticket.Status.ToString();

            <div class="col-md-6 col-xl-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                        <span class="fw-semibold text-truncate" style="max-width:200px;" title="@ticket.Title">
                            <i class="fas fa-ticket-alt me-1 text-primary"></i>#@ticket.Id — @ticket.Title
                        </span>
                        <span class="badge bg-@stateBadge">@stateName</span>
                    </div>
                    <div class="card-body py-2">
                        <div class="small text-muted mb-2">
                            <i class="fas fa-calendar-alt me-1"></i>Opened @ticket.CreatedDate.ToString("MMM d, yyyy")
                        </div>
                        <div class="row text-center g-2">
                            <div class="col-6">
                                <div class="bg-light rounded p-2">
                                    <div class="fw-bold fs-5">@totalHours.ToString("0.##")</div>
                                    <div class="small text-muted">Total Hrs</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light rounded p-2">
                                    <div class="fw-bold fs-5 text-success">@billableHours.ToString("0.##")</div>
                                    <div class="small text-muted">Billable Hrs</div>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ticket.Description))
                        {
                            <p class="small text-muted mt-2 mb-0" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @ticket.Description
                            </p>
                        }
                    </div>
                    <div class="card-footer py-2">
                        <a asp-controller="Tickets" asp-action="Edit" asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-primary w-100">
                            <i class="fas fa-clock me-1"></i>View &amp; Log Time
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
