@model ServiceDesk.Core.Models.ConsumableItem

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label fw-semibold"></label>
        <input asp-for="Name" class="form-control" placeholder="e.g. Toner Cartridge HP 58A" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Category" class="form-label fw-semibold"></label>
        <input asp-for="Category" class="form-control" placeholder="e.g. Printer Supplies" />
    </div>
    <div class="col-md-6">
        <label asp-for="Manufacturer" class="form-label fw-semibold"></label>
        <input asp-for="Manufacturer" class="form-control" placeholder="e.g. HP" />
    </div>
    <div class="col-md-6">
        <label asp-for="PartNumber" class="form-label fw-semibold"></label>
        <input asp-for="PartNumber" class="form-control font-monospace" placeholder="SKU / part number" />
    </div>
    <div class="col-md-4">
        <label asp-for="QuantityOnHand" class="form-label fw-semibold"></label>
        <input asp-for="QuantityOnHand" class="form-control" type="number" min="0" />
    </div>
    <div class="col-md-4">
        <label asp-for="ReorderPoint" class="form-label fw-semibold"></label>
        <input asp-for="ReorderPoint" class="form-control" type="number" min="0" />
        <div class="form-text">Alert when stock falls to or below this level.</div>
    </div>
    <div class="col-md-4">
        <label asp-for="UnitCost" class="form-label fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="UnitCost" class="form-control" type="number" step="0.01" min="0" />
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label fw-semibold"></label>
        <textarea asp-for="Notes" class="form-control" rows="2" maxlength="500"></textarea>
    </div>
</div>
