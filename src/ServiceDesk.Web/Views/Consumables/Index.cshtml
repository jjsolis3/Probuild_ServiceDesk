@model IEnumerable<ServiceDesk.Core.Models.ConsumableItem>
@{
    ViewData["Title"] = "Consumables";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-stack"></i> Consumables</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>New Item
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-primary">@ViewBag.TotalItems</div>
                <div class="small text-muted">Total Items</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm @(((int)ViewBag.LowStockCount) > 0 ? "border-warning" : "")">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold @(((int)ViewBag.LowStockCount) > 0 ? "text-warning" : "")">@ViewBag.LowStockCount</div>
                <div class="small text-muted">Low Stock</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="card text-center shadow-sm">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-success">@(((decimal)ViewBag.TotalValue).ToString("C0"))</div>
                <div class="small text-muted">Estimated Inventory Value</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="d-flex gap-2 mb-3 flex-wrap">
    <div class="input-group input-group-sm" style="max-width:260px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="cQ" class="form-control" placeholder="Search..." value="@ViewBag.Query">
        <button type="button" class="btn btn-outline-primary" onclick="applyFilters()">Search</button>
    </div>
    <a asp-action="Index" asp-route-lowStock="true" class="btn btn-sm @(ViewBag.LowStock == true ? "btn-warning" : "btn-outline-warning")">
        <i class="bi bi-exclamation-triangle me-1"></i>Low Stock
    </a>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-x me-1"></i>Clear
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Manufacturer</th>
                <th>Part #</th>
                <th>On Hand</th>
                <th>Reorder At</th>
                <th>Unit Cost</th>
                <th>Stock Value</th>
                <th class="no-sort">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.IsLowStock ? "table-warning" : "")">
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold">@item.Name</a>
                    </td>
                    <td>@(item.Category ?? "—")</td>
                    <td>@(item.Manufacturer ?? "—")</td>
                    <td class="font-monospace small">@(item.PartNumber ?? "—")</td>
                    <td>
                        <span class="fw-semibold @(item.IsLowStock ? "text-warning" : item.QuantityOnHand == 0 ? "text-danger" : "")">
                            @item.QuantityOnHand
                            @if (item.IsLowStock) { <i class="bi bi-exclamation-triangle-fill ms-1 text-warning"></i> }
                        </span>
                    </td>
                    <td class="text-muted">@item.ReorderPoint</td>
                    <td>@(item.UnitCost?.ToString("C") ?? "—")</td>
                    <td>@(item.UnitCost.HasValue ? (item.UnitCost.Value * item.QuantityOnHand).ToString("C") : "—")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-box-arrow-in-down"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this item?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-stack display-1 opacity-25"></i>
        <p class="mt-3">No consumable items found.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Item</a>
    </div>
}

@section Scripts {
<script>
function applyFilters() {
    const q = document.getElementById('cQ').value.trim();
    const url = new URL(window.location.href);
    if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
    url.searchParams.delete('lowStock');
    window.location.href = url.toString();
}
document.getElementById('cQ')?.addEventListener('keydown', e => { if (e.key === 'Enter') applyFilters(); });
</script>
}
