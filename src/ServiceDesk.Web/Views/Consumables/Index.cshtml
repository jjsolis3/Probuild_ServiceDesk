@model IEnumerable<ServiceDesk.Core.Models.ConsumableItem>
@{
    ViewData["Title"] = "Consumables";
    var totalItems    = (int)(ViewBag.TotalItems    ?? 0);
    var lowStockCount = (int)(ViewBag.LowStockCount ?? 0);
    var totalValue    = (decimal)(ViewBag.TotalValue ?? 0m);
    var inStockCount  = totalItems - lowStockCount;
}

@section Styles {
<style>
    :root {
        --con-navy:   #1a3a5c;
        --con-blue:   #0d6efd;
        --con-green:  #198754;
        --con-amber:  #f59e0b;
        --con-red:    #ef4444;
        --con-muted:  #6c757d;
        --con-border: #dee2e6;
        --con-bg:     #f8f9fb;
    }
    .con-kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:18px; }
    .con-kpi { background:#fff; border:1px solid var(--con-border); border-radius:8px; padding:16px 20px;
               box-shadow:0 2px 8px rgba(0,0,0,.05); position:relative; overflow:hidden;
               transition:transform .15s,box-shadow .15s; }
    .con-kpi:hover { transform:translateY(-2px); box-shadow:0 6px 18px rgba(0,0,0,.09); }
    .con-kpi-bar { position:absolute;top:0;left:0;right:0;height:4px;border-radius:8px 8px 0 0; }
    .con-kpi-label { font-size:.68rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
                     color:var(--con-muted);margin:4px 0 6px; }
    .con-kpi-value { font-size:1.8rem;font-weight:700;line-height:1;color:var(--con-navy); }

    .con-card { background:#fff;border:1px solid var(--con-border);border-radius:8px;
                box-shadow:0 2px 10px rgba(0,0,0,.06);overflow:hidden;margin-bottom:18px; }
    .con-card-accent { height:5px;background:linear-gradient(90deg,var(--con-navy),var(--con-blue)); }
    .con-card-body { padding:14px 18px; }

    .con-table { width:100%;border-collapse:collapse;font-size:.875rem; }
    .con-table thead tr { background:var(--con-navy) !important; }
    .con-table thead th,
    table.con-table.dataTable thead th,
    table.con-table.dataTable thead td { padding:10px 14px;font-size:.7rem;font-weight:700;
                          letter-spacing:.07em;text-transform:uppercase;white-space:nowrap;
                          color:#fff !important;background:var(--con-navy) !important;
                          border-bottom:none !important; }
    .con-table tbody tr { border-bottom:1px solid #f0f0f0; }
    .con-table tbody tr:nth-child(even) { background:#f8f9fb; }
    .con-table tbody tr:hover { background:#eef4ff; }
    .con-table tbody tr.low-stock { background:#fff8e1; }
    .con-table tbody tr.low-stock:hover { background:#fff3cd; }
    .con-table tbody td { padding:10px 14px;color:#212529;vertical-align:middle; }

    .cp { display:inline-block;padding:2px 10px;border-radius:50px;font-size:.7rem;
          font-weight:700;letter-spacing:.04em;white-space:nowrap; }
    .cp-ok       { background:#d1e7dd;color:#0a5c36;border:1px solid #a3cfbb; }
    .cp-low      { background:#fff3cd;color:#856404;border:1px solid #ffc107; }
    .cp-out      { background:#f8d7da;color:#842029;border:1px solid #f1aeb5; }

    @@media(max-width:991px) { .con-kpi-grid { grid-template-columns:1fr 1fr; } }
    @@media(max-width:575px) { .con-kpi-grid { grid-template-columns:1fr; } }
</style>
}

@* ── Header ──────────────────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0" style="font-size:1.4rem;font-weight:700;color:var(--con-navy);">
            <i class="bi bi-stack me-2" style="color:var(--con-blue);"></i>Consumables
        </h1>
        <p class="text-muted mb-0" style="font-size:.85rem;">@Model.Count() item@(Model.Count() == 1 ? "" : "s") shown</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>New Item
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-3">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── KPI tiles ────────────────────────────────────────────────────────────── *@
<div class="con-kpi-grid">
    <div class="con-kpi">
        <div class="con-kpi-bar" style="background:var(--con-navy);"></div>
        <div class="con-kpi-label">Total Items</div>
        <div class="con-kpi-value">@totalItems</div>
        <div style="font-size:.78rem;color:var(--con-muted);margin-top:3px;">in catalog</div>
    </div>
    <div class="con-kpi">
        <div class="con-kpi-bar" style="background:var(--con-green);"></div>
        <div class="con-kpi-label">In Stock</div>
        <div class="con-kpi-value" style="color:var(--con-green);">@inStockCount</div>
        <div style="font-size:.78rem;color:var(--con-green);margin-top:3px;">above reorder</div>
    </div>
    <div class="con-kpi">
        <div class="con-kpi-bar" style="background:var(--con-amber);"></div>
        <div class="con-kpi-label">Low Stock</div>
        <div class="con-kpi-value" style="color:@(lowStockCount > 0 ? "var(--con-amber)" : "var(--con-navy)");">@lowStockCount</div>
        <div style="font-size:.78rem;color:var(--con-amber);margin-top:3px;">need reorder</div>
    </div>
    <div class="con-kpi">
        <div class="con-kpi-bar" style="background:var(--con-blue);"></div>
        <div class="con-kpi-label">Inventory Value</div>
        <div class="con-kpi-value" style="color:var(--con-blue);font-size:1.4rem;">@totalValue.ToString("C0")</div>
        <div style="font-size:.78rem;color:var(--con-muted);margin-top:3px;">estimated</div>
    </div>
</div>

@* ── Filters ─────────────────────────────────────────────────────────────── *@
<div class="con-card">
    <div class="con-card-accent"></div>
    <div class="con-card-body">
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <div class="input-group input-group-sm" style="max-width:280px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="cQ" class="form-control" placeholder="Search items, parts, manufacturer..." value="@ViewBag.Query">
                <button type="button" class="btn btn-outline-primary" onclick="applyFilters()">Search</button>
            </div>
            <a asp-action="Index" asp-route-lowStock="true" class="btn btn-sm @(ViewBag.LowStock == true ? "btn-warning" : "btn-outline-warning")">
                <i class="bi bi-exclamation-triangle me-1"></i>Low Stock Only
            </a>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-auto">
                <i class="bi bi-x-circle me-1"></i>Clear
            </a>
        </div>
    </div>
</div>

@* ── Table ───────────────────────────────────────────────────────────────── *@
@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", new {
        Icon       = "bi-stack",
        Title      = "No consumables tracked yet",
        Message    = "Consumables are things like printer toner, batteries, or cables — items you reorder regularly. Add one to start tracking stock levels and reorder thresholds.",
        ActionLink = Url.Action("Create"),
        ActionText = "Add First Item",
        ActionIcon = "bi-plus-lg"
    })
}
else
{
    <div class="con-card">
        <div class="table-responsive">
            <table class="con-table ss-datatable" data-export-title="Consumables Inventory">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Manufacturer</th>
                        <th>Part #</th>
                        <th class="text-end">On Hand</th>
                        <th class="text-end">Reorder At</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Stock Value</th>
                        <th class="no-sort">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var stockPill  = item.QuantityOnHand == 0 ? "cp-out" : item.IsLowStock ? "cp-low" : "cp-ok";
                        var stockLabel = item.QuantityOnHand == 0 ? "Out" : item.IsLowStock ? "Low" : "OK";
                        <tr class="@(item.IsLowStock ? "low-stock" : "")">
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none" style="color:var(--con-navy);">@item.Name</a>
                            </td>
                            <td class="text-muted">@(item.Category ?? "—")</td>
                            <td>@(item.Manufacturer ?? "—")</td>
                            <td class="font-monospace small text-muted">@(item.PartNumber ?? "—")</td>
                            <td class="text-end">
                                <span class="cp @stockPill me-1">@stockLabel</span>
                                <span class="fw-semibold">@item.QuantityOnHand</span>
                            </td>
                            <td class="text-end text-muted">@item.ReorderPoint</td>
                            <td class="text-end">@(item.UnitCost?.ToString("C") ?? "—")</td>
                            <td class="text-end">@(item.UnitCost.HasValue ? (item.UnitCost.Value * item.QuantityOnHand).ToString("C") : "—")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Details">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this item?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
function applyFilters() {
    const q = document.getElementById('cQ').value.trim();
    const url = new URL(window.location.href);
    if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
    url.searchParams.delete('lowStock');
    window.location.href = url.toString();
}
document.getElementById('cQ')?.addEventListener('keydown', e => { if (e.key === 'Enter') applyFilters(); });
</script>
}
