@model Employee
@{
    ViewData["Title"] = Model.FullName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
        <li class="breadcrumb-item active">@Model.FullName</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>
        <i class="bi bi-person"></i> @Model.FullName
        @if (Model.IsActive)
        {
            <span class="badge bg-success fs-6">Active</span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">Inactive</span>
        }
    </h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Employee Details Card -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-person-badge"></i> Employee Details
            </div>
            <div class="card-body">
                <dl>
                    <dt>First Name</dt>
                    <dd>@Model.FirstName</dd>

                    <dt>Last Name</dt>
                    <dd>@Model.LastName</dd>

                    <dt>Email</dt>
                    <dd><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    <dt>Phone</dt>
                    <dd>@(Model.Phone ?? "N/A")</dd>

                    <dt>Department</dt>
                    <dd>@Model.Department</dd>

                    <dt>Job Title</dt>
                    <dd>@(Model.JobTitle ?? "N/A")</dd>

                    <dt>Hire Date</dt>
                    <dd>@Model.HireDate.ToString("MMM dd, yyyy")</dd>

                    <dt>Status</dt>
                    <dd>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Tickets & Assets -->
    <div class="col-md-8">
        <!-- Submitted Tickets -->
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-ticket-detailed"></i> Submitted Tickets
                <span class="badge bg-primary rounded-pill ms-1">@Model.SubmittedTickets.Count</span>
            </div>
            <div class="card-body">
                @if (Model.SubmittedTickets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.SubmittedTickets)
                                {
                                    <tr>
                                        <td>@ticket.Id</td>
                                        <td>
                                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                                @ticket.Title
                                            </a>
                                        </td>
                                        <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                        <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                                        <td>@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No submitted tickets.</p>
                }
            </div>
        </div>

        <!-- Assigned Tickets -->
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-clipboard-check"></i> Assigned Tickets
                <span class="badge bg-info rounded-pill ms-1">@Model.AssignedTickets.Count</span>
            </div>
            <div class="card-body">
                @if (Model.AssignedTickets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.AssignedTickets)
                                {
                                    <tr>
                                        <td>@ticket.Id</td>
                                        <td>
                                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                                @ticket.Title
                                            </a>
                                        </td>
                                        <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                        <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                                        <td>@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No assigned tickets.</p>
                }
            </div>
        </div>

        <!-- Assigned Assets -->
        <div class="card">
            <div class="card-header">
                <i class="bi bi-laptop"></i> Assigned Assets
                <span class="badge bg-warning text-dark rounded-pill ms-1">@Model.AssignedAssets.Count</span>
            </div>
            <div class="card-body">
                @if (Model.AssignedAssets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Asset Tag</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Serial Number</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asset in Model.AssignedAssets)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Assets" asp-action="Details" asp-route-id="@asset.Id">
                                                @asset.AssetTag
                                            </a>
                                        </td>
                                        <td>@asset.Name</td>
                                        <td>@asset.AssetType</td>
                                        <td><span class="badge badge-@asset.Status.ToString().ToLower()">@asset.Status</span></td>
                                        <td>@(asset.SerialNumber ?? "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No assets assigned.</p>
                }
            </div>
        </div>
    </div>
</div>
