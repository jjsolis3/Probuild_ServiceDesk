@model Employee
@using ServiceDesk.Core.Enums
@{
    ViewData["Title"] = Model.FullName;
    var categoryBreakdown = ViewBag.CategoryBreakdown as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var monthlyTrend      = ViewBag.MonthlyTrend      as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var recurringCategories = ViewBag.RecurringCategories as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    int totalSubmitted    = Model.SubmittedTickets.Count;
    int openCount         = Model.SubmittedTickets.Count(t => t.Status == TicketStatus.Open || t.Status == TicketStatus.InProgress);
    int resolvedCount     = Model.SubmittedTickets.Count(t => t.Status == TicketStatus.Resolved || t.Status == TicketStatus.Closed);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
        <li class="breadcrumb-item active">@Model.FullName</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>
        <i class="bi bi-person"></i> @Model.FullName
        @if (Model.IsActive)
        {
            <span class="badge bg-success fs-6">Active</span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">Inactive</span>
        }
    </h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Employee Details Card -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-person-badge"></i> Employee Details
            </div>
            <div class="card-body">
                <dl>
                    <dt>First Name</dt>
                    <dd>@Model.FirstName</dd>

                    <dt>Last Name</dt>
                    <dd>@Model.LastName</dd>

                    <dt>Email</dt>
                    <dd><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    <dt>Phone</dt>
                    <dd>@(Model.Phone ?? "N/A")</dd>

                    <dt>Department</dt>
                    <dd>@Model.Department</dd>

                    <dt>Job Title</dt>
                    <dd>@(Model.JobTitle ?? "N/A")</dd>

                    <dt>Hire Date</dt>
                    <dd>@Model.HireDate.ToString("MMM dd, yyyy")</dd>

                    <dt>Status</dt>
                    <dd>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Tickets, Assets & Trend Analytics -->
    <div class="col-md-8">

        <!-- Trend KPI row -->
        <div class="row g-3 mb-3">
            <div class="col-4">
                <div class="card text-center shadow-sm border-0 h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-bold text-primary">@totalSubmitted</div>
                        <div class="text-muted small">Total Tickets</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card text-center shadow-sm border-0 h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-bold text-warning">@openCount</div>
                        <div class="text-muted small">Open / In Progress</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card text-center shadow-sm border-0 h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-bold text-success">@resolvedCount</div>
                        <div class="text-muted small">Resolved / Closed</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Training hint banner -->
        @if (recurringCategories.Any())
        {
            <div class="alert alert-warning py-2 mb-3 small">
                <i class="bi bi-mortarboard me-2"></i>
                <strong>Training Opportunity:</strong>
                This employee has repeatedly submitted tickets in:
                @string.Join(", ", recurringCategories.Select(x => (string)x.CategoryName).ToArray()).
                Consider targeted training or knowledge base articles.
            </div>
        }

        <!-- Category Breakdown -->
        @if (categoryBreakdown.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header fw-semibold">
                    <i class="bi bi-bar-chart-line me-2"></i>Ticket Category Breakdown
                </div>
                <div class="card-body p-3">
                    @foreach (var cat in categoryBreakdown)
                    {
                        var pct = totalSubmitted > 0 ? (int)((double)cat.Count / totalSubmitted * 100) : 0;
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold">@cat.CategoryName</span>
                                <span class="small text-muted">@cat.Count ticket@(cat.Count == 1 ? "" : "s") (@pct%)</span>
                            </div>
                            <div class="progress" style="height:8px;">
                                <div class="progress-bar bg-primary" role="progressbar"
                                     style="width:@pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Monthly trend (last 6 months) -->
        @if (monthlyTrend.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header fw-semibold">
                    <i class="bi bi-graph-up me-2"></i>Monthly Submissions (Last 6 Months)
                </div>
                <div class="card-body p-3">
                    <div class="d-flex align-items-end gap-2" style="height:80px;">
                        @{
                            var maxMonthly = monthlyTrend.Any() ? (int)monthlyTrend.Max(x => (int)x.Count) : 1;
                            if (maxMonthly == 0) maxMonthly = 1;
                        }
                        @foreach (var m in monthlyTrend)
                        {
                            var barHeight = Math.Max(6, (int)((double)(int)m.Count / maxMonthly * 72));
                            <div class="flex-fill text-center">
                                <div class="bg-primary rounded-top mx-auto"
                                     style="height:@(barHeight)px;min-width:18px;" title="@m.Count tickets"></div>
                                <div class="text-muted" style="font-size:0.65rem;margin-top:2px;">@m.Label</div>
                                <div class="fw-semibold" style="font-size:0.7rem;">@m.Count</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Submitted Tickets -->
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-ticket-detailed"></i> Submitted Tickets
                <span class="badge bg-primary rounded-pill ms-1">@Model.SubmittedTickets.Count</span>
            </div>
            <div class="card-body">
                @if (Model.SubmittedTickets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 ss-datatable-compact">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.SubmittedTickets)
                                {
                                    <tr>
                                        <td>@ticket.Id</td>
                                        <td>
                                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                                @ticket.Title
                                            </a>
                                        </td>
                                        <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                        <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                                        <td>@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No submitted tickets.</p>
                }
            </div>
        </div>

        <!-- Assigned Tickets -->
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-clipboard-check"></i> Assigned Tickets
                <span class="badge bg-info rounded-pill ms-1">@Model.AssignedTickets.Count</span>
            </div>
            <div class="card-body">
                @if (Model.AssignedTickets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 ss-datatable-compact">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.AssignedTickets)
                                {
                                    <tr>
                                        <td>@ticket.Id</td>
                                        <td>
                                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                                @ticket.Title
                                            </a>
                                        </td>
                                        <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                        <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                                        <td>@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No assigned tickets.</p>
                }
            </div>
        </div>

        <!-- Assigned Assets -->
        <div class="card">
            <div class="card-header">
                <i class="bi bi-laptop"></i> Assigned Assets
                <span class="badge bg-warning text-dark rounded-pill ms-1">@Model.AssignedAssets.Count</span>
            </div>
            <div class="card-body">
                @if (Model.AssignedAssets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 ss-datatable-compact">
                            <thead>
                                <tr>
                                    <th>Asset Tag</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Serial Number</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asset in Model.AssignedAssets)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Assets" asp-action="Details" asp-route-id="@asset.Id">
                                                @asset.AssetTag
                                            </a>
                                        </td>
                                        <td>@asset.Name</td>
                                        <td>@asset.AssetType</td>
                                        <td><span class="badge badge-@asset.Status.ToString().ToLower()">@asset.Status</span></td>
                                        <td>@(asset.SerialNumber ?? "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No assets assigned.</p>
                }
            </div>
        </div>
    </div>
</div>
