@section Scripts {
<script>
(function () {
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    window.revealEmpPwd = function (credId, btn) {
        var input = document.getElementById('empwd_' + credId);
        if (input.type === 'text') {
            input.type = 'password';
            input.value = '••••••••';
            btn.innerHTML = '<i class="bi bi-eye"></i>';
            return;
        }
        fetch('@Url.Action("RevealPassword", "Employees")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'credentialId=' + credId
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                input.type = 'text';
                input.value = d.password;
                btn.innerHTML = '<i class="bi bi-eye-slash"></i>';
            } else {
                alert('Error: ' + d.message);
            }
        });
    };

    window.copyEmpPwd = function (credId) {
        var input = document.getElementById('empwd_' + credId);
        if (input.type !== 'text') {
            fetch('@Url.Action("RevealPassword", "Employees")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'credentialId=' + credId
            })
            .then(r => r.json())
            .then(d => { if (d.success) navigator.clipboard.writeText(d.password); });
        } else {
            navigator.clipboard.writeText(input.value);
        }
    };

    window.toggleEmpNewPwd = function () {
        var inp = document.getElementById('newEmpCredPwd');
        var ico = document.getElementById('newEmpPwdIcon');
        inp.type = inp.type === 'password' ? 'text' : 'password';
        ico.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
    };
})();

// ── Gmail Signature ───────────────────────────────────────────────────────
(function () {
    var token       = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    var editor      = document.getElementById('sigEditor');
    var livePreview = document.getElementById('sigLivePreview');
    var preview     = document.getElementById('sigPreview');
    var status      = document.getElementById('sigStatus');

    if (!editor) return;   // tab not rendered

    function showStatus(msg, type) {
        status.className = 'alert alert-' + type + ' py-2 small mb-3';
        status.textContent = msg;
        status.classList.remove('d-none');
        if (type === 'success') setTimeout(function(){ status.classList.add('d-none'); }, 4000);
    }

    editor.addEventListener('input', function () {
        livePreview.innerHTML = editor.value || '<span class="text-muted small">Preview will appear here as you edit.</span>';
    });

    window.toggleSigView = function(cb) {
        editor.classList.toggle('d-none', cb.checked);
        preview.classList.toggle('d-none', !cb.checked);
        if (cb.checked) preview.innerHTML = editor.value;
    };

    window.clearEditor = function() {
        editor.value = '';
        livePreview.innerHTML = '<span class="text-muted small">Preview will appear here as you edit.</span>';
        preview.innerHTML = '';
    };

    window.loadCurrentSignature = function() {
        showStatus('Loading signature from Gmail…', 'info');
        fetch('@Url.Action("GetSignature", "Employees", new { id = Model.Id })')
            .then(function(r){ return r.json(); })
            .then(function(d) {
                if (d.success) {
                    editor.value = d.html;
                    livePreview.innerHTML = d.html || '<span class="text-muted small">Signature is currently empty.</span>';
                    showStatus('Signature loaded from Gmail.', 'success');
                } else {
                    showStatus('Error: ' + d.error, 'danger');
                }
            })
            .catch(function(){ showStatus('Network error loading signature.', 'danger'); });
    };

    window.applyTemplate = function() {
        showStatus('Applying template…', 'info');
        fetch('@Url.Action("GetSignatureTemplate", "Employees", new { id = Model.Id })')
            .then(function(r){ return r.json(); })
            .then(function(d) {
                if (d.success) {
                    editor.value = d.html;
                    livePreview.innerHTML = d.html;
                    showStatus('Template applied. Review and click Save to Gmail.', 'success');
                } else {
                    showStatus('Error: ' + d.message, 'danger');
                }
            })
            .catch(function(){ showStatus('Network error loading template.', 'danger'); });
    };

    window.saveSignature = function() {
        var html           = editor.value.trim();
        var includeAliases = document.getElementById('sigIncludeAliases')?.checked ?? false;
        showStatus('Saving signature to Gmail…', 'info');
        var fd = new FormData();
        fd.append('html', html);
        fd.append('includeAliases', includeAliases);
        fetch('@Url.Action("UpdateSignature", "Employees", new { id = Model.Id })', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: fd
        })
        .then(function(r){ return r.json(); })
        .then(function(d) {
            showStatus(d.message, d.success ? 'success' : 'danger');
            if (d.success && d.syncDate) {
                var badge = document.getElementById('sigSyncBadge');
                if (badge) {
                    badge.className = 'badge bg-success';
                    badge.innerHTML = '<i class="bi bi-cloud-check me-1"></i>Synced ' + d.syncDate;
                }
            }
        })
        .catch(function(){ showStatus('Network error saving signature.', 'danger'); });
    };
})();

// ── Google Workspace Tab ──────────────────────────────────────────────────
(function () {
    var wsLoaded    = false;
    var wsState     = { suspended: false, groups: [] };
    var antiForgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    function wsAlert(msg, type) {
        var el = document.getElementById('wsAlert');
        el.className = 'alert alert-' + type + ' py-2 small mb-3';
        el.textContent = msg;
        el.classList.remove('d-none');
        if (type === 'success') setTimeout(function () { el.classList.add('d-none'); }, 4000);
    }

    function post(url, extra) {
        var fd = new FormData();
        fd.append('__RequestVerificationToken', antiForgery);
        Object.entries(extra || {}).forEach(function ([k, v]) { fd.append(k, v); });
        return fetch(url, { method: 'POST', headers: { 'RequestVerificationToken': antiForgery }, body: fd })
            .then(function (r) { return r.json(); });
    }

    window.loadWorkspaceInfo = function () {
        document.getElementById('wsLoader').classList.remove('d-none');
        document.getElementById('wsContent').classList.add('d-none');
        document.getElementById('wsAlert').classList.add('d-none');

        Promise.all([
            fetch('@Url.Action("GetWorkspaceInfo","Employees",new{id=Model.Id})').then(r => r.json()),
            fetch('@Url.Action("GetDomainGroups","Employees")').then(r => r.json())
        ]).then(function ([info, domGrps]) {
            document.getElementById('wsLoader').classList.add('d-none');
            document.getElementById('wsContent').classList.remove('d-none');

            // Account status
            wsState.suspended = info.user?.suspended ?? false;
            var badge = document.getElementById('wsStatusBadge');
            badge.innerHTML = wsState.suspended
                ? '<span class="badge bg-danger fs-6"><i class="bi bi-pause-circle me-1"></i>Suspended</span>'
                : '<span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Active</span>';
            document.getElementById('wsOrgUnit').textContent = info.user?.orgUnit ?? '';
            document.getElementById('wsSuspendBtn').classList.toggle('d-none', wsState.suspended);
            document.getElementById('wsUnsuspendBtn').classList.toggle('d-none', !wsState.suspended);

            // OOO
            var vac = info.vacation;
            var oooBadge = document.getElementById('wsOooBadge');
            if (vac && !vac.error) {
                oooBadge.textContent = vac.enabled ? 'Active' : 'Off';
                oooBadge.className   = 'badge ' + (vac.enabled ? 'bg-warning text-dark' : 'bg-secondary');
                if (vac.subject) document.getElementById('wsOooSubject').value = vac.subject;
                if (vac.body)    document.getElementById('wsOooBody').value    = vac.body;
                if (vac.start)   document.getElementById('wsOooStart').value   = vac.start;
                if (vac.end)     document.getElementById('wsOooEnd').value     = vac.end;
                document.getElementById('wsOooDomain').checked = vac.domain ?? false;
            } else {
                oooBadge.textContent = 'Unavailable'; oooBadge.className = 'badge bg-secondary';
            }

            // Groups
            wsState.groups = Array.isArray(info.groups) ? info.groups : [];
            renderGroups(wsState.groups);

            // Domain group dropdown
            var sel = document.getElementById('wsGroupSelect');
            sel.innerHTML = '<option value="">— Select a group to add —</option>';
            if (domGrps.success && Array.isArray(domGrps.groups)) {
                domGrps.groups.forEach(function (g) {
                    var already = wsState.groups.some(function (m) { return m.Email === g.Email; });
                    if (!already) {
                        var o = document.createElement('option');
                        o.value = g.Email; o.textContent = g.Name + ' (' + g.Email + ')';
                        sel.appendChild(o);
                    }
                });
            }

            wsLoaded = true;
        }).catch(function (e) {
            document.getElementById('wsLoader').classList.add('d-none');
            wsAlert('Failed to load Workspace data: ' + e, 'danger');
        });
    };

    function renderGroups(grps) {
        var el = document.getElementById('wsGroupsList');
        if (!grps || grps.length === 0) {
            el.innerHTML = '<p class="text-muted small p-3 mb-0">Not a member of any groups.</p>';
            return;
        }
        var rows = grps.map(function (g) {
            return '<tr><td><code class="small">' + escHtml(g.Email) + '</code></td>' +
                   '<td>' + escHtml(g.Name) + '</td>' +
                   '<td class="text-end"><button class="btn btn-sm btn-outline-danger" onclick="removeFromGroup(' +
                   "'" + escHtml(g.Email) + "'" + ')"><i class="bi bi-x-lg"></i></button></td></tr>';
        }).join('');
        el.innerHTML = '<div class="table-responsive"><table class="table table-sm mb-0"><thead class="table-light">' +
            '<tr><th>Email</th><th>Name</th><th class="text-end">Remove</th></tr></thead><tbody>' +
            rows + '</tbody></table></div>';
    }

    window.toggleSuspend = function (suspend) {
        if (!confirm((suspend ? 'Suspend' : 'Unsuspend') + ' this Google account?')) return;
        post('@Url.Action("SuspendUser","Employees",new{id=Model.Id})', { suspended: suspend })
            .then(function (d) {
                wsAlert(d.message, d.success ? 'success' : 'danger');
                if (d.success) {
                    wsState.suspended = suspend;
                    document.getElementById('wsStatusBadge').innerHTML = suspend
                        ? '<span class="badge bg-danger fs-6"><i class="bi bi-pause-circle me-1"></i>Suspended</span>'
                        : '<span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Active</span>';
                    document.getElementById('wsSuspendBtn').classList.toggle('d-none', suspend);
                    document.getElementById('wsUnsuspendBtn').classList.toggle('d-none', !suspend);
                }
            });
    };

    window.resetPassword = function () {
        if (!confirm('Generate a new temporary password for this account?')) return;
        post('@Url.Action("ResetWorkspacePassword","Employees",new{id=Model.Id})')
            .then(function (d) {
                if (d.success) {
                    document.getElementById('wsTempPwBox').classList.remove('d-none');
                    document.getElementById('wsTempPw').value = d.tempPassword;
                    wsAlert('Password reset. Share the temporary password securely with the employee.', 'warning');
                } else {
                    wsAlert('Reset failed: ' + d.message, 'danger');
                }
            });
    };

    window.copyTempPw = function () {
        var pw = document.getElementById('wsTempPw').value;
        navigator.clipboard?.writeText(pw);
        wsAlert('Password copied to clipboard.', 'success');
    };

    window.loadStorage = function () {
        var card = document.getElementById('wsStorageCard');
        card.innerHTML = '<div class="spinner-border spinner-border-sm text-primary me-2"></div><span class="small text-muted">Loading storage data…</span>';
        fetch('@Url.Action("GetStorageInfo","Employees",new{id=Model.Id})')
            .then(r => r.json())
            .then(function (d) {
                if (!d.success) { card.innerHTML = '<p class="text-muted small mb-0">' + escHtml(d.error) + '</p>'; return; }
                var totalUsedMb = d.gmailMb + d.driveMb;
                var pct = d.totalMb > 0 ? Math.min(100, Math.round(totalUsedMb / d.totalMb * 100)) : 0;
                var barClass = pct > 85 ? 'bg-danger' : pct > 60 ? 'bg-warning' : 'bg-primary';
                card.innerHTML =
                    '<div class="mb-2"><div class="d-flex justify-content-between small mb-1">' +
                    '<span>' + totalUsedMb.toLocaleString() + ' MB used</span>' +
                    '<span class="text-muted">' + d.totalMb.toLocaleString() + ' MB total</span>' +
                    '</div><div class="progress" style="height:10px;">' +
                    '<div class="progress-bar ' + barClass + '" style="width:' + pct + '%"></div></div>' +
                    '<div class="small text-muted mt-1">' + pct + '% used</div></div>' +
                    '<div class="row g-2 mt-1"><div class="col-6 text-center border-end">' +
                    '<div class="fw-bold">' + d.gmailMb.toLocaleString() + ' MB</div>' +
                    '<div class="small text-muted">Gmail</div></div>' +
                    '<div class="col-6 text-center"><div class="fw-bold">' + d.driveMb.toLocaleString() + ' MB</div>' +
                    '<div class="small text-muted">Drive</div></div></div>' +
                    (d.asOf ? '<div class="small text-muted mt-2"><i class="bi bi-clock me-1"></i>Data as of ' + escHtml(d.asOf) + '</div>' : '');
            });
    };

    window.saveOoo = function (enable) {
        var data = {
            enabled:          enable,
            subject:          document.getElementById('wsOooSubject').value,
            body:             document.getElementById('wsOooBody').value,
            startDate:        document.getElementById('wsOooStart').value,
            endDate:          document.getElementById('wsOooEnd').value,
            restrictToDomain: document.getElementById('wsOooDomain').checked
        };
        post('@Url.Action("SetVacationResponder","Employees",new{id=Model.Id})', data)
            .then(function (d) {
                wsAlert(d.message, d.success ? 'success' : 'danger');
                if (d.success) {
                    var b = document.getElementById('wsOooBadge');
                    b.textContent = enable ? 'Active' : 'Off';
                    b.className   = 'badge ' + (enable ? 'bg-warning text-dark' : 'bg-secondary');
                }
            });
    };

    window.addToGroup = function () {
        var sel = document.getElementById('wsGroupSelect');
        var grp = sel.value;
        if (!grp) return;
        post('@Url.Action("AddToGroup","Employees",new{id=Model.Id})', { groupEmail: grp })
            .then(function (d) {
                wsAlert(d.message, d.success ? 'success' : 'danger');
                if (d.success) loadWorkspaceInfo();
            });
    };

    window.removeFromGroup = function (grpEmail) {
        if (!confirm('Remove from ' + grpEmail + '?')) return;
        post('@Url.Action("RemoveFromGroup","Employees",new{id=Model.Id})', { groupEmail: grpEmail })
            .then(function (d) {
                wsAlert(d.message, d.success ? 'success' : 'danger');
                if (d.success) loadWorkspaceInfo();
            });
    };

    // ── Onboarding ────────────────────────────────────────────────────────────

    window.provisionAccount = function () {
        if (!confirm('Create a new Google Workspace account for @Html.Raw(Model.Email ?? Model.FullName)?\n\nMake sure this account does not already exist in your domain.')) return;
        var ou = document.getElementById('wsOrgUnitInput').value.trim();
        post('@Url.Action("ProvisionWorkspaceAccount","Employees",new{id=Model.Id})', { orgUnit: ou })
            .then(function (d) {
                var res = document.getElementById('wsProvisionResult');
                var msg = document.getElementById('wsProvisionMsg');
                res.classList.remove('d-none');
                msg.textContent = d.message;
                msg.className   = 'alert py-2 small mb-2 ' + (d.success ? 'alert-success' : 'alert-danger');
                if (d.success && d.tempPassword) {
                    var box = document.getElementById('wsNewPwBox');
                    box.classList.remove('d-none');
                    document.getElementById('wsNewPw').value = d.tempPassword;
                }
            });
    };

    window.copyNewPw = function () {
        navigator.clipboard?.writeText(document.getElementById('wsNewPw').value);
        wsAlert('Password copied to clipboard.', 'success');
    };

    // ── Offboarding ───────────────────────────────────────────────────────────

    window.runOffboarding = function () {
        if (!confirm('Run offboarding steps for this employee? This will apply the selected actions to their Google account.')) return;
        var data = {
            suspend:          document.getElementById('offSuspend').checked,
            removeGroups:     document.getElementById('offGroups').checked,
            setOoo:           document.getElementById('offOoo').checked,
            oooSubject:       document.getElementById('offOooSubject').value,
            oooBody:          document.getElementById('offOooBody').value,
            revokeTokens:     document.getElementById('offRevoke').checked,
            transferDrive:    document.getElementById('offTransfer').checked,
            transferToEmail:  document.getElementById('offTransferEmail')?.value ?? ''
        };
        var btn = document.querySelector('[onclick="runOffboarding()"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Running…';

        post('@Url.Action("RunOffboarding","Employees",new{id=Model.Id})', data)
            .then(function (d) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-right me-1"></i>Run Offboarding';

                var resultEl = document.getElementById('offboardingResult');
                resultEl.classList.remove('d-none');
                var rows = (d.steps || []).map(function (s) {
                    var icon = s.ok
                        ? '<i class="bi bi-check-circle-fill text-success me-1"></i>'
                        : '<i class="bi bi-x-circle-fill text-danger me-1"></i>';
                    return '<li class="list-group-item py-1 small d-flex justify-content-between align-items-start">' +
                           '<span>' + icon + escHtml(s.step) + '</span>' +
                           '<span class="text-muted small ms-2">' + escHtml(s.message || '') + '</span></li>';
                }).join('');
                resultEl.innerHTML =
                    '<div class="alert alert-' + (d.success ? 'success' : 'warning') + ' py-2 small mb-2">' +
                    escHtml(d.message) + '</div>' +
                    (rows ? '<ul class="list-group list-group-flush border rounded">' + rows + '</ul>' : '');
            }).catch(function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-right me-1"></i>Run Offboarding';
                wsAlert('Request failed. Check your network and try again.', 'danger');
            });
    };

    // ── Security ──────────────────────────────────────────────────────────────

    window.loadOAuthApps = function () {
        var sec = document.getElementById('wsSecurityPlaceholder');
        sec.classList.add('d-none');
        var el = document.getElementById('wsOAuthSection');
        el.classList.remove('d-none');
        el.querySelector('#wsOAuthList').innerHTML =
            '<div class="spinner-border spinner-border-sm text-primary me-2"></div><span class="small">Loading…</span>';

        fetch('@Url.Action("GetOAuthApps","Employees",new{id=Model.Id})')
            .then(r => r.json())
            .then(function (d) {
                if (!d.success) {
                    el.querySelector('#wsOAuthList').innerHTML = '<p class="text-danger small">' + escHtml(d.error) + '</p>';
                    return;
                }
                if (!d.tokens || d.tokens.length === 0) {
                    el.querySelector('#wsOAuthList').innerHTML = '<p class="text-muted small">No authorized apps found.</p>';
                    return;
                }
                var rows = d.tokens.map(function (t) {
                    return '<tr><td class="fw-semibold small">' + escHtml(t.appName) + '</td>' +
                           '<td><code class="small">' + escHtml(t.clientId) + '</code></td>' +
                           '<td class="text-end"><span class="badge bg-secondary">' + t.scopeCount + ' scope(s)</span></td></tr>';
                }).join('');
                el.querySelector('#wsOAuthList').innerHTML =
                    '<div class="table-responsive"><table class="table table-sm mb-0"><thead class="table-light">' +
                    '<tr><th>App</th><th>Client ID</th><th class="text-end">Scopes</th></tr></thead>' +
                    '<tbody>' + rows + '</tbody></table></div>';
            });
    };

    window.loadLoginActivity = function () {
        var sec = document.getElementById('wsSecurityPlaceholder');
        sec.classList.add('d-none');
        var el = document.getElementById('wsLoginSection');
        el.classList.remove('d-none');
        el.querySelector('#wsLoginList').innerHTML =
            '<div class="spinner-border spinner-border-sm text-primary me-2"></div><span class="small">Loading…</span>';

        fetch('@Url.Action("GetLoginActivity","Employees",new{id=Model.Id})')
            .then(r => r.json())
            .then(function (d) {
                if (!d.success) {
                    el.querySelector('#wsLoginList').innerHTML = '<p class="text-danger small">' + escHtml(d.error) + '</p>';
                    return;
                }
                if (!d.events || d.events.length === 0) {
                    el.querySelector('#wsLoginList').innerHTML = '<p class="text-muted small">No login events found.</p>';
                    return;
                }
                var eventIcons = { 'login_success': 'bi-check-circle text-success',
                    'login_failure': 'bi-x-circle text-danger', 'logout': 'bi-box-arrow-right text-secondary' };
                var rows = d.events.map(function (e) {
                    var icon = eventIcons[e.eventName] || 'bi-circle text-muted';
                    return '<tr><td class="small">' + escHtml(e.time) + '</td>' +
                           '<td><i class="bi ' + icon + ' me-1"></i><span class="small">' + escHtml(e.eventName) + '</span></td>' +
                           '<td><code class="small">' + escHtml(e.ip || '—') + '</code></td></tr>';
                }).join('');
                el.querySelector('#wsLoginList').innerHTML =
                    '<div class="table-responsive"><table class="table table-sm mb-0"><thead class="table-light">' +
                    '<tr><th>Time</th><th>Event</th><th>IP Address</th></tr></thead>' +
                    '<tbody>' + rows + '</tbody></table></div>';
            });
    };

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // Auto-load when workspace tab is clicked
    document.querySelectorAll('a[href="?tab=workspace"]').forEach(function (a) {
        a.addEventListener('click', function () {
            if (!wsLoaded) setTimeout(loadWorkspaceInfo, 80);
        });
    });

    // Auto-load if workspace is the active tab on page load
    if (window.location.search.includes('tab=workspace')) {
        setTimeout(loadWorkspaceInfo, 200);
    }

    // Drive transfer toggle in offboarding tab
    document.getElementById('offTransfer')?.addEventListener('change', function () {
        document.getElementById('offTransferDest').style.display = this.checked ? '' : 'none';
    });

    // ── Sync Profile to Google ────────────────────────────────────────────────
    window.syncProfile = function () {
        var btn    = document.getElementById('btnSyncProfile');
        var result = document.getElementById('syncProfileResult');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Syncing…';

        post('@Url.Action("SyncWorkspaceProfile","Employees",new{id=Model.Id})', {})
            .then(function (d) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>Sync Profile to Google';
                result.className = 'alert py-2 small mb-2 ' + (d.success ? 'alert-success' : 'alert-danger');
                result.textContent = d.message;
                result.classList.remove('d-none');
                if (d.success) setTimeout(function () { result.classList.add('d-none'); }, 5000);
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>Sync Profile to Google';
                result.className = 'alert alert-danger py-2 small mb-2';
                result.textContent = 'Request failed — check your connection and try again.';
                result.classList.remove('d-none');
            });
    };
})();

// ── Ticket Viewer Modal ────────────────────────────────────────────────────
var empTickets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    ((IEnumerable<dynamic>)(ViewBag.RecentSubmitted ?? Enumerable.Empty<dynamic>()))
    .Select(t => new {
        id          = (int)t.Id,
        title       = (string)t.Title,
        statusInt   = (int)t.Status,
        status      = ((object)t.Status).ToString(),
        priority    = ((object)t.Priority).ToString(),
        category    = (int)t.Category,
        createdDate = ((DateTime)t.CreatedDate).ToString("MMM dd, yyyy")
    })
));

(function () {
    var statusLabels = {0:'Open',1:'In Progress',2:'On Hold',3:'Resolved',4:'Closed',5:'Cancelled'};
    var statusClasses = {0:'open',1:'inprogress',2:'onhold',3:'resolved',4:'closed',5:'cancelled'};

    function escHtml(s) {
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function showTicketModal(label, tickets) {
        document.getElementById('ticketViewerLabel').textContent = label;
        var tbody  = document.getElementById('ticketViewerBody');
        var empty  = document.getElementById('ticketViewerEmpty');
        var wrap   = document.getElementById('ticketViewerTableWrap');
        var count  = document.getElementById('ticketViewerCount');

        tbody.innerHTML = '';

        if (tickets.length === 0) {
            empty.classList.remove('d-none');
            wrap.classList.add('d-none');
            count.textContent = '0 tickets';
        } else {
            empty.classList.add('d-none');
            wrap.classList.remove('d-none');
            count.textContent = tickets.length + ' ticket' + (tickets.length !== 1 ? 's' : '');

            tickets.slice().sort(function(a,b){ return b.id - a.id; }).forEach(function(t) {
                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td class="text-muted small">#' + t.id + '</td>' +
                    '<td><a href="/Tickets/Details/' + t.id + '">' + escHtml(t.title) + '</a></td>' +
                    '<td><span class="badge badge-' + (statusClasses[t.statusInt] || 'secondary') + '">' + (statusLabels[t.statusInt] || t.status) + '</span></td>' +
                    '<td><span class="badge badge-' + t.priority.toLowerCase() + '">' + t.priority + '</span></td>' +
                    '<td class="text-muted small">' + t.createdDate + '</td>';
                tbody.appendChild(tr);
            });
        }

        new bootstrap.Modal(document.getElementById('ticketViewerModal')).show();
    }

    // KPI card clicks
    document.querySelectorAll('.kpi-card').forEach(function(card) {
        card.addEventListener('click', function() {
            var filter = this.dataset.filter;
            var filtered, label;
            if (filter === 'all') {
                filtered = empTickets.slice();
                label = 'All Tickets';
            } else if (filter === 'open') {
                filtered = empTickets.filter(function(t) { return t.statusInt === 0 || t.statusInt === 1; });
                label = 'Open / In Progress';
            } else {
                filtered = empTickets.filter(function(t) { return t.statusInt === 3 || t.statusInt === 4; });
                label = 'Resolved / Closed';
            }
            showTicketModal(label + ' (' + filtered.length + ')', filtered);
        });
    });

    // Category bar clicks
    document.querySelectorAll('.cat-bar').forEach(function(row) {
        row.addEventListener('click', function() {
            var catId   = parseInt(this.dataset.catId);
            var catName = this.dataset.catName;
            var filtered = empTickets.filter(function(t) { return t.category === catId; });
            showTicketModal(catName + ' (' + filtered.length + ')', filtered);
        });
    });
})();
</script>
}
