@model IEnumerable<Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-people"></i> Employees</h1>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="ImportCsv" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-upload me-1"></i> Import Employees
            </a>
        }
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Employee
        </a>
    </div>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label small">Department</label>
            <select name="department" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Departments</option>
                @if (ViewBag.Departments != null)
                {
                    foreach (var dept in (List<string>)ViewBag.Departments)
                    {
                        var deptSel = ViewBag.CurrentDepartment != null && (string)ViewBag.CurrentDepartment == dept;
                        <option value="@dept" selected="@(deptSel ? "selected" : null)">@dept</option>
                    }
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small">Status</label>
            <select name="active" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                <option value="true"  selected="@(ViewBag.CurrentActive != null && (bool)ViewBag.CurrentActive == true  ? "selected" : null)">Active</option>
                <option value="false" selected="@(ViewBag.CurrentActive != null && (bool)ViewBag.CurrentActive == false ? "selected" : null)">Inactive</option>
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small">Branch</label>
            <select name="branchId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Branches</option>
                @if (ViewBag.Branches != null)
                {
                    foreach (var b in (IEnumerable<dynamic>)ViewBag.Branches)
                    {
                        <option value="@b.Id" selected="@(ViewBag.CurrentBranchId != null && (int)ViewBag.CurrentBranchId == (int)b.Id ? "selected" : null)">@b.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small">Login Account</label>
            <select name="hasLogin" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                <option value="true"  selected="@(ViewBag.CurrentHasLogin != null && (bool)ViewBag.CurrentHasLogin == true  ? "selected" : null)">Has Login</option>
                <option value="false" selected="@(ViewBag.CurrentHasLogin != null && (bool)ViewBag.CurrentHasLogin == false ? "selected" : null)">No Login</option>
            </select>
        </div>
        <div class="col-auto align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Employees Report">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Department</th>
                <th>Job Title</th>
                <th>Status</th>
                <th>Hire Date</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@employee.Id">@employee.FullName</a>
                    </td>
                    <td>@employee.Email</td>
                    <td>@employee.Phone</td>
                    <td>@employee.Department</td>
                    <td>@employee.JobTitle</td>
                    <td>
                        @if (employee.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@employee.HireDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-people display-1"></i>
        <p class="mt-3 mb-3">No employees found matching the current filters.</p>
        <a asp-action="Create" class="btn btn-primary me-2"><i class="bi bi-plus-lg me-1"></i> Add Employee</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
    </div>
}
