@model IEnumerable<Employee>
@{
    ViewData["Title"] = "Employees";
    var curDepartment = ViewBag.CurrentDepartment as string;
    var curActive = ViewBag.CurrentActive as bool?;
    var curBranchId = ViewBag.CurrentBranchId as int?;
    var curHasLogin = ViewBag.CurrentHasLogin as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-people"></i> Employees</h1>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="ImportCsv" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-upload me-1"></i> Import Employees
            </a>
        }
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Employee
        </a>
    </div>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <div class="form-label small mb-1">Department</div>
            <input type="hidden" id="empDepartmentInput" name="department" value="@(curDepartment ?? "")" />
            <div class="dropdown">
                <button type="button" id="empDepartmentBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(!string.IsNullOrWhiteSpace(curDepartment) ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(string.IsNullOrWhiteSpace(curDepartment) ? "All Departments" : curDepartment)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:200px;max-height:280px;overflow-y:auto;">
                    <button type="button" class="dropdown-item small single-filter-option @(string.IsNullOrWhiteSpace(curDepartment) ? "active" : "")" data-input-id="empDepartmentInput" data-button-id="empDepartmentBtn" data-value="" data-label="All Departments">All Departments</button>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in (List<string>)ViewBag.Departments)
                        {
                            <button type="button" class="dropdown-item small single-filter-option @(curDepartment == dept ? "active" : "")"
                                    data-input-id="empDepartmentInput" data-button-id="empDepartmentBtn" data-value="@dept" data-label="@dept">@dept</button>
                        }
                    }
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div>
            <div class="form-label small mb-1">Status</div>
            <input type="hidden" id="empActiveInput" name="active" value="@(curActive?.ToString().ToLower() ?? "")" />
            <div class="dropdown">
                <button type="button" id="empActiveBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curActive != null ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(curActive == null ? "All" : curActive.Value ? "Active" : "Inactive")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    <button type="button" class="dropdown-item small single-filter-option @(curActive == null ? "active" : "")" data-input-id="empActiveInput" data-button-id="empActiveBtn" data-value="" data-label="All">All</button>
                    <button type="button" class="dropdown-item small single-filter-option @(curActive == true ? "active" : "")" data-input-id="empActiveInput" data-button-id="empActiveBtn" data-value="true" data-label="Active">Active</button>
                    <button type="button" class="dropdown-item small single-filter-option @(curActive == false ? "active" : "")" data-input-id="empActiveInput" data-button-id="empActiveBtn" data-value="false" data-label="Inactive">Inactive</button>
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div>
            <div class="form-label small mb-1">Branch</div>
            <input type="hidden" id="empBranchInput" name="branchId" value="@(curBranchId?.ToString() ?? "")" />
            <div class="dropdown">
                <button type="button" id="empBranchBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curBranchId != null ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @if (curBranchId == null)
                    {
                        <text>All Branches</text>
                    }
                    else
                    {
                        var selectedBranch = ((IEnumerable<dynamic>)ViewBag.Branches).FirstOrDefault(b => (int)b.Id == curBranchId.Value);
                        <text>@(selectedBranch?.Name ?? "All Branches")</text>
                    }
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:200px;max-height:280px;overflow-y:auto;">
                    <button type="button" class="dropdown-item small single-filter-option @(curBranchId == null ? "active" : "")" data-input-id="empBranchInput" data-button-id="empBranchBtn" data-value="" data-label="All Branches">All Branches</button>
                    @if (ViewBag.Branches != null)
                    {
                        foreach (var b in (IEnumerable<dynamic>)ViewBag.Branches)
                        {
                            <button type="button" class="dropdown-item small single-filter-option @(curBranchId == (int)b.Id ? "active" : "")"
                                    data-input-id="empBranchInput" data-button-id="empBranchBtn" data-value="@b.Id" data-label="@b.Name">@b.Name</button>
                        }
                    }
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div>
            <div class="form-label small mb-1">Login Account</div>
            <input type="hidden" id="empHasLoginInput" name="hasLogin" value="@(curHasLogin?.ToString().ToLower() ?? "")" />
            <div class="dropdown">
                <button type="button" id="empHasLoginBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curHasLogin != null ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(curHasLogin == null ? "All" : curHasLogin.Value ? "Has Login" : "No Login")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    <button type="button" class="dropdown-item small single-filter-option @(curHasLogin == null ? "active" : "")" data-input-id="empHasLoginInput" data-button-id="empHasLoginBtn" data-value="" data-label="All">All</button>
                    <button type="button" class="dropdown-item small single-filter-option @(curHasLogin == true ? "active" : "")" data-input-id="empHasLoginInput" data-button-id="empHasLoginBtn" data-value="true" data-label="Has Login">Has Login</button>
                    <button type="button" class="dropdown-item small single-filter-option @(curHasLogin == false ? "active" : "")" data-input-id="empHasLoginInput" data-button-id="empHasLoginBtn" data-value="false" data-label="No Login">No Login</button>
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Clear Filters</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener('click', function (e) {
    const opt = e.target.closest('.single-filter-option');
    if (!opt) return;
    e.preventDefault();
    const input = document.getElementById(opt.dataset.inputId);
    const btn = document.getElementById(opt.dataset.buttonId);
    if (!input || !btn) return;
    input.value = opt.dataset.value ?? '';
    btn.textContent = opt.dataset.label ?? '';
    btn.classList.toggle('active', input.value !== '');
    opt.closest('.dropdown-menu')?.querySelectorAll('.single-filter-option').forEach(x => x.classList.remove('active'));
    opt.classList.add('active');
});
</script>
}

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Employees Report">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Department</th>
                <th>Job Title</th>
                <th>Status</th>
                <th>Hire Date</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@employee.Id">@employee.FullName</a>
                    </td>
                    <td>@employee.Email</td>
                    <td>@employee.Phone</td>
                    <td>@employee.Department</td>
                    <td>@employee.JobTitle</td>
                    <td>
                        @if (employee.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@employee.HireDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-people display-1"></i>
        <p class="mt-3 mb-3">No employees found matching the current filters.</p>
        <a asp-action="Create" class="btn btn-primary me-2"><i class="bi bi-plus-lg me-1"></i> Add Employee</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
    </div>
}
