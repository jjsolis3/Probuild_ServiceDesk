@model Employee
@using ServiceDesk.Core.Enums
@using ServiceDesk.Core.Models
@using ServiceDesk.Web.Services
@{
    ViewData["Title"] = $"Edit {Model.FullName}";
    var recurringCharges = (ViewBag.RecurringCharges as IEnumerable<RecurringChargeTemplate>) ?? Enumerable.Empty<RecurringChargeTemplate>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.FullName</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>

<h1><i class="bi bi-pencil"></i> Edit @Model.FullName</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" data-loading-btn="btnSaveEmployee">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BranchId" class="form-label">Branch / Location</label>
                    <select asp-for="BranchId" class="form-select">
                        <option value="">— None —</option>
                        @if (ViewBag.Branches != null)
                        {
                            foreach (var b in (IEnumerable<ServiceDesk.Core.Models.Branch>)ViewBag.Branches)
                            {
                                if (Model.BranchId == b.Id) {
                                    <option value="@b.Id" selected="selected">@b.Name</option>
                                }
                                else {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-5">
                    <label asp-for="Phone" class="form-label">Direct Phone</label>
                    <input asp-for="Phone" class="form-control" placeholder="Direct phone number" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Extension" class="form-label">Extension</label>
                    <input asp-for="Extension" class="form-control" placeholder="e.g. 101" />
                    <span asp-validation-for="Extension" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted">Company Phone</label>
                    <p class="form-control-plaintext text-muted small">
                        @(Model.Branch?.Phone ?? "Pulled from Branch record")
                    </p>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Department" class="form-label"></label>
                    <input asp-for="Department" class="form-control" />
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="JobTitle" class="form-label"></label>
                    <input asp-for="JobTitle" class="form-control" />
                    <span asp-validation-for="JobTitle" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="HireDate" class="form-label"></label>
                    <input asp-for="HireDate" class="form-control" type="date" />
                    <span asp-validation-for="HireDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <hr class="my-3" />
            <p class="text-muted small mb-3"><i class="bi bi-google me-1"></i>The fields below sync to Google Workspace via <em>Workspace → Sync Profile to Google</em>.</p>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="ManagerEmail" class="form-label"></label>
                    <input asp-for="ManagerEmail" class="form-control" type="email" placeholder="manager@domain.com" />
                    <span asp-validation-for="ManagerEmail" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="EmployeeType" class="form-label"></label>
                    <input asp-for="EmployeeType" class="form-control" placeholder="e.g. IT, Sales" />
                </div>
                <div class="col-md-3">
                    <label asp-for="FloorSection" class="form-label"></label>
                    <input asp-for="FloorSection" class="form-control" placeholder="e.g. Tech, Ops" />
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="row g-3 mb-3 border-top pt-3">
                    <div class="col-12">
                        <h6 class="text-muted mb-2"><i class="fas fa-briefcase me-1"></i>Contractor Settings</h6>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check mt-2">
                            <input asp-for="IsContractor" class="form-check-input" type="checkbox" />
                            <label asp-for="IsContractor" class="form-check-label">Is Contractor</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HourlyRate" class="form-label">Hourly Rate (Standard)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EmergencyHourlyRate" class="form-label">Emergency / Weekend Rate</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="EmergencyHourlyRate" class="form-control" type="number" step="0.01" min="0" placeholder="Leave blank to disable" />
                        </div>
                        <small class="text-muted">Blank = single-rate contractor; no Rate Type picker on time entries.</small>
                        <span asp-validation-for="EmergencyHourlyRate" class="text-danger"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <h6 class="text-muted mb-2"><i class="fas fa-hand-holding-usd me-1"></i>Monthly Retainer
                            <small class="text-muted">— optional. Burn-down model: included hours are absorbed before any Standard hour bills at the hourly rate. Emergency hours always bill at the Emergency rate.</small>
                        </h6>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MonthlyRetainerAmount" class="form-label">Retainer Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="MonthlyRetainerAmount" class="form-control" type="number" step="0.01" min="0" placeholder="Leave blank for no retainer" />
                            <span class="input-group-text">/ mo</span>
                        </div>
                        <span asp-validation-for="MonthlyRetainerAmount" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MonthlyRetainerHoursIncluded" class="form-label">Hours Included</label>
                        <div class="input-group">
                            <input asp-for="MonthlyRetainerHoursIncluded" class="form-control" type="number" step="0.25" min="0" placeholder="e.g. 20" />
                            <span class="input-group-text">hrs / mo</span>
                        </div>
                        <span asp-validation-for="MonthlyRetainerHoursIncluded" class="text-danger"></span>
                    </div>
                </div>
            }

            <div class="mt-4">
                <button type="submit" id="btnSaveEmployee" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@if (User.IsInRole("Admin") && Model.IsContractor)
{
    <div class="row mt-4">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fas fa-repeat me-1"></i><strong>Recurring Charges</strong>
                        <small class="text-muted ms-2">— line items auto-suggested on every new payroll receipt</small>
                    </span>
                    <button type="button" class="btn btn-sm btn-primary"
                            data-bs-toggle="modal" data-bs-target="#recurringChargeModal"
                            id="addRecurringChargeBtn">
                        <i class="bi bi-plus-lg"></i> Add Charge
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (!recurringCharges.Any())
                    {
                        <p class="text-muted small mb-0 p-3">No recurring charges defined. Add one to have it appear as a pre-filled line item on this contractor's new receipts.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Label</th>
                                        <th>Cadence</th>
                                        <th>Unit</th>
                                        <th>Window</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-end" style="width:140px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in recurringCharges)
                                    {
                                        <tr class="@(t.IsActive ? "" : "text-muted")">
                                            <td>
                                                <strong>@t.Label</strong>
                                                @if (!string.IsNullOrWhiteSpace(t.Notes))
                                                {
                                                    <div class="small text-muted">@t.Notes</div>
                                                }
                                            </td>
                                            <td class="small">@RecurringChargeCalculator.DescribeCadence(t)</td>
                                            <td class="small">
                                                @if (t.PricingMode == RecurringChargePricingMode.Flat)
                                                {
                                                    @($"{t.UnitAmount:C2} flat")
                                                }
                                                else
                                                {
                                                    @($"{t.UnitAmount:0.##} h × rate")
                                                }
                                            </td>
                                            <td class="small">
                                                @if (t.StartDate.HasValue || t.EndDate.HasValue)
                                                {
                                                    @($"{(t.StartDate?.ToString("MMM d, yyyy") ?? "—")} → {(t.EndDate?.ToString("MMM d, yyyy") ?? "—")}")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Always</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (t.IsActive)
                                                { <span class="badge bg-success">Active</span> }
                                                else
                                                { <span class="badge bg-secondary">Inactive</span> }
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-charge-btn"
                                                        data-bs-toggle="modal" data-bs-target="#recurringChargeModal"
                                                        data-id="@t.Id"
                                                        data-label="@t.Label"
                                                        data-cadence="@((int)t.Cadence)"
                                                        data-weekdaymask="@t.WeekdayMask"
                                                        data-pricingmode="@((int)t.PricingMode)"
                                                        data-unitamount="@t.UnitAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-startdate="@(t.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-enddate="@(t.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-isactive="@(t.IsActive ? "true" : "false")"
                                                        data-notes="@t.Notes">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-action="DeleteRecurringCharge" asp-route-id="@t.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('Delete recurring charge \'@t.Label\'? Saved receipts that already used it will keep their snapshot.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Shared Add/Edit modal — JS rewrites action + populates fields based on which button opened it. *@
    <div class="modal fade" id="recurringChargeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="recurringChargeForm" method="post"
                      asp-action="AddRecurringCharge"
                      data-add-url="@Url.Action("AddRecurringCharge", new { employeeId = Model.Id })"
                      data-update-url-base="@Url.Action("UpdateRecurringCharge")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="employeeId" value="@Model.Id" id="rcModalEmployeeId" />
                    <input type="hidden" name="id" value="0" id="rcModalId" />
                    <div class="modal-header">
                        <h5 class="modal-title"><span id="rcModalTitle">Add Recurring Charge</span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">Label <span class="text-danger">*</span></label>
                                <input type="text" name="Label" id="rcLabel" class="form-control" maxlength="120" required placeholder="e.g. Daily Reports" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cadence <span class="text-danger">*</span></label>
                                <select name="Cadence" id="rcCadence" class="form-select">
                                    <option value="0">Per day (with weekday filter)</option>
                                    <option value="1">Per week</option>
                                    <option value="2">Per month</option>
                                    <option value="3">Flat per receipt</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Pricing Mode <span class="text-danger">*</span></label>
                                <select name="PricingMode" id="rcPricingMode" class="form-select">
                                    <option value="0">Flat dollar amount per occurrence</option>
                                    <option value="1">Hours × contractor's standard rate</option>
                                </select>
                            </div>
                            <div class="col-md-12" id="rcWeekdayGroup">
                                <label class="form-label">Weekdays <small class="text-muted">— which days the charge fires on</small></label>
                                <div class="mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary rc-weekday-preset" data-mask="62">Mon–Fri</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary rc-weekday-preset" data-mask="127">All days</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary rc-weekday-preset" data-mask="65">Sat/Sun</button>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    @{
                                        var dayNames = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
                                    }
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input rc-weekday-check" type="checkbox" id="rcWeekday@(i)" data-bit="@(1 << i)" />
                                            <label class="form-check-label" for="rcWeekday@(i)">@dayNames[i]</label>
                                        </div>
                                    }
                                </div>
                                <input type="hidden" name="WeekdayMask" id="rcWeekdayMask" value="62" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Unit Amount <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" id="rcUnitPrefix">$</span>
                                    <input type="number" name="UnitAmount" id="rcUnitAmount" class="form-control" step="0.01" min="0" required value="0" />
                                    <span class="input-group-text" id="rcUnitSuffix">per occurrence</span>
                                </div>
                                <small class="text-muted" id="rcUnitHelp">Dollars billed each time this fires.</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Start Date <small class="text-muted">(optional)</small></label>
                                <input type="date" name="StartDate" id="rcStartDate" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">End Date <small class="text-muted">(optional)</small></label>
                                <input type="date" name="EndDate" id="rcEndDate" class="form-control" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Notes <small class="text-muted">(internal — never shown on receipts)</small></label>
                                <textarea name="Notes" id="rcNotes" class="form-control" rows="2" maxlength="500"></textarea>
                            </div>
                            <div class="col-md-12">
                                <div class="form-check form-switch">
                                    <input type="hidden" name="IsActive" value="false" />
                                    <input class="form-check-input" type="checkbox" name="IsActive" id="rcIsActive" value="true" checked />
                                    <label class="form-check-label" for="rcIsActive">Active — auto-suggest on new receipts</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> <span id="rcSubmitLabel">Add Charge</span></button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (function () {
                var modal       = document.getElementById('recurringChargeModal');
                if (!modal) return;
                var form        = document.getElementById('recurringChargeForm');
                var addUrl      = form.dataset.addUrl;
                var updateBase  = form.dataset.updateUrlBase;
                var addBtn      = document.getElementById('addRecurringChargeBtn');
                var titleEl     = document.getElementById('rcModalTitle');
                var submitEl    = document.getElementById('rcSubmitLabel');
                var idEl        = document.getElementById('rcModalId');
                var labelEl     = document.getElementById('rcLabel');
                var cadenceEl   = document.getElementById('rcCadence');
                var pricingEl   = document.getElementById('rcPricingMode');
                var unitEl      = document.getElementById('rcUnitAmount');
                var startEl     = document.getElementById('rcStartDate');
                var endEl       = document.getElementById('rcEndDate');
                var notesEl     = document.getElementById('rcNotes');
                var activeEl    = document.getElementById('rcIsActive');
                var maskHidden  = document.getElementById('rcWeekdayMask');
                var weekdayGrp  = document.getElementById('rcWeekdayGroup');
                var dayChecks   = Array.prototype.slice.call(document.querySelectorAll('.rc-weekday-check'));
                var presets     = Array.prototype.slice.call(document.querySelectorAll('.rc-weekday-preset'));
                var unitPrefix  = document.getElementById('rcUnitPrefix');
                var unitSuffix  = document.getElementById('rcUnitSuffix');
                var unitHelp    = document.getElementById('rcUnitHelp');

                function setMask(mask) {
                    var m = parseInt(mask, 10) || 0;
                    if (m === 0) m = 127;
                    dayChecks.forEach(function (c) {
                        var bit = parseInt(c.dataset.bit, 10);
                        c.checked = (m & bit) !== 0;
                    });
                    maskHidden.value = m;
                }

                function recomputeMask() {
                    var m = 0;
                    dayChecks.forEach(function (c) {
                        if (c.checked) m |= parseInt(c.dataset.bit, 10);
                    });
                    maskHidden.value = m;
                }

                function applyCadenceVisibility() {
                    weekdayGrp.style.display = (cadenceEl.value === '0') ? '' : 'none';
                }

                function applyPricingLabels() {
                    if (pricingEl.value === '1') {
                        unitPrefix.textContent = '';
                        unitSuffix.textContent = 'hours per occurrence';
                        unitHelp.textContent = 'Hours billed each time × the contractor’s standard hourly rate at receipt creation.';
                    } else {
                        unitPrefix.textContent = '$';
                        unitSuffix.textContent = 'per occurrence';
                        unitHelp.textContent = 'Dollars billed each time this fires.';
                    }
                }

                function resetForAdd() {
                    form.setAttribute('action', addUrl);
                    titleEl.textContent = 'Add Recurring Charge';
                    submitEl.textContent = 'Add Charge';
                    idEl.value = '0';
                    labelEl.value = '';
                    cadenceEl.value = '0';
                    pricingEl.value = '0';
                    unitEl.value = '0';
                    startEl.value = '';
                    endEl.value = '';
                    notesEl.value = '';
                    activeEl.checked = true;
                    setMask(62);
                    applyCadenceVisibility();
                    applyPricingLabels();
                }

                function loadFromButton(btn) {
                    var id = btn.dataset.id;
                    form.setAttribute('action', updateBase + '/' + id);
                    titleEl.textContent = 'Edit Recurring Charge';
                    submitEl.textContent = 'Save Changes';
                    idEl.value = id;
                    labelEl.value = btn.dataset.label || '';
                    cadenceEl.value = btn.dataset.cadence || '0';
                    pricingEl.value = btn.dataset.pricingmode || '0';
                    unitEl.value = btn.dataset.unitamount || '0';
                    startEl.value = btn.dataset.startdate || '';
                    endEl.value = btn.dataset.enddate || '';
                    notesEl.value = btn.dataset.notes || '';
                    activeEl.checked = btn.dataset.isactive === 'true';
                    setMask(btn.dataset.weekdaymask || '62');
                    applyCadenceVisibility();
                    applyPricingLabels();
                }

                if (addBtn) addBtn.addEventListener('click', resetForAdd);
                document.querySelectorAll('.edit-charge-btn').forEach(function (b) {
                    b.addEventListener('click', function () { loadFromButton(b); });
                });
                cadenceEl.addEventListener('change', applyCadenceVisibility);
                pricingEl.addEventListener('change', applyPricingLabels);
                dayChecks.forEach(function (c) { c.addEventListener('change', recomputeMask); });
                presets.forEach(function (p) {
                    p.addEventListener('click', function () { setMask(p.dataset.mask); });
                });

                resetForAdd();
            })();
        </script>
    }
}
