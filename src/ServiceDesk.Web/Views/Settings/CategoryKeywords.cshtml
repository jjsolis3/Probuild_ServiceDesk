@model List<ServiceDesk.Core.Models.CategoryKeyword>
@using ServiceDesk.Core.Enums
@using ServiceDesk.Core.Extensions
@{
    ViewData["Title"] = "Category Keywords";
    // Category icon + colour map
    var catStyle = new Dictionary<TicketCategory, (string Icon, string Color)>
    {
        [TicketCategory.ServiceRequest]   = ("bi-clipboard-check",      "#4f46e5"),
        [TicketCategory.HardwareIssue]    = ("bi-pc-display",           "#0d6efd"),
        [TicketCategory.SoftwareIssue]    = ("bi-code-square",          "#198754"),
        [TicketCategory.EmployeeIssue]    = ("bi-person-badge",         "#fd7e14"),
        [TicketCategory.NetworkIssue]     = ("bi-router",               "#0dcaf0"),
        [TicketCategory.SecurityIncident] = ("bi-shield-exclamation",   "#dc3545"),
        [TicketCategory.Other]            = ("bi-question-circle",      "#6c757d"),
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-key"></i> Category Keywords</h1>
        <p class="text-muted mb-0">
            Define keywords used to automatically classify inbound emails into ticket categories.
            When an email arrives, its subject and body are scanned for these keywords and the
            category with the most matches is selected.
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Settings
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4 align-items-start">
@foreach (var cat in Enum.GetValues<TicketCategory>())
{
    var (icon, color) = catStyle.TryGetValue(cat, out var s) ? s : ("bi-tag", "#6c757d");
    var catKeywords = Model.Where(k => k.Category == cat).OrderBy(k => k.Keyword).ToList();
    var activeCount = catKeywords.Count(k => k.IsActive);

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header d-flex align-items-center gap-2 border-0"
                 style="background: linear-gradient(135deg, @(color)18 0%, @(color)08 100%);">
                <div class="rounded-3 p-2" style="background-color: @(color)22;">
                    <i class="bi @icon" style="color: @color; font-size: 1.25rem;"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-0 fw-semibold">@cat.GetDisplayName()</h6>
                    <small class="text-muted">@activeCount active of @catKeywords.Count keywords</small>
                </div>
                <button class="btn btn-sm btn-outline-primary"
                        data-bs-toggle="collapse"
                        data-bs-target="#add-@((int)cat)"
                        aria-expanded="false">
                    <i class="bi bi-plus-lg me-1"></i>Add
                </button>
            </div>

            <!-- Add keyword form (collapsed by default) -->
            <div class="collapse" id="add-@((int)cat)">
                <div class="card-body border-bottom pb-3">
                    <form asp-action="CreateCategoryKeyword" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="category" value="@((int)cat)" />
                        <input type="text" name="keyword" class="form-control form-control-sm"
                               placeholder="e.g. vpn, outlook, printer..."
                               minlength="2" maxlength="100" required />
                        <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                            <i class="bi bi-plus-lg"></i> Add
                        </button>
                    </form>
                    <div class="form-text ms-1">Keyword is stored in lowercase and matched case-insensitively.</div>
                </div>
            </div>

            <!-- Keyword list -->
            <div class="card-body">
                @if (!catKeywords.Any())
                {
                    <p class="text-muted small mb-0 fst-italic">No keywords defined for this category.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var kw in catKeywords)
                        {
                            <span class="badge d-inline-flex align-items-center gap-1 fs-6 fw-normal px-3 py-2"
                                  style="background-color: @(kw.IsActive ? color + "22" : "#f3f4f6");
                                         color: @(kw.IsActive ? color : "#9ca3af");
                                         border: 1px solid @(kw.IsActive ? color + "44" : "#e5e7eb");">
                                @kw.Keyword
                                <!-- Toggle button -->
                                <form asp-action="ToggleCategoryKeyword" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@kw.Id" />
                                    <button type="submit"
                                            class="btn btn-link p-0 border-0"
                                            style="color: inherit; line-height: 1;"
                                            title="@(kw.IsActive ? "Disable keyword" : "Enable keyword")">
                                        <i class="bi @(kw.IsActive ? "bi-eye" : "bi-eye-slash")"
                                           style="font-size: 0.75rem;"></i>
                                    </button>
                                </form>
                                <!-- Delete button -->
                                <form asp-action="DeleteCategoryKeyword" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete keyword \'@kw.Keyword\'?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@kw.Id" />
                                    <button type="submit"
                                            class="btn btn-link p-0 border-0"
                                            style="color: inherit; line-height: 1;"
                                            title="Delete keyword">
                                        <i class="bi bi-x" style="font-size: 0.85rem;"></i>
                                    </button>
                                </form>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
</div>

<div class="alert alert-info mt-4 d-flex gap-3 align-items-start">
    <i class="bi bi-info-circle-fill fs-5 mt-1"></i>
    <div>
        <strong>How keyword detection works:</strong>
        <ul class="mb-0 mt-1">
            <li>When an email arrives, the subject and body are combined and searched for all active keywords.</li>
            <li>Each category is scored by the number of matching keywords — the highest score wins.</li>
            <li>If no keywords match, the ticket is classified as <strong>Other</strong>.</li>
            <li>Disabled keywords (eye icon) are kept for reference but not used in detection.</li>
            <li>Changes take effect immediately for the next inbound email — no restart required.</li>
        </ul>
    </div>
</div>
