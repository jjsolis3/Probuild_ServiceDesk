@model IEnumerable<ServiceDesk.Core.Models.AssignmentRule>
@{
    ViewData["Title"] = "Assignment Rules";
}

<div class="row">
    <div class="col-12">
        <div class="page-title d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-1">Assignment Rules</h4>
                <p class="text-muted mb-0">
                    Rules automatically assign inbound email tickets to the right agent based on
                    detected category and/or the submitter's branch/location.
                    Rules are evaluated in <strong>priority order</strong> — the first match wins.
                </p>
            </div>
            <a asp-action="CreateAssignmentRule" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> New Rule
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- How it works callout -->
        <div class="alert alert-info d-flex align-items-start py-2 mb-3" role="alert">
            <i class="fas fa-info-circle me-2 mt-1 flex-shrink-0"></i>
            <div class="small">
                <strong>How it works:</strong>
                Rules are tested in <strong>priority order</strong> — first match wins.
                Category is detected from email keywords; Branch is pulled from the submitter's Employee record.
                Leave either blank to match <em>any</em> value.
                If no rule matches, the ticket goes to the <strong>Default Assignee</strong> on the email configuration.
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="fas fa-sitemap fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No assignment rules yet</h5>
                    <p class="text-muted">Create your first rule to start automatically routing tickets.</p>
                    <a asp-action="CreateAssignmentRule" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Create First Rule
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px">Priority</th>
                                    <th>Rule Name</th>
                                    <th>Category</th>
                                    <th>Branch / Location</th>
                                    <th>Assign To</th>
                                    <th>Status</th>
                                    <th style="width:120px">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rule in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">@rule.SortOrder</span>
                                        </td>
                                        <td>
                                            <strong>@rule.Name</strong>
                                        </td>
                                        <td>
                                            @if (rule.Category.HasValue)
                                            {
                                                <span class="badge bg-info text-dark">@rule.Category.Value</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">Any</span>
                                            }
                                        </td>
                                        <td>
                                            @if (rule.Branch != null)
                                            {
                                                <span class="badge bg-light text-dark border">
                                                    <i class="fas fa-map-marker-alt me-1 text-danger"></i>@rule.Branch.Name
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">Any</span>
                                            }
                                        </td>
                                        <td>
                                            @if (rule.Assignee != null)
                                            {
                                                <span class="d-flex align-items-center gap-2">
                                                    <span class="avatar-initials-sm rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                                          style="width:28px;height:28px;font-size:0.7rem;font-weight:700;flex-shrink:0;">
                                                        @(rule.Assignee.FirstName.Length > 0 ? rule.Assignee.FirstName[0].ToString() : "")@(rule.Assignee.LastName.Length > 0 ? rule.Assignee.LastName[0].ToString() : "")
                                                    </span>
                                                    @rule.Assignee.FullName
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (rule.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-action="EditAssignmentRule" asp-route-id="@rule.Id"
                                                   class="btn btn-sm btn-outline-secondary" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="DeleteAssignmentRule" asp-route-id="@rule.Id"
                                                      method="post" class="d-inline"
                                                      onsubmit="return confirm('Delete rule \'@rule.Name\'?')">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <p class="text-muted small mt-2">
                <i class="fas fa-lightbulb me-1 text-warning"></i>
                Tip: Rules with the lowest <strong>Priority</strong> number are checked first.
                Put specific rules (category + branch) at a lower number than broad catch-all rules.
            </p>
        }
    </div>
</div>
