@model List<ServiceDesk.Web.Services.GoogleWorkspaceService.GroupInfo>
@{
    ViewData["Title"] = "Google Groups";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="GoogleWorkspace">Google Workspace</a></li>
        <li class="breadcrumb-item active">Google Groups</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1 fs-3 fw-bold">
            <i class="bi bi-people-fill text-primary me-2"></i>Google Groups
        </h1>
        <p class="text-muted mb-0">View all mailing groups in your Workspace domain. Manage individual memberships from each employee's profile.</p>
    </div>
    <a asp-action="GoogleGroups" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.Error</div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-people display-4 d-block mb-3 opacity-25"></i>
            <p class="mb-0">No groups found in your domain, or the Groups scope has not been granted yet.</p>
            <p class="small mt-2">Make sure <code>https://www.googleapis.com/auth/admin.directory.group</code> is added to your DWD configuration in Google Admin Console.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-envelope-at me-2"></i>Domain Groups</span>
            <span class="badge bg-primary">@Model.Count group@(Model.Count == 1 ? "" : "s")</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 ss-datatable" data-export-title="Google Groups">
                    <thead class="table-light">
                        <tr>
                            <th>Group Email</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th class="text-end">Members</th>
                            <th class="no-export text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.OrderBy(x => x.Email))
                        {
                            <tr>
                                <td><code class="small">@g.Email</code></td>
                                <td class="fw-semibold">@g.Name</td>
                                <td class="text-muted small">@(g.Description ?? "—")</td>
                                <td class="text-end">
                                    <span class="badge bg-secondary">@g.MemberCount</span>
                                </td>
                                <td class="text-end no-export">
                                    <a href="https://admin.google.com/ac/groups" target="_blank"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Manage in Google Admin Console">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>Admin Console
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-3 small">
        <i class="bi bi-info-circle me-1"></i>
        To add or remove employees from specific groups, go to the employee's
        <strong>Details → Workspace</strong> tab and use the Group Memberships section.
    </div>
}
