@model IEnumerable<CompanyHoliday>
@{
    ViewData["Title"] = "Company Holidays";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1><i class="bi bi-calendar-event"></i> Company Holidays</h1>
        <p class="text-muted mb-0">Dates listed here pre-select the <span class="badge bg-warning text-dark">Emergency</span> rate when contractors log time on the holiday. Mark a holiday as <em>repeats yearly</em> for fixed-date holidays like New Year's Day or July 4.</p>
    </div>
    <a asp-action="CreateHoliday" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Holiday
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Company Holidays">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Repeats Yearly</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td>@h.Name</td>
                    <td>
                        @if (h.IsRecurringYearly)
                        {
                            <span title="Recurs each year on this month/day">@h.Date.ToString("MMM d")</span>
                        }
                        else
                        {
                            @h.Date.ToString("MMM d, yyyy")
                        }
                    </td>
                    <td>
                        @if (h.IsRecurringYearly)
                        {
                            <span class="badge bg-info text-dark">Yearly</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">One-time</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditHoliday" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="DeleteHoliday" asp-route-id="@h.Id" method="post" class="d-inline"
                              data-confirm-title="Delete Holiday" data-confirm-message="Remove this holiday from the list?">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar-x display-1"></i>
        <p class="mt-3">No company holidays configured yet.</p>
        <a asp-action="CreateHoliday" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Your First Holiday
        </a>
    </div>
}
