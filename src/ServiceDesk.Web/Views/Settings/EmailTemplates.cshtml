@model IEnumerable<EmailTemplate>
@{
    ViewData["Title"] = "Email Templates";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item active">Email Templates</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-envelope-paper text-primary"></i> Email Templates</h1>
        <p class="text-muted mb-0">Customise the HTML layout and content of automated notification emails.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="alert alert-info border-0" role="alert">
    <i class="bi bi-info-circle me-2"></i>
    <strong>How it works:</strong> Each template controls the HTML body of one type of email.
    Use <code>{{"{{"}}TokenName{{"}}"}}</code> placeholders for dynamic values — see the token list on the edit page.
    If a template has no custom body, the system default is used.
</div>

<div class="row g-3">
    @foreach (var tmpl in Model)
    {
        var isCustomised = !string.IsNullOrWhiteSpace(tmpl.BodyTemplate);
        var statusBadge  = tmpl.IsActive
            ? "<span class='badge bg-success'>Active</span>"
            : "<span class='badge bg-secondary'>Disabled</span>";
        var customBadge  = isCustomised
            ? "<span class='badge bg-primary ms-1'>Custom</span>"
            : "<span class='badge bg-light text-muted border ms-1'>Default</span>";

        <div class="col-lg-6">
            <div class="card shadow-sm h-100 @(tmpl.IsActive ? "" : "opacity-75")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-envelope me-1 text-primary"></i>
                            @tmpl.Name
                        </h6>
                        <div>
                            @Html.Raw(statusBadge)
                            @Html.Raw(customBadge)
                        </div>
                    </div>
                    <p class="card-text text-muted small mb-2">@tmpl.Description</p>
                    @if (tmpl.SubjectTemplate != null)
                    {
                        <div class="small text-muted mb-2">
                            <strong>Subject:</strong>
                            <code class="ms-1 small">@tmpl.SubjectTemplate</code>
                        </div>
                    }
                    <div class="small text-muted mb-3">
                        @if (isCustomised)
                        {
                            <span class="text-success"><i class="bi bi-pencil-square me-1"></i>Custom body template active</span>
                        }
                        else
                        {
                            <span><i class="bi bi-code-slash me-1"></i>Using system default body</span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a asp-action="EditEmailTemplate" asp-route-id="@tmpl.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i> Edit Template
                    </a>
                    @if (isCustomised)
                    {
                        <form asp-action="ResetEmailTemplate" asp-route-id="@tmpl.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                    onclick="return confirm('Reset this template to the system default? Your custom body will be removed.');">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset to Default
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
