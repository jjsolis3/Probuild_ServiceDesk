@model EmailConfiguration
@{
    ViewData["Title"] = "Add Email Configuration";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="EmailIntegration">Email Integration</a></li>
        <li class="breadcrumb-item active">New Configuration</li>
    </ol>
</nav>

<h1><i class="bi bi-plus-lg"></i> Add Email Configuration</h1>

<form asp-action="CreateEmailConfig" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row align-items-start">
        <!-- Left Column: Account Details -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-person-badge"></i> Account Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Support Inbox" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EmailAddress" class="form-label"></label>
                        <input asp-for="EmailAddress" class="form-control" type="email" placeholder="support@company.com" />
                        <span asp-validation-for="EmailAddress" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DefaultAssigneeId" class="form-label"></label>
                        <select asp-for="DefaultAssigneeId" class="form-select">
                            <option value="">-- No Default Assignee --</option>
                            @if (ViewBag.Employees != null)
                            {
                                foreach (var employee in (IEnumerable<Employee>)ViewBag.Employees)
                                {
                                    <option value="@employee.Id">@employee.FullName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="DefaultAssigneeId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Gmail API Configuration -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-google"></i> Gmail API Configuration</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="GmailClientId" class="form-label"></label>
                        <input asp-for="GmailClientId" class="form-control" placeholder="your-client-id.apps.googleusercontent.com" />
                        <span asp-validation-for="GmailClientId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GmailClientSecret" class="form-label"></label>
                        <input asp-for="GmailClientSecret" class="form-control" type="password" placeholder="Client secret from Google Cloud Console" />
                        <span asp-validation-for="GmailClientSecret" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="SmtpServer" class="form-label"></label>
                            <input asp-for="SmtpServer" class="form-control" placeholder="smtp.gmail.com" value="smtp.gmail.com" />
                            <span asp-validation-for="SmtpServer" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SmtpPort" class="form-label"></label>
                            <input asp-for="SmtpPort" class="form-control" type="number" value="587" />
                            <span asp-validation-for="SmtpPort" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SmtpUsername" class="form-label"></label>
                        <input asp-for="SmtpUsername" class="form-control" placeholder="e.g. support@company.com" />
                        <div class="form-text">Usually the same as your email address.</div>
                        <span asp-validation-for="SmtpUsername" class="text-danger"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="SmtpPassword" class="form-label"></label>
                        <input asp-for="SmtpPassword" class="form-control" type="password" placeholder="SMTP password or App Password" />
                        <div class="form-text">
                            <i class="bi bi-info-circle"></i>
                            For <strong>Gmail Workspace with 2-Step Verification</strong>, use a
                            <strong>16-character App Password</strong> (not your account password).
                            Generate one at <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener">myaccount.google.com/apppasswords</a>.
                        </div>
                        <span asp-validation-for="SmtpPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Behavior Card (full width below both columns) -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-sliders"></i> Behavior</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="UseSsl" class="form-check-input" type="checkbox" checked />
                            <label asp-for="UseSsl" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="CreateTicketsFromEmails" class="form-check-input" type="checkbox" checked />
                            <label asp-for="CreateTicketsFromEmails" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="AutoReplyOnNewTicket" class="form-check-input" type="checkbox" checked />
                            <label asp-for="AutoReplyOnNewTicket" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="PollIntervalMinutes" class="form-label"></label>
                        <input asp-for="PollIntervalMinutes" class="form-control" type="number" min="1" value="5" />
                        <div class="form-text">How often to check for new emails (in minutes).</div>
                        <span asp-validation-for="PollIntervalMinutes" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Help Text Card -->
    <div class="alert alert-warning d-flex align-items-start mb-4" role="alert">
        <i class="bi bi-lightbulb-fill me-2 mt-1"></i>
        <div>
            <strong>Next Step:</strong> After creating this configuration, you'll need to authorize it with Google.
            Click the <strong>"Authorize with Google"</strong> button on the Email Integration page to complete the OAuth setup.
        </div>
    </div>

    <div class="mt-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Configuration</button>
        <a asp-action="EmailIntegration" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
