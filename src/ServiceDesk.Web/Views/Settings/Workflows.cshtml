@model List<ServiceDesk.Core.Models.WorkflowRule>
@using System.Text.Json

@{
    ViewData["Title"] = "Automation Workflows";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-diagram-3 me-2 text-primary"></i>Automation Workflows</h4>
            <p class="text-muted mb-0 small">Rules are evaluated in sort-order when a ticket is created. All conditions must match (AND logic). Use AI Route action to let Ollama classify priority.</p>
        </div>
        <a asp-action="CreateWorkflow" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Rule
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-diagram-3 text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3 text-muted">No automation rules yet</h5>
                <p class="text-muted small">Create your first rule to automatically triage, assign, or enrich tickets when they arrive.</p>
                <a asp-action="CreateWorkflow" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i>Create First Rule
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3">Order</th>
                            <th>Rule Name</th>
                            <th>Trigger</th>
                            <th>Conditions</th>
                            <th>Actions</th>
                            <th>Runs</th>
                            <th>Last Run</th>
                            <th class="text-center">Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model)
                        {
                            var conditions = TryParseList<ServiceDesk.Core.Models.WorkflowCondition>(rule.ConditionsJson);
                            var actions    = TryParseList<ServiceDesk.Core.Models.WorkflowAction>(rule.ActionsJson);
                            <tr>
                                <td class="px-3 text-muted small">@rule.SortOrder</td>
                                <td>
                                    <div class="fw-semibold">@rule.Name</div>
                                    @if (!string.IsNullOrEmpty(rule.Description))
                                    {
                                        <div class="small text-muted">@rule.Description</div>
                                    }
                                    @if (rule.StopOnMatch)
                                    {
                                        <span class="badge bg-warning text-dark small">Stop on match</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle">
                                        @(rule.Trigger == ServiceDesk.Core.Models.WorkflowTrigger.NewTicket ? "New Ticket" : "Ticket Updated")
                                    </span>
                                </td>
                                <td>
                                    @if (conditions.Count == 0)
                                    {
                                        <span class="text-muted small">Any ticket</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var c in conditions)
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle small">
                                                    @FormatCondition(c)
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var a in actions)
                                        {
                                            <span class="badge @ActionBadgeClass(a.Type) small">
                                                @FormatAction(a)
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-muted small">@rule.RunCount.ToString("N0")</td>
                                <td class="text-muted small">
                                    @(rule.LastRunAt.HasValue ? rule.LastRunAt.Value.ToString("MMM d, HH:mm") : "—")
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <input class="form-check-input workflow-toggle" type="checkbox"
                                               data-id="@rule.Id"
                                               @(rule.IsActive ? "checked" : "")>
                                    </div>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="EditWorkflow" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteWorkflow" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete rule \'@rule.Name\'?')">
                                        <input type="hidden" name="id" value="@rule.Id" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- How it works info panel -->
        <div class="card border-0 bg-light mt-4">
            <div class="card-body">
                <h6 class="mb-2"><i class="bi bi-info-circle me-1 text-primary"></i>How Automation Works</h6>
                <div class="row g-3 small text-muted">
                    <div class="col-md-3">
                        <strong>1. Trigger</strong><br>Rules fire when a new ticket is created (or updated).
                    </div>
                    <div class="col-md-3">
                        <strong>2. Conditions</strong><br>ALL conditions must match. Leave empty to match every ticket.
                    </div>
                    <div class="col-md-3">
                        <strong>3. Actions</strong><br>Executed in order — assign agent, set priority, add note, or let AI route.
                    </div>
                    <div class="col-md-3">
                        <strong>4. Stop on Match</strong><br>Prevents lower-priority rules from also running for the same ticket.
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
<script>
document.querySelectorAll('.workflow-toggle').forEach(function(cb) {
    cb.addEventListener('change', function() {
        const id = this.dataset.id;
        fetch('/Settings/ToggleWorkflow', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
            },
            body: 'id=' + id
        }).then(r => {
            if (!r.ok) { this.checked = !this.checked; }
        }.bind(this));
    });
});
</script>
@Html.AntiForgeryToken()
}

@functions {
    static List<T> TryParseList<T>(string json)
    {
        try { return System.Text.Json.JsonSerializer.Deserialize<List<T>>(json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? []; }
        catch { return []; }
    }

    static string FormatCondition(ServiceDesk.Core.Models.WorkflowCondition c)
    {
        var field = c.Field switch
        {
            "category"            => "Category",
            "priority"            => "Priority",
            "keyword_title"       => "Title",
            "keyword_description" => "Description",
            "assignee_empty"      => "Assignee",
            "branch"              => "Branch",
            _                     => c.Field
        };
        var op = c.Operator switch
        {
            "equals"       => "=",
            "not_equals"   => "≠",
            "contains"     => "contains",
            "not_contains" => "!contains",
            "is_empty"     => "is empty",
            "not_empty"    => "is set",
            _              => c.Operator
        };
        return c.Operator is "is_empty" or "not_empty"
            ? $"{field} {op}"
            : $"{field} {op} {c.Value}";
    }

    static string FormatAction(ServiceDesk.Core.Models.WorkflowAction a)
    {
        return a.Type switch
        {
            "assign_agent"  => $"Assign: {a.Label ?? a.Value}",
            "set_priority"  => $"Priority → {a.Value}",
            "add_note"      => "Add Note",
            "ai_route"      => "AI Route",
            _               => a.Type
        };
    }

    static string ActionBadgeClass(string type)
    {
        return type switch
        {
            "assign_agent"  => "bg-primary bg-opacity-10 text-primary border border-primary-subtle",
            "set_priority"  => "bg-warning bg-opacity-10 text-warning border border-warning-subtle",
            "add_note"      => "bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle",
            "ai_route"      => "bg-success bg-opacity-10 text-success border border-success-subtle",
            _               => "bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle"
        };
    }
}
