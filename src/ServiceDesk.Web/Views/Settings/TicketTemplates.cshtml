@model IEnumerable<TicketTemplate>
@{
    ViewData["Title"] = "Ticket Templates";
    var categories = ViewBag.Categories as Dictionary<int, string> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1><i class="bi bi-file-earmark-text"></i> Ticket Templates</h1>
        <p class="text-muted mb-0">Reusable boilerplate that agents can pick from when creating a ticket. Pre-fills Title, Description, Category, Sub-Category, and Priority.</p>
    </div>
    <a asp-action="CreateTicketTemplate" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Template
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-file-earmark-text" style="font-size: 3rem; color: #dee2e6;"></i>
            <h5 class="mt-3">No templates yet</h5>
            <p class="text-muted mb-3">Create your first template to give agents boilerplate for common issue types — new hire setup, password resets, equipment requests, etc.</p>
            <a asp-action="CreateTicketTemplate" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Create First Template
            </a>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover ss-datatable" data-export-title="Ticket Templates">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Pre-filled Title</th>
                    <th>Sort</th>
                    <th>Active</th>
                    <th class="no-sort no-export">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var priorityBadge = item.Priority switch {
                        TicketPriority.Critical => "bg-danger",
                        TicketPriority.High     => "bg-warning text-dark",
                        TicketPriority.Medium   => "bg-info text-dark",
                        _                       => "bg-secondary"
                    };
                    <tr>
                        <td class="fw-semibold">
                            @item.Name
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="text-muted small fw-normal">@item.Description</div>
                            }
                        </td>
                        <td>
                            @if (categories.TryGetValue(item.Category, out var catName))
                            {
                                <span class="badge bg-info text-dark">@catName</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td><span class="badge @priorityBadge">@item.Priority</span></td>
                        <td class="text-muted small" style="max-width:350px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">
                            @item.TitleTemplate
                        </td>
                        <td>@item.SortOrder</td>
                        <td>
                            <form asp-action="ToggleTicketTemplate" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent" title="Toggle active">
                                    @if (item.IsActive)
                                    { <span class="badge bg-success">Active</span> }
                                    else
                                    { <span class="badge bg-secondary">Inactive</span> }
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-action="EditTicketTemplate" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="DeleteTicketTemplate" asp-route-id="@item.Id" method="post"
                                  class="d-inline"
                                  data-confirm-title="Delete Template" data-confirm-message="Delete this ticket template? This cannot be undone.">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
