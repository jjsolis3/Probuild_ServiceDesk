@model IEnumerable<Role>
@{
    ViewData["Title"] = "Roles & Permissions";

    var permissionColors = new Dictionary<string, string>
    {
        { "ManageTickets", "primary" },
        { "ManageAssets", "success" },
        { "ManageEmployees", "info" },
        { "ManageSubscriptions", "warning" },
        { "ManageServices", "secondary" },
        { "ViewReports", "dark" },
        { "ManageSettings", "danger" },
        { "ManageUsers", "primary" },
        { "ManageRoles", "danger" },
        { "SubmitTickets", "success" },
        { "ViewOwnTickets", "info" },
        { "ViewTickets", "secondary" }
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item active">Roles &amp; Permissions</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-shield-lock" style="color: #6f42c1;"></i> Roles &amp; Permissions</h1>
        <p class="text-muted mb-0">Define roles and assign permissions for IT staff and portal users.</p>
    </div>
    <a asp-action="CreateRole" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Role
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Roles & Permissions">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Permissions</th>
                <th class="text-center">Users</th>
                <th class="text-center">System</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>
                        <strong>@role.Name</strong>
                    </td>
                    <td class="text-muted small">
                        @(role.Description ?? "--")
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(role.Permissions))
                        {
                            @foreach (var perm in role.Permissions.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                var colorClass = permissionColors.ContainsKey(perm) ? permissionColors[perm] : "secondary";
                                <span class="badge bg-@colorClass me-1 mb-1" style="font-size: 0.7rem;">@perm</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No permissions</span>
                        }
                    </td>
                    <td class="text-center">
                        <span class="badge bg-light text-dark border">@role.Users.Count</span>
                    </td>
                    <td class="text-center">
                        @if (role.IsSystem)
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-lock-fill me-1"></i>System
                            </span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditRole" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        @if (!role.IsSystem)
                        {
                            <form asp-action="DeleteRole" asp-route-id="@role.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete role \'@role.Name\'? This cannot be undone.')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-shield-x display-1"></i>
        <p class="mt-3">No roles defined yet. Click "Add Role" to create your first role.</p>
    </div>
}
