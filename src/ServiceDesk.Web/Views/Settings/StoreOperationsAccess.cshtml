@using ServiceDesk.Core.Models
@{
    ViewData["Title"] = "Store Operations Access";
    var accessList = ViewBag.AccessList as List<StoreOperationsAccess> ?? new();
    var allUsers   = ViewBag.AllUsers   as List<PortalUser>            ?? new();
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="StoreSettings">Store Settings</a></li>
        <li class="breadcrumb-item active">Operations Access</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0"><i class="bi bi-boxes text-primary me-2"></i>Operations Hub Access</h1>
        <p class="text-muted small mt-1 mb-0">
            @accessList.Count designated user(s) can access the Operations Hub to manage and fulfil store orders.
            Admin and IT Agent accounts always have access by default.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Grant Access -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Grant Access</h5>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">
                    Operations staff can view all orders, update statuses, and trigger email notifications
                    to employees — but have no access to tickets, assets, or other system features.
                </p>
                @if (!allUsers.Any())
                {
                    <p class="text-muted small mb-0">All active portal users already have Operations Hub access.</p>
                }
                else
                {
                    <form method="post" asp-action="StoreOperationsAccessGrant" asp-antiforgery="true">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Select User</label>
                            <select name="portalUserId" class="form-select" required>
                                <option value="">— choose a user —</option>
                                @foreach (var u in allUsers)
                                {
                                    <option value="@u.Id">@u.FullName (@u.Email)</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-boxes me-1"></i>Grant Operations Access
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3 border-0 bg-light shadow-sm">
            <div class="card-body py-3">
                <h6 class="fw-bold mb-2"><i class="bi bi-info-circle me-1 text-primary"></i>What ops staff can do</h6>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-1">View all store orders for any quarter</li>
                    <li class="mb-1">Mark orders Confirmed, Fulfilled, or Cancelled</li>
                    <li class="mb-1">Each status change triggers an email to the ordering employee</li>
                    <li class="mb-1">See product totals to assist bulk purchasing</li>
                    <li>Export orders as CSV</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Current Access List -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Current Operations Staff</h5>
            </div>
            @if (!accessList.Any())
            {
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-boxes display-4 d-block mb-2 opacity-25"></i>
                    <p class="mb-0">No portal users have been designated as operations staff.</p>
                    <p class="small mt-1">Admin and IT Agent accounts can always access the Operations Hub.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Granted By</th>
                                <th>Granted Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in accessList)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@a.PortalUser.FullName</div>
                                        <div class="text-muted small">@a.PortalUser.Email</div>
                                    </td>
                                    <td class="text-muted small">@(a.GrantedBy?.FullName ?? "System")</td>
                                    <td class="text-muted small">@a.GrantedDate.ToString("MMM d, yyyy")</td>
                                    <td class="text-end">
                                        <form method="post"
                                              asp-action="StoreOperationsAccessRevoke"
                                              asp-route-id="@a.Id"
                                              asp-antiforgery="true"
                                              class="d-inline"
                                              onsubmit="return confirm('Revoke Operations Hub access for @Html.Raw(a.PortalUser.FullName.Replace("'", "\\'"))?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-person-dash me-1"></i>Revoke
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
