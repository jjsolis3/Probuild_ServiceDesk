@model UserGroup
@{
    ViewData["Title"] = $"Edit Group - {Model.Name}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Groups">Groups</a></li>
        <li class="breadcrumb-item active">Edit @Model.Name</li>
    </ol>
</nav>

<h1><i class="bi bi-pencil"></i> Edit @Model.Name</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="EditGroup" data-loading-btn="btnSave">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" id="btnSave" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a asp-action="Groups" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<!-- Members Section -->
<hr class="my-4" />

<div class="row">
    <div class="col-md-10">
        <h3><i class="bi bi-people"></i> Members</h3>

        @if (Model.Members.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover ss-datatable-compact">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Joined Date</th>
                            <th class="no-sort">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td>
                                    @if (member.PortalUser != null)
                                    {
                                        @member.PortalUser.FullName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown User</span>
                                    }
                                </td>
                                <td>
                                    @if (member.PortalUser != null)
                                    {
                                        @member.PortalUser.Email
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@member.JoinedDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <form asp-action="RemoveGroupMember" method="post" class="d-inline">
                                        <input type="hidden" name="groupId" value="@Model.Id" />
                                        <input type="hidden" name="memberId" value="@member.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to remove this member from the group?');">
                                            <i class="bi bi-person-x"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-person-plus display-4"></i>
                <p class="mt-2">No members in this group yet. Add one below.</p>
            </div>
        }

        <!-- Add Member Form -->
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-person-plus"></i> Add Member</h5>
            </div>
            <div class="card-body">
                <form asp-action="AddGroupMember" method="post" class="row g-3 align-items-end">
                    <input type="hidden" name="groupId" value="@Model.Id" />
                    <div class="col-md-8">
                        <label for="userId" class="form-label">Select User</label>
                        <select name="userId" id="userId" class="form-select" required>
                            <option value="">-- Select a User --</option>
                            @if (ViewBag.AvailableUsers != null)
                            {
                                foreach (var user in (IEnumerable<PortalUser>)ViewBag.AvailableUsers)
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-lg"></i> Add Member
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
