@model IEnumerable<CannedResponse>
@{
    ViewData["Title"] = "Canned Responses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1><i class="bi bi-chat-square-text"></i> Canned Responses</h1>
        <p class="text-muted mb-0">Saved reply templates that agents can insert into ticket notes with one click.</p>
    </div>
    <a asp-action="CreateCannedResponse" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Template
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Canned Responses">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Preview</th>
                <th>Sort</th>
                <th>Active</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Title</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Category))
                        {
                            <span class="badge bg-info text-dark">@item.Category</span>
                        }
                    </td>
                    <td class="text-muted small" style="max-width:350px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">
                        @item.Content
                    </td>
                    <td>@item.SortOrder</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditCannedResponse" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="DeleteCannedResponse" asp-route-id="@item.Id" method="post"
                              class="d-inline"
                              data-confirm-title="Delete Template" data-confirm-message="Delete this canned response? This cannot be undone.">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
