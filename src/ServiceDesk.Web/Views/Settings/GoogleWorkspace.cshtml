@model ServiceDesk.Core.Models.GoogleWorkspaceSettings
@{
    ViewData["Title"] = "Google Workspace";
    bool configured = Model?.IsConfigured ?? false;
    bool testPassed = Model?.LastTestPassed ?? false;
}

@Html.AntiForgeryToken()
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item active">Google Workspace</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1 fs-3 fw-bold">
            <i class="bi bi-google text-primary me-2"></i>Google Workspace Integration
        </h1>
        <p class="text-muted mb-0">
            Connect a Service Account with Domain-Wide Delegation to manage Gmail signatures for all employees.
        </p>
    </div>
    @if (configured)
    {
        <form asp-action="TestGoogleWorkspace" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-wifi me-1"></i>Test Connection
            </button>
        </form>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-3">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-3">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Status card -->
@if (configured)
{
    <div class="alert @(testPassed ? "alert-success" : "alert-warning") d-flex align-items-center gap-3 mb-4">
        <i class="bi @(testPassed ? "bi-check-circle-fill" : "bi-exclamation-circle-fill") fs-4"></i>
        <div>
            <strong>@(testPassed ? "Connected" : "Not verified")</strong>
            @if (Model!.LastTestedDate.HasValue)
            {
                <span class="ms-2 small text-muted">Last tested @Model.LastTestedDate.Value.ToString("MMM d, yyyy h:mm tt")</span>
            }
            @if (!string.IsNullOrEmpty(Model!.LastTestResult))
            {
                <div class="small mt-1">@Model.LastTestResult</div>
            }
        </div>
    </div>
}

<div class="row g-4">

    <!-- Setup steps -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header fw-semibold"><i class="bi bi-list-ol me-2"></i>Setup Checklist</div>
            <div class="card-body">
                <ol class="ps-3 mb-0" style="line-height:2.1;">
                    <li>In <strong>Google Cloud Console</strong>, enable the <em>Gmail API</em> and <em>Admin SDK API</em> for your project.</li>
                    <li>Create a <strong>Service Account</strong> and download its JSON key.</li>
                    <li>In the Service Account details, enable <strong>Domain-Wide Delegation</strong> and copy the Client ID.</li>
                    <li>In <strong>Google Admin Console</strong> → Security → API Controls → Domain-wide Delegation, paste the Client ID and add the scopes below.
                        <div class="mt-2 mb-1">
                            <span class="badge bg-primary me-1">Required</span> — core features (signatures, suspend, groups, storage):
                        </div>
                        <ul class="mt-1 mb-2 ps-3 small" style="line-height:2;">
                            <li><code>https://www.googleapis.com/auth/gmail.settings.basic</code> <span class="text-muted">(signatures, OOO)</span></li>
                            <li><code>https://www.googleapis.com/auth/admin.directory.user</code> <span class="text-muted">(user info, suspend, password reset, 2FA status)</span></li>
                            <li><code>https://www.googleapis.com/auth/admin.directory.group</code> <span class="text-muted">(group memberships)</span></li>
                            <li><code>https://www.googleapis.com/auth/admin.reports.usage.readonly</code> <span class="text-muted">(Drive/Gmail storage usage)</span></li>
                        </ul>
                        <div class="mt-1 mb-1">
                            <span class="badge bg-secondary me-1">Optional</span> — advanced features (add when needed):
                        </div>
                        <ul class="mt-1 mb-1 ps-3 small" style="line-height:2;">
                            <li><code>https://www.googleapis.com/auth/admin.directory.user.security</code> <span class="text-muted">(OAuth app audit &amp; token revocation)</span></li>
                            <li><code>https://www.googleapis.com/auth/admin.reports.audit.readonly</code> <span class="text-muted">(login activity)</span></li>
                            <li><code>https://www.googleapis.com/auth/admin.datatransfer</code> <span class="text-muted">(offboarding Drive file transfer)</span></li>
                            <li><code>https://www.googleapis.com/auth/drive.readonly</code> <span class="text-muted">(list shared drives for transfer picker)</span></li>
                        </ul>
                        <div class="alert alert-warning py-1 small mt-2 mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Important:</strong> Each scope set must be saved as one comma-separated entry for the same Client ID. Adding even one unauthorized scope to a JWT breaks <em>all</em> API calls that use that token.
                        </div>
                    </li>
                    <li>Upload the JSON key below and click <strong>Save</strong>.</li>
                    <li>Click <strong>Test Connection</strong> to verify.</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- Configuration form -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header fw-semibold"><i class="bi bi-gear me-2"></i>Configuration</div>
            <div class="card-body">
                <form asp-action="GoogleWorkspace" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Admin / Impersonation Email <span class="text-danger">*</span></label>
                            <input type="email" name="adminEmail" class="form-control"
                                   value="@(Model?.AdminEmail ?? "")"
                                   placeholder="admin@yourdomain.com" required />
                            <div class="form-text">A Workspace admin email used to test the connection.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Workspace Domain <span class="text-danger">*</span></label>
                            <input type="text" name="domain" class="form-control"
                                   value="@(Model?.Domain ?? "")"
                                   placeholder="yourdomain.com" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Service Account JSON Key
                            @if (configured)
                            { <span class="badge bg-success ms-1">Uploaded</span> }
                        </label>
                        <input type="file" name="serviceAccountFile" class="form-control"
                               accept=".json" @(configured ? "" : "required") />
                        <div class="form-text">
                            @if (configured)
                            { <span>Leave blank to keep the existing key. Upload a new file to replace it.</span> }
                            else
                            { <span>Download from Google Cloud Console → IAM & Admin → Service Accounts → Keys.</span> }
                        </div>
                    </div>

                    <!-- Signature template -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Default Signature Template</label>
                        <div class="form-text mb-2">
                            Variables: <code>{FIRST_NAME}</code> <code>{LAST_NAME}</code>
                            <code>{FIRST_NAME_SLUG}</code> <code>{LAST_NAME_SLUG}</code>
                            <code>{FULL_NAME}</code> <code>{JOB_TITLE}</code>
                            <code>{EMAIL}</code> <code>{EMAIL_DISPLAY}</code>
                            <code>{PHONE}</code> <code>{DEPARTMENT}</code>
                            <code>{BRANCH}</code> <code>{BRANCH_PHONE}</code>
                            <code>{COST_CENTER}</code> <code>{BUILDING_ID}</code>
                            <div class="mt-1 text-muted" style="font-size:0.8rem;">
                                <i class="bi bi-info-circle me-1"></i>
                                <code>{FIRST_NAME_SLUG}</code> / <code>{LAST_NAME_SLUG}</code> replace spaces with underscores (e.g. <em>Mary_Jane</em>) — use these in image file paths.
                                <code>{EMAIL_DISPLAY}</code> converts <em>.org</em> → <em>.com</em>.
                                <code>{COST_CENTER}</code> is the branch cost center code (e.g. <em>LAX</em>); <code>{BUILDING_ID}</code> is the branch building ID (e.g. <em>LA</em>).
                            </div>
                        </div>
                        <textarea name="signatureTemplate" class="form-control font-monospace"
                                  rows="10" placeholder="Paste your HTML signature template here...">@(Model?.SignatureTemplate ?? "")</textarea>
                        <div class="form-text">HTML is supported. This template is applied when you update a signature from an Employee's profile.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Save Settings
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Template preview -->
        @if (!string.IsNullOrEmpty(Model?.SignatureTemplate))
        {
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header fw-semibold d-flex justify-content-between">
                    <span><i class="bi bi-eye me-2"></i>Template Preview (sample values)</span>
                    <span class="badge bg-secondary">Read-only</span>
                </div>
                <div class="card-body">
                    @{
                        var preview = (Model.SignatureTemplate ?? "")
                            .Replace("{FIRST_NAME}",      "Jane")
                            .Replace("{LAST_NAME}",       "Smith")
                            .Replace("{FULL_NAME}",       "Jane Smith")
                            .Replace("{FIRST_NAME_SLUG}", "Jane")
                            .Replace("{LAST_NAME_SLUG}",  "Smith")
                            .Replace("{JOB_TITLE}",       "IT Manager")
                            .Replace("{EMAIL}",           "jsmith@yourdomain.org")
                            .Replace("{EMAIL_DISPLAY}",   "jsmith@yourdomain.com")
                            .Replace("{PHONE}",           "(555) 000-1234")
                            .Replace("{DEPARTMENT}",      "Information Technology")
                            .Replace("{BRANCH}",          "Main Office")
                            .Replace("{BRANCH_PHONE}",    "(555) 000-0000")
                            .Replace("{COST_CENTER}",     "LAX")
                            .Replace("{BUILDING_ID}",     "LA");
                    }
                    <div class="border rounded p-3 bg-light" style="font-family:Arial,sans-serif;font-size:14px;">
                        @Html.Raw(preview)
                    </div>
                </div>
            </div>
        }

        <!-- ── Bulk Signature Push ───────────────────────────────────────── -->
        @if (configured)
        {
            <div class="card shadow-sm border-0 mt-4" id="bulkPushCard">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-send me-2 text-primary"></i>Bulk Signature Push</span>
                    <span class="badge bg-primary" id="bulkBadge">Active employees</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Apply the configured template to every active employee's Gmail account at once.
                        Signatures are set for <strong>new emails, replies, and forwards</strong> — no per-user
                        action needed after the push.
                    </p>

                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <!-- Include aliases toggle -->
                        <div class="form-check form-switch d-flex align-items-center gap-2">
                            <input class="form-check-input" type="checkbox" id="bulkIncludeAliases" role="switch"
                                   style="width:2.5em;height:1.4em;" checked />
                            <label class="form-check-label fw-semibold" for="bulkIncludeAliases">
                                Include alias addresses
                                <span class="text-muted fw-normal small">(e.g. .com alias alongside .org login)</span>
                            </label>
                        </div>
                        <!-- Active only toggle -->
                        <div class="form-check form-switch d-flex align-items-center gap-2">
                            <input class="form-check-input" type="checkbox" id="bulkActiveOnly" role="switch"
                                   style="width:2.5em;height:1.4em;" checked
                                   onchange="document.getElementById('bulkBadge').textContent = this.checked ? 'Active employees' : 'All employees'" />
                            <label class="form-check-label fw-semibold" for="bulkActiveOnly">
                                Active employees only
                            </label>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Reply &amp; forward behavior:</strong> Gmail applies the saved signature whenever
                        composing from a send-as address — new email, reply, and forward are all covered automatically.
                        The Gmail web "before quoted text" placement preference is a per-user client setting that
                        does not affect whether the signature appears.
                    </div>

                    <button class="btn btn-primary" id="bulkPushBtn" onclick="startBulkPush()">
                        <i class="bi bi-send me-1"></i>Apply Signature to All
                    </button>

                    <!-- Progress / results -->
                    <div id="bulkProgress" class="mt-3 d-none">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="spinner-border spinner-border-sm text-primary" id="bulkSpinner"></div>
                            <span id="bulkProgressText" class="small">Applying signatures…</span>
                        </div>
                        <div class="progress mb-3" style="height:8px;">
                            <div id="bulkProgressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                                 style="width:100%"></div>
                        </div>
                    </div>

                    <div id="bulkResults" class="mt-3 d-none">
                        <div id="bulkSummary" class="mb-2 fw-semibold small"></div>
                        <div class="table-responsive" style="max-height:320px;overflow-y:auto;">
                            <table class="table table-sm table-hover mb-0 small" id="bulkResultTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Employee</th>
                                        <th>Email</th>
                                        <th>Result</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody id="bulkResultBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function startBulkPush() {
    var btn         = document.getElementById('bulkPushBtn');
    var progress    = document.getElementById('bulkProgress');
    var results     = document.getElementById('bulkResults');
    var includeAl   = document.getElementById('bulkIncludeAliases').checked;
    var activeOnly  = document.getElementById('bulkActiveOnly').checked;

    btn.disabled = true;
    results.classList.add('d-none');
    progress.classList.remove('d-none');
    document.getElementById('bulkProgressText').textContent = 'Applying signatures — this may take a minute…';

    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    fetch('@Url.Action("BulkApplySignatures", "Settings")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': token
        },
        body: 'includeAliases=' + includeAl + '&activeOnly=' + activeOnly +
              '&__RequestVerificationToken=' + encodeURIComponent(token)
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        progress.classList.add('d-none');
        btn.disabled = false;

        if (!data.success) {
            alert('Error: ' + data.message);
            return;
        }

        var s = data.successCount, f = data.failedCount, sk = data.skippedCount;
        var summaryEl = document.getElementById('bulkSummary');
        summaryEl.innerHTML =
            '<span class="text-success me-3"><i class="bi bi-check-circle me-1"></i>' + s + ' succeeded</span>' +
            (f  > 0 ? '<span class="text-danger me-3"><i class="bi bi-x-circle me-1"></i>'  + f  + ' failed</span>'  : '') +
            (sk > 0 ? '<span class="text-muted"><i class="bi bi-dash-circle me-1"></i>'     + sk + ' skipped</span>' : '');

        var tbody = document.getElementById('bulkResultBody');
        tbody.innerHTML = '';
        (data.results || []).forEach(function(r) {
            var badge = r.status === 'success'
                ? '<span class="badge bg-success">Success</span>'
                : r.status === 'skipped'
                    ? '<span class="badge bg-secondary">Skipped</span>'
                    : '<span class="badge bg-danger">Failed</span>';
            var row = '<tr><td>' + escHtml(r.name) + '</td><td class="text-muted">' +
                      escHtml(r.email) + '</td><td>' + badge + '</td><td class="text-muted small">' +
                      escHtml(r.message) + '</td></tr>';
            tbody.insertAdjacentHTML('beforeend', row);
        });

        results.classList.remove('d-none');
    })
    .catch(function(err) {
        progress.classList.add('d-none');
        btn.disabled = false;
        alert('Request failed: ' + err);
    });
}

function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>
}
