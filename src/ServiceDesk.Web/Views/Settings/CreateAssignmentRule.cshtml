@model ServiceDesk.Core.Models.AssignmentRule
@{
    ViewData["Title"] = "Create Assignment Rule";
    var branches  = ViewBag.Branches  as IEnumerable<ServiceDesk.Core.Models.Branch>   ?? Enumerable.Empty<ServiceDesk.Core.Models.Branch>();
    var employees = ViewBag.Employees as IEnumerable<ServiceDesk.Core.Models.Employee> ?? Enumerable.Empty<ServiceDesk.Core.Models.Employee>();
    var categories = ViewBag.Categories as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-4">
            <a asp-action="AssignmentRules" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h4 class="mb-0">Create Assignment Rule</h4>
        </div>

        <div class="card">
            <div class="card-body">
                <form asp-action="CreateAssignmentRule" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small d-none" id="valSummary"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Hardware – Dallas Office" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                        <div class="form-text">A descriptive label so you can identify the rule at a glance.</div>
                    </div>

                    <hr class="my-3" />
                    <h6 class="text-muted fw-semibold mb-3">Match Conditions <span class="fw-normal">(leave blank to match any)</span></h6>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="">— Any Category —</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Value">@cat.Text</option>
                                }
                            </select>
                            <div class="form-text">Leave blank to match all categories.</div>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="BranchId" class="form-label fw-semibold"></label>
                            <select asp-for="BranchId" class="form-select">
                                <option value="">— Any Branch —</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name@(b.City != null ? $" – {b.City}" : "")</option>
                                }
                            </select>
                            <div class="form-text">Leave blank to match all locations.</div>
                        </div>
                    </div>

                    <hr class="my-3" />
                    <h6 class="text-muted fw-semibold mb-3">Assignment Action</h6>

                    <div class="mb-3">
                        <label asp-for="AssigneeId" class="form-label fw-semibold"></label>
                        <select asp-for="AssigneeId" class="form-select">
                            <option value="">— Select Agent —</option>
                            @foreach (var emp in employees)
                            {
                                <option value="@emp.Id">@emp.FullName (@emp.Department)</option>
                            }
                        </select>
                        <span asp-validation-for="AssigneeId" class="text-danger small"></span>
                    </div>

                    <hr class="my-3" />
                    <h6 class="text-muted fw-semibold mb-3">Rule Settings</h6>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-4">
                            <label asp-for="SortOrder" class="form-label fw-semibold"></label>
                            <input asp-for="SortOrder" type="number" class="form-control" min="1" max="9999" />
                            <div class="form-text">Lower = checked first. Use 10–50 for specific rules, 90–100 for catch-alls.</div>
                        </div>
                        <div class="col-sm-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Save Rule
                        </button>
                        <a asp-action="AssignmentRules" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
