@model IEnumerable<AppSetting>
@{
    ViewData["Title"] = "AI Triage Settings";

    // Keys that should render as toggle switches
    var boolKeys    = new[] { "AiTriageEnabled", "OllamaEnabled",
                              "GeminiEnabled", "OpenAiEnabled", "AnthropicEnabled",
                              "OllamaWarmupEnabled", "AiLlmEnrichmentEnabled" };

    // Keys that should render as dropdowns
    var modeOptions = new[] { "RecommendOnly", "AutoApply" };

    // API-key fields — rendered as password with a mask so the current value
    // is never re-displayed. Blank submit = "leave existing value alone";
    // typing a new value replaces it (encrypted by the POST handler).
    var secretKeys  = new[] { "GeminiApiKey", "OpenAiApiKey", "AnthropicApiKey" };

    // Provider selector dropdowns.
    var providerKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "AiProvider", "AiProviderDraft", "AiProviderTriage"
    };
    var providerOptions = new (string Value, string Label)[]
    {
        ("",          "— use default —"),
        ("ollama",    "Ollama (local)"),
        ("gemini",    "Google Gemini"),
        ("openai",    "OpenAI (GPT)"),
        ("anthropic", "Anthropic Claude"),
    };

    var lastLog = ViewBag.LastRunLog as ServiceDesk.Core.Models.AiRunLog;
    var totalTrained = (int)(ViewBag.TotalTrainingTickets ?? 0);
    var modelIsTrained = (bool)(ViewBag.ModelIsTrained ?? false);
    var minTraining = (int)(ViewBag.MinTrainingTickets ?? 20);

    // Tab layout: each provider gets its own tab, plus a General tab for the
    // cross-provider triage / enrichment / provider-selection knobs. A key
    // maps to a tab by prefix; the General bucket catches everything that
    // isn't part of a provider block.
    var tabDefs = new (string Id, string Label, string Icon, Func<string, bool> Match)[]
    {
        ("general",   "General",   "bi-gear-fill",         k => k.StartsWith("AiProvider", StringComparison.Ordinal)
                                                              || k.StartsWith("AiTriage", StringComparison.Ordinal)
                                                              || k.StartsWith("AiConfidence", StringComparison.Ordinal)
                                                              || k.StartsWith("AiMin", StringComparison.Ordinal)
                                                              || k.StartsWith("AiLlm", StringComparison.Ordinal)),
        ("ollama",    "Ollama",    "bi-hdd-stack",         k => k.StartsWith("Ollama",    StringComparison.Ordinal)),
        ("gemini",    "Gemini",    "bi-stars",             k => k.StartsWith("Gemini",    StringComparison.Ordinal)),
        ("openai",    "OpenAI",    "bi-cpu",               k => k.StartsWith("OpenAi",    StringComparison.Ordinal)),
        ("anthropic", "Anthropic", "bi-chat-square-quote", k => k.StartsWith("Anthropic", StringComparison.Ordinal)),
    };
    var allSettings = Model.ToList();
    var settingsByTab = tabDefs.ToDictionary(
        t => t.Id,
        t => allSettings.Where(s => t.Match(s.Key)).OrderBy(s => s.Key).ToList());
    // Anything the prefix rules didn't catch falls into General so no setting
    // is ever silently missing from the UI.
    var alreadyAssigned = settingsByTab.Values.SelectMany(l => l).Select(s => s.Key).ToHashSet();
    var leftover = allSettings.Where(s => !alreadyAssigned.Contains(s.Key)).ToList();
    if (leftover.Count > 0)
        settingsByTab["general"].AddRange(leftover);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item active">AI Triage</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-robot text-primary"></i> AI Triage Settings</h1>
        <p class="text-muted mb-0">Configure ML.NET-powered automatic ticket triage and Ollama LLM draft replies.</p>
    </div>
    <a asp-action="AiDashboard" class="btn btn-outline-success">
        <i class="bi bi-bar-chart-line me-1"></i>View AI Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ── Live model status banner ──────────────────────────────────────────── -->
<div class="card shadow-sm border-0 mb-4 @(modelIsTrained ? "border-start border-4 border-success" : totalTrained < minTraining ? "border-start border-4 border-warning" : "border-start border-4 border-secondary")">
    <div class="card-body py-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-3">
                <div class="small text-muted">Model status</div>
                @if (modelIsTrained)
                {
                    <div class="fs-5"><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Ready</span></div>
                }
                else if (totalTrained < minTraining)
                {
                    <div class="fs-5"><span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Insufficient Data</span></div>
                }
                else
                {
                    <div class="fs-5"><span class="badge bg-secondary"><i class="bi bi-cpu me-1"></i>Awaiting First Train</span></div>
                }
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Training samples</div>
                <div class="fs-5 fw-semibold @(totalTrained >= minTraining ? "text-success" : "text-warning")">
                    @totalTrained <span class="text-muted fw-normal small">/ @minTraining min</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Last trained</div>
                <div class="fs-6 fw-semibold">
                    @if (lastLog != null)
                    {
                        <span title="@lastLog.RunDate.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")">
                            @lastLog.RunDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">Never</span>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Last run result</div>
                @if (lastLog == null)
                {
                    <div class="text-muted">—</div>
                }
                else if (lastLog.Success)
                {
                    <div class="text-success"><i class="bi bi-check-circle me-1"></i>Success (@lastLog.TrainingTicketCount tickets)</div>
                }
                else
                {
                    <div class="text-danger" title="@lastLog.ErrorMessage"><i class="bi bi-x-circle me-1"></i>Failed</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 align-items-start">
    <!-- ── Left column: settings form ─────────────────────────────────────── -->
    <div class="col-lg-8">

        <form method="post" asp-action="Ai" asp-antiforgery="true">
            <div class="card shadow-sm mb-4">
                <div class="card-header p-0">
                    <ul class="nav nav-tabs card-header-tabs mx-2 mt-2 border-bottom-0" role="tablist" id="aiSettingsTabs">
                        @{ var isFirstTab = true; }
                        @foreach (var t in tabDefs)
                        {
                            var count = settingsByTab[t.Id].Count;
                            <li class="nav-item" role="presentation">
                                <button type="button"
                                        class="nav-link @(isFirstTab ? "active" : "")"
                                        id="tab-btn-@t.Id"
                                        data-bs-toggle="tab"
                                        data-bs-target="#tab-@t.Id"
                                        role="tab"
                                        aria-controls="tab-@t.Id"
                                        aria-selected="@(isFirstTab ? "true" : "false")">
                                    <i class="bi @t.Icon me-1"></i>@t.Label
                                    @if (count > 0)
                                    {
                                        <span class="badge bg-light text-muted ms-1">@count</span>
                                    }
                                </button>
                            </li>
                            isFirstTab = false;
                        }
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content" id="aiSettingsTabContent">
                        @{ var isFirstPane = true; }
                        @foreach (var t in tabDefs)
                        {
                            <div class="tab-pane fade @(isFirstPane ? "show active" : "")"
                                 id="tab-@t.Id"
                                 role="tabpanel"
                                 aria-labelledby="tab-btn-@t.Id">
                                @if (settingsByTab[t.Id].Count == 0)
                                {
                                    <p class="text-muted small mb-0">No settings in this tab.</p>
                                }
                                else
                                {
                                    @foreach (var setting in settingsByTab[t.Id])
                                    {
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold" for="s_@setting.Key">
                                                @FormatKey(setting.Key)
                                            </label>

                                            @if (boolKeys.Contains(setting.Key))
                                            {
                                                <input type="hidden" name="@setting.Key" value="false" />
                                                <div class="form-check form-switch">
                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           name="@setting.Key"
                                                           value="true"
                                                           id="s_@setting.Key"
                                                           @(setting.Value?.Equals("true", StringComparison.OrdinalIgnoreCase) == true ? "checked" : "") />
                                                    <label class="form-check-label" for="s_@setting.Key">
                                                        @(setting.Value?.Equals("true", StringComparison.OrdinalIgnoreCase) == true ? "Enabled" : "Disabled")
                                                    </label>
                                                </div>
                                            }
                                            else if (setting.Key == "AiTriageMode")
                                            {
                                                <select name="@setting.Key" class="form-select" id="s_@setting.Key" data-no-picker="true">
                                                    @foreach (var opt in modeOptions)
                                                    {
                                                        if (setting.Value == opt)
                                                        {
                                                            <option value="@opt" selected="selected">@opt</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@opt">@opt</option>
                                                        }
                                                    }
                                                </select>
                                            }
                                            else if (providerKeys.Contains(setting.Key))
                                            {
                                                <select name="@setting.Key" class="form-select" id="s_@setting.Key" data-no-picker="true">
                                                    @foreach (var opt in providerOptions)
                                                    {
                                                        // AiProvider must have a real backend; role overrides allow blank.
                                                        if (setting.Key == "AiProvider" && opt.Value == "") { continue; }
                                                        var isSelected = string.Equals(setting.Value ?? string.Empty, opt.Value, StringComparison.OrdinalIgnoreCase);
                                                        <option value="@opt.Value" selected="@(isSelected ? "selected" : null)">@opt.Label</option>
                                                    }
                                                </select>
                                            }
                                            else if (secretKeys.Contains(setting.Key))
                                            {
                                                // Show a mask when a value is already stored; empty submit == "keep existing".
                                                var hasStored = !string.IsNullOrEmpty(setting.Value);
                                                <input type="password"
                                                       class="form-control"
                                                       name="@setting.Key"
                                                       placeholder="@(hasStored ? "•••••• (stored — leave blank to keep)" : "Paste API key")"
                                                       autocomplete="new-password"
                                                       id="s_@setting.Key" />
                                            }
                                            else
                                            {
                                                <input type="text"
                                                       class="form-control"
                                                       name="@setting.Key"
                                                       value="@setting.Value"
                                                       id="s_@setting.Key" />
                                            }

                                            @if (!string.IsNullOrEmpty(setting.Description))
                                            {
                                                <div class="form-text text-muted">
                                                    <i class="bi bi-info-circle me-1"></i>@setting.Description
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                            isFirstPane = false;
                        }
                    </div>
                </div>
            </div>

            <div class="mb-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Save Settings
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <span class="ms-auto text-muted small align-self-center">
                    <i class="bi bi-info-circle me-1"></i>Save applies changes across every tab.
                </span>
            </div>
        </form>

        <!-- ── Force retrain ──────────────────────────────────────────────── -->
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Model Training</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    The ML.NET model automatically retrains every 24 hours using resolved and closed tickets.
                    Use the button below to trigger an immediate retrain — useful after bulk ticket imports
                    or when you want the model to reflect recent data without waiting.
                </p>
                <div class="d-flex align-items-center gap-3">
                    <form method="post" asp-action="AiRetrain" asp-antiforgery="true" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-cpu me-1"></i>Retrain Model Now
                        </button>
                    </form>
                    <div class="small text-muted">
                        Training data: <strong>@totalTrained</strong> resolved/closed tickets available
                    </div>
                </div>

                @if (lastLog != null)
                {
                    <div class="mt-3 p-3 rounded @(lastLog.Success ? "bg-success" : "bg-danger") bg-opacity-10 border border-@(lastLog.Success ? "success" : "danger") border-opacity-25">
                        <div class="small">
                            <strong>Last training run:</strong>
                            @lastLog.RunDate.ToString("MMM dd, yyyy h:mm tt")
                            — @(lastLog.Success ? "Succeeded" : "Failed")
                            (@lastLog.DurationMs.ToString("F0") ms,
                             @lastLog.TrainingTicketCount tickets)
                        </div>
                        @if (!string.IsNullOrEmpty(lastLog.ErrorMessage))
                        {
                            <div class="small text-danger mt-1">@lastLog.ErrorMessage</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ── Right column: info panel ──────────────────────────────────────── -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 bg-light mb-4">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="bi bi-robot me-1 text-primary"></i> How AI Triage Works
                </h6>
                <ul class="small text-muted mb-0">
                    <li class="mb-2">The ML.NET model trains on your <strong>resolved and closed tickets</strong> to learn which categories and priorities apply to different issue descriptions.</li>
                    <li class="mb-2">When a new ticket is created, the model predicts the most likely <strong>Category</strong> and <strong>Priority</strong> and shows a suggestion card on the Edit page.</li>
                    <li class="mb-2">In <strong>RecommendOnly</strong> mode, agents see the suggestion and can approve or dismiss it. In <strong>AutoApply</strong> mode, high-confidence predictions are applied automatically.</li>
                    <li class="mb-2">Accuracy improves as more resolved tickets accumulate. A minimum of <strong>@((Model.FirstOrDefault(s => s.Key == "AiMinTrainingTickets")?.Value) ?? "20")</strong> resolved tickets is required to train.</li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="bi bi-hdd-stack me-1 text-info"></i> LLM Provider Setup
                </h6>
                <div class="small text-muted mb-3">
                    <p class="mb-2">
                        <strong>AiProvider</strong> picks the backend for every AI feature. Two role-scoped overrides
                        (<strong>AiProviderDraft</strong>, <strong>AiProviderTriage</strong>) let you route draft replies
                        to a smarter model and classification to a cheaper one.
                    </p>
                    <ul class="mb-2">
                        <li><strong>Ollama</strong> — local, free, private. Slow on CPU (30–120s cold-load); fast on GPU.</li>
                        <li><strong>Gemini</strong> — <code>gemini-1.5-flash</code> replies in 1–3s and is very cheap. Requires <code>GeminiApiKey</code>.</li>
                        <li><strong>OpenAI</strong> — <code>gpt-4o-mini</code>. Requires <code>OpenAiApiKey</code>. Off by default.</li>
                        <li><strong>Anthropic Claude</strong> — <code>claude-haiku-4-5</code>. Requires <code>AnthropicApiKey</code>. Off by default.</li>
                    </ul>
                    <p class="mb-0 small">
                        <i class="bi bi-shield-lock me-1"></i>
                        API keys are encrypted at rest (Data Protection API, purpose <code>LlmApiKeys.v1</code>).
                        Cloud providers send prompt text to their servers — confirm with your team before enabling if
                        ticket content is sensitive.
                    </p>
                </div>
                <form method="post" asp-action="TestOllama" id="frmTestOllama">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-info w-100" id="btnTestOllama">
                        <i class="bi bi-wifi me-1"></i>Test Active Provider
                    </button>
                </form>
                <div id="ollamaTestResult" class="mt-2 small" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

@functions {
    string FormatKey(string key)
    {
        if (string.IsNullOrEmpty(key)) return key;
        var sb = new System.Text.StringBuilder();
        sb.Append(key[0]);
        for (int i = 1; i < key.Length; i++)
        {
            if (char.IsUpper(key[i]) && !char.IsUpper(key[i - 1]))
                sb.Append(' ');
            sb.Append(key[i]);
        }
        return sb.ToString();
    }
}

<script>
(function () {
    var form = document.getElementById('frmTestOllama');
    var btn  = document.getElementById('btnTestOllama');
    var res  = document.getElementById('ollamaTestResult');
    if (!form) return;

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Testing (running a real generation probe — may take 30–60s on a cold model)…';
        res.style.display = 'none';

        var fd = new FormData(form);
        fetch('/Settings/TestOllama', { method: 'POST', body: fd })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-wifi me-1"></i>Test Active Provider';
                res.style.display = '';
                res.className = 'mt-2 small alert ' + (data.ok ? 'alert-success' : 'alert-warning') + ' py-2 px-3';
                var modelsHtml = (data.models && data.models.length)
                    ? '<br><strong>Installed models:</strong> ' + data.models.map(function(m){ return '<code>' + m + '</code>'; }).join(', ')
                    : '';
                var latencySec = data.latencyMs ? (data.latencyMs / 1000) : 0;
                var perfHtml = '';
                if (data.ok && latencySec > 0) {
                    // >45s on a 1-token probe is a warning — strongly suggests CPU inference + cold load,
                    // and signals to admins they should configure a longer OllamaTimeoutSeconds.
                    var slow = latencySec > 45;
                    perfHtml = '<br><strong>Probe latency:</strong> ' + latencySec.toFixed(1) + 's' +
                               (slow ? ' <span class="badge bg-warning text-dark ms-1">Slow — consider a smaller model or longer OllamaTimeoutSeconds</span>' : '');
                }
                res.innerHTML = (data.ok ? '<i class="bi bi-check-circle me-1"></i>' : '<i class="bi bi-exclamation-triangle me-1"></i>')
                    + data.message + perfHtml + modelsHtml;
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-wifi me-1"></i>Test Active Provider';
                res.style.display = '';
                res.className = 'mt-2 small alert alert-danger py-2 px-3';
                res.innerHTML = '<i class="bi bi-x-circle me-1"></i>Request failed — check browser console.';
            });
    });
})();

// ── Persist the active AI-settings tab across saves / reloads ─────────────
// Save/Cancel triggers a POST-redirect, so without persistence the page
// always comes back on "General". LocalStorage keeps the user on the tab
// they were editing.
(function () {
    var storageKey = 'aiSettingsActiveTab';
    var tabList = document.getElementById('aiSettingsTabs');
    if (!tabList || typeof bootstrap === 'undefined') return;

    // Restore the last-active tab on load — falls back silently to the
    // server-rendered default (General) when storage is unavailable.
    try {
        var saved = localStorage.getItem(storageKey);
        if (saved) {
            var target = tabList.querySelector('[data-bs-target="#tab-' + saved + '"]');
            if (target) new bootstrap.Tab(target).show();
        }
    } catch (_) { /* private mode — ignore */ }

    // Save on tab switch. Bootstrap fires shown.bs.tab after the transition.
    tabList.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (btn) {
        btn.addEventListener('shown.bs.tab', function (e) {
            var t = (e.target.getAttribute('data-bs-target') || '').replace('#tab-', '');
            try { if (t) localStorage.setItem(storageKey, t); } catch (_) {}
        });
    });
})();
</script>
