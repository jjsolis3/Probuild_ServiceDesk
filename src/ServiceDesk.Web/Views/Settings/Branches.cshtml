@model IEnumerable<ServiceDesk.Core.Models.Branch>
@{
    ViewData["Title"] = "Branches & Sites";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-geo-alt"></i> Branches &amp; Sites</h1>
    <a asp-action="CreateBranch" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Branch
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Branches">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Site Manager</th>
                <th>Active</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var branch in Model)
            {
                <tr>
                    <td>@branch.Name</td>
                    <td>
                        @{
                            var addressParts = new List<string>();
                            if (!string.IsNullOrWhiteSpace(branch.Address)) addressParts.Add(branch.Address);
                            if (!string.IsNullOrWhiteSpace(branch.City)) addressParts.Add(branch.City);
                            if (!string.IsNullOrWhiteSpace(branch.State)) addressParts.Add(branch.State);
                            if (!string.IsNullOrWhiteSpace(branch.ZipCode)) addressParts.Add(branch.ZipCode);
                        }
                        @(addressParts.Any() ? string.Join(", ", addressParts) : "—")
                    </td>
                    <td>@(branch.Phone ?? "—")</td>
                    <td>@(branch.SiteManager?.FullName ?? "Not Assigned")</td>
                    <td>
                        @if (branch.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditBranch" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="DeleteBranch" asp-route-id="@branch.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete branch \'@branch.Name\'? This cannot be undone.')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-geo-alt display-1"></i>
        <p class="mt-3">No branches found.</p>
    </div>
}
