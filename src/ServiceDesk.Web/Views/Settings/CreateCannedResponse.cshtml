@model CannedResponse
@{
    ViewData["Title"] = "Add Canned Response";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="CannedResponses">Canned Responses</a></li>
        <li class="breadcrumb-item active">New Template</li>
    </ol>
</nav>

<h1><i class="bi bi-plus-lg"></i> Add Canned Response</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="CreateCannedResponse" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Password Reset Instructions" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <input asp-for="Category" class="form-control" placeholder="e.g. General, Account, Resolution" />
                            <div class="form-text">Optional grouping label shown in the template picker.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SortOrder" class="form-label fw-semibold"></label>
                            <input asp-for="SortOrder" class="form-control" type="number" />
                            <div class="form-text">Lower numbers appear first.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label fw-semibold"></label>
                        <textarea asp-for="Content" class="form-control" rows="8"
                                  placeholder="Type the full response text here. Use {{Variables}} to personalize."></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                        @await Html.PartialAsync("_CannedResponseVariablesHelp")
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">Active (visible to agents)</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Save Template
                    </button>
                    <a asp-action="CannedResponses" class="btn btn-outline-secondary ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
