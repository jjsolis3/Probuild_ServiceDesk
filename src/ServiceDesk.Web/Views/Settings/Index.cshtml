@{
    ViewData["Title"] = "Settings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1><i class="bi bi-gear"></i> Settings</h1>
        <p class="text-muted mb-0">Configure and manage your ServiceDesk platform settings.</p>
    </div>
</div>

<!-- Settings search bar -->
<div class="mb-4" style="max-width:420px;">
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="search" id="settingsSearch" class="form-control border-start-0 ps-0"
               placeholder="Search settings…" autocomplete="off" />
        <button class="btn btn-outline-secondary" type="button" id="settingsSearchClear" style="display:none;">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
</div>
<div id="settingsNoResults" class="text-muted text-center py-5" style="display:none;">
    <i class="bi bi-search display-4 d-block mb-2 opacity-25"></i>
    No settings match "<span id="settingsNoResultsQuery"></span>". Try a different keyword.
</div>

<!-- ADMIN & COMPANY SETTINGs -->
<div class="settings-section-label visually-hidden">Account Company Branding Logo Branches Sites Portal</div>
<div class="row g-4 mb-4 settings-row">

    <!-- Account Settings -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(13, 110, 253, 0.1);">
                        <i class="bi bi-building display-6 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Account Settings</h5>
                        <p class="card-text text-muted small">Manage company name, timezone, default assignee, and ticket prefix</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Account" class="btn btn-sm btn-primary">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

    <!-- Branding -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(111, 66, 193, 0.1);">
                        <i class="bi bi-palette display-6" style="color: #6f42c1;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Branding</h5>
                        <p class="card-text text-muted small">Logo, brand colour, and company contact details for emails and the portal</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Branding" class="btn btn-sm" style="background-color: #6f42c1; color: #fff;">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

    <!-- Branches & Sites -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(25, 135, 84, 0.1);">
                        <i class="bi bi-geo-alt display-6 text-success"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Branches &amp; Sites</h5>
                        <p class="card-text text-muted small">Manage office locations and site managers</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Branches" class="btn btn-sm btn-success">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

    <!-- Portal Branding -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(111, 66, 193, 0.1);">
                        <i class="bi bi-window-fullscreen display-6" style="color:#6f42c1;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Portal Branding</h5>
                        <p class="card-text text-muted small">Welcome message, page title, announcement banner, and Knowledge Base toggle</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="PortalBranding" class="btn btn-sm" style="background-color:#6f42c1;color:#fff;">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>
</div>

<!-- EMAIL & NOTIFICATION SETTINGS -->
