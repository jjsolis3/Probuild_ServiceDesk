@{
    ViewData["Title"] = "Settings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-gear"></i> Settings</h1>
        <p class="text-muted mb-0">Configure and manage your ServiceDesk platform settings.</p>
    </div>
</div>

<!-- ADMIN & COMPANY SETTINGs -->
<div class="row g-4 mb-4">

    <!-- Account Settings -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(13, 110, 253, 0.1);">
                        <i class="bi bi-building display-6 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Account Settings</h5>
                        <p class="card-text text-muted small">Manage company name, timezone, default assignee, and ticket prefix</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Account" class="btn btn-sm btn-primary">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

    <!-- Branding -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(111, 66, 193, 0.1);">
                        <i class="bi bi-palette display-6" style="color: #6f42c1;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Branding</h5>
                        <p class="card-text text-muted small">Logo, brand colour, and company contact details for emails and the portal</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Branding" class="btn btn-sm" style="background-color: #6f42c1; color: #fff;">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

    <!-- Branches & Sites -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(25, 135, 84, 0.1);">
                        <i class="bi bi-geo-alt display-6 text-success"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Branches &amp; Sites</h5>
                        <p class="card-text text-muted small">Manage office locations and site managers</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Branches" class="btn btn-sm btn-success">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

    <!-- Email Integration -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(220, 53, 69, 0.1);">
                        <i class="bi bi-envelope display-6 text-danger"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Email Integration</h5>
                        <p class="card-text text-muted small">Configure email-to-ticket and notifications</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="EmailIntegration" class="btn btn-sm btn-danger">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>
</div>

<!-- USER & ROLES MANAGEMENT-->
<div class="row g-4 mb-4">

    <!-- Portal Users -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(13, 202, 240, 0.1);">
                        <i class="bi bi-people display-6 text-info"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Portal Users</h5>
                        <p class="card-text text-muted small">Manage portal user accounts, passwords, and role assignments</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Users" class="btn btn-sm btn-info text-white">
                    <i class="bi bi-arrow-right-circle me-1"></i> Manage Users
                </a>
            </div>
        </div>
    </div>

    <!-- User Groups / Teams -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(13, 202, 240, 0.15);">
                        <i class="bi bi-people-fill display-6 text-info"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">User Groups &amp; Teams</h5>
                        <p class="card-text text-muted small">Create and manage IT teams for ticket group assignments</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Groups" class="btn btn-sm btn-info text-white">
                    <i class="bi bi-arrow-right-circle me-1"></i> Manage Groups
                </a>
            </div>
        </div>
    </div>

    <!-- Roles & Permissions -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(111, 66, 193, 0.1);">
                        <i class="bi bi-shield-lock display-6" style="color: #6f42c1;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Roles &amp; Permissions</h5>
                        <p class="card-text text-muted small">Define roles and assign permissions for IT staff</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Roles" class="btn btn-sm" style="background-color: #6f42c1; color: #fff;">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>


</div>

<!-- TICKET CREATION / MANAGEMENT -->
<div class="row g-4 mb-4">

    <!-- Categories & Keywords -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(13, 110, 253, 0.1);">
                        <i class="bi bi-key display-6 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Category Keywords</h5>
                        <p class="card-text text-muted small">Manage keywords used to auto-classify inbound emails into ticket categories</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="CategoryKeywords" class="btn btn-sm btn-primary">
                    <i class="bi bi-arrow-right-circle me-1"></i> Manage
                </a>
            </div>
        </div>
    </div>
    
    <!-- Sub-Categories -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(102, 16, 242, 0.1);">
                        <i class="bi bi-tags display-6" style="color: #6610f2;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Categories &amp; Sub-Categories</h5>
                        <p class="card-text text-muted small">Customise ticket categories and define sub-categories for your IT department</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Categories" class="btn btn-sm" style="background-color: #6610f2; color: #fff;">
                    <i class="bi bi-arrow-right-circle me-1"></i> Manage
                </a>
            </div>
        </div>
    </div>

    <!-- Assignment Rules -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(255, 193, 7, 0.15);">
                        <i class="bi bi-signpost-split display-6 text-warning"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Assignment Rules</h5>
                        <p class="card-text text-muted small">Auto-assign new tickets to agents based on branch/location, category, and sub-category</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="AssignmentRules" class="btn btn-sm btn-warning text-dark">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>
</div>

<!-- AI & AUTOMATION -->
<div class="row g-4 mb-4">

    <!-- AI Triage -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(13, 110, 253, 0.1);">
                        <i class="bi bi-robot display-6 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">AI Triage</h5>
                        <p class="card-text text-muted small">ML.NET ticket classification, Ollama draft replies, and confidence thresholds</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="Ai" class="btn btn-sm btn-primary">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

</div>

<!-- TICKET STATUS AND RESOLUTIONS -->
<div class="row g-4 mb-4">

    <!-- Custom Ticket States -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(253, 126, 20, 0.1);">
                        <i class="bi bi-diagram-3 display-6" style="color: #fd7e14;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Custom Ticket States</h5>
                        <p class="card-text text-muted small">Configure ticket workflow states and colors</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="TicketStates" class="btn btn-sm" style="background-color: #fd7e14; color: #fff;">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

    <!-- Resolution Codes -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(32, 201, 151, 0.1);">
                        <i class="bi bi-check2-square display-6" style="color: #20c997;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Resolution Codes</h5>
                        <p class="card-text text-muted small">Define standard resolution codes for closing tickets</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="ResolutionCodes" class="btn btn-sm" style="background-color: #20c997; color: #fff;">
                    <i class="bi bi-arrow-right-circle me-1"></i> Configure
                </a>
            </div>
        </div>
    </div>

    <!-- Canned Responses -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(32, 201, 151, 0.1);">
                        <i class="bi bi-chat-square-text display-6 text-success"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Canned Responses</h5>
                        <p class="card-text text-muted small">Manage saved reply templates for common IT support scenarios</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="CannedResponses" class="btn btn-sm btn-success">
                    <i class="bi bi-arrow-right-circle me-1"></i> Manage
                </a>
            </div>
        </div>
    </div>

    <!-- Email Templates -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color: rgba(13, 202, 240, 0.1);">
                        <i class="bi bi-envelope-paper display-6 text-info"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Email Templates</h5>
                        <p class="card-text text-muted small">Customise HTML layout and content of automated notification emails</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="EmailTemplates" class="btn btn-sm btn-info text-white">
                    <i class="bi bi-arrow-right-circle me-1"></i> Manage
                </a>
            </div>
        </div>
    </div>

</div>
