@section Scripts {
<script>
(function () {
    var searchInput  = document.getElementById('settingsSearch');
    var clearBtn     = document.getElementById('settingsSearchClear');
    var noResults    = document.getElementById('settingsNoResults');
    var noResultsQ   = document.getElementById('settingsNoResultsQuery');

    if (!searchInput) return;

    // Build searchable text for each card column once, then cache it
    var cols = Array.from(document.querySelectorAll('.settings-row .col-lg-3, .settings-row .col-md-6'));
    cols.forEach(function (col) {
        // Include surrounding section label in each card's search text
        var row = col.closest('.settings-row');
        var sectionLabel = '';
        if (row) {
            var prev = row.previousElementSibling;
            while (prev && !prev.classList.contains('settings-section-label')) {
                prev = prev.previousElementSibling;
            }
            if (prev) sectionLabel = prev.textContent;
        }
        col.dataset.searchText = (col.textContent + ' ' + sectionLabel).toLowerCase().replace(/\s+/g, ' ');
    });

    function filterCards(q) {
        q = q.trim().toLowerCase();
        clearBtn.style.display = q ? 'block' : 'none';
        if (!q) {
            cols.forEach(function (c) { c.style.display = ''; });
            // Restore section row visibility
            document.querySelectorAll('.settings-row').forEach(function (r) { r.style.display = ''; });
            noResults.style.display = 'none';
            return;
        }
        var terms = q.split(/\s+/).filter(Boolean);
        var totalVisible = 0;
        // Process row by row
        document.querySelectorAll('.settings-row').forEach(function (row) {
            var rowCols = Array.from(row.querySelectorAll('.col-lg-3, .col-md-6'));
            var anyVisible = false;
            rowCols.forEach(function (col) {
                var text = col.dataset.searchText || '';
                var match = terms.every(function (t) { return text.includes(t); });
                col.style.display = match ? '' : 'none';
                if (match) { anyVisible = true; totalVisible++; }
            });
            row.style.display = anyVisible ? '' : 'none';
        });
        if (totalVisible === 0) {
            noResults.style.display = 'block';
            if (noResultsQ) noResultsQ.textContent = q;
        } else {
            noResults.style.display = 'none';
        }
    }

    searchInput.addEventListener('input', function () { filterCards(searchInput.value); });
    clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        filterCards('');
        searchInput.focus();
    });
})();
</script>
}
