        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color:rgba(13,110,253,.1);">
                        <i class="bi bi-envelope-check display-6" style="color:#0d6efd;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Email Activity Log</h5>
                        <p class="card-text text-muted small">Audit every outbound notification — who received it, when, and whether it was delivered</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <a asp-action="EmailActivity" class="btn btn-sm btn-primary">
                    <i class="bi bi-arrow-right-circle me-1"></i> View Log
                </a>
            </div>
        </div>
    </div>

    <!-- Inbound Email Log -->
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="rounded-3 p-3 me-3" style="background-color:rgba(25,135,84,.1);">
                        <i class="bi bi-inbox-fill display-6" style="color:#198754;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Inbound Email Log</h5>
