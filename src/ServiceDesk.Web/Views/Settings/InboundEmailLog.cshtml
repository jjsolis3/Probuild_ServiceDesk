@using ServiceDesk.Core.Models
@model IEnumerable<InboundEmailLog>
@{
    var filterAction    = ViewBag.FilterAction    as string;
    var filterRecipient = ViewBag.FilterRecipient as string;
    var pageNum         = (int)ViewBag.Page;
    var totalPages      = (int)ViewBag.TotalPages;
    var totalCount      = (int)ViewBag.TotalCount;
    var actions         = ViewBag.Actions as string[] ?? Array.Empty<string>();
    bool isFiltered     = !string.IsNullOrEmpty(filterAction) || !string.IsNullOrEmpty(filterRecipient);

    // Quick counts of the current page (cheaper than a separate aggregate query).
    var created  = Model.Count(l => l.Action == nameof(InboundAction.TicketCreated));
    var threaded = Model.Count(l => l.Action == nameof(InboundAction.NoteAppended));
    var skipped  = Model.Count(l => l.Action != null && l.Action.StartsWith("Skipped"));
    var failed   = Model.Count(l => l.Action == nameof(InboundAction.Failed));

    string BadgeClass(string? action) => action switch
    {
        nameof(InboundAction.TicketCreated)        => "bg-success",
        nameof(InboundAction.NoteAppended)         => "bg-info text-dark",
        nameof(InboundAction.SkippedDuplicate)     => "bg-secondary",
        nameof(InboundAction.SkippedSelf)          => "bg-secondary",
        nameof(InboundAction.SkippedAutoGenerated) => "bg-secondary",
        nameof(InboundAction.SkippedAutoReply)     => "bg-secondary",
        nameof(InboundAction.SkippedStale)         => "bg-warning text-dark",
        nameof(InboundAction.SkippedNoCreate)      => "bg-warning text-dark",
        nameof(InboundAction.Failed)               => "bg-danger",
        _                                          => "bg-light text-dark border"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="EmailIntegration">Email Integration</a></li>
        <li class="breadcrumb-item active">Inbound Email Log</li>
    </ol>
</nav>

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-inbox-fill text-primary me-2"></i>Inbound Email Log</h2>
    <p class="text-muted small mb-0">
        Every Gmail message the poller saw, and what it did with it. Companion to the
        <a asp-action="EmailActivity">Email Activity Log</a> which records outbound sends.
    </p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI tiles -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-uppercase small text-muted fw-bold">Showing</div>
                <div class="display-6 fw-bold mt-1">@totalCount</div>
                <div class="small text-muted">matching entries</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-uppercase small text-muted fw-bold">Tickets Created</div>
                <div class="display-6 fw-bold mt-1 text-success">@created</div>
                <div class="small text-muted">on current page</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-uppercase small text-muted fw-bold">Threaded</div>
                <div class="display-6 fw-bold mt-1 text-info">@threaded</div>
                <div class="small text-muted">on current page</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-uppercase small text-muted fw-bold">Skipped / Failed</div>
                <div class="display-6 fw-bold mt-1 @(failed > 0 ? "text-danger" : "text-warning")">@(skipped + failed)</div>
                <div class="small text-muted">@skipped skipped, @failed failed</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter card -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-uppercase">Action</label>
                <select name="action" class="form-select form-select-sm">
                    <option value="">All actions</option>
                    @foreach (var a in actions)
                    {
                        if (a == filterAction)
                        {
                            <option value="@a" selected>@a</option>
                        }
                        else
                        {
                            <option value="@a">@a</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-uppercase">Sender / Subject contains</label>
                <input type="text" name="recipient" class="form-control form-control-sm"
                       placeholder="search…" value="@filterRecipient" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                    <i class="bi bi-funnel-fill me-1"></i>Filter
                </button>
                <a asp-action="InboundEmailLog" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Log -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
        <span class="text-uppercase small fw-bold text-muted">
            <i class="bi bi-list-ul me-1"></i>Inbound Log
        </span>
        <span class="small text-muted">
            @totalCount @(totalCount == 1 ? "entry" : "entries")
            @if (totalPages > 1) { <text> · page @pageNum of @totalPages</text> }
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox display-3 d-block mb-2 opacity-25"></i>
            <div class="fw-semibold">No log entries found</div>
            <div class="small mt-1">
                @(isFiltered
                    ? "No entries match the current filter. Try clearing it."
                    : "Once the poller processes its next message, an entry will appear here. Use the \"Poll Now\" button on the Email Integration page to force a cycle immediately.")
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th style="width:140px;">Processed</th>
                        <th style="width:160px;">Action</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td class="text-nowrap">
                            <div>@entry.ProcessedDate.ToString("MMM d, HH:mm")</div>
                            @if (entry.ReceivedDate.HasValue)
                            {
                                <div class="text-muted" style="font-size:.7rem;">
                                    received @entry.ReceivedDate.Value.ToString("MMM d, HH:mm")
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge @BadgeClass(entry.Action)">@entry.Action</span>
                        </td>
                        <td>
                            <div class="fw-semibold text-truncate" style="max-width:560px;" title="@entry.Subject">
                                @(string.IsNullOrEmpty(entry.Subject) ? "(no subject)" : entry.Subject)
                            </div>
                            <div class="text-muted small text-truncate" style="max-width:560px;">
                                @if (!string.IsNullOrEmpty(entry.FromAddress))
                                {
                                    <i class="bi bi-person me-1"></i>@entry.FromAddress
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(entry.ActionDetail))
                            {
                                <div class="text-muted small" style="font-size:.72rem;">@entry.ActionDetail</div>
                            }
                            @if (!string.IsNullOrEmpty(entry.ErrorMessage))
                            {
                                <div class="text-danger small mt-1" style="font-size:.72rem;">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@entry.ErrorMessage
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-light d-flex justify-content-center gap-2 py-2">
                @if (pageNum > 1)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="InboundEmailLog"
                       asp-route-action="@filterAction"
                       asp-route-recipient="@filterRecipient"
                       asp-route-page="@(pageNum - 1)">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                }
                <span class="align-self-center small text-muted">Page @pageNum of @totalPages</span>
                @if (pageNum < totalPages)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="InboundEmailLog"
                       asp-route-action="@filterAction"
                       asp-route-recipient="@filterRecipient"
                       asp-route-page="@(pageNum + 1)">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
</div>
