@model IEnumerable<ResolutionCode>
@{
    ViewData["Title"] = "Resolution Codes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-check2-square"></i> Resolution Codes</h1>
    <a asp-action="CreateResolutionCode" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Resolution Code
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Resolution Codes">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Sort Order</th>
                <th>Active</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var code in Model.OrderBy(c => c.SortOrder))
            {
                <tr>
                    <td>@code.Name</td>
                    <td>@code.Description</td>
                    <td>@code.SortOrder</td>
                    <td>
                        @if (code.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditResolutionCode" asp-route-id="@code.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="DeleteResolutionCode" asp-route-id="@code.Id" method="post" class="d-inline"
                              data-confirm-title="Delete Code" data-confirm-message="Delete this resolution code? This cannot be undone.">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-check2-square display-1"></i>
        <p class="mt-3">No resolution codes found.</p>
    </div>
}
