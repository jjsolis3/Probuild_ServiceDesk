@using ServiceDesk.Core.Models
@using ServiceDesk.Web.Models.ViewModels
@model StoreProduct
@{
    ViewData["Title"] = "Edit Product";
    ViewData["FormContext"] = new StoreProductFormContext
    {
        Product             = Model,
        ExistingCategories  = ViewBag.ExistingCategories as List<string> ?? new List<string>(),
        ControllerName      = "Settings",
        ListAction          = "StoreProducts",
        CreateAction        = "StoreProductCreate",
        EditAction          = "StoreProductEdit",
        DeleteAction        = "StoreProductDelete",
        ImageDeleteAction   = "StoreProductImageDelete",
        DuplicateAction     = "StoreProductDuplicate",
        BulkSetActiveAction = "StoreProductBulkSetActive"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="StoreSettings">Store Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="StoreProducts">Products</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>

<h1 class="mb-4"><i class="bi bi-pencil text-primary me-2"></i>Edit Product</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                @await Html.PartialAsync("StoreProducts/_ProductForm", Model)
            </div>
        </div>
    </div>
</div>
