@using ServiceDesk.Core.Models
@model StoreProduct
@{
    ViewData["Title"] = "Edit Product";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="StoreSettings">Store Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="StoreProducts">Products</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>

<h1 class="mb-4"><i class="bi bi-pencil text-primary me-2"></i>Edit Product</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" asp-action="StoreProductEdit" asp-route-id="@Model.Id"
                      asp-antiforgery="true" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <input asp-for="Category" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UnitOfMeasure" class="form-label fw-semibold"></label>
                            <input asp-for="UnitOfMeasure" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SortOrder" class="form-label fw-semibold"></label>
                            <input asp-for="SortOrder" type="number" class="form-control" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Active</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                <label class="form-check-label" asp-for="IsActive">Visible in catalog</label>
                            </div>
                        </div>
                    </div>

                    <!-- Variant Options -->
                    <div class="card border-0 bg-light mb-4">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3"><i class="bi bi-sliders me-2 text-primary"></i>Variant Options</h6>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="HasGenderOption"
                                               id="HasGenderOption" onchange="toggleVariantFields()" />
                                        <label class="form-check-label fw-semibold" asp-for="HasGenderOption">Gender Selector</label>
                                    </div>
                                    <div class="form-text">Men's / Women's / Unisex.</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="HasSizes"
                                               id="HasSizes" onchange="toggleVariantFields()" />
                                        <label class="form-check-label fw-semibold" asp-for="HasSizes">Size Selector</label>
                                    </div>
                                    <div class="form-text">Size buttons.</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="HasColorOptions"
                                               id="HasColorOptions" onchange="toggleVariantFields()" />
                                        <label class="form-check-label fw-semibold" asp-for="HasColorOptions">Color Selector</label>
                                    </div>
                                    <div class="form-text">Color swatches.</div>
                                </div>
                            </div>

                            <div id="sizeField" class="mt-3 @(Model.HasSizes ? "" : "d-none")">
                                <label asp-for="AvailableSizes" class="form-label fw-semibold"></label>
                                <input asp-for="AvailableSizes" class="form-control"
                                       placeholder="XS,S,M,L,XL,XXL,3XL" />
                                <div class="form-text">Comma-separated list of sizes.</div>
                            </div>

                            <div id="colorField" class="mt-3 @(Model.HasColorOptions ? "" : "d-none")">
                                <label asp-for="AvailableColors" class="form-label fw-semibold"></label>
                                <input asp-for="AvailableColors" class="form-control"
                                       placeholder="Black,White,Navy,Gray,Red" />
                                <div class="form-text">Comma-separated list of color names.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Product Image -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Main Product Image</label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mb-2 d-flex align-items-center gap-3">
                                <img src="@Model.ImagePath" alt="Current image"
                                     style="height:80px;width:80px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb;" />
                                <div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="clearImage" name="clearImage" value="true" />
                                        <label class="form-check-label text-danger small" for="clearImage">Remove main image</label>
                                    </div>
                                </div>
                            </div>
                        }
                        <input type="file" class="form-control" name="imageFile"
                               accept=".jpg,.jpeg,.png,.webp,.gif" />
                        <div class="form-text">Upload a new image to replace the main one.</div>
                    </div>

                    <!-- Additional Gallery Images -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Gallery Images</label>
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @foreach (var img in Model.Images.OrderBy(i => i.SortOrder))
                                {
                                    <div class="position-relative" style="width:80px;height:80px;">
                                        <img src="@img.ImagePath" alt="Gallery image"
                                             style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb;" />
                                        <form method="post" asp-action="StoreProductImageDelete"
                                              asp-antiforgery="true"
                                              class="position-absolute top-0 end-0"
                                              style="transform:translate(25%,-25%);"
                                              onsubmit="return confirm('Delete this gallery image?');">
                                            <input type="hidden" name="imageId" value="@img.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm rounded-circle p-0"
                                                    style="width:22px;height:22px;line-height:18px;font-size:.7rem;" title="Delete">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        <input type="file" class="form-control" name="galleryFiles"
                               accept=".jpg,.jpeg,.png,.webp,.gif" multiple />
                        <div class="form-text">
                            Additional images appear in the product detail modal. Select multiple files at once to upload them.
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i>Save Changes
                        </button>
                        <a asp-action="StoreProducts" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleVariantFields() {
    var hasSizes  = document.getElementById('HasSizes').checked;
    var hasColors = document.getElementById('HasColorOptions').checked;
    document.getElementById('sizeField').classList.toggle('d-none', !hasSizes);
    document.getElementById('colorField').classList.toggle('d-none', !hasColors);
}
</script>
}
