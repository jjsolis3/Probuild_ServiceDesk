@using ServiceDesk.Core.Models
@using ServiceDesk.Web.Models.ViewModels
@model List<StoreProduct>
@{
    ViewData["Title"] = "Store Products";
    var ctx = new StoreProductFormContext
    {
        Products            = Model,
        ControllerName      = "Settings",
        ListAction          = "StoreProducts",
        CreateAction        = "StoreProductCreate",
        EditAction          = "StoreProductEdit",
        DeleteAction        = "StoreProductDelete",
        ImageDeleteAction   = "StoreProductImageDelete",
        DuplicateAction     = "StoreProductDuplicate",
        BulkSetActiveAction = "StoreProductBulkSetActive"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="StoreSettings">Store Settings</a></li>
        <li class="breadcrumb-item active">Products</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0"><i class="bi bi-box-seam text-primary me-2"></i>Store Products</h1>
        <p class="text-muted small mt-1 mb-0">@Model.Count(p => p.IsActive) active product(s) in the catalog.</p>
    </div>
    <a asp-action="StoreProductCreate" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Add Product
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@await Html.PartialAsync("StoreProducts/_ProductList", ctx)
