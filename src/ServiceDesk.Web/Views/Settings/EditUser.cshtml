@model PortalUser
@{
    ViewData["Title"] = $"Edit {Model.FullName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Users">Users</a></li>
        <li class="breadcrumb-item active">Edit @Model.FullName</li>
    </ol>
</nav>

<h1><i class="bi bi-pencil"></i> Edit @Model.FullName</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="EditUser" method="post" data-loading-btn="btnSave">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="RoleId" class="form-label"></label>
                    <select asp-for="RoleId" class="form-select">
                        <option value="">-- Select Role --</option>
                        @if (ViewBag.Roles != null)
                        {
                            foreach (var role in (IEnumerable<Role>)ViewBag.Roles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EmployeeId" class="form-label"></label>
                    <select asp-for="EmployeeId" class="form-select">
                        <option value="">Not Linked</option>
                        @if (ViewBag.Employees != null)
                        {
                            foreach (var employee in (IEnumerable<Employee>)ViewBag.Employees)
                            {
                                <option value="@employee.Id">@employee.FullName</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" id="btnSave" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>

        <hr class="mt-5" />
        <h5 class="mb-3"><i class="bi bi-key me-2"></i>Password Management</h5>

        <div class="row g-4 align-items-start">
            <!-- Set password directly -->
            <div class="col-md-6">
                <div class="card border">
                    <div class="card-body">
                        <h6 class="card-title">Set Password Directly</h6>
                        <p class="text-muted small">Set a known password for this user (min 8 characters). Share it with them securely.</p>
                        <form asp-action="AdminResetPassword" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label for="newPassword" class="form-label small fw-semibold">New Password</label>
                                <input type="password" name="newPassword" id="newPassword"
                                       class="form-control form-control-sm" placeholder="Min 8 characters"
                                       autocomplete="new-password" />
                            </div>
                            <button type="submit" class="btn btn-warning btn-sm">
                                <i class="bi bi-key me-1"></i>Set Password
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Send password reset email -->
            <div class="col-md-6">
                <div class="card border">
                    <div class="card-body">
                        <h6 class="card-title">Send Password Reset Email</h6>
                        <p class="text-muted small">Send a 24-hour reset link to <strong>@Model.Email</strong> so the user sets their own password.</p>
                        <form asp-action="AdminSendPasswordReset" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-envelope me-1"></i>Send Reset Email
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
