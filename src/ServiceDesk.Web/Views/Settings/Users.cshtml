@model IEnumerable<PortalUser>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-person-gear"></i> Users</h1>
    <a asp-action="CreateUser" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add User
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Linked Employee</th>
                <th>Groups</th>
                <th>Active</th>
                <th>Last Login</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FirstName @user.LastName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Role != null)
                        {
                            @user.Role.Name
                        }
                        else
                        {
                            <span class="text-muted">No Role</span>
                        }
                    </td>
                    <td>
                        @if (user.Employee != null)
                        {
                            @user.Employee.FullName
                        }
                        else
                        {
                            <span class="text-muted">Not Linked</span>
                        }
                    </td>
                    <td>@user.GroupMemberships.Count</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        @if (user.LastLogin.HasValue)
                        {
                            @user.LastLogin.Value.ToString("MMM dd, yyyy")
                        }
                        else
                        {
                            <span class="text-muted">Never</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-person-gear display-1"></i>
        <p class="mt-3">No users found.</p>
    </div>
}
