@model IEnumerable<EmailConfiguration>
@{
    ViewData["Title"] = "Email Integration";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item active">Email Integration</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-envelope-at"></i> Email Integration</h1>
    <a asp-action="CreateEmailConfig" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Email Configuration
    </a>
</div>

<div class="alert alert-info d-flex align-items-start mb-4" role="alert">
    <i class="bi bi-info-circle-fill me-2 mt-1"></i>
    <div>
        <strong>Gmail API Setup:</strong> To connect via the Gmail API, you need to:
        <ol class="mb-0 mt-1">
            <li>Create a <strong>Google Cloud project</strong> at <a href="https://console.cloud.google.com/" target="_blank" rel="noopener">console.cloud.google.com</a></li>
            <li>Enable the <strong>Gmail API</strong> in your project</li>
            <li>Create <strong>OAuth 2.0 credentials</strong> (Client ID and Client Secret) under APIs &amp; Services &gt; Credentials</li>
            <li>Set the authorized redirect URI to your application's <code>/Settings/GmailCallback</code> endpoint</li>
        </ol>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-envelope-at display-1"></i>
        <p class="mt-3">No email configurations have been set up yet.</p>
        <a asp-action="CreateEmailConfig" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Your First Email Configuration
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-4">
        @foreach (var config in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@config.Name</h5>
                        @if (config.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted"><i class="bi bi-envelope"></i> Email Address</div>
                            <div class="col-sm-7">@config.EmailAddress</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-5 text-muted"><i class="bi bi-shield-lock"></i> Authorization</div>
                            <div class="col-sm-7">
                                @if (config.IsAuthorized)
                                {
                                    <span class="badge bg-success me-2"><i class="bi bi-check-circle-fill"></i> Authorized</span>
                                    <form asp-action="RevokeGmailAuth" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@config.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle"></i> Revoke
                                        </button>
                                    </form>
                                }
                                else if (!string.IsNullOrEmpty(config.GmailClientId))
                                {
                                    <span class="badge bg-warning text-dark me-2"><i class="bi bi-exclamation-triangle-fill"></i> Not Authorized</span>
                                    <a asp-action="GmailAuthorize" asp-route-id="@config.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-google"></i> Authorize with Google
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">No credentials configured</span>
                                }
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted"><i class="bi bi-clock"></i> Poll Interval</div>
                            <div class="col-sm-7">@config.PollIntervalMinutes minutes</div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted"><i class="bi bi-ticket-detailed"></i> Create Tickets</div>
                            <div class="col-sm-7">
                                @if (config.CreateTicketsFromEmails)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill"></i> Yes</span>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-x-circle"></i> No</span>
                                }
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted"><i class="bi bi-reply"></i> Auto-Reply</div>
                            <div class="col-sm-7">
                                @if (config.AutoReplyOnNewTicket)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill"></i> Yes</span>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-x-circle"></i> No</span>
                                }
                            </div>
                        </div>

                        <div class="row mb-0">
                            <div class="col-sm-5 text-muted"><i class="bi bi-person"></i> Default Assignee</div>
                            <div class="col-sm-7">
                                @if (config.DefaultAssignee != null)
                                {
                                    @config.DefaultAssignee.FullName
                                }
                                else
                                {
                                    <span class="text-muted">Not Set</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="small">
                                <div class="text-muted">
                                    <i class="bi bi-clock-history"></i> Last Polled:
                                    @if (config.LastPolledDate.HasValue)
                                    {
                                        @config.LastPolledDate.Value.ToString("MMM dd, yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span>Never</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(config.LastError))
                                {
                                    <div class="text-danger mt-1">
                                        <i class="bi bi-exclamation-triangle-fill"></i> @config.LastError
                                    </div>
                                }
                            </div>
                            <div class="d-flex gap-2 flex-wrap justify-content-end">
                                @if (!config.IsAuthorized && !string.IsNullOrEmpty(config.GmailClientId))
                                {
                                    <a asp-action="GmailAuthorize" asp-route-id="@config.Id" class="btn btn-sm btn-success">
                                        <i class="bi bi-google"></i> Authorize with Google
                                    </a>
                                }
                                <a asp-action="EditEmailConfig" asp-route-id="@config.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="TestEmailConnection" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@config.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-plug"></i> Test
                                    </button>
                                </form>
                                <form asp-action="DeleteEmailConfig" asp-route-id="@config.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete email configuration \'@config.Name\'? This cannot be undone.')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
