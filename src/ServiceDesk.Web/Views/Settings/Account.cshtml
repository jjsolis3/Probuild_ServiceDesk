@model IEnumerable<AppSetting>
@{
    ViewData["Title"] = "Account Settings";

    var booleanKeys  = new[] { "AutoAssign", "EmailNotifications", "PortalEnabled" };
    var dropdownKeys = new[] { "DefaultAssigneeId" };
    var timezoneKeys = new[] { "Timezone" };
    var employees    = ViewBag.Employees as IEnumerable<Employee>;

    var commonTimezones = new (string Id, string Label)[]
    {
        ("UTC",                  "UTC — Coordinated Universal Time"),
        ("America/New_York",     "Eastern Time — New York (UTC-5/4)"),
        ("America/Chicago",      "Central Time — Chicago (UTC-6/5)"),
        ("America/Denver",       "Mountain Time — Denver (UTC-7/6)"),
        ("America/Phoenix",      "Mountain Time — Arizona, no DST (UTC-7)"),
        ("America/Los_Angeles",  "Pacific Time — Los Angeles (UTC-8/7)"),
        ("America/Anchorage",    "Alaska Time (UTC-9/8)"),
        ("Pacific/Honolulu",     "Hawaii Time (UTC-10)"),
        ("America/Puerto_Rico",  "Atlantic Time — Puerto Rico (UTC-4)"),
        ("America/Sao_Paulo",    "Brazil — São Paulo (UTC-3)"),
        ("Europe/London",        "London — GMT/BST"),
        ("Europe/Paris",         "Paris / Brussels — CET/CEST"),
        ("Europe/Berlin",        "Berlin / Vienna — CET/CEST"),
        ("Europe/Madrid",        "Madrid — CET/CEST"),
        ("Europe/Rome",          "Rome — CET/CEST"),
        ("Europe/Moscow",        "Moscow — MSK (UTC+3)"),
        ("Africa/Johannesburg",  "Johannesburg — SAST (UTC+2)"),
        ("Asia/Dubai",           "Dubai — GST (UTC+4)"),
        ("Asia/Kolkata",         "India Standard Time (UTC+5:30)"),
        ("Asia/Bangkok",         "Bangkok / Jakarta (UTC+7)"),
        ("Asia/Shanghai",        "Beijing / Shanghai (UTC+8)"),
        ("Asia/Singapore",       "Singapore (UTC+8)"),
        ("Asia/Tokyo",           "Tokyo — JST (UTC+9)"),
        ("Australia/Perth",      "Perth — AWST (UTC+8)"),
        ("Australia/Adelaide",   "Adelaide — ACST/ACDT"),
        ("Australia/Sydney",     "Sydney — AEST/AEDT"),
        ("Pacific/Auckland",     "Auckland — NZST/NZDT"),
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item active">Account Settings</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-building text-primary"></i> Account Settings</h1>
        <p class="text-muted mb-0">Manage company information, timezone, default assignee, and ticket prefix.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" asp-action="Account" asp-antiforgery="true">
    <div class="row align-items-start">
        <div class="col-lg-8">
            @foreach (var group in Model.GroupBy(s => s.Category).OrderBy(g => g.Key))
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-folder2-open me-2"></i> @group.Key
                        </h5>
                    </div>
                    <div class="card-body">
                        @foreach (var setting in group)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="setting_@setting.Key">
                                    @FormatKey(setting.Key)
                                </label>

                                @if (booleanKeys.Contains(setting.Key))
                                {
                                    <!-- Hidden "false" ensures unchecked checkbox still submits a value -->
                                    <input type="hidden" name="@setting.Key" value="false" />
                                    <div class="form-check form-switch">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               name="@setting.Key"
                                               value="true"
                                               id="setting_@setting.Key"
                                               @(setting.Value?.Equals("true", StringComparison.OrdinalIgnoreCase) == true ? "checked" : "") />
                                        <label class="form-check-label" for="setting_@setting.Key">
                                            @(setting.Value?.Equals("true", StringComparison.OrdinalIgnoreCase) == true ? "Enabled" : "Disabled")
                                        </label>
                                    </div>
                                }
                                else if (timezoneKeys.Contains(setting.Key))
                                {
                                    <!-- Dropdown for Timezone — IANA IDs, avoids free-text typos -->
                                    @{
                                        var currentTz = (setting.Value ?? "UTC").Replace(' ', '_');
                                    }
                                    <select name="@setting.Key" class="form-select" id="setting_@setting.Key" data-no-picker="true">
                                        @foreach (var (tzId, tzLabel) in commonTimezones)
                                        {
                                            if (tzId.Equals(currentTz, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@tzId" selected>@tzLabel</option>
                                            }
                                            else
                                            {
                                                <option value="@tzId">@tzLabel</option>
                                            }
                                        }
                                    </select>
                                }
                                else if (dropdownKeys.Contains(setting.Key) && employees != null)
                                {
                                    <!-- Dropdown for DefaultAssigneeId -->
                                    <select name="@setting.Key" class="form-select" id="setting_@setting.Key" data-no-picker="true">
                                        <option value="">-- No Default Assignee --</option>
                                        @foreach (var emp in employees)
                                        {
                                            if (setting.Value == emp.Id.ToString())
                                            {
                                                <option value="@emp.Id" selected="selected">@emp.FullName (@emp.Department)</option>
                                            }
                                            else
                                            {
                                                <option value="@emp.Id">@emp.FullName (@emp.Department)</option>
                                            }
                                        }
                                    </select>
                                }
                                else
                                {
                                    <!-- Standard text input -->
                                    <input type="text"
                                           class="form-control"
                                           name="@setting.Key"
                                           value="@setting.Value"
                                           id="setting_@setting.Key" />
                                }

                                @if (!string.IsNullOrEmpty(setting.Description))
                                {
                                    <div class="form-text text-muted">
                                        <i class="bi bi-info-circle me-1"></i> @setting.Description
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mb-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save Settings
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Related settings quick-nav -->
            <div class="card shadow-sm mb-4 border-0" style="background:#f8fafc;">
                <div class="card-body">
                    <h6 class="card-title text-muted mb-3">
                        <i class="bi bi-grid-3x3-gap me-1"></i> Related Settings
                    </h6>
                    <div class="d-grid gap-2">
                        <a asp-action="Branding" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-palette me-2"></i> Branding
                            <small class="d-block text-muted" style="font-size:0.7rem;">Logo, colours, email header &amp; footer</small>
                        </a>
                        <a asp-action="Notifications" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-bell me-2"></i> Notification Settings
                            <small class="d-block text-muted" style="font-size:0.7rem;">Toggle which events send emails</small>
                        </a>
                        <a asp-action="EmailTemplates" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-envelope-at me-2"></i> Email Templates
                            <small class="d-block text-muted" style="font-size:0.7rem;">Customise notification email bodies</small>
                        </a>
                        <a asp-action="Users" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-people me-2"></i> Portal Users
                            <small class="d-block text-muted" style="font-size:0.7rem;">Manage user accounts &amp; passwords</small>
                        </a>
                        <a asp-action="Roles" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-shield-check me-2"></i> Roles &amp; Permissions
                            <small class="d-block text-muted" style="font-size:0.7rem;">Access control and role configuration</small>
                        </a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-lightbulb me-1 text-warning"></i> Tips
                    </h6>
                    <ul class="small text-muted mb-0">
                        <li class="mb-2">The <strong>Ticket Prefix</strong> is prepended to all ticket IDs (e.g., "SD-1001").</li>
                        <li class="mb-2">Setting a <strong>Default Assignee</strong> will auto-assign new tickets when no specific assignee is selected.</li>
                        <li class="mb-2">Enable <strong>Auto Assign</strong> to automatically distribute tickets using round-robin logic.</li>
                        <li>Toggle <strong>Email Notifications</strong> to control whether the system sends email alerts for ticket updates.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</form>

@functions {
    string FormatKey(string key)
    {
        if (string.IsNullOrEmpty(key)) return key;

        var result = new System.Text.StringBuilder();
        result.Append(key[0]);

        for (int i = 1; i < key.Length; i++)
        {
            if (char.IsUpper(key[i]) && !char.IsUpper(key[i - 1]))
            {
                result.Append(' ');
            }
            result.Append(key[i]);
        }

        return result.ToString();
    }
}
