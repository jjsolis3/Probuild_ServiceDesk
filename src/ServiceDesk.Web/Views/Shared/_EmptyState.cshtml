@*
    Generic empty-state partial. Pass a small anonymous model when invoking:
        @await Html.PartialAsync("_EmptyState", new {
            Icon       = "bi-ticket-perforated",
            Title      = "No tickets yet",
            Message    = "Tickets you submit or are assigned to will appear here.",
            ActionLink = Url.Action("Create", "Tickets"),
            ActionText = "New Ticket",
            ActionIcon = "bi-plus-lg"
        })

    Optional fields:
        SecondaryLink / SecondaryText / SecondaryIcon — second CTA
        Tone — "success" | "warning" | "danger" | "neutral" (default)

    Properties are read reflectively so call sites only need to pass what
    they care about; missing properties resolve to null without throwing
    a dynamic-binder exception. Use anonymous objects freely.
*@
@{
    // Reflection-based lookup — works against any anonymous type because
    // anonymous types are public read-only properties under the hood.
    // Returns null when the property doesn't exist on the supplied model,
    // which is the behavior the call sites have always expected.
    string? GetString(string name)
    {
        var prop = Model?.GetType().GetProperty(name);
        var v    = prop?.GetValue(Model);
        return v?.ToString();
    }

    var icon       = GetString("Icon")       ?? "bi-inbox";
    var title      = GetString("Title")      ?? "Nothing here yet";
    var message    = GetString("Message");
    var actionLink = GetString("ActionLink");
    var actionText = GetString("ActionText");
    var actionIcon = GetString("ActionIcon") ?? "bi-plus-lg";
    var tone       = GetString("Tone")       ?? "neutral";

    var secondaryLink = GetString("SecondaryLink");
    var secondaryText = GetString("SecondaryText");
    var secondaryIcon = GetString("SecondaryIcon") ?? "bi-arrow-right";

    var iconColor = tone switch
    {
        "success" => "#16a34a",
        "warning" => "#f59e0b",
        "danger"  => "#dc2626",
        _         => "#6c757d"
    };
    var bgColor = tone switch
    {
        "success" => "#ecfdf5",
        "warning" => "#fffbeb",
        "danger"  => "#fef2f2",
        _         => "#f8f9fb"
    };
}
<div class="text-center py-5 px-3 rounded" style="background:@bgColor;border:1px dashed #e5e7eb;">
    <div class="d-inline-flex align-items-center justify-content-center mb-3"
         style="width:72px;height:72px;border-radius:50%;background:#fff;color:@iconColor;font-size:2rem;border:1px solid #e5e7eb;">
        <i class="bi @icon"></i>
    </div>
    <h5 class="mb-2" style="color:#1f2937;">@title</h5>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="text-muted mb-3" style="max-width:480px;margin:0 auto;">@message</p>
    }
    @if (!string.IsNullOrWhiteSpace(actionLink) && !string.IsNullOrWhiteSpace(actionText))
    {
        <a href="@actionLink" class="btn btn-primary">
            <i class="bi @actionIcon me-1"></i>@actionText
        </a>
    }
    @if (!string.IsNullOrWhiteSpace(secondaryLink) && !string.IsNullOrWhiteSpace(secondaryText))
    {
        <a href="@secondaryLink" class="btn btn-outline-secondary ms-2">
            <i class="bi @secondaryIcon me-1"></i>@secondaryText
        </a>
    }
</div>
