@{
    var companyName        = ViewBag.CompanyName        as string ?? "Your Company";
    var companyLogoUrl     = ViewBag.CompanyLogoUrl     as string ?? string.Empty;
    var companyPhone       = ViewBag.CompanyPhone       as string ?? string.Empty;
    var companyWebsite     = ViewBag.CompanyWebsite     as string ?? string.Empty;
    var supportTitle       = ViewBag.PortalSupportTitle as string ?? "IT Support Portal";
    var announcement       = ViewBag.PortalAnnouncement     as string ?? string.Empty;
    var announcementType   = ViewBag.PortalAnnouncementType as string ?? "info";
    bool showKb            = ViewBag.PortalShowKnowledgeBase is bool b ? b : true;
    bool showStore         = ViewBag.PortalShowStore         is bool s ? s : false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @companyName @supportTitle</title>
    <link rel="shortcut icon" type="image/png" href="~/images/logo-sm.png" />
    <link rel="stylesheet" href="~/jobick/css/style.css" />
    <link rel="stylesheet" href="~/css/servicesphere.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">

<!-- Portal Nav -->
<nav class="navbar navbar-expand-lg bg-white shadow-sm border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/Portal">
            @if (!string.IsNullOrEmpty(companyLogoUrl))
            {
                <img src="@companyLogoUrl" alt="@companyName" style="height:32px;object-fit:contain;" />
            }
            else
            {
                <img src="~/images/logo-sm.png" alt="@companyName" style="height:32px;object-fit:contain;" />
            }
            @companyName
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="portalNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "MyTickets" ? "active fw-semibold" : "")"
                       href="/Portal">
                        <i class="bi bi-ticket-detailed me-1"></i>My Tickets
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Submit" ? "active fw-semibold" : "")"
                       href="/Portal/SubmitTicket">
                        <i class="bi bi-plus-circle me-1"></i>Submit Ticket
                    </a>
                </li>
                @if (showKb)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "KB" ? "active fw-semibold" : "")"
                           asp-controller="Portal" asp-action="KnowledgeBase">
                            <i class="bi bi-book-half me-1"></i>Knowledge Base
                        </a>
                    </li>
                }
                @if (showStore)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Store" ? "active fw-semibold" : "")"
                           asp-controller="Store" asp-action="Index">
                            <i class="bi bi-shop me-1"></i>Store
                        </a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                @if (User.IsInRole("Admin") || User.IsInRole("IT Agent"))
                {
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Home" asp-action="Index" title="Return to IT Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>IT Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <span class="badge bg-warning text-dark">IT Staff</span>
                    </li>
                }
                <li class="nav-item">
                    <span class="text-muted small">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                    </span>
                </li>
                <li class="nav-item">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container py-4">
    @if (!string.IsNullOrWhiteSpace(announcement))
    {
        <div class="alert alert-@announcementType alert-dismissible fade show py-2 mb-3" role="alert">
            <i class="bi bi-megaphone me-2"></i>@announcement
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</div>

<footer class="border-top bg-white py-3 mt-5">
    <div class="container text-center text-muted small">
        @companyName IT Support &copy; @DateTime.Now.Year
        @if (!string.IsNullOrEmpty(companyPhone))
        {
            <span class="mx-2">&mdash;</span>
            <i class="bi bi-telephone me-1"></i>@companyPhone
        }
        @if (!string.IsNullOrEmpty(companyWebsite))
        {
            <span class="mx-2">&mdash;</span>
            <a href="@companyWebsite" target="_blank" rel="noopener" class="text-muted">@companyWebsite</a>
        }
        <span class="mx-2">&mdash;</span>
        <span class="opacity-50">Powered by ServiceSphere</span>
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
