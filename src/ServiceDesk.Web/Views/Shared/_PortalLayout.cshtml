@{
    var companyName        = ViewBag.CompanyName        as string ?? "Your Company";
    var companyLogoUrl     = ViewBag.CompanyLogoUrl     as string ?? string.Empty;
    var companyPhone       = ViewBag.CompanyPhone       as string ?? string.Empty;
    var companyWebsite     = ViewBag.CompanyWebsite     as string ?? string.Empty;
    var supportTitle       = ViewBag.PortalSupportTitle as string ?? "IT Support Portal";
    var announcement       = ViewBag.PortalAnnouncement     as string ?? string.Empty;
    var announcementType   = ViewBag.PortalAnnouncementType as string ?? "info";
    bool showKb            = ViewBag.PortalShowKnowledgeBase is bool b ? b : true;
    bool showStore         = ViewBag.PortalShowStore         is bool s ? s : false;
    bool showOpsHub        = ViewBag.PortalShowOpsHub        is bool o ? o : false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @companyName @supportTitle</title>
    <link rel="shortcut icon" type="image/png" href="~/images/logo-sm.png" />
    <link rel="stylesheet" href="~/jobick/css/style.css" />
    <link rel="stylesheet" href="~/css/servicesphere.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">

<!-- Portal Nav -->
<nav class="navbar navbar-expand-lg bg-white shadow-sm border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/Portal">
            @if (!string.IsNullOrEmpty(companyLogoUrl))
            {
                <img src="@companyLogoUrl" alt="@companyName" style="height:32px;object-fit:contain;" />
            }
            else
            {
                <img src="~/images/logo-sm.png" alt="@companyName" style="height:32px;object-fit:contain;" />
            }
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="portalNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "MyTickets" ? "active fw-semibold" : "")"
                       href="/Portal">
                        <i class="bi bi-ticket-detailed me-1"></i>My Tickets
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Submit" ? "active fw-semibold" : "")"
                       href="/Portal/SubmitTicket">
                        <i class="bi bi-plus-circle me-1"></i>Submit Ticket
                    </a>
                </li>
                @if (showKb)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "KB" ? "active fw-semibold" : "")"
                           asp-controller="Portal" asp-action="KnowledgeBase">
                            <i class="bi bi-book-half me-1"></i>Knowledge Base
                        </a>
                    </li>
                }
                @if (showStore)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Store" ? "active fw-semibold" : "")"
                           asp-controller="Store" asp-action="Index">
                            <i class="bi bi-shop me-1"></i>Store
                        </a>
                    </li>
                }
                @if (showOpsHub)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "OpsHub" ? "active fw-semibold" : "")"
                           asp-controller="Store" asp-action="OperationsHub">
                            <i class="bi bi-boxes me-1"></i>Operations Hub
                        </a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                @if (User.IsInRole("Admin") || User.IsInRole("IT Agent"))
                {
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Home" asp-action="Index" title="Return to IT Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>IT Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <span class="badge bg-warning text-dark">IT Staff</span>
                    </li>
                }
                <li class="nav-item dropdown" id="portalNotificationBell">
                    <a class="nav-link position-relative" href="#" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false"
                       title="Notifications">
                        <i class="bi bi-bell fs-5"></i>
                        <span id="portalNotifBadge"
                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                              style="font-size:.65rem;">0</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end shadow"
                         style="width: 360px; max-width: 92vw; padding: 0;">
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <strong class="small text-uppercase text-muted">Notifications</strong>
                            <button type="button" id="portalNotifMarkAll"
                                    class="btn btn-link btn-sm p-0 text-decoration-none d-none">
                                Mark all read
                            </button>
                        </div>
                        <div id="portalNotifList" style="max-height: 420px; overflow-y: auto;">
                            <div class="text-center text-muted small py-4">Loading&hellip;</div>
                        </div>
                    </div>
                </li>
                <li class="nav-item">
                    <span class="text-muted small">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                    </span>
                </li>
                <li class="nav-item">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container py-4">
    @if (!string.IsNullOrWhiteSpace(announcement))
    {
        <div class="alert alert-@announcementType alert-dismissible fade show py-2 mb-3" role="alert">
            <i class="bi bi-megaphone me-2"></i>@announcement
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</div>

<footer class="border-top bg-white py-3 mt-5">
    <div class="container text-center text-muted small">
        @companyName IT Support 
        @if (!string.IsNullOrEmpty(companyPhone))
        {
            <span class="mx-2">&mdash;</span>
            <i class="bi bi-telephone me-1"></i>@companyPhone
        }
        @if (!string.IsNullOrEmpty(companyWebsite))
        {
            <span class="mx-2">&mdash;</span>
            <a href="@companyWebsite" target="_blank" rel="noopener" class="text-muted">@companyWebsite</a>
        }
        <span class="mx-2">&mdash;</span>
        <span class="opacity-50">Powered by ServiceSphere</span> 
        &copy; @DateTime.Now.Year
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@Html.AntiForgeryToken()
<script>
(function () {
    var bell = document.getElementById('portalNotificationBell');
    if (!bell) return;

    var badge   = document.getElementById('portalNotifBadge');
    var list    = document.getElementById('portalNotifList');
    var markAll = document.getElementById('portalNotifMarkAll');

    function tokenHeader() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? { 'RequestVerificationToken': t.value } : {};
    }

    function timeAgo(iso) {
        var d = new Date(iso);
        var s = Math.max(1, Math.floor((Date.now() - d.getTime()) / 1000));
        if (s < 60)   return s + 's ago';
        if (s < 3600) return Math.floor(s / 60) + 'm ago';
        if (s < 86400) return Math.floor(s / 3600) + 'h ago';
        if (s < 604800) return Math.floor(s / 86400) + 'd ago';
        return d.toLocaleDateString();
    }

    function escapeHtml(s) {
        return (s == null ? '' : String(s))
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderItems(items) {
        if (!items || items.length === 0) {
            list.innerHTML = '<div class="text-center text-muted small py-4">' +
                '<i class="bi bi-bell-slash d-block mb-2" style="font-size:1.8rem;opacity:.4;"></i>' +
                'You\'re all caught up.</div>';
            return;
        }
        var html = '';
        items.forEach(function (n) {
            var icon  = n.icon || 'bi-info-circle';
            var bg    = n.isRead ? '' : 'background:#f1f7ff;';
            var fw    = n.isRead ? '' : 'font-weight:600;';
            var msg   = n.message ? '<div class="small text-muted">' + escapeHtml(n.message) + '</div>' : '';
            var href  = n.linkUrl || '#';
            html += '<a href="' + escapeHtml(href) + '" data-notif-id="' + n.id +
                    '" class="d-block px-3 py-2 text-decoration-none text-dark border-bottom portal-notif-item" style="' + bg + '">' +
                    '<div class="d-flex gap-2">' +
                    '<i class="bi ' + escapeHtml(icon) + ' text-primary mt-1"></i>' +
                    '<div class="flex-grow-1" style="min-width:0;">' +
                        '<div class="small text-truncate" style="' + fw + '">' + escapeHtml(n.title) + '</div>' +
                        msg +
                        '<div class="text-muted" style="font-size:.7rem;">' + timeAgo(n.createdAt) + '</div>' +
                    '</div></div></a>';
        });
        list.innerHTML = html;
    }

    function load() {
        fetch('/PortalNotifications/Feed', { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
                if (!data) {
                    list.innerHTML = '<div class="text-center text-muted small py-4">' +
                                     'Unable to load notifications.</div>';
                    return;
                }
                if (data.unread > 0) {
                    badge.textContent = data.unread > 99 ? '99+' : data.unread;
                    badge.classList.remove('d-none');
                    markAll.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                    markAll.classList.add('d-none');
                }
                renderItems(data.items);
            })
            .catch(function () {
                list.innerHTML = '<div class="text-center text-muted small py-4">' +
                                 'Unable to load notifications.</div>';
            });
    }

    // Mark a single notification read when clicked (server-side; navigation continues).
    list.addEventListener('click', function (e) {
        var a = e.target.closest('.portal-notif-item');
        if (!a) return;
        var id = a.getAttribute('data-notif-id');
        if (!id) return;
        var headers = Object.assign({ 'Content-Type': 'application/x-www-form-urlencoded' }, tokenHeader());
        fetch('/PortalNotifications/MarkRead/' + id, {
            method: 'POST', credentials: 'same-origin', headers: headers
        }).catch(function () { /* ignore */ });
    });

    markAll.addEventListener('click', function (e) {
        e.preventDefault();
        var headers = Object.assign({ 'Content-Type': 'application/x-www-form-urlencoded' }, tokenHeader());
        fetch('/PortalNotifications/MarkAllRead', {
            method: 'POST', credentials: 'same-origin', headers: headers
        }).then(load).catch(function () { /* ignore */ });
    });

    // Initial load + refresh every 60 seconds.
    load();
    setInterval(load, 60000);
})();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
