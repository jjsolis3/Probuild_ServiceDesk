@using System.Text.Json
@{
    string companyName    = ViewBag.CompanyName    as string ?? "Your Company";
    string companyLogo    = ViewBag.CompanyLogoUrl as string ?? "";
    string companyPhone   = ViewBag.CompanyPhone   as string ?? "";
    string companyAddress = ViewBag.CompanyAddress as string ?? "";

    var brandingJson = JsonSerializer.Serialize(new {
        name    = companyName,
        logo    = companyLogo,
        phone   = companyPhone,
        address = companyAddress,
        ssLogo  = Url.Content("~/images/logo.png"),
        ssDark  = Url.Content("~/images/logo_Dark.png")
    });
}

<!-- ─── Export / Print Preview Modal ─────────────────────────────── -->
<div class="modal fade" id="ssExportModal" tabindex="-1" aria-labelledby="ssExportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-secondary">

            <!-- toolbar -->
            <div class="modal-header bg-dark text-white border-0 py-2 px-3">
                <h6 class="modal-title mb-0 me-3" id="ssExportModalLabel">
                    <i class="bi bi-file-earmark-text me-2"></i><span id="ssExportModalTitle">Export Preview</span>
                </h6>
                <div class="d-flex gap-2 ms-auto me-3">
                    <button class="btn btn-sm btn-danger" id="ssExportPdfBtn" onclick="ssExport.downloadPdf()">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
                    </button>
                    <button class="btn btn-sm btn-light" onclick="ssExport.printPreview()">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"
                        id="ssExportCloseBtn"></button>
            </div>

            <!-- paper preview -->
            <div class="modal-body overflow-auto p-4">
                <div id="ssExportPage"
                     style="background:#fff;max-width:960px;margin:0 auto;padding:32px 40px;
                            box-shadow:0 4px 24px rgba(0,0,0,.35);min-height:600px;font-family:Arial,sans-serif;font-size:13px;">
                    <!-- populated by ssExport.show() -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var __ssBranding = @Html.Raw(brandingJson);
</script>
<script>
(function () {
    /* ── branding ── */
    var B = window.__ssBranding;

    /* ── public API ── */
    window.ssExport = {
        _title: '',
        _html2pdfLoaded: false,
        show: show,
        downloadPdf: downloadPdf,
        printPreview: printPreview
    };

    /* ── helpers ── */
    function escHtml(s) {
        return String(s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function imgTag(src, alt, style) {
        return src ? '<img src="' + escHtml(src) + '" alt="' + escHtml(alt || '') + '" style="' + (style || '') + '" onerror="this.style.display=\'none\'">' : '';
    }

    function buildHeader(title) {
        var logoHtml = B.logo
            ? imgTag(B.logo, B.name, 'max-height:48px;max-width:160px;object-fit:contain;')
            : '<span style="font-size:18px;font-weight:700;color:#1a3a6b;">' + escHtml(B.name) + '</span>';
        var meta = [];
        if (B.address) meta.push(escHtml(B.address));
        if (B.phone)   meta.push(escHtml(B.phone));

        return '<table style="width:100%;border-collapse:collapse;margin-bottom:0;">' +
            '<tr>' +
              '<td style="width:60%;vertical-align:bottom;border:none;padding:0;">' +
                logoHtml +
                (meta.length ? '<div style="color:#555;font-size:11px;margin-top:4px;">' + meta.join(' &bull; ') + '</div>' : '') +
              '</td>' +
              '<td style="width:40%;vertical-align:bottom;text-align:right;border:none;padding:0;">' +
                '<div style="font-size:16px;font-weight:700;color:#1a3a6b;">' + escHtml(title) + '</div>' +
                '<div style="font-size:11px;color:#777;margin-top:2px;">Generated: ' + new Date().toLocaleString() + '</div>' +
              '</td>' +
            '</tr>' +
            '<tr><td colspan="2" style="border:none;padding:0;">' +
              '<hr style="border:none;border-top:2px solid #1a3a6b;margin:8px 0 16px 0;">' +
            '</td></tr>' +
          '</table>';
    }

    function buildFooter() {
        var ssLogoHtml = imgTag(B.ssLogo, 'ServiceSphere', 'height:20px;vertical-align:middle;margin-right:5px;');
        return '<div style="margin-top:24px;">' +
            '<hr style="border:none;border-top:1px solid #ddd;margin:0 0 8px 0;">' +
            '<table style="width:100%;border-collapse:collapse;">' +
              '<tr>' +
                '<td style="font-size:10px;color:#999;border:none;padding:0;">Confidential &bull; Internal Use Only</td>' +
                '<td style="text-align:right;border:none;padding:0;">' +
                  '<span style="font-size:10px;color:#555;">' + ssLogoHtml +
                    'Powered by <strong>ServiceSphere</strong> &mdash; a <strong>ProbuildIQ&trade;</strong> product' +
                  '</span>' +
                '</td>' +
              '</tr>' +
            '</table>' +
          '</div>';
    }

    /* ── normalise table styles for PDF rendering ── */
    function normaliseTables(root) {
        root.querySelectorAll('table').forEach(function (t) {
            t.style.borderCollapse = 'collapse';
            t.style.width = '100%';
            t.style.fontSize = '12px';
        });
        root.querySelectorAll('th, td').forEach(function (c) {
            c.style.border = '1px solid #dee2e6';
            c.style.padding = '4px 7px';
            c.style.verticalAlign = 'top';
        });
        root.querySelectorAll('th').forEach(function (c) {
            c.style.backgroundColor = '#f0f4fa';
            c.style.fontWeight = '700';
        });
        /* strip zebra-stripe background from DataTables odd rows */
        root.querySelectorAll('tr.odd, tr.even').forEach(function (r) {
            r.style.backgroundColor = '';
        });
    }

    /* ── DataTables: expand to all rows before cloning ── */
    function dtShowAll(contentEl) {
        var restored = [];
        if (typeof $ !== 'undefined' && $.fn && $.fn.dataTable) {
            contentEl.querySelectorAll('table.dataTable').forEach(function (tbl) {
                try {
                    var dt = $(tbl).DataTable();
                    var prev = dt.page.len();
                    dt.page.len(-1).draw(false);
                    restored.push({ dt: dt, prev: prev });
                } catch (e) { /* not a DT table */ }
            });
        }
        return restored;
    }

    function dtRestore(restored) {
        (restored || []).forEach(function (r) {
            try { r.dt.page.len(r.prev).draw(false); } catch (e) {}
        });
    }

    /* ── strip non-print elements from a clone ── */
    function stripInteractive(root) {
        /* remove buttons, forms, pagination, filter widgets */
        root.querySelectorAll(
            'button, input, select, form, .dataTables_filter, .dataTables_length, ' +
            '.dataTables_paginate, .dataTables_info, .btn, .alert-dismissible .btn-close, ' +
            '.no-export, [data-bs-dismiss]'
        ).forEach(function (el) { el.remove(); });

        /* remove action columns (th/td with class no-export or containing only icon buttons) */
        var headerCells = Array.from(root.querySelectorAll('thead th'));
        var actIdxs = [];
        headerCells.forEach(function (th, i) {
            if (th.classList.contains('no-export')) actIdxs.push(i);
        });
        if (actIdxs.length) {
            root.querySelectorAll('tr').forEach(function (row) {
                var cells = Array.from(row.querySelectorAll('th, td'));
                actIdxs.forEach(function (idx) {
                    if (cells[idx]) cells[idx].remove();
                });
            });
        }

        /* unwrap hidden/collapsed DataTables child rows */
        root.querySelectorAll('tr.child').forEach(function (r) { r.remove(); });

        /* strip inline Bootstrap utility bg colors that look bad in print */
        root.querySelectorAll('.bg-primary, .bg-success, .bg-danger, .bg-warning, .bg-info, .bg-secondary, .bg-dark').forEach(function(el){
            el.classList.remove('bg-primary','bg-success','bg-danger','bg-warning','bg-info','bg-secondary','bg-dark');
        });
    }

    /* ── main public entry point ── */
    function show(contentEl, title) {
        if (typeof contentEl === 'string') contentEl = document.getElementById(contentEl);
        if (!contentEl) { console.error('ssExport.show: element not found'); return; }

        window.ssExport._title = title || document.title;
        document.getElementById('ssExportModalTitle').textContent = window.ssExport._title;

        /* expand DataTables to show all rows */
        var restored = dtShowAll(contentEl);

        /* clone content */
        var clone = contentEl.cloneNode(true);

        /* restore table pagination immediately */
        dtRestore(restored);

        /* strip interactive chrome */
        stripInteractive(clone);

        /* normalise table styles */
        normaliseTables(clone);

        /* assemble page */
        var page = document.getElementById('ssExportPage');
        page.innerHTML = buildHeader(window.ssExport._title) + clone.innerHTML + buildFooter();

        /* show modal */
        var modal = bootstrap.Modal.getOrCreate(document.getElementById('ssExportModal'));
        modal.show();

        /* lazy-load html2pdf */
        loadHtml2Pdf(function () {
            document.getElementById('ssExportPdfBtn').disabled = false;
        });
    }

    /* ── PDF download ── */
    function downloadPdf() {
        loadHtml2Pdf(function () {
            var page = document.getElementById('ssExportPage');
            var filename = (window.ssExport._title || 'export').replace(/[^a-z0-9]/gi, '_').toLowerCase() + '.pdf';
            html2pdf().set({
                margin:      [8, 8, 8, 8],
                filename:    filename,
                image:       { type: 'jpeg', quality: 0.95 },
                html2canvas: { scale: 2, useCORS: true, logging: false },
                jsPDF:       { unit: 'mm', format: 'a4', orientation: 'landscape' }
            }).from(page).save();
        });
    }

    /* ── print window ── */
    function printPreview() {
        var page = document.getElementById('ssExportPage');
        var win = window.open('', '_blank', 'width=1100,height=800');
        if (!win) { alert('Please allow pop-ups to use the Print feature.'); return; }
        win.document.write(
            '<!DOCTYPE html><html><head><meta charset="utf-8">' +
            '<title>' + escHtml(window.ssExport._title) + '</title>' +
            '<style>' +
              'body{font-family:Arial,sans-serif;font-size:13px;margin:24px;color:#222;}' +
              'table{border-collapse:collapse;width:100%;font-size:12px;}' +
              'th,td{border:1px solid #ccc;padding:4px 7px;vertical-align:top;}' +
              'th{background:#f0f4fa;font-weight:700;}' +
              'img{max-width:100%;height:auto;}' +
              'hr{border:none;border-top:1px solid #1a3a6b;}' +
              '@@page{margin:12mm;}' +
            '</style>' +
            '</head><body>' +
            page.innerHTML +
            '</body></html>'
        );
        win.document.close();
        win.focus();
        setTimeout(function () { win.print(); }, 600);
    }

    /* ── lazy load html2pdf.js ── */
    function loadHtml2Pdf(cb) {
        if (window.html2pdf) { cb(); return; }
        if (window.ssExport._html2pdfLoaded) {
            /* already injecting — poll */
            var t = setInterval(function () {
                if (window.html2pdf) { clearInterval(t); cb(); }
            }, 100);
            return;
        }
        window.ssExport._html2pdfLoaded = true;
        var s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
        s.onload  = cb;
        s.onerror = function () { console.error('html2pdf.js failed to load'); };
        document.head.appendChild(s);
    }
})();
</script>
