    <script type="application/json" id="__ssLayoutBranding">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { companyName = (string)(ViewBag.CompanyName ?? "ServiceSphere"), brandColor = "#4f46e5" }))</script>
    <script>
        window.ssBranding = JSON.parse(document.getElementById('__ssLayoutBranding').textContent);
    </script>
    <!-- ServiceSphere Custom JS -->
    <script src="~/js/servicesphere.js"></script>
    <!-- DataTables Initialization -->
    <script src="~/js/servicesphere-datatables.js"></script>
    <!-- ===== Global: Confirm Delete Modal ===== -->
    <div class="modal fade" id="ssConfirmModal" tabindex="-1" aria-labelledby="ssConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="ssConfirmModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="ssConfirmModalBody">Are you sure? This action cannot be undone.</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="ssConfirmModalConfirm">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
    // ===== Global: Confirm modal =====
    (function () {
        var modal = null;
        var pendingForm = null;

        document.addEventListener('DOMContentLoaded', function () {
            modal = new bootstrap.Modal(document.getElementById('ssConfirmModal'));

            // Wire up any form with data-confirm-message attribute
            document.querySelectorAll('form[data-confirm-message]').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    pendingForm = form;
                    var title = form.getAttribute('data-confirm-title') || 'Confirm Delete';
                    var msg   = form.getAttribute('data-confirm-message') || 'Are you sure? This cannot be undone.';
                    document.getElementById('ssConfirmModalLabel').innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i>' + title;
                    document.getElementById('ssConfirmModalBody').textContent = msg;
                    modal.show();
                });
            });

            document.getElementById('ssConfirmModalConfirm').addEventListener('click', function () {
                if (pendingForm) {
                    modal.hide();
                    // Remove the event listener to prevent infinite loop then submit
                    pendingForm.removeAttribute('data-confirm-message');
                    pendingForm.submit();
                    pendingForm = null;
                }
            });

            // ===== Global: Auto-disable submit button on form submit =====
            document.querySelectorAll('form[data-loading-btn]').forEach(function (form) {
                form.addEventListener('submit', function () {
                    var btnId = form.getAttribute('data-loading-btn');
                    var btn = document.getElementById(btnId);
                    if (btn && !btn.disabled) {
                        btn.disabled = true;
                        var orig = btn.innerHTML;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Saving…';
                        // Re-enable after 8s as safety fallback
                        setTimeout(function () { btn.disabled = false; btn.innerHTML = orig; }, 8000);
                    }
                });
            });
        });
    })();
    </script>
    <script>
        (function () {
            function getThemeMode() {
                const bodyTheme = document.body?.getAttribute('data-theme-version');
                const htmlTheme = document.documentElement?.getAttribute('data-theme-version');

                if (bodyTheme) return bodyTheme.toLowerCase();
                if (htmlTheme) return htmlTheme.toLowerCase();

                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }

            function isSidebarCollapsed() {
                const wrapper = document.getElementById('main-wrapper');
                const sidebarStyle = document.body?.getAttribute('data-sidebar-style');

                return (
                    wrapper?.classList.contains('menu-toggle') ||
                    sidebarStyle === 'mini' ||
                    sidebarStyle === 'compact' ||
                    sidebarStyle === 'icon-hover'
                );
            }

            function updateBrandLogo() {
                const img = document.getElementById('brandLogo');
                if (!img) return;

                if (isSidebarCollapsed()) {
                    img.src = img.dataset.logoSmall;
                    return;
                }

                const theme = getThemeMode();
                img.src = theme === 'dark'
                    ? img.dataset.logoDark
                    : img.dataset.logoLight;
            }

            document.addEventListener('DOMContentLoaded', function () {
                updateBrandLogo();

                const observer = new MutationObserver(updateBrandLogo);

                if (document.body) {
                    observer.observe(document.body, {
                        attributes: true,
                        attributeFilter: ['class', 'data-theme-version', 'data-sidebar-style']
                    });
                }

                const wrapper = document.getElementById('main-wrapper');
                if (wrapper) {
                    observer.observe(wrapper, {
                        attributes: true,
                        attributeFilter: ['class']
                    });
                }

                if (document.documentElement) {
                    observer.observe(document.documentElement, {
                        attributes: true,
                        attributeFilter: ['class', 'data-theme-version']
                    });
                }

                document.querySelector('.hamburger')?.addEventListener('click', function () {
                    setTimeout(updateBrandLogo, 80);
                    setTimeout(updateBrandLogo, 250);
                });

                document.querySelector('.dlab-theme-mode')?.addEventListener('click', function () {
                    setTimeout(updateBrandLogo, 80);
                    setTimeout(updateBrandLogo, 250);
                });

                window.addEventListener('resize', updateBrandLogo);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_ExportPreviewModal")

    <!-- ─── Command Palette ─────────────────────────────────────────────── -->
    <div id="cmdPaletteOverlay" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.55);backdrop-filter:blur(4px);" onclick="closeCmdPalette()">
    </div>
    <div id="cmdPaletteBox" style="display:none;position:fixed;top:120px;left:50%;transform:translateX(-50%);width:min(640px,96vw);z-index:10000;border-radius:14px;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,0.35);">
        <div style="background:#fff;border-radius:14px;">
            <div style="display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid #eee;gap:10px;">
                <i class="bi bi-search" style="color:#888;font-size:16px;flex-shrink:0;"></i>
                <input id="cmdInput" type="text" placeholder="Search tickets, assets, employees, KB…"
                       style="border:none;outline:none;width:100%;font-size:15px;background:transparent;"
                       autocomplete="off" spellcheck="false" />
                <kbd style="font-size:11px;color:#aaa;background:#f3f3f3;border:1px solid #ddd;border-radius:4px;padding:2px 6px;flex-shrink:0;">Esc</kbd>
            </div>
            <div id="cmdResults" style="max-height:420px;overflow-y:auto;padding:8px 0;">
                <div id="cmdEmpty" style="text-align:center;color:#aaa;font-size:13px;padding:28px 0;">
                    Type to search across the entire service desk…
                </div>
            </div>
        </div>
    </div>

    <script>
    (function() {
        var _open = false, _debounce = null, _selected = -1, _items = [];

        window.openCmdPalette = function() {
            document.getElementById('cmdPaletteOverlay').style.display = 'block';
            document.getElementById('cmdPaletteBox').style.display = 'block';
            document.getElementById('cmdInput').value = '';
            document.getElementById('cmdResults').innerHTML = document.getElementById('cmdEmpty').outerHTML;
            document.getElementById('cmdInput').focus();
            _open = true; _selected = -1; _items = [];
        };

        window.closeCmdPalette = function() {
            document.getElementById('cmdPaletteOverlay').style.display = 'none';
            document.getElementById('cmdPaletteBox').style.display = 'none';
            _open = false;
        };

        document.addEventListener('keydown', function(e) {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                _open ? closeCmdPalette() : openCmdPalette();
            }
            if (!_open) return;
            if (e.key === 'Escape') { closeCmdPalette(); return; }
            if (e.key === 'ArrowDown') { e.preventDefault(); moveSelection(1); }
            if (e.key === 'ArrowUp')   { e.preventDefault(); moveSelection(-1); }
            if (e.key === 'Enter') { e.preventDefault(); selectCurrent(); }
        });

        document.getElementById('cmdInput').addEventListener('input', function() {
            clearTimeout(_debounce);
            var q = this.value.trim();
            if (q.length < 2) {
                document.getElementById('cmdResults').innerHTML = document.getElementById('cmdEmpty').outerHTML;
                _items = []; _selected = -1;
                return;
            }
            _debounce = setTimeout(function() { doSearch(q); }, 280);
        });

        function doSearch(q) {
            fetch('/Home/GlobalSearch?q=' + encodeURIComponent(q))
                .then(function(r) { return r.json(); })
                .then(function(data) { renderResults(data.groups); });
        }

        function renderResults(groups) {
            _items = [];
            if (!groups || groups.length === 0) {
                document.getElementById('cmdResults').innerHTML =
                    '<div style="text-align:center;color:#aaa;font-size:13px;padding:28px 0;">No results found.</div>';
                return;
            }
            var html = '';
            groups.forEach(function(g) {
                html += '<div style="padding:6px 16px 2px;font-size:11px;font-weight:700;color:#aaa;letter-spacing:.06em;text-transform:uppercase;">'
                      + '<i class="bi ' + g.icon + ' me-1"></i>' + g.group + '</div>';
                g.items.forEach(function(item) {
                    var idx = _items.length;
                    _items.push(item.url);
                    html += '<div class="cmd-item" data-idx="' + idx + '" data-url="' + item.url + '" '
                          + 'style="display:flex;align-items:center;justify-content:space-between;padding:8px 16px;cursor:pointer;border-radius:0;gap:12px;" '
                          + 'onmouseenter="hoverItem(' + idx + ')" onclick="goTo(\'' + item.url + '\')">'
                          + '<div style="min-width:0;">'
                          + '<div style="font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + escHtml(item.label) + '</div>'
                          + '<div style="font-size:12px;color:#888;">' + escHtml(item.sub || '') + '</div>'
                          + '</div>'
                          + '<i class="bi bi-arrow-return-left" style="color:#ccc;font-size:12px;flex-shrink:0;"></i>'
                          + '</div>';
                });
            });
            document.getElementById('cmdResults').innerHTML = html;
            _selected = -1;
        }

        window.hoverItem = function(idx) { setSelected(idx); };

        function moveSelection(dir) {
            setSelected(Math.max(0, Math.min(_items.length - 1, _selected + dir)));
        }

        function setSelected(idx) {
            document.querySelectorAll('.cmd-item').forEach(function(el, i) {
                el.style.background = i === idx ? '#f0f4ff' : '';
            });
            _selected = idx;
        }

        function selectCurrent() {
            if (_selected >= 0 && _selected < _items.length) goTo(_items[_selected]);
        }

        window.goTo = function(url) { closeCmdPalette(); window.location.href = url; };

        function escHtml(s) {
            return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
    })();
    </script>

    @* ── Bell Notification Center ───────────────────────────────────────
       Polls /PortalNotifications/Feed every 60s, renders unread badge,
       supports mark-as-read on click and mark-all-read. Shared backend
       with the portal bell so we don't have two notification stacks.
       ─────────────────────────────────────────────────────────────── *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        @Html.AntiForgeryToken()
        <script>
        (function () {
            var bell = document.getElementById('staffNotificationBell');
            if (!bell) return;

            var badge   = document.getElementById('staffNotifBadge');
            var list    = document.getElementById('staffNotifList');
            var markAll = document.getElementById('staffNotifMarkAll');

            function tokenHeader() {
                var t = document.querySelector('input[name="__RequestVerificationToken"]');
                return t ? { 'RequestVerificationToken': t.value } : {};
            }

            function timeAgo(iso) {
                var d = new Date(iso);
                var s = Math.max(1, Math.floor((Date.now() - d.getTime()) / 1000));
                if (s < 60)    return s + 's ago';
                if (s < 3600)  return Math.floor(s / 60)   + 'm ago';
                if (s < 86400) return Math.floor(s / 3600) + 'h ago';
                if (s < 604800) return Math.floor(s / 86400) + 'd ago';
                return d.toLocaleDateString();
            }

            function escapeHtml(s) {
                return (s == null ? '' : String(s))
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            function renderItems(items) {
                if (!items || items.length === 0) {
                    list.innerHTML = '<div class="text-center text-muted small py-4">' +
                        '<i class="bi bi-bell-slash d-block mb-2" style="font-size:1.8rem;opacity:.4;"></i>' +
                        "You're all caught up.</div>";
                    return;
                }
                var html = '';
                items.forEach(function (n) {
                    var icon = n.icon || 'bi-info-circle';
                    var bg   = n.isRead ? '' : 'background:#eef4ff;';
                    var fw   = n.isRead ? '' : 'font-weight:600;';
                    var msg  = n.message ? '<div class="small text-muted">' + escapeHtml(n.message) + '</div>' : '';
                    var href = n.linkUrl || '#';
                    html += '<a href="' + escapeHtml(href) + '" data-notif-id="' + n.id +
                            '" class="d-block px-3 py-2 text-decoration-none text-dark border-bottom staff-notif-item" style="' + bg + '">' +
                            '<div class="d-flex gap-2">' +
                            '<i class="bi ' + escapeHtml(icon) + ' text-primary mt-1"></i>' +
                            '<div class="flex-grow-1" style="min-width:0;">' +
                                '<div class="small text-truncate" style="' + fw + '">' + escapeHtml(n.title) + '</div>' +
                                msg +
                                '<div class="text-muted" style="font-size:.7rem;">' + timeAgo(n.createdAt) + '</div>' +
                            '</div></div></a>';
                });
                list.innerHTML = html;
            }

            function load() {
                fetch('/PortalNotifications/Feed', { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) {
                        if (!data) {
                            list.innerHTML = '<div class="text-center text-muted small py-4">Unable to load notifications.</div>';
                            return;
                        }
                        if (data.unread > 0) {
                            badge.textContent = data.unread > 99 ? '99+' : data.unread;
                            badge.classList.remove('d-none');
                            markAll.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                            markAll.classList.add('d-none');
                        }
                        renderItems(data.items);
                    })
                    .catch(function () {
                        list.innerHTML = '<div class="text-center text-muted small py-4">Unable to load notifications.</div>';
                    });
            }

            list.addEventListener('click', function (e) {
                var a = e.target.closest('.staff-notif-item');
                if (!a) return;
                var id = a.getAttribute('data-notif-id');
                if (!id) return;
                var headers = Object.assign({ 'Content-Type': 'application/x-www-form-urlencoded' }, tokenHeader());
                fetch('/PortalNotifications/MarkRead/' + id, {
                    method: 'POST', credentials: 'same-origin', headers: headers
                }).catch(function () { /* ignore */ });
            });

            markAll.addEventListener('click', function (e) {
                e.preventDefault();
                var headers = Object.assign({ 'Content-Type': 'application/x-www-form-urlencoded' }, tokenHeader());
                fetch('/PortalNotifications/MarkAllRead', {
                    method: 'POST', credentials: 'same-origin', headers: headers
                }).then(load).catch(function () { /* ignore */ });
            });

            load();
            setInterval(load, 60000);
        })();
        </script>
    }

    @* ── Auto-save drafts ─────────────────────────────────────────────
       Any <textarea data-autosave="someKey"> (or <input> on the same
       attribute) is kept in sync with localStorage. Restored on page
       load with a discreet banner so the user can choose to discard.
       Cleared automatically when the surrounding form is submitted. *@
    <script>
    (function () {
        var STORAGE_PREFIX = 'ss-draft:';
        var DEBOUNCE_MS    = 500;

        function debounce(fn, ms) {
            var t; return function () {
                clearTimeout(t);
                t = setTimeout(fn, ms);
            };
        }

        function bannerFor(el, savedAt) {
            // Inject a small "Draft restored" notice right above the field.
            if (el.dataset.autosaveBannered) return;
            el.dataset.autosaveBannered = '1';
            var when = '';
            try {
                var d = new Date(savedAt);
                when = d.toLocaleString();
            } catch (e) { when = ''; }
            var banner = document.createElement('div');
            banner.className = 'small text-muted mb-1';
            banner.style.cssText = 'display:flex;justify-content:space-between;gap:8px;align-items:center;';
            banner.innerHTML =
                '<span><i class="bi bi-arrow-counterclockwise me-1 text-info"></i>Draft restored' +
                (when ? ' from ' + escAttr(when) : '') + '.</span>' +
                '<button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" data-discard>' +
                'Discard draft</button>';
            el.parentNode && el.parentNode.insertBefore(banner, el);
            banner.querySelector('[data-discard]').addEventListener('click', function () {
                el.value = '';
                localStorage.removeItem(storageKey(el));
                banner.remove();
                el.dataset.autosaveBannered = '';
                el.dispatchEvent(new Event('input', { bubbles: true }));
            });
        }

        function escAttr(s) {
            return (s || '').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        }

        function storageKey(el) {
            return STORAGE_PREFIX + el.getAttribute('data-autosave');
        }

        function restore(el) {
            var raw = localStorage.getItem(storageKey(el));
            if (!raw) return;
            try {
                var p = JSON.parse(raw);
                if (p && typeof p.value === 'string' && p.value !== '' && el.value === '') {
                    el.value = p.value;
                    bannerFor(el, p.at);
                }
            } catch (e) {
                // Legacy plain-string draft — promote then load.
                if (typeof raw === 'string' && raw !== '' && el.value === '') {
                    el.value = raw;
                    bannerFor(el, null);
                }
            }
        }

        function save(el) {
            var v = el.value || '';
            if (!v.trim()) {
                localStorage.removeItem(storageKey(el));
                return;
            }
            try {
                localStorage.setItem(storageKey(el), JSON.stringify({
                    value: v,
                    at:    new Date().toISOString()
                }));
            } catch (e) { /* quota / private mode */ }
        }

        function wire(el) {
            if (el.dataset.autosaveWired) return;
            el.dataset.autosaveWired = '1';
            restore(el);
            el.addEventListener('input',
                debounce(function () { save(el); }, DEBOUNCE_MS));
            // Clear on successful form submit — assume the server accepted
            // it; if it didn't, the user will reopen the form and reload
            // the draft from typing again.
            var form = el.closest('form');
            if (form && !form.dataset.autosaveClearWired) {
                form.dataset.autosaveClearWired = '1';
                form.addEventListener('submit', function () {
                    form.querySelectorAll('[data-autosave]').forEach(function (e) {
                        localStorage.removeItem(storageKey(e));
                    });
                });
            }
        }

        function scan() {
            document.querySelectorAll('[data-autosave]').forEach(wire);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scan);
        } else {
            scan();
        }
        // Re-scan on dynamic insertions (modals etc.). Cheap MutationObserver.
        try {
            new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
        } catch (e) { /* older browsers — initial scan is enough */ }
    })();
    </script>
</body>
</html>
