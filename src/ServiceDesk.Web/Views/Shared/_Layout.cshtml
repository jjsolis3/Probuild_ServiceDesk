                                        </div>
                                    </div>
                                </li>
                            }
                            <!-- Profile Dropdown -->
                            <li class="nav-item dropdown header-profile">
                                <a class="nav-link" href="javascript:void(0);" role="button" data-bs-toggle="dropdown">
                                    <div class="header-info">
                                        <span class="fw-semibold small me-1 d-none d-md-inline">@User.Identity?.Name</span>
                                        <i class="fas fa-user-circle fa-lg"></i>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <div class="dropdown-item text-muted small py-1 disabled">
                                        <i class="fas fa-user-circle me-1"></i>@User.Identity?.Name
                                        <div class="small opacity-75">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Settings" asp-action="Index" class="dropdown-item ai-icon">
                                            <i class="fas fa-cog text-primary me-2"></i>
                                            <span>Settings</span>
                                        </a>
                                    }
                                    <a asp-controller="Portal" asp-action="Index" class="dropdown-item ai-icon">
                                        <i class="fas fa-globe text-info me-2"></i>
                                        <span>User Portal</span>
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-block">
                                        <button type="submit" class="dropdown-item ai-icon text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>
                                            <span>Sign Out</span>
                                        </button>
                                    </form>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
