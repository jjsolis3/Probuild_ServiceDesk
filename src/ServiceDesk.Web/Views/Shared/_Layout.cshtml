<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiceSphere</title>
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/png" href="~/images/logo-sm.png" />
    <!-- Jobick Theme CSS (includes MetisMenu, Font Awesome, Bootstrap Icons via @import) -->
    <link rel="stylesheet" href="~/jobick/css/style.css" />
    <!-- Bootstrap Select (required by Jobick custom.min.js handleSelectPicker) -->
    <link rel="stylesheet" href="~/jobick/vendor/bootstrap-select/dist/css/bootstrap-select.min.css" />
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <!-- ServiceSphere Overrides -->
    <link rel="stylesheet" href="~/css/servicesphere.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!--**********************************
        Preloader
    ***********************************-->
    <div id="preloader">
        <div class="sk-three-bounce">
            <div class="sk-child sk-bounce1"></div>
            <div class="sk-child sk-bounce2"></div>
            <div class="sk-child sk-bounce3"></div>
        </div>
    </div>

    <!--**********************************
        Main wrapper start
    ***********************************-->
    <div id="main-wrapper">

        <!--**********************************
            Nav header start
        ***********************************-->
        <div class="nav-header">
            <a asp-controller="Home" asp-action="Index" class="brand-logo">
                <svg class="logo-abbr" xmlns="http://www.w3.org/2000/svg" width="54" height="54" viewBox="0 0 54 54">
                    <circle cx="27" cy="27" r="27" fill="#2f4cdd"/>
                    <text x="27" y="33" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="20" font-weight="bold">SS</text>
                </svg>
                <svg class="brand-title" xmlns="http://www.w3.org/2000/svg" width="160" height="32" viewBox="0 0 160 32">
                    <text x="0" y="22" font-family="Arial,sans-serif" font-size="18" font-weight="600" fill="#464646">ServiceSphere</text>
                </svg>
            </a>
            <div class="nav-control">
                <div class="hamburger">
                    <span class="line"></span><span class="line"></span><span class="line"></span>
                </div>
            </div>
        </div>
        <!--**********************************
            Nav header end
        ***********************************-->

        <!--**********************************
            Header start
        ***********************************-->
        <div class="header">
            <div class="header-content">
                <nav class="navbar navbar-expand">
                    <div class="collapse navbar-collapse justify-content-between">
                        <div class="header-left">
                            <div class="dashboard_bar">
                                @(ViewData["Title"]?.ToString() ?? "Dashboard")
                            </div>
                        </div>
                        <ul class="navbar-nav header-right">
                            <!-- Dark/Light Mode Toggle -->
                            <li class="nav-item dropdown notification_dropdown">
                                <a class="nav-link bell dlab-theme-mode p-0" href="javascript:void(0);" title="Toggle Theme">
                                    <i id="icon-light" class="fas fa-sun"></i>
                                    <i id="icon-dark" class="fas fa-moon"></i>
                                </a>
                            </li>
                            <!-- Profile Dropdown -->
                            <li class="nav-item dropdown header-profile">
                                <a class="nav-link" href="javascript:void(0);" role="button" data-bs-toggle="dropdown">
                                    <div class="header-info">
                                        <span class="text-black"><i class="fas fa-user-circle fa-lg"></i></span>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a asp-controller="Settings" asp-action="Index" class="dropdown-item ai-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                        <span class="ms-2">Settings</span>
                                    </a>
                                    <a href="#" class="dropdown-item ai-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="text-danger" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                        <span class="ms-2">Sign Out</span>
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
        <!--**********************************
            Header end
        ***********************************-->

        <!--**********************************
            Sidebar start
        ***********************************-->
        <div class="dlabnav">
            <div class="dlabnav-scroll">
                <ul class="metismenu" id="menu">

                    <!-- MAIN -->
                    <li class="menu-title"><span>Main</span></li>
                    <li>
                        <a asp-controller="Home" asp-action="Index" aria-expanded="false">
                            <i class="fas fa-tachometer-alt"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </li>

                    <!-- MANAGEMENT -->
                    <li class="menu-title"><span>Management</span></li>
                    <li>
                        <a asp-controller="Tickets" asp-action="Index" aria-expanded="false">
                            <i class="fas fa-ticket-alt"></i>
                            <span class="nav-text">Tickets</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Assets" asp-action="Index" aria-expanded="false">
                            <i class="fas fa-laptop"></i>
                            <span class="nav-text">Assets</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Employees" asp-action="Index" aria-expanded="false">
                            <i class="fas fa-users"></i>
                            <span class="nav-text">Employees</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Subscriptions" asp-action="Index" aria-expanded="false">
                            <i class="fas fa-credit-card"></i>
                            <span class="nav-text">Subscriptions</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Services" asp-action="Index" aria-expanded="false">
                            <i class="fas fa-cog"></i>
                            <span class="nav-text">Services</span>
                        </a>
                    </li>

                    <!-- ANALYTICS -->
                    <li class="menu-title"><span>Analytics</span></li>
                    <li>
                        <a class="has-arrow" href="javascript:void(0);" aria-expanded="false">
                            <i class="fas fa-chart-bar"></i>
                            <span class="nav-text">Reports</span>
                        </a>
                        <ul aria-expanded="false">
                            <li><a asp-controller="Reports" asp-action="Tickets">Ticket Reports</a></li>
                            <li><a asp-controller="Reports" asp-action="Assets">Asset Reports</a></li>
                            <li><a asp-controller="Reports" asp-action="Users">User Reports</a></li>
                        </ul>
                    </li>

                    <!-- ADMINISTRATION -->
                    <li class="menu-title"><span>Administration</span></li>
                    <li>
                        <a class="has-arrow" href="javascript:void(0);" aria-expanded="false">
                            <i class="fas fa-sliders-h"></i>
                            <span class="nav-text">Settings</span>
                        </a>
                        <ul aria-expanded="false">
                            <li><a asp-controller="Settings" asp-action="Index">Overview</a></li>
                            <li><a asp-controller="Settings" asp-action="Account">Account</a></li>
                            <li><a asp-controller="Settings" asp-action="Roles">Roles &amp; Permissions</a></li>
                            <li><a asp-controller="Settings" asp-action="Branches">Branches &amp; Sites</a></li>
                            <li><a asp-controller="Settings" asp-action="TicketStates">Ticket States</a></li>
                            <li><a asp-controller="Settings" asp-action="ResolutionCodes">Resolution Codes</a></li>
                            <li><a asp-controller="Settings" asp-action="Users">Users &amp; Groups</a></li>
                            <li><a asp-controller="Settings" asp-action="EmailIntegration">Email Integration</a></li>
                            <li><a asp-controller="Settings" asp-action="AssignmentRules">Assignment Rules</a></li>
                        </ul>
                    </li>

                </ul>

                <div class="copyright">
                    <p><strong>ServiceSphere</strong> &copy; @DateTime.Now.Year</p>
                    <p class="fs-12">Powered by ProbuildIQ</p>
                </div>
            </div>
        </div>
        <!--**********************************
            Sidebar end
        ***********************************-->

        <!--**********************************
            Content body start
        ***********************************-->
        <div class="content-body">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
        <!--**********************************
            Content body end
        ***********************************-->

        <!--**********************************
            Footer start
        ***********************************-->
        <div class="footer">
            <div class="copyright">
                <p>ServiceSphere &copy; @DateTime.Now.Year &mdash; Crafted by <strong>ProbuildIQ</strong></p>
            </div>
        </div>
        <!--**********************************
            Footer end
        ***********************************-->

    </div>
    <!--**********************************
        Main wrapper end
    ***********************************-->

    <!-- jQuery (required by MetisMenu + DataTables) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- MetisMenu (sidebar accordion) -->
    <script src="~/jobick/vendor/metismenu/js/metisMenu.min.js"></script>
    <!-- Jobick deznav scroll -->
    <script src="~/jobick/vendor/deznav/deznav.min.js"></script>
    <!-- Bootstrap Select (required by Jobick custom.min.js handleSelectPicker) -->
    <script src="~/jobick/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <!-- Polyfills required by custom.min.js (originally from global.min.js) -->
    <script>
        // getCookie / setCookie — used by Jobick's handleThemeMode to persist dark/light preference
        function getCookie(name) {
            var value = '; ' + document.cookie;
            var parts = value.split('; ' + name + '=');
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }
        function setCookie(name, value, days) {
            var expires = '';
            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
                expires = '; expires=' + date.toUTCString();
            }
            document.cookie = name + '=' + (value || '') + expires + '; path=/';
        }
    </script>
    <!-- Jobick Custom JS (theme behavior: sidebar toggle, dark mode, preloader) -->
    <script src="~/jobick/js/custom.min.js"></script>
    <!-- DataTables Core + Bootstrap 5 -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <!-- DataTables Buttons Extension -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <!-- Export Libraries (Excel + PDF) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <!-- ServiceSphere Custom JS -->
    <script src="~/js/servicesphere.js"></script>
    <!-- DataTables Initialization -->
    <script src="~/js/servicesphere-datatables.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
