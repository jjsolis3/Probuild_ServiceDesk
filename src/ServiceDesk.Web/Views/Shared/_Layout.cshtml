@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string controller, string action = "") =>
        currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(action) || currentAction.Equals(action, StringComparison.OrdinalIgnoreCase))
            ? "mm-active"
            : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiceSphere</title>
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/png" href="~/images/logo-sm.png" />
    <!-- Jobick Theme CSS (includes MetisMenu, Font Awesome, Bootstrap Icons via @@import) -->
    <link rel="stylesheet" href="~/jobick/css/style.css" />
    <!-- Bootstrap Select (required by Jobick custom.min.js handleSelectPicker) -->
    <link rel="stylesheet" href="~/jobick/vendor/bootstrap-select/dist/css/bootstrap-select.min.css" />
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <!-- ServiceSphere Overrides -->
    <link rel="stylesheet" href="~/css/servicesphere.css" />
    <style>
        /* ── Theme-aware topbar + sidebar fixes ────────────────────────
           The Jobick template assumes a dark navbar; several inline
           styles bake white text in. In light mode that produces the
           white-on-white invisibility the user reported. These rules
           re-color the offending elements when the theme is light, and
           let the existing styles win when it's dark. */

        /* Command palette trigger pill in the topbar */
        #cmdPaletteBtn {
            background: rgba(0, 0, 0, 0.04) !important;
            border: 1px solid rgba(0, 0, 0, 0.1) !important;
            color: #4b5563 !important;
        }
        #cmdPaletteBtn kbd {
            background: rgba(0, 0, 0, 0.07) !important;
            color: #6b7280 !important;
        }
        [data-theme-version="dark"] #cmdPaletteBtn {
            background: rgba(255, 255, 255, 0.12) !important;
            border-color: rgba(255, 255, 255, 0.22) !important;
            color: rgba(255, 255, 255, 0.85) !important;
        }
        [data-theme-version="dark"] #cmdPaletteBtn kbd {
            background: rgba(255, 255, 255, 0.15) !important;
            color: rgba(255, 255, 255, 0.75) !important;
        }

        /* Sidebar section headers (MAIN / MANAGEMENT / ANALYTICS / ADMIN) */
        .dlabnav .metismenu > li.menu-title,
        .dlabnav .metismenu > li.menu-title > span {
            color: #6b7280 !important;
        }
        [data-theme-version="dark"] .dlabnav .metismenu > li.menu-title,
        [data-theme-version="dark"] .dlabnav .metismenu > li.menu-title > span {
            color: rgba(255, 255, 255, 0.55) !important;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-sidebar-style="full" data-layout="vertical" data-nav-headerbg="color_1" data-headerbg="color_1" data-sibebarbg="color_1">

    <!--**********************************
        Preloader
    ***********************************-->
    <div id="preloader">
        <div class="sk-three-bounce">
            <div class="sk-child sk-bounce1"></div>
            <div class="sk-child sk-bounce2"></div>
            <div class="sk-child sk-bounce3"></div>
        </div>
    </div>

    <!--**********************************
        Main wrapper start
    ***********************************-->
    <div id="main-wrapper">

        <!--**********************************
            Nav header start
        ***********************************-->
        <div class="nav-header">
            <a asp-controller="Home" asp-action="Index" class="brand-logo ss-brand-logo">
                <img id="brandLogo"
                     src="@Url.Content("~/images/logo_Dark.png")"
                     data-logo-dark="@Url.Content("~/images/logo_Dark.png")"
                     data-logo-light="@Url.Content("~/images/logo_Light.png")"
                     data-logo-small="@Url.Content("~/images/logo-sm.png")"
                     alt="ServiceSphere" />
            </a>

            <div class="nav-control">
                <div class="hamburger">
                    <span class="line"></span><span class="line"></span><span class="line"></span>
                </div>
            </div>
        </div>
        <!--**********************************
            Nav header end
        ***********************************-->

        <!--**********************************
            Header start
        ***********************************-->
