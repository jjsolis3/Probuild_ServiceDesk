                               Anonymized + role-agnostic; surfaces ticket updates, payroll
                               lifecycle events, store activity, @mentions, etc. *@
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item dropdown" id="staffNotificationBell">
                                    @* Inherits the navbar foreground color so it tracks
                                       dark/light theme without needing its own override. *@
                                    <a class="nav-link position-relative px-2" href="javascript:void(0);" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false"
                                       title="Notifications">
                                        <i class="bi bi-bell" style="font-size:1.15rem;"></i>
                                        <span id="staffNotifBadge"
