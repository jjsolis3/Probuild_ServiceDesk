<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiceSphere</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />
    <!-- ServiceSphere Custom CSS -->
    <link rel="stylesheet" href="~/css/servicesphere.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="ss-wrapper">

        <!-- Sidebar Overlay (Mobile) -->
        <div class="ss-sidebar-overlay" id="ss-sidebar-overlay"></div>

        <!-- Sidebar -->
        <nav class="ss-sidebar" id="ss-sidebar">
            <!-- Brand -->
            <div class="ss-sidebar-brand">
                <img src="~/images/logo-sm.png" alt="ServiceSphere" onerror="this.style.display='none'" />
                <span class="brand-text">Service<span>Sphere</span></span>
            </div>

            <!-- Sidebar Menu -->
            <div class="ss-sidebar-menu">
                <ul class="nav flex-column">

                    <!-- MAIN -->
                    <li><span class="menu-label">Main</span></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-1x2"></i> Dashboard
                        </a>
                    </li>

                    <!-- MANAGEMENT -->
                    <li><span class="menu-label">Management</span></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Tickets" asp-action="Index">
                            <i class="bi bi-ticket-detailed"></i> Tickets
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Assets" asp-action="Index">
                            <i class="bi bi-laptop"></i> Assets
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employees" asp-action="Index">
                            <i class="bi bi-people"></i> Employees
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Subscriptions" asp-action="Index">
                            <i class="bi bi-credit-card-2-front"></i> Subscriptions
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Services" asp-action="Index">
                            <i class="bi bi-gear"></i> Services
                        </a>
                    </li>

                    <!-- ANALYTICS -->
                    <li><span class="menu-label">Analytics</span></li>
                    <li class="nav-item has-submenu">
                        <a class="nav-link" href="#">
                            <i class="bi bi-bar-chart-line"></i> Reports
                            <i class="bi bi-chevron-right menu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Tickets">
                                    Ticket Reports
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Assets">
                                    Asset Reports
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Users">
                                    User Reports
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- ADMINISTRATION -->
                    <li><span class="menu-label">Administration</span></li>
                    <li class="nav-item has-submenu">
                        <a class="nav-link" href="#">
                            <i class="bi bi-sliders"></i> Settings
                            <i class="bi bi-chevron-right menu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="Index">
                                    Overview
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="Account">
                                    Account
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="Roles">
                                    Roles & Permissions
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="Branches">
                                    Branches & Sites
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="TicketStates">
                                    Ticket States
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="ResolutionCodes">
                                    Resolution Codes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="Users">
                                    Users & Groups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="EmailIntegration">
                                    Email Integration
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="ss-main" id="ss-main">

            <!-- Topbar -->
            <header class="ss-topbar">
                <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-search position-relative d-none d-md-block">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="form-control" placeholder="Search..." />
                </div>

                <div class="ss-topbar-right">
                    <button class="topbar-btn" id="fullscreen-toggle" data-bs-toggle="tooltip" title="Fullscreen">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                    <button class="topbar-btn" id="dark-mode-toggle" data-bs-toggle="tooltip" title="Toggle Theme">
                        <i class="bi bi-moon"></i>
                    </button>
                    <div class="dropdown">
                        <button class="topbar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>Settings</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <div class="ss-content">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="ss-footer">
                <span>ProbuildIQ ServiceSphere &copy; @DateTime.Now.Year — Crafted by ProbuildIQ</span>
            </footer>

        </div>

    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- ServiceSphere Custom JS -->
    <script src="~/js/servicesphere.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
