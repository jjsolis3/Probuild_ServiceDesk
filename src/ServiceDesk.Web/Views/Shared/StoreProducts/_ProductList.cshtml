@using ServiceDesk.Core.Models
@using ServiceDesk.Web.Models.ViewModels
@model StoreProductFormContext
@{
    var products = Model.Products ?? new List<StoreProduct>();
}

@if (!products.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-box display-3 d-block mb-3 opacity-25"></i>
            <p class="mb-2">No products yet.</p>
            <a asp-controller="@Model.ControllerName" asp-action="@Model.CreateAction"
               class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i>Add your first product
            </a>
        </div>
    </div>
}
else
{
    <!--
        Bulk action bar — hidden until at least one row is checked. Lives
        outside the per-row delete forms so the bulk submit can't conflict
        with them. Hidden id inputs are injected by JS just before submit so
        we don't keep DOM and form state in sync as users toggle rows.
    -->
    <form id="bulkActionForm" method="post" class="d-none mb-3"
          asp-controller="@Model.ControllerName" asp-action="@Model.BulkSetActiveAction"
          onsubmit="return collectBulkIds(this);">
        @Html.AntiForgeryToken()
        <input type="hidden" name="isActive" id="bulkIsActive" value="true" />
        <div class="card border-primary shadow-sm">
            <div class="card-body py-2 d-flex flex-wrap align-items-center gap-2">
                <span class="fw-semibold">
                    <i class="bi bi-check2-square text-primary me-1"></i>
                    <span id="bulkSelectedCount">0</span> selected
                </span>
                <span class="vr d-none d-md-inline mx-2"></span>
                <button type="submit" class="btn btn-sm btn-success"
                        onclick="document.getElementById('bulkIsActive').value='true';">
                    <i class="bi bi-check-circle me-1"></i>Activate
                </button>
                <button type="submit" class="btn btn-sm btn-warning"
                        onclick="document.getElementById('bulkIsActive').value='false';">
                    <i class="bi bi-pause-circle me-1"></i>Deactivate
                </button>
                <button type="button" class="btn btn-sm btn-link text-decoration-none ms-auto"
                        onclick="clearBulkSelection()">
                    <i class="bi bi-x-lg me-1"></i>Clear selection
                </button>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px;">
                            <div class="form-check m-0">
                                <input class="form-check-input" type="checkbox" id="bulkSelectAll"
                                       onclick="toggleSelectAll(this)" aria-label="Select all products" />
                            </div>
                        </th>
                        <th style="width:60px;"></th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Unit</th>
                        <th>Sort</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in products)
                    {
                        <tr class="@(!p.IsActive ? "table-secondary opacity-75" : "")">
                            <td>
                                <div class="form-check m-0">
                                    <input class="form-check-input bulk-select-row" type="checkbox"
                                           value="@p.Id" aria-label="Select @p.Name"
                                           onclick="updateBulkBar()" />
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.ImagePath))
                                {
                                    <img src="@p.ImagePath" alt="@p.Name"
                                         style="width:44px;height:44px;object-fit:cover;border-radius:6px;" />
                                }
                                else
                                {
                                    <div class="rounded d-flex align-items-center justify-content-center bg-light"
                                         style="width:44px;height:44px;">
                                        <i class="bi bi-box text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@p.Name</div>
                                @if (!string.IsNullOrEmpty(p.Description))
                                {
                                    <div class="text-muted small" style="max-width:300px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        @p.Description
                                    </div>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@(p.Category ?? "—")</span></td>
                            <td class="text-muted small">@(p.UnitOfMeasure ?? "—")</td>
                            <td class="text-muted small">@p.SortOrder</td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="@Model.ControllerName" asp-action="@Model.EditAction"
                                   asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="@Model.ControllerName" asp-action="@Model.DuplicateAction"
                                      asp-route-id="@p.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary me-1"
                                            title="Duplicate product">
                                        <i class="bi bi-files"></i>
                                    </button>
                                </form>
                                <form asp-controller="@Model.ControllerName" asp-action="@Model.DeleteAction"
                                      asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Remove product @Html.Raw(p.Name.Replace("'","\\'")??"")? If it has orders it will be deactivated instead of deleted.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script>
    (function () {
        function rowCheckboxes() {
            return document.querySelectorAll('.bulk-select-row');
        }
        window.toggleSelectAll = function (master) {
            rowCheckboxes().forEach(function (cb) { cb.checked = master.checked; });
            updateBulkBar();
        };
        window.updateBulkBar = function () {
            var checked = Array.from(rowCheckboxes()).filter(function (cb) { return cb.checked; });
            var bar   = document.getElementById('bulkActionForm');
            var count = document.getElementById('bulkSelectedCount');
            if (!bar) return;
            if (checked.length === 0) {
                bar.classList.add('d-none');
            } else {
                bar.classList.remove('d-none');
                if (count) count.textContent = checked.length;
            }
            var master = document.getElementById('bulkSelectAll');
            if (master) {
                var all = rowCheckboxes();
                master.checked       = checked.length === all.length && all.length > 0;
                master.indeterminate = checked.length > 0 && checked.length < all.length;
            }
        };
        // Inject the selected ids as hidden inputs right before submit so we
        // don't have to keep DOM and form state in sync as users toggle rows.
        window.collectBulkIds = function (form) {
            var ids = Array.from(rowCheckboxes())
                           .filter(function (cb) { return cb.checked; })
                           .map(function (cb) { return cb.value; });
            if (ids.length === 0) { alert('Select at least one product first.'); return false; }
            form.querySelectorAll('input[name="ids"]').forEach(function (el) { el.remove(); });
            ids.forEach(function (id) {
                var i = document.createElement('input');
                i.type  = 'hidden'; i.name = 'ids'; i.value = id;
                form.appendChild(i);
            });
            var verb = document.getElementById('bulkIsActive').value === 'true' ? 'activate' : 'deactivate';
            return confirm(verb.charAt(0).toUpperCase() + verb.slice(1) + ' ' + ids.length + ' product(s)?');
        };
        window.clearBulkSelection = function () {
            rowCheckboxes().forEach(function (cb) { cb.checked = false; });
            updateBulkBar();
        };
    })();
    </script>
}
