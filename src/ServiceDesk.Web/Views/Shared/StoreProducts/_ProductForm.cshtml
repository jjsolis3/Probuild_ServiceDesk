@using ServiceDesk.Core.Models
@using ServiceDesk.Web.Models.ViewModels
@model StoreProductFormContext
@{
    var product = Model.Product ?? new StoreProduct();
    var isEdit  = product.Id > 0;
    var formAction = isEdit ? Model.EditAction : Model.CreateAction;

    // Build the suggestion list shown in the Variant Tag datalist from the
    // product's configured options. Keeps admins from typo'ing tags that
    // would silently break the catalog's variant-filtered image rendering.
    var variantSuggestions = new List<string>();
    if (product.HasGenderOption)
        variantSuggestions.AddRange(new[] { "Men's", "Women's", "Unisex" });
    if (!string.IsNullOrWhiteSpace(product.AvailableSizes))
        variantSuggestions.AddRange(
            product.AvailableSizes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    if (!string.IsNullOrWhiteSpace(product.AvailableColors))
        variantSuggestions.AddRange(
            product.AvailableColors.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    variantSuggestions = variantSuggestions
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<form method="post"
      asp-controller="@Model.ControllerName"
      asp-action="@formAction"
      asp-route-id="@(isEdit ? product.Id : (int?)null)"
      asp-antiforgery="true"
      enctype="multipart/form-data">
    @if (isEdit)
    {
        <input type="hidden" name="Id" value="@product.Id" />
    }
    @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

    <div class="mb-3">
        <label class="form-label fw-semibold" for="Name">Name</label>
        <input id="Name" name="Name" value="@product.Name" class="form-control" required />
        <span class="text-danger small" data-valmsg-for="Name" data-valmsg-replace="true"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold" for="Category">Category</label>
            <input id="Category" name="Category" value="@product.Category"
                   class="form-control" list="categoryList" autocomplete="off" />
            <datalist id="categoryList">
                @foreach (var c in Model.ExistingCategories)
                {
                    <option value="@c"></option>
                }
            </datalist>
            <div class="form-text">Pick from existing or type a new one.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" for="UnitOfMeasure">Unit of Measure</label>
            <input id="UnitOfMeasure" name="UnitOfMeasure" value="@product.UnitOfMeasure"
                   class="form-control" />
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold" for="Tags">Tags</label>
            <input id="Tags" name="Tags" value="@product.Tags" class="form-control"
                   placeholder="featured, new, clearance" />
            <div class="form-text">Comma-separated. Shown as small badges on the catalog card.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" for="MaxQtyPerOrder">Max Qty Per Order</label>
            <input id="MaxQtyPerOrder" name="MaxQtyPerOrder" type="number" min="1"
                   value="@(product.MaxQtyPerOrder?.ToString() ?? "")" class="form-control"
                   placeholder="No limit" />
            <div class="form-text">Optional cap on quantity per order line.</div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold" for="Description">Description</label>
        <textarea id="Description" name="Description" class="form-control" rows="3">@product.Description</textarea>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold" for="SortOrder">Sort Order</label>
            <input id="SortOrder" name="SortOrder" type="number" min="0"
                   value="@product.SortOrder" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Active</label>
            <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive"
                       value="true" @(product.IsActive ? "checked" : "") />
                <input type="hidden" name="IsActive" value="false" />
                <label class="form-check-label" for="IsActive">Visible in catalog</label>
            </div>
        </div>
    </div>

    <!-- Pricing -->
    <div class="card border-0 bg-light mb-4">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-currency-dollar me-2 text-primary"></i>Pricing</h6>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="HasPrice" name="HasPrice"
                       value="true" @(product.HasPrice ? "checked" : "") onchange="togglePriceField()" />
                <input type="hidden" name="HasPrice" value="false" />
                <label class="form-check-label fw-semibold" for="HasPrice">Charge a price for this product</label>
                <div class="form-text">Leave off if items are free-issue (no employee cost).</div>
            </div>
            <div id="priceField" class="@(product.HasPrice ? "" : "d-none")" style="max-width:240px;">
                <label class="form-label fw-semibold" for="Price">Price</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input id="Price" name="Price" type="number" step="0.01" min="0"
                           value="@(product.Price?.ToString("0.##") ?? "")"
                           class="form-control" placeholder="0.00" />
                </div>
            </div>
        </div>
    </div>

    <!-- Variant Options -->
    <div class="card border-0 bg-light mb-4">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-sliders me-2 text-primary"></i>Variant Options</h6>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="HasGenderOption" name="HasGenderOption"
                               value="true" @(product.HasGenderOption ? "checked" : "")
                               onchange="toggleVariantFields()" />
                        <input type="hidden" name="HasGenderOption" value="false" />
                        <label class="form-check-label fw-semibold" for="HasGenderOption">Gender Selector</label>
                    </div>
                    <div class="form-text">Men's / Women's / Unisex.</div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="HasSizes" name="HasSizes"
                               value="true" @(product.HasSizes ? "checked" : "")
                               onchange="toggleVariantFields()" />
                        <input type="hidden" name="HasSizes" value="false" />
                        <label class="form-check-label fw-semibold" for="HasSizes">Size Selector</label>
                    </div>
                    <div class="form-text">Size buttons.</div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="HasColorOptions" name="HasColorOptions"
                               value="true" @(product.HasColorOptions ? "checked" : "")
                               onchange="toggleVariantFields()" />
                        <input type="hidden" name="HasColorOptions" value="false" />
                        <label class="form-check-label fw-semibold" for="HasColorOptions">Color Selector</label>
                    </div>
                    <div class="form-text">Color swatches.</div>
                </div>
            </div>

            <div id="sizeField" class="mt-3 @(product.HasSizes ? "" : "d-none")">
                <label class="form-label fw-semibold" for="AvailableSizes">Available Sizes</label>
                <input id="AvailableSizes" name="AvailableSizes" value="@product.AvailableSizes"
                       class="form-control" placeholder="XS,S,M,L,XL,XXL,3XL" />
                <div class="form-text">Comma-separated list of sizes.</div>
            </div>

            <div id="colorField" class="mt-3 @(product.HasColorOptions ? "" : "d-none")">
                <label class="form-label fw-semibold" for="AvailableColors">Available Colors</label>
                <input id="AvailableColors" name="AvailableColors" value="@product.AvailableColors"
                       class="form-control" placeholder="Black,White,Navy,Gray,Red" />
                <div class="form-text">Comma-separated list of color names.</div>
            </div>
        </div>
    </div>

    <!-- Custom Options Builder -->
    <div class="card border-0 bg-light mb-4">
        <div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-list-check me-2 text-primary"></i>Custom Options</h6>
            <p class="small text-muted mb-3">
                Add any extra selectable options shoppers must (or may) choose — works for any product type.
                Examples: <em>Imprint Color</em>, <em>Material</em>, <em>Logo Placement</em>, <em>Pack Size</em>.
            </p>
            <input type="hidden" id="CustomOptionsJson" name="CustomOptionsJson" value="@product.CustomOptionsJson" />
            <div id="customOptionsList" class="d-flex flex-column gap-2"></div>
            <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addCustomOptionRow()">
                <i class="bi bi-plus-lg me-1"></i>Add Option
            </button>
        </div>
    </div>

    <!-- Main Product Image -->
    <div class="mb-3">
        <label class="form-label fw-semibold">Main Product Image</label>
        <div class="mb-2 d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(product.ImagePath))
            {
                <img id="mainImagePreview" src="@product.ImagePath" alt="Current image"
                     style="height:80px;width:80px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb;" />
            }
            else
            {
                <img id="mainImagePreview" alt=""
                     style="display:none;height:80px;width:80px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb;" />
            }
            @if (isEdit && !string.IsNullOrEmpty(product.ImagePath))
            {
                <div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="clearImage" name="clearImage" value="true" />
                        <label class="form-check-label text-danger small" for="clearImage">Remove main image</label>
                    </div>
                </div>
            }
        </div>
        <input type="file" class="form-control" name="imageFile" id="mainImageInput"
               accept=".jpg,.jpeg,.png,.webp,.gif"
               onchange="previewMainImage(this)" />
        <div class="form-text">@(isEdit ? "Upload a new image to replace the main one." : "Upload the product's main image (resized to 800px).")</div>
    </div>

    <datalist id="variantTagSuggestions">
        @foreach (var s in variantSuggestions)
        {
            <option value="@s"></option>
        }
    </datalist>

    <!-- Gallery Images -->
    <div class="mb-4">
        <label class="form-label fw-semibold">Gallery Images</label>
        @if (isEdit && product.Images != null && product.Images.Any())
        {
            <div class="mb-3">
                <div class="form-text mb-2">
                    Set a <strong>Variant Tag</strong> on each image (e.g. <em>Red</em>, <em>Navy</em>, <em>Men's</em>)
                    so it only appears in the store when that variant is selected.
                    Leave blank to show for all variants.
                </div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var img in product.Images.OrderBy(i => i.SortOrder).ThenBy(i => i.Id))
                    {
                        <div class="d-flex align-items-start gap-3 p-2 border rounded gallery-meta-row"
                             id="gallery-row-@img.Id"
                             style="background:#f9f9f9;">
                            <img src="@img.ImagePath" alt="Gallery image"
                                 style="width:64px;height:64px;object-fit:cover;border-radius:6px;flex-shrink:0;" />
                            <div class="flex-grow-1">
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <input type="text"
                                               name="imageTags[@img.Id]"
                                               value="@img.VariantTag"
                                               class="form-control form-control-sm"
                                               list="variantTagSuggestions"
                                               placeholder="Variant tag (e.g. Red)"
                                               maxlength="100" />
                                        <small class="text-muted" style="font-size:.7rem;">Variant tag</small>
                                    </div>
                                    <div class="col-md-5">
                                        <input type="text"
                                               name="imageAlts[@img.Id]"
                                               value="@img.Alt"
                                               class="form-control form-control-sm"
                                               placeholder="Alt text / caption"
                                               maxlength="200" />
                                        <small class="text-muted" style="font-size:.7rem;">Alt text</small>
                                    </div>
                                    <div class="col-md-2">
                                        <input type="number"
                                               name="imageOrders[@img.Id]"
                                               value="@img.SortOrder"
                                               class="form-control form-control-sm"
                                               min="0" max="9999" />
                                        <small class="text-muted" style="font-size:.7rem;">Sort</small>
                                    </div>
                                </div>
                            </div>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm flex-shrink-0"
                                    title="Delete image"
                                    onclick="deleteGalleryImage(@img.Id, this)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        <input type="file" class="form-control" id="galleryFilesInput" name="galleryFiles"
               accept=".jpg,.jpeg,.png,.webp,.gif" multiple
               onchange="buildGalleryTagRows(this)" />
        <div class="form-text">
            Select additional images to add. After selecting, optionally tag each with a variant value.
        </div>
        <div id="galleryTagRows" class="mt-2 d-flex flex-column gap-2"></div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy me-1"></i>@(isEdit ? "Save Changes" : "Create Product")
        </button>
        <a asp-controller="@Model.ControllerName" asp-action="@Model.ListAction" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<!--
    Shared product-form JS. All functions are defined inside an IIFE so the
    partial can be included on multiple top-level views without name clashes.
    The image-delete fetch URL is built from the context so the same partial
    points at Settings/StoreProductImageDelete or Store/OpsProductImageDelete
    depending on whoever rendered the page.
-->
<script>
(function () {
    window.toggleVariantFields = function () {
        var hasSizes  = document.getElementById('HasSizes').checked;
        var hasColors = document.getElementById('HasColorOptions').checked;
        document.getElementById('sizeField').classList.toggle('d-none', !hasSizes);
        document.getElementById('colorField').classList.toggle('d-none', !hasColors);
    };
    window.togglePriceField = function () {
        var on = document.getElementById('HasPrice').checked;
        document.getElementById('priceField').classList.toggle('d-none', !on);
    };

    window.addCustomOptionRow = function (label, values, required) {
        var list = document.getElementById('customOptionsList');
        var row = document.createElement('div');
        row.className = 'custom-option-row border rounded p-2 bg-white';
        row.innerHTML =
            '<div class="row g-2 align-items-center">' +
            '  <div class="col-md-3"><input type="text" class="form-control form-control-sm opt-label" ' +
            '         placeholder="Label (e.g. Imprint Color)" maxlength="60" /></div>' +
            '  <div class="col-md-6"><input type="text" class="form-control form-control-sm opt-values" ' +
            '         placeholder="Comma-separated values (Red, Blue, Black)" maxlength="500" /></div>' +
            '  <div class="col-md-2"><div class="form-check"><input type="checkbox" class="form-check-input opt-required" /> ' +
            '         <label class="form-check-label small">Required</label></div></div>' +
            '  <div class="col-md-1 text-end"><button type="button" class="btn btn-sm btn-outline-danger" ' +
            '         onclick="this.closest(\'.custom-option-row\').remove(); serializeCustomOptions();">' +
            '         <i class="bi bi-trash"></i></button></div>' +
            '</div>';
        list.appendChild(row);
        if (label)    row.querySelector('.opt-label').value    = label;
        if (values)   row.querySelector('.opt-values').value   = values;
        if (required) row.querySelector('.opt-required').checked = true;
        row.querySelectorAll('input').forEach(function (i) {
            i.addEventListener('input',  serializeCustomOptions);
            i.addEventListener('change', serializeCustomOptions);
        });
        serializeCustomOptions();
    };

    window.serializeCustomOptions = function () {
        var rows = document.querySelectorAll('#customOptionsList .custom-option-row');
        var arr = [];
        rows.forEach(function (r) {
            var label  = (r.querySelector('.opt-label').value  || '').trim();
            var values = (r.querySelector('.opt-values').value || '').trim();
            var req    = r.querySelector('.opt-required').checked;
            if (label && values) arr.push({ label: label, values: values, required: req });
        });
        document.getElementById('CustomOptionsJson').value = arr.length ? JSON.stringify(arr) : '';
    };

    // Pre-populate the builder from the saved CustomOptionsJson value.
    (function () {
        var existing = document.getElementById('CustomOptionsJson');
        if (!existing || !existing.value) return;
        try {
            var arr = JSON.parse(existing.value);
            if (Array.isArray(arr)) arr.forEach(function (o) {
                addCustomOptionRow(o.label || '', o.values || '', !!o.required);
            });
        } catch (e) { /* ignore */ }
    })();

    function escHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function escAttr(s) {
        return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;');
    }

    window.buildGalleryTagRows = function (input) {
        var container = document.getElementById('galleryTagRows');
        container.innerHTML = '';
        Array.from(input.files).forEach(function (file) {
            var row = document.createElement('div');
            row.className = 'input-group input-group-sm';
            row.innerHTML =
                '<span class="input-group-text text-truncate" style="max-width:200px;" title="' + escAttr(file.name) + '">' +
                    escHtml(file.name) +
                '</span>' +
                '<input type="text" class="form-control" name="galleryTags" ' +
                       'list="variantTagSuggestions" ' +
                       'placeholder="Variant tag (e.g. Red, Navy) — leave blank for all" ' +
                       'maxlength="100" />';
            container.appendChild(row);
        });
    };

    window.previewMainImage = function (input) {
        var preview = document.getElementById('mainImagePreview');
        if (!preview) return;
        var file = input.files && input.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function (e) {
            preview.src = e.target.result;
            preview.style.display = '';
            var clear = document.getElementById('clearImage');
            if (clear) clear.checked = false;
        };
        reader.readAsDataURL(file);
    };

    // Fetch-based gallery image delete so the click doesn't accidentally
    // submit the surrounding edit form (HTML forbids nested forms).
    var imageDeleteUrl = '@Url.Action(Model.ImageDeleteAction, Model.ControllerName)';
    window.deleteGalleryImage = function (imageId, btn) {
        if (!confirm('Delete this gallery image?')) return;
        btn.disabled = true;

        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        var fd = new FormData();
        fd.append('imageId', imageId);
        if (tokenEl) fd.append('__RequestVerificationToken', tokenEl.value);

        fetch(imageDeleteUrl, {
            method: 'POST',
            body: fd,
            credentials: 'same-origin'
        }).then(function (r) {
            if (r.ok || r.redirected) {
                var row = document.getElementById('gallery-row-' + imageId);
                if (row) row.remove();
            } else {
                btn.disabled = false;
                alert('Could not delete image. Please try again.');
            }
        }).catch(function () {
            btn.disabled = false;
            alert('Network error. Please try again.');
        });
    };
})();
</script>
