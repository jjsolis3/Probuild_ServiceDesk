<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiceSphere</title>
    <link rel="shortcut icon" type="image/png" href="~/images/logo-sm.png" />
    <link rel="stylesheet" href="~/jobick/css/style.css" />
    <link rel="stylesheet" href="~/css/servicesphere.css" />
</head>
<body class="bg-light" style="min-height:100vh; display:flex; align-items:center; justify-content:center;">
    <div style="width:100%; max-width:440px; padding:1.5rem;">
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
