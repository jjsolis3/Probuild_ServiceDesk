@model CompanyService
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Services</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-gear"></i> @Model.Name</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Description</div>
            <div class="card-body">
                <p>@(Model.Description ?? "No description provided.")</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Service Details</div>
            <div class="card-body">
                <dl>
                    <dt>Status</dt>
                    <dd>
                        @{
                            var statusClass = Model.Status switch
                            {
                                ServiceStatus.Active => "bg-success",
                                ServiceStatus.Inactive => "bg-secondary",
                                ServiceStatus.Maintenance => "bg-warning text-dark",
                                ServiceStatus.Deprecated => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass">@Model.Status</span>
                    </dd>

                    <dt>Category</dt>
                    <dd>@Model.Category</dd>

                    <dt>Service Owner</dt>
                    <dd>@(Model.ServiceOwner ?? "—")</dd>

                    <dt>Support Contact</dt>
                    <dd>@(Model.SupportContact ?? "—")</dd>

                    <dt>Documentation URL</dt>
                    <dd>
                        @if (!string.IsNullOrEmpty(Model.DocumentationUrl))
                        {
                            <a href="@Model.DocumentationUrl" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-box-arrow-up-right"></i> View Documentation
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt>SLA (Hours)</dt>
                    <dd>@(Model.SlaHours?.ToString() ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Related Tickets -->
<div class="card mt-4">
    <div class="card-header">
        <i class="bi bi-ticket-detailed"></i> Related Tickets
    </div>
    <div class="card-body p-0">
        @if (Model.RelatedTickets != null && Model.RelatedTickets.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted By</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.RelatedTickets)
                        {
                            <tr>
                                <td>@ticket.Id</td>
                                <td>
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                                <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                <td>@ticket.SubmittedBy?.FullName</td>
                                <td>@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-inbox display-4"></i>
                <p class="mt-2">No tickets are linked to this service.</p>
            </div>
        }
    </div>
</div>
