@model CompanyService
@{
    ViewData["Title"] = "Delete Service";
}

<h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Service</h1>
<h3>Are you sure you want to delete this service?</h3>

<div class="card mt-3" style="max-width: 600px;">
    <div class="card-body">
        <dl>
            <dt>ID</dt>
            <dd>@Model.Id</dd>
            <dt>Name</dt>
            <dd>@Model.Name</dd>
            <dt>Category</dt>
            <dd>@Model.Category</dd>
            <dt>Status</dt>
            <dd>
                @{
                    var statusClass = Model.Status switch
                    {
                        ServiceStatus.Active => "bg-success",
                        ServiceStatus.Inactive => "bg-secondary",
                        ServiceStatus.Maintenance => "bg-warning text-dark",
                        ServiceStatus.Deprecated => "bg-danger",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @statusClass">@Model.Status</span>
            </dd>
            <dt>Service Owner</dt>
            <dd>@(Model.ServiceOwner ?? "—")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
