@model IEnumerable<CompanyService>
@{
    ViewData["Title"] = "Services";
    var currentStatus = ViewBag.CurrentStatus as ServiceStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-gear"></i> Company Services</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Service
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <div class="form-label small mb-1">Status</div>
            <input type="hidden" id="svcStatusInput" name="status" value="@(currentStatus?.ToString() ?? "")" />
            <div class="dropdown">
                <button type="button" id="svcStatusBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(currentStatus != null ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(currentStatus?.ToString() ?? "All Statuses")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:180px;">
                    <button type="button" class="dropdown-item small single-filter-option @(currentStatus == null ? "active" : "")" data-input-id="svcStatusInput" data-button-id="svcStatusBtn" data-value="" data-label="All Statuses">All Statuses</button>
                    @foreach (var s in Enum.GetValues<ServiceStatus>())
                    {
                        <button type="button" class="dropdown-item small single-filter-option @(currentStatus == s ? "active" : "")"
                                data-input-id="svcStatusInput" data-button-id="svcStatusBtn" data-value="@s" data-label="@s">@s</button>
                    }
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Clear Filters</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener('click', function (e) {
    const opt = e.target.closest('.single-filter-option');
    if (!opt) return;
    e.preventDefault();
    const input = document.getElementById(opt.dataset.inputId);
    const btn = document.getElementById(opt.dataset.buttonId);
    if (!input || !btn) return;
    input.value = opt.dataset.value ?? '';
    btn.textContent = opt.dataset.label ?? '';
    btn.classList.toggle('active', input.value !== '');
    opt.closest('.dropdown-menu')?.querySelectorAll('.single-filter-option').forEach(x => x.classList.remove('active'));
    opt.classList.add('active');
});
</script>
}

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Services Report">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Status</th>
                <th>Service Owner</th>
                <th>SLA (Hours)</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@service.Id">@service.Name</a>
                    </td>
                    <td>@service.Category</td>
                    <td>
                        @{
                            var statusClass = service.Status switch
                            {
                                ServiceStatus.Active => "bg-success",
                                ServiceStatus.Inactive => "bg-secondary",
                                ServiceStatus.Maintenance => "bg-warning text-dark",
                                ServiceStatus.Deprecated => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass">@service.Status</span>
                    </td>
                    <td>@(service.ServiceOwner ?? "—")</td>
                    <td>@(service.SlaHours?.ToString() ?? "—")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@service.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@service.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-gear display-1"></i>
        <p class="mt-3">No services found matching the current filters.</p>
    </div>
}
