@model IEnumerable<CompanyService>
@{
    ViewData["Title"] = "Services";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-gear"></i> Company Services</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Service
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label small">Status</label>
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<ServiceStatus>())
                {
                    <option value="@s" selected="@(ViewBag.CurrentStatus != null && (ServiceStatus)ViewBag.CurrentStatus == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Status</th>
                <th>Service Owner</th>
                <th>SLA (Hours)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@service.Id">@service.Name</a>
                    </td>
                    <td>@service.Category</td>
                    <td>
                        @{
                            var statusClass = service.Status switch
                            {
                                ServiceStatus.Active => "bg-success",
                                ServiceStatus.Inactive => "bg-secondary",
                                ServiceStatus.Maintenance => "bg-warning text-dark",
                                ServiceStatus.Deprecated => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass">@service.Status</span>
                    </td>
                    <td>@(service.ServiceOwner ?? "—")</td>
                    <td>@(service.SlaHours?.ToString() ?? "—")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@service.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@service.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-gear display-1"></i>
        <p class="mt-3">No services found matching the current filters.</p>
    </div>
}
