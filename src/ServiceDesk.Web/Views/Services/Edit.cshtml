@model CompanyService
@{
    ViewData["Title"] = $"Edit Service - {Model.Name}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Services</a></li>
        <li class="breadcrumb-item active">Edit @Model.Name</li>
    </ol>
</nav>

<h1><i class="bi bi-pencil"></i> Edit Service</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" data-loading-btn="btnSaveService">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Service name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the service"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <input asp-for="Category" class="form-control" placeholder="e.g. Infrastructure, Communication" />
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<ServiceStatus>()" class="form-select"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="ServiceOwner" class="form-label"></label>
                    <input asp-for="ServiceOwner" class="form-control" placeholder="Person or team responsible" />
                    <span asp-validation-for="ServiceOwner" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SupportContact" class="form-label"></label>
                    <input asp-for="SupportContact" class="form-control" placeholder="Email, phone, or team name" />
                    <span asp-validation-for="SupportContact" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label asp-for="DocumentationUrl" class="form-label"></label>
                    <input asp-for="DocumentationUrl" class="form-control" type="url" placeholder="https://docs.example.com/service" />
                    <span asp-validation-for="DocumentationUrl" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SlaHours" class="form-label"></label>
                    <input asp-for="SlaHours" class="form-control" type="number" min="0" placeholder="Hours" />
                    <span asp-validation-for="SlaHours" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" id="btnSaveService" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
