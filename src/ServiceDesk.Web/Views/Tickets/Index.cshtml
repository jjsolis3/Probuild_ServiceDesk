@model IEnumerable<Ticket>
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-ticket-detailed"></i> Tickets</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Ticket
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label small">Status</label>
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<TicketStatus>())
                {
                    <option value="@s" selected="@(ViewBag.CurrentStatus != null && (TicketStatus)ViewBag.CurrentStatus == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small">Category</label>
            <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var c in Enum.GetValues<TicketCategory>())
                {
                    <option value="@c" selected="@(ViewBag.CurrentCategory != null && (TicketCategory)ViewBag.CurrentCategory == c)">@c</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small">Priority</label>
            <select name="priority" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Priorities</option>
                @foreach (var p in Enum.GetValues<TicketPriority>())
                {
                    <option value="@p" selected="@(ViewBag.CurrentPriority != null && (TicketPriority)ViewBag.CurrentPriority == p)">@p</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Submitted By</th>
                <th>Assigned To</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Id</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@ticket.Id">@ticket.Title</a>
                    </td>
                    <td>@ticket.Category</td>
                    <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                    <td><span class="badge badge-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                    <td>@ticket.SubmittedBy?.FullName</td>
                    <td>@(ticket.AssignedTo?.FullName ?? "Unassigned")</td>
                    <td>@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-1"></i>
        <p class="mt-3">No tickets found matching the current filters.</p>
    </div>
}
