@model IEnumerable<Ticket>
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-ticket-detailed"></i> Tickets</h1>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="ImportCsv" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-upload me-1"></i> Import from SolarWinds
            </a>
        }
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Ticket
        </a>
    </div>
</div>

<!-- Views Bar -->
<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    @if (ViewBag.ActiveViewId != null)
    {
        <span class="badge bg-primary fs-6 px-3 py-2">
            <i class="bi bi-funnel-fill me-1"></i>@ViewBag.ActiveViewName
            <a asp-action="Index" class="text-white ms-2" title="Clear view" style="text-decoration:none;">×</a>
        </span>
    }
    <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="viewsDropdownBtn"
                data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-layout-text-sidebar-reverse me-1"></i> My Views
        </button>
        <ul class="dropdown-menu shadow" id="viewsDropdownMenu" style="min-width:280px;">
            <li><span class="dropdown-item-text text-muted small px-3">Loading…</span></li>
        </ul>
    </div>
    <button class="btn btn-outline-primary btn-sm" onclick="openSaveViewModal()">
        <i class="bi bi-bookmark-plus me-1"></i> Save as View
    </button>
</div>

<!-- Filters -->
@{
    var selStatuses   = (TicketStatus[])(ViewBag.SelectedStatuses   ?? Array.Empty<TicketStatus>());
    var selCategories = (TicketCategory[])(ViewBag.SelectedCategories ?? Array.Empty<TicketCategory>());
    var selPriorities = (TicketPriority[])(ViewBag.SelectedPriorities ?? Array.Empty<TicketPriority>());
    var selAssignees  = (int[])(ViewBag.SelectedAssigneeIds ?? Array.Empty<int>());
    var curUnmatched  = ViewBag.CurrentUnmatched  != null && (bool)ViewBag.CurrentUnmatched;
    var curUnassigned = ViewBag.CurrentUnassigned != null && (bool)ViewBag.CurrentUnassigned;

    string FilterLabel(string singular, string plural, int count) =>
        count == 0 ? $"All {plural}" : count == 1 ? $"1 {singular}" : $"{count} {plural}";

    string AssigneeLabel() {
        var cnt = selAssignees.Length + (curUnassigned ? 1 : 0);
        return cnt == 0 ? "All Assignees" : cnt == 1 ? "1 Assignee" : $"{cnt} Assignees";
    }
}
<div class="filter-bar">
    <div class="d-flex flex-wrap gap-2 align-items-end">

        <!-- Status -->
        <div>
            <div class="form-label small mb-1">Status</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selStatuses.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Status", "Statuses", selStatuses.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:170px;">
                    @foreach (var s in Enum.GetValues<TicketStatus>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="statuses"
                                   value="@s" id="fs_@s" @(selStatuses.Contains(s) ? "checked" : "")>
                            <label class="form-check-label small" for="fs_@s">@s</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Category -->
        <div>
            <div class="form-label small mb-1">Category</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selCategories.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Category", "Categories", selCategories.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:190px;">
                    @foreach (var c in Enum.GetValues<TicketCategory>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="categories"
                                   value="@c" id="fc_@c" @(selCategories.Contains(c) ? "checked" : "")>
                            <label class="form-check-label small" for="fc_@c">@c</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Priority -->
        <div>
            <div class="form-label small mb-1">Priority</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selPriorities.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Priority", "Priorities", selPriorities.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:150px;">
                    @foreach (var p in Enum.GetValues<TicketPriority>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="priorities"
                                   value="@p" id="fp_@p" @(selPriorities.Contains(p) ? "checked" : "")>
                            <label class="form-check-label small" for="fp_@p">@p</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Assignee (IT staff + Unassigned) -->
        <div>
            <div class="form-label small mb-1">Assignee</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selAssignees.Length > 0 || curUnassigned ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @AssigneeLabel()
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:200px; max-height:280px; overflow-y:auto;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="unassigned"
                               value="true" id="fa_unassigned" @(curUnassigned ? "checked" : "")>
                        <label class="form-check-label small fw-semibold" for="fa_unassigned">
                            <i class="bi bi-person-dash me-1"></i>Unassigned
                        </label>
                    </div>
                    <hr class="my-1">
                    @foreach (var staff in (ViewBag.AssignableStaff as IEnumerable<dynamic> ?? []))
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="assigneeIds"
                                   value="@staff.Id" id="fa_@staff.Id"
                                   @(selAssignees.Contains((int)staff.Id) ? "checked" : "")>
                            <label class="form-check-label small" for="fa_@staff.Id">@staff.Name</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <!-- Requester -->
        <div>
            <div class="form-label small mb-1">Requester</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(curUnmatched ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(curUnmatched ? "Unmatched only" : "All Requesters")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:190px;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="unmatched"
                               value="true" id="fr_unmatched" @(curUnmatched ? "checked" : "")>
                        <label class="form-check-label small" for="fr_unmatched">Unmatched (needs update)</label>
                    </div>
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </a>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Bulk Action Bar (shown when rows selected) -->
<div id="bulkActionBar" class="alert alert-secondary d-none mb-3 py-2">
    <form id="bulkActionForm" asp-controller="Tickets" asp-action="BulkUpdate" method="post" class="d-flex align-items-center gap-3 flex-wrap">
        @Html.AntiForgeryToken()
        <span id="bulkSelectionCount" class="fw-semibold text-nowrap">0 selected</span>
        <select name="bulkAction" id="bulkActionSelect" class="form-select form-select-sm" style="width:auto;">
            <option value="">— Choose Action —</option>
            <option value="status">Change Status</option>
            <option value="assign">Reassign</option>
        </select>
        <div id="bulkStatusGroup" class="d-none">
            <select name="bulkStatus" class="form-select form-select-sm" style="width:auto;">
                @foreach (var s in Enum.GetValues<TicketStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div id="bulkAssigneeGroup" class="d-none">
            <select name="bulkAssigneeId" id="bulkAssigneeSelect" class="form-select form-select-sm" style="width:auto;">
                <option value="">— Unassigned —</option>
            </select>
        </div>
        <button type="submit" class="btn btn-sm btn-primary" id="btnBulkApply">Apply</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnBulkClear">Clear</button>
    </form>
</div>

<!-- Table toolbar: count + page size -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">
        Showing @((ViewBag.Page - 1) * ViewBag.PageSize + 1)–@(Math.Min((int)ViewBag.Page * (int)ViewBag.PageSize, (int)ViewBag.TotalCount))
        of <strong>@ViewBag.TotalCount</strong> ticket(s)
    </span>
    <form method="get" class="d-flex align-items-center gap-2">
        <!-- preserve all current filters when changing page size -->
        @if (ViewBag.CurrentStatus   != null) { <input type="hidden" name="status"     value="@ViewBag.CurrentStatus"> }
        @if (ViewBag.CurrentCategory != null) { <input type="hidden" name="category"   value="@ViewBag.CurrentCategory"> }
        @if (ViewBag.CurrentPriority != null) { <input type="hidden" name="priority"   value="@ViewBag.CurrentPriority"> }
        @if (ViewBag.CurrentUnmatched  != null && (bool)ViewBag.CurrentUnmatched)  { <input type="hidden" name="unmatched"  value="true"> }
        @if (ViewBag.CurrentUnassigned != null && (bool)ViewBag.CurrentUnassigned) { <input type="hidden" name="unassigned" value="true"> }
        <input type="hidden" name="sortBy"  value="@ViewBag.SortBy">
        <input type="hidden" name="sortDir" value="@ViewBag.SortDir">
        <input type="hidden" name="page"    value="1">
        <label class="form-label small mb-0 me-1">Show</label>
        <select name="pageSize" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
            @foreach (var sz in new[] { 15, 25, 50, 100 })
            {
                <option value="@sz" selected="@((int)ViewBag.PageSize == sz ? "selected" : null)">@sz</option>
            }
        </select>
        <label class="form-label small mb-0 ms-1">per page</label>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th class="text-center" style="width:36px;">
                    <input type="checkbox" id="chkSelectAll" class="form-check-input" title="Select all">
                </th>
                <th>@SortHeader("id",       "ID")</th>
                <th>@SortHeader("title",    "Title")</th>
                <th>@SortHeader("category", "Category")</th>
                <th>@SortHeader("priority", "Priority")</th>
                <th>@SortHeader("status",   "Status")</th>
                <th>Submitted By</th>
                <th>Assigned To</th>
                <th>@SortHeader("created",  "Created")</th>
                <th>@SortHeader("due",      "Due Date")</th>
                <th style="width:90px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input ticket-chk" name="selectedIds" value="@ticket.Id">
                    </td>
                    <td>@ticket.Id</td>
                    <td style="max-width:340px;">
                        <a asp-action="Details" asp-route-id="@ticket.Id" class="text-truncate d-block" style="max-width:320px;" title="@ticket.Title">@ticket.Title</a>
                        @if (ticket.IsOverdue)
                        {
                            <span class="badge bg-danger ms-1" title="Overdue since @ticket.DueDate!.Value.ToString("MMM dd, yyyy")">
                                <i class="bi bi-exclamation-circle me-1"></i>Overdue
                            </span>
                        }
                    </td>
                    <td>@ticket.Category</td>
                    <td><span class="badge badge-@ticket.Priority.ToString().ToLower()">@ticket.Priority</span></td>
                    <td>
                        <div class="dropdown inline-edit-dropdown">
                            <span class="badge badge-@ticket.Status.ToString().ToLower() inline-edit-badge"
                                  data-ticket-id="@ticket.Id" data-field="status" data-current="@ticket.Status"
                                  title="Click to change status" role="button"
                                  data-bs-toggle="dropdown" aria-expanded="false">
                                @ticket.Status <i class="bi bi-chevron-down ms-1" style="font-size:0.65em;"></i>
                            </span>
                            <ul class="dropdown-menu dropdown-menu-sm shadow-sm status-dropdown" data-ticket-id="@ticket.Id">
                                @foreach (var s in Enum.GetValues<TicketStatus>())
                                {
                                    <li>
                                        <a class="dropdown-item status-option @(ticket.Status == s ? "active" : "")"
                                           data-value="@s" href="#">
                                            <span class="badge badge-@s.ToString().ToLower() me-2">@s</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </td>
                    <td>@ticket.SubmittedBy?.FullName</td>
                    <td>
                        <div class="dropdown inline-edit-dropdown">
                            <span class="inline-edit-assignee text-nowrap"
                                  data-ticket-id="@ticket.Id" data-field="assignee"
                                  data-current="@(ticket.AssignedToId?.ToString() ?? "0")"
                                  title="Click to change assignee" role="button"
                                  data-bs-toggle="dropdown" aria-expanded="false">
                                @if (ticket.AssignedTo != null)
                                {
                                    <span>@ticket.AssignedTo.FullName <i class="bi bi-chevron-down ms-1 text-muted" style="font-size:0.7em;"></i></span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Unassigned <i class="bi bi-chevron-down ms-1" style="font-size:0.7em;"></i></span>
                                }
                            </span>
                            <div class="dropdown-menu p-2 shadow-sm assignee-dropdown" style="min-width:220px;" data-ticket-id="@ticket.Id">
                                <input type="text" class="form-control form-control-sm mb-2 assignee-search" placeholder="Search agent..." autocomplete="off" />
                                <ul class="list-unstyled mb-0 assignee-list" style="max-height:200px;overflow-y:auto;">
                                    <li><a class="dropdown-item assignee-option @(ticket.AssignedToId == null ? "active" : "")" data-value="0" href="#">— Unassigned —</a></li>
                                </ul>
                            </div>
                        </div>
                    </td>
                    <td class="text-nowrap">@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                    <td class="text-nowrap">
                        @if (ticket.DueDate.HasValue)
                        {
                            <span class="@(ticket.IsOverdue ? "text-danger fw-semibold" : "text-muted")">
                                @ticket.DueDate.Value.ToString("MMM dd, yyyy")
                            </span>
                        }
                        else { <span class="text-muted">—</span> }
                    </td>
                    <td>
                        <a asp-action="Edit"   asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-1"></i>
        <p class="mt-3 mb-3">No tickets found matching the current filters.</p>
        <a asp-action="Create" class="btn btn-primary me-2"><i class="bi bi-plus-lg me-1"></i> New Ticket</a>
        <a asp-action="Index"  class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
    </div>
}

<!-- Pagination -->
@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Ticket pages">
        <ul class="pagination pagination-sm justify-content-center flex-wrap mb-0">
            <li class="page-item @((int)ViewBag.Page == 1 ? "disabled" : "")">
                <a class="page-link" href="@PageUrl((int)ViewBag.Page - 1)">&#8249; Prev</a>
            </li>
            @{
                int tp = (int)ViewBag.TotalPages, cp = (int)ViewBag.Page;
                var pages = Enumerable.Range(1, tp)
                    .Where(p => p == 1 || p == tp || Math.Abs(p - cp) <= 2)
                    .ToList();
                int? prev = null;
                foreach (var p in pages)
                {
                    if (prev.HasValue && p - prev.Value > 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item @(p == cp ? "active" : "")">
                        <a class="page-link" href="@PageUrl(p)">@p</a>
                    </li>
                    prev = p;
                }
            }
            <li class="page-item @((int)ViewBag.Page == (int)ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@PageUrl((int)ViewBag.Page + 1)">Next &#8250;</a>
            </li>
        </ul>
    </nav>
}

<!-- ── Save / Edit View Modal ──────────────────────────────────────────── -->
<div class="modal fade" id="saveViewModal" tabindex="-1" aria-labelledby="saveViewModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="saveViewModalLabel"><i class="bi bi-bookmark-plus me-2"></i>Save Ticket View</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="svEditId" value="" />
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label fw-semibold">View Name <span class="text-danger">*</span></label>
            <input type="text" id="svName" class="form-control" placeholder="e.g. My Open Tickets, Unassigned Critical" maxlength="100" />
          </div>
          <div class="col-md-4 d-flex align-items-end gap-3">
            <div class="form-check form-switch mb-1">
              <input class="form-check-input" type="checkbox" id="svIsShared" />
              <label class="form-check-label" for="svIsShared">Shared with all users</label>
            </div>
          </div>
          <div class="col-12"><hr class="my-1" /><p class="text-muted small mb-1">Filter Criteria</p></div>
          <div class="col-md-4">
            <label class="form-label small">Status</label>
            <select id="svStatus" class="form-select form-select-sm">
              <option value="">All Statuses</option>
              @foreach (var s in Enum.GetValues<TicketStatus>())
              { <option value="@((int)s)">@s</option> }
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Category</label>
            <select id="svCategory" class="form-select form-select-sm">
              <option value="">All Categories</option>
              @foreach (var c in Enum.GetValues<TicketCategory>())
              { <option value="@((int)c)">@c</option> }
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Priority</label>
            <select id="svPriority" class="form-select form-select-sm">
              <option value="">All Priorities</option>
              @foreach (var p in Enum.GetValues<TicketPriority>())
              { <option value="@((int)p)">@p</option> }
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Branch / Location</label>
            <select id="svBranch" class="form-select form-select-sm">
              <option value="">All Branches</option>
              @foreach (var b in (ViewBag.Branches as IEnumerable<dynamic> ?? []))
              { <option value="@b.Id">@b.Name</option> }
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Department</label>
            <select id="svDepartment" class="form-select form-select-sm">
              <option value="">All Departments</option>
              @foreach (var d in (ViewBag.Departments as IEnumerable<string> ?? []))
              { <option value="@d">@d</option> }
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Group / Team</label>
            <select id="svGroup" class="form-select form-select-sm">
              <option value="">All Groups</option>
              @foreach (var g in (ViewBag.Groups as IEnumerable<dynamic> ?? []))
              { <option value="@g.Id">@g.Name</option> }
            </select>
          </div>
          <div class="col-12 d-flex gap-4">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="svAssignedToMe" />
              <label class="form-check-label small" for="svAssignedToMe">Assigned to me only</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="svUnassigned" />
              <label class="form-check-label small" for="svUnassigned">Unassigned tickets only</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="svUnmatched" />
              <label class="form-check-label small" for="svUnmatched">Unmatched requester only</label>
            </div>
          </div>
          <div class="col-12"><hr class="my-1" /><p class="text-muted small mb-1">Default Sort &amp; Display</p></div>
          <div class="col-md-4">
            <label class="form-label small">Sort By</label>
            <select id="svSortBy" class="form-select form-select-sm">
              <option value="id">Ticket ID</option>
              <option value="created">Created Date</option>
              <option value="due">Due Date</option>
              <option value="priority">Priority</option>
              <option value="status">Status</option>
              <option value="title">Title</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Sort Direction</label>
            <select id="svSortDir" class="form-select form-select-sm">
              <option value="desc">Newest / Highest First ↓</option>
              <option value="asc">Oldest / Lowest First ↑</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Tickets Per Page</label>
            <select id="svPageSize" class="form-select form-select-sm">
              <option value="15">15</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="submitSaveView()">
          <i class="bi bi-bookmark-check me-1"></i><span id="svSaveLabel">Save View</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Manage Views Modal ──────────────────────────────────────────────── -->
<div class="modal fade" id="manageViewsModal" tabindex="-1" aria-labelledby="manageViewsModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="manageViewsModalLabel"><i class="bi bi-layout-text-sidebar-reverse me-2"></i>Manage Views</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0">
        <div id="manageViewsList" class="list-group list-group-flush">
          <div class="list-group-item text-muted text-center py-3">Loading…</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="openSaveViewModal()">
          <i class="bi bi-bookmark-plus me-1"></i> New View
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Toast notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
    <div id="quickEditToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i><span id="quickEditToastMsg">Updated successfully.</span></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script type="application/json" id="itStaffData">@Html.Raw(ViewBag.ITStaffJson ?? "[]")</script>
<script type="application/json" id="pageStateData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
    activeViewId      = (int?)ViewBag.ActiveViewId,
    currentUnmatched  = ViewBag.CurrentUnmatched  != null && (bool)ViewBag.CurrentUnmatched,
    currentUnassigned = ViewBag.CurrentUnassigned != null && (bool)ViewBag.CurrentUnassigned,
    sortBy   = (string?)ViewBag.SortBy  ?? "id",
    sortDir  = (string?)ViewBag.SortDir ?? "desc",
    pageSize = (int)(ViewBag.PageSize ?? 25)
}))</script>
<script>
(function () {
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const itStaff = JSON.parse(document.getElementById('itStaffData').textContent);
    const toast = new bootstrap.Toast(document.getElementById('quickEditToast'), { delay: 2500 });
    const toastMsg = document.getElementById('quickEditToastMsg');

    function showToast(msg, isError) {
        const el = document.getElementById('quickEditToast');
        el.classList.toggle('text-bg-success', !isError);
        el.classList.toggle('text-bg-danger', !!isError);
        toastMsg.textContent = msg;
        toast.show();
    }

    function sendQuickUpdate(ticketId, field, value, onSuccess) {
        const fd = new FormData();
        fd.append('id', ticketId);
        fd.append('field', field);
        fd.append('value', value);
        fd.append('__RequestVerificationToken', antiForgeryToken);
        fetch('/Tickets/QuickUpdate', { method: 'POST', body: fd })
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(data => { if (data.success) { showToast('Updated successfully.'); if (onSuccess) onSuccess(data); } })
            .catch(() => showToast('Update failed. Please try again.', true));
    }

    // Status inline edit
    document.querySelectorAll('.status-option').forEach(function (opt) {
        opt.addEventListener('click', function (e) {
            e.preventDefault();
            const dropdown = this.closest('.status-dropdown');
            const ticketId = dropdown.getAttribute('data-ticket-id');
            const badge = document.querySelector(`.inline-edit-badge[data-ticket-id="${ticketId}"]`);
            sendQuickUpdate(ticketId, 'status', this.getAttribute('data-value'), function (data) {
                badge.className = `badge badge-${data.status.toLowerCase()} inline-edit-badge`;
                badge.setAttribute('data-current', data.status);
                badge.innerHTML = `${data.status} <i class="bi bi-chevron-down ms-1" style="font-size:0.65em;"></i>`;
                dropdown.querySelectorAll('.status-option').forEach(o => o.classList.remove('active'));
                opt.classList.add('active');
            });
        });
    });

    // Assignee dropdown populate
    document.querySelectorAll('.assignee-dropdown').forEach(function (dd) {
        const ticketId = dd.getAttribute('data-ticket-id');
        const list = dd.querySelector('.assignee-list');
        const currentVal = document.querySelector(`.inline-edit-assignee[data-ticket-id="${ticketId}"]`)?.getAttribute('data-current') || '0';
        itStaff.forEach(function (emp) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.className = 'dropdown-item assignee-option' + (String(emp.id) === currentVal ? ' active' : '');
            a.setAttribute('data-value', emp.id);
            a.href = '#';
            a.textContent = emp.name;
            li.appendChild(a);
            list.appendChild(li);
        });
    });

    // Assignee search
    document.querySelectorAll('.assignee-search').forEach(function (input) {
        input.addEventListener('input', function () {
            const q = this.value.toLowerCase();
            this.closest('.assignee-dropdown').querySelector('.assignee-list')
                .querySelectorAll('.assignee-option')
                .forEach(a => a.parentElement.style.display = a.textContent.toLowerCase().includes(q) ? '' : 'none');
        });
        input.addEventListener('click', e => e.stopPropagation());
    });

    // Assignee click
    document.addEventListener('click', function (e) {
        const opt = e.target.closest('.assignee-option');
        if (!opt) return;
        e.preventDefault();
        const dd = opt.closest('.assignee-dropdown');
        const ticketId = dd.getAttribute('data-ticket-id');
        const span = document.querySelector(`.inline-edit-assignee[data-ticket-id="${ticketId}"]`);
        sendQuickUpdate(ticketId, 'assignee', opt.getAttribute('data-value'), function (data) {
            span.innerHTML = data.assigneeName
                ? `${data.assigneeName} <i class="bi bi-chevron-down ms-1 text-muted" style="font-size:0.7em;"></i>`
                : `<span class="text-muted fst-italic">Unassigned <i class="bi bi-chevron-down ms-1" style="font-size:0.7em;"></i></span>`;
            span.setAttribute('data-current', opt.getAttribute('data-value'));
            dd.querySelectorAll('.assignee-option').forEach(o => o.classList.remove('active'));
            opt.classList.add('active');
            const bsDropdown = bootstrap.Dropdown.getInstance(span);
            if (bsDropdown) bsDropdown.hide();
        });
    });

    // Bulk actions
    (function () {
        const bar = document.getElementById('bulkActionBar');
        const countLabel = document.getElementById('bulkSelectionCount');
        const chkAll = document.getElementById('chkSelectAll');
        const actionSelect = document.getElementById('bulkActionSelect');
        const statusGroup = document.getElementById('bulkStatusGroup');
        const assigneeGroup = document.getElementById('bulkAssigneeGroup');
        const form = document.getElementById('bulkActionForm');
        const bulkAssigneeSelect = document.getElementById('bulkAssigneeSelect');

        if (bulkAssigneeSelect && itStaff) {
            itStaff.forEach(function (emp) {
                const opt = document.createElement('option');
                opt.value = emp.id;
                opt.textContent = emp.name;
                bulkAssigneeSelect.appendChild(opt);
            });
        }

        function updateBar() {
            const checked = document.querySelectorAll('.ticket-chk:checked');
            bar.classList.toggle('d-none', checked.length === 0);
            countLabel.textContent = checked.length + ' selected';
        }

        chkAll?.addEventListener('change', function () {
            document.querySelectorAll('.ticket-chk').forEach(c => c.checked = this.checked);
            updateBar();
        });
        document.querySelectorAll('.ticket-chk').forEach(c => c.addEventListener('change', function () {
            const all = document.querySelectorAll('.ticket-chk');
            if (chkAll) chkAll.checked = all.length > 0 && [...all].every(x => x.checked);
            updateBar();
        }));
        actionSelect?.addEventListener('change', function () {
            statusGroup.classList.toggle('d-none', this.value !== 'status');
            assigneeGroup.classList.toggle('d-none', this.value !== 'assign');
        });
        document.getElementById('btnBulkClear')?.addEventListener('click', function () {
            document.querySelectorAll('.ticket-chk').forEach(c => c.checked = false);
            if (chkAll) chkAll.checked = false;
            bar.classList.add('d-none');
        });
        form?.addEventListener('submit', function (e) {
            const checked = document.querySelectorAll('.ticket-chk:checked');
            if (checked.length === 0) { e.preventDefault(); return; }
            if (!actionSelect.value) { e.preventDefault(); actionSelect.focus(); return; }
            checked.forEach(c => {
                const inp = document.createElement('input');
                inp.type = 'hidden'; inp.name = 'selectedIds'; inp.value = c.value;
                form.appendChild(inp);
            });
        });
    })();
})();
</script>

<script>
// ── Multi-select filter apply ──────────────────────────────────────────────
function applyFilters() {
    const params = new URLSearchParams();
    params.set('sortBy',   pageState.sortBy);
    params.set('sortDir',  pageState.sortDir);
    params.set('pageSize', pageState.pageSize);
    params.set('page', '1');
    document.querySelectorAll('[name="statuses"]:checked').forEach(cb   => params.append('statuses',    cb.value));
    document.querySelectorAll('[name="categories"]:checked').forEach(cb => params.append('categories',  cb.value));
    document.querySelectorAll('[name="priorities"]:checked').forEach(cb => params.append('priorities',  cb.value));
    document.querySelectorAll('[name="assigneeIds"]:checked').forEach(cb => params.append('assigneeIds', cb.value));
    if (document.querySelector('[name="unassigned"]:checked')) params.set('unassigned', 'true');
    if (document.querySelector('[name="unmatched"]:checked'))  params.set('unmatched',  'true');
    window.location.href = '/Tickets?' + params.toString();
}
</script>

<script>
// ── Saved Views ────────────────────────────────────────────────────────────
(function () {
    const aft = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    // ---- Load views into dropdown and manage list -------------------------
    async function loadViews() {
        const resp = await fetch('@Url.Action("GetSavedViews", "Tickets")', { credentials: 'same-origin' });
        if (!resp.ok) return [];
        return await resp.json();
    }

    async function renderDropdown() {
        const views = await loadViews();
        const menu  = document.getElementById('viewsDropdownMenu');
        if (!menu) return;
        if (views.length === 0) {
            menu.innerHTML = '<li><span class="dropdown-item-text text-muted small px-3 py-2">No saved views yet.<br>Click <strong>Save as View</strong> to create one.</span></li>';
            return;
        }
        const owned  = views.filter(v => v.isOwner && !v.isShared);
        const shared = views.filter(v => v.isShared);

        let html = '';
        if (owned.length) {
            html += '<li><h6 class="dropdown-header">My Views</h6></li>';
            owned.forEach(v => html += viewItem(v));
        }
        if (shared.length) {
            html += '<li><h6 class="dropdown-header mt-1">Shared Views</h6></li>';
            shared.forEach(v => html += viewItem(v));
        }
        html += '<li><hr class="dropdown-divider" /></li>';
        html += '<li><a class="dropdown-item small" href="#" onclick="openManageViews(event)"><i class="bi bi-gear me-1"></i>Manage Views…</a></li>';
        menu.innerHTML = html;
    }

    const pageState = JSON.parse(document.getElementById('pageStateData').textContent);

    function viewItem(v) {
        const active = v.id === pageState.activeViewId;
        const starCls = v.isDefault ? 'bi-star-fill text-warning' : 'bi-star text-muted';
        return `<li>
          <div class="dropdown-item d-flex align-items-center gap-1 pe-2 ${active ? 'active' : ''}">
            <a href="?viewId=${v.id}" class="flex-grow-1 text-decoration-none ${active ? 'text-white' : ''}" style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;" title="${escHtml(v.name)}">
              ${escHtml(v.name)}
            </a>
            <button class="btn btn-link btn-sm p-0 ms-1" title="${v.isDefault ? 'Remove default' : 'Set as default'}" onclick="toggleDefault(event,${v.id},${v.isDefault})">
              <i class="bi ${starCls}"></i>
            </button>
            ${v.isOwner ? `<button class="btn btn-link btn-sm p-0" title="Edit" onclick="editView(event,${v.id})"><i class="bi bi-pencil text-muted"></i></button>
            <button class="btn btn-link btn-sm p-0" title="Delete" onclick="deleteView(event,${v.id},${JSON.stringify(v.name)})"><i class="bi bi-trash text-danger"></i></button>` : ''}
          </div></li>`;
    }

    function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    // Trigger dropdown load when shown
    document.getElementById('viewsDropdownBtn')?.addEventListener('show.bs.dropdown', renderDropdown);

    // ---- Manage Views modal ----------------------------------------------
    window.openManageViews = async function(e) {
        if (e) e.preventDefault();
        const views = await loadViews();
        const list  = document.getElementById('manageViewsList');
        if (!list) return;
        if (views.length === 0) {
            list.innerHTML = '<div class="list-group-item text-muted text-center py-3">No saved views yet.</div>';
        } else {
            list.innerHTML = views.map(v => `
              <div class="list-group-item d-flex align-items-center gap-2">
                <i class="bi ${v.isDefault ? 'bi-star-fill text-warning' : 'bi-star text-muted'}"></i>
                <div class="flex-grow-1">
                  <strong>${escHtml(v.name)}</strong>
                  ${v.isShared ? '<span class="badge bg-info ms-1">Shared</span>' : ''}
                  <div class="text-muted small">${buildSummary(v)}</div>
                </div>
                <div class="d-flex gap-1">
                  <a href="?viewId=${v.id}" class="btn btn-sm btn-outline-primary" title="Apply view"><i class="bi bi-play-fill"></i></a>
                  ${v.isOwner ? `<button class="btn btn-sm btn-outline-secondary" onclick="editView(event,${v.id})" title="Edit"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteView(event,${v.id},${JSON.stringify(v.name)})" title="Delete"><i class="bi bi-trash"></i></button>` : ''}
                </div>
              </div>`).join('');
        }
        new bootstrap.Modal(document.getElementById('manageViewsModal')).show();
    };

    function buildSummary(v) {
        const parts = [];
        const statusLabels = ['Open','InProgress','OnHold','Resolved','Closed','Cancelled'];
        const catLabels    = ['ServiceRequest','HardwareIssue','SoftwareIssue','EmployeeIssue','NetworkIssue','SecurityIncident','Other'];
        const priLabels    = ['Low','Medium','High','Critical'];
        if (v.filterStatus   != null) parts.push('Status: ' + (statusLabels[v.filterStatus] ?? v.filterStatus));
        if (v.filterCategory != null) parts.push('Category: ' + (catLabels[v.filterCategory] ?? v.filterCategory));
        if (v.filterPriority != null) parts.push('Priority: ' + (priLabels[v.filterPriority] ?? v.filterPriority));
        if (v.filterAssignedToMe)   parts.push('Assigned to me');
        if (v.filterUnassignedOnly) parts.push('Unassigned');
        if (v.filterUnmatchedOnly)  parts.push('Unmatched requester');
        if (v.filterDepartment) parts.push('Dept: ' + v.filterDepartment);
        return parts.length ? parts.join(' · ') : 'No filters — shows all tickets';
    }

    // ---- Save / Edit modal -----------------------------------------------
    window.openSaveViewModal = function() {
        document.getElementById('svEditId').value  = '';
        document.getElementById('svName').value    = '';
        document.getElementById('svIsShared').checked = false;
        document.getElementById('svStatus').value  = '';
        document.getElementById('svCategory').value = '';
        document.getElementById('svPriority').value = '';
        document.getElementById('svBranch').value  = '';
        document.getElementById('svDepartment').value = '';
        document.getElementById('svGroup').value   = '';
        document.getElementById('svAssignedToMe').checked  = false;
        document.getElementById('svUnassigned').checked    = false;
        document.getElementById('svUnmatched').checked     = false;
        document.getElementById('svSortBy').value   = pageState.sortBy;
        document.getElementById('svSortDir').value  = pageState.sortDir;
        document.getElementById('svPageSize').value = pageState.pageSize;
        // Pre-fill current active filters
        const curStatus     = pageState.currentStatus   ?? '';
        const curCategory   = pageState.currentCategory ?? '';
        const curPriority   = pageState.currentPriority ?? '';
        const curUnmatched  = pageState.currentUnmatched;
        const curUnassigned = pageState.currentUnassigned;
        if (curStatus)   { const opts = document.getElementById('svStatus').options; for (let o of opts) if (o.text === curStatus) { o.selected=true; break; } }
        if (curCategory) { const opts = document.getElementById('svCategory').options; for (let o of opts) if (o.text === curCategory) { o.selected=true; break; } }
        if (curPriority) { const opts = document.getElementById('svPriority').options; for (let o of opts) if (o.text === curPriority) { o.selected=true; break; } }
        document.getElementById('svUnmatched').checked  = curUnmatched;
        document.getElementById('svUnassigned').checked = curUnassigned;
        document.getElementById('svSaveLabel').textContent = 'Save View';
        document.getElementById('saveViewModalLabel').innerHTML = '<i class="bi bi-bookmark-plus me-2"></i>Save Ticket View';
        new bootstrap.Modal(document.getElementById('saveViewModal')).show();
    };

    window.editView = async function(e, id) {
        if (e) e.preventDefault();
        const views = await loadViews();
        const v = views.find(x => x.id === id);
        if (!v) return;
        const statusValues = [0,1,2,3,4,5];
        document.getElementById('svEditId').value  = v.id;
        document.getElementById('svName').value    = v.name;
        document.getElementById('svIsShared').checked = v.isShared;
        document.getElementById('svStatus').value  = v.filterStatus   != null ? v.filterStatus   : '';
        document.getElementById('svCategory').value = v.filterCategory != null ? v.filterCategory : '';
        document.getElementById('svPriority').value = v.filterPriority != null ? v.filterPriority : '';
        document.getElementById('svBranch').value  = v.filterBranchId ?? '';
        document.getElementById('svDepartment').value = v.filterDepartment ?? '';
        document.getElementById('svGroup').value   = v.filterGroupId  ?? '';
        document.getElementById('svAssignedToMe').checked  = v.filterAssignedToMe;
        document.getElementById('svUnassigned').checked    = v.filterUnassignedOnly;
        document.getElementById('svUnmatched').checked     = v.filterUnmatchedOnly;
        document.getElementById('svSortBy').value  = v.sortBy;
        document.getElementById('svSortDir').value = v.sortDir;
        document.getElementById('svPageSize').value = v.pageSize;
        document.getElementById('svSaveLabel').textContent = 'Update View';
        document.getElementById('saveViewModalLabel').innerHTML = '<i class="bi bi-pencil me-2"></i>Edit View';
        // Close manage modal if open, then open save modal
        bootstrap.Modal.getInstance(document.getElementById('manageViewsModal'))?.hide();
        setTimeout(() => new bootstrap.Modal(document.getElementById('saveViewModal')).show(), 200);
    };

    window.submitSaveView = async function() {
        const editId = document.getElementById('svEditId').value;
        const name   = document.getElementById('svName').value.trim();
        if (!name) { alert('Please enter a view name.'); return; }

        const body = new FormData();
        body.append('__RequestVerificationToken', aft);
        body.append('name',     name);
        body.append('isShared', document.getElementById('svIsShared').checked);
        const status   = document.getElementById('svStatus').value;
        const category = document.getElementById('svCategory').value;
        const priority = document.getElementById('svPriority').value;
        const branch   = document.getElementById('svBranch').value;
        const dept     = document.getElementById('svDepartment').value;
        const group    = document.getElementById('svGroup').value;
        if (status)   body.append('filterStatus',   status);
        if (category) body.append('filterCategory', category);
        if (priority) body.append('filterPriority', priority);
        if (branch)   body.append('filterBranchId', branch);
        if (dept)     body.append('filterDepartment', dept);
        if (group)    body.append('filterGroupId',  group);
        body.append('filterAssignedToMe',   document.getElementById('svAssignedToMe').checked);
        body.append('filterUnassignedOnly', document.getElementById('svUnassigned').checked);
        body.append('filterUnmatchedOnly',  document.getElementById('svUnmatched').checked);
        body.append('sortBy',   document.getElementById('svSortBy').value);
        body.append('sortDir',  document.getElementById('svSortDir').value);
        body.append('pageSize', document.getElementById('svPageSize').value);
        if (editId) body.append('id', editId);

        const url = editId
            ? '@Url.Action("UpdateView", "Tickets")'
            : '@Url.Action("SaveView",   "Tickets")';
        const resp = await fetch(url, { method: 'POST', body, credentials: 'same-origin' });
        const result = await resp.json();
        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('saveViewModal'))?.hide();
            renderDropdown();
            if (!editId && result.id) window.location.href = '?viewId=' + result.id;
        }
    };

    window.deleteView = async function(e, id, name) {
        if (e) e.preventDefault();
        if (!confirm(`Delete the view "${name}"?`)) return;
        const body = new FormData();
        body.append('__RequestVerificationToken', aft);
        body.append('id', id);
        const resp = await fetch('@Url.Action("DeleteView", "Tickets")', { method: 'POST', body, credentials: 'same-origin' });
        const result = await resp.json();
        if (result.success) {
            renderDropdown();
            openManageViews(null);
            if (window.location.search.includes('viewId=' + id))
                window.location.href = '@Url.Action("Index", "Tickets")';
        }
    };

    window.toggleDefault = async function(e, id, isCurrentlyDefault) {
        if (e) e.preventDefault();
        const body = new FormData();
        body.append('__RequestVerificationToken', aft);
        body.append('id', id);
        const url = isCurrentlyDefault
            ? '@Url.Action("ClearDefaultView", "Tickets")'
            : '@Url.Action("SetDefaultView",  "Tickets")';
        await fetch(url, { method: 'POST', body, credentials: 'same-origin' });
        renderDropdown();
    };
})();
</script>
}


@functions {
    IHtmlContent SortHeader(string col, string label) {
        var sb = (string?)ViewBag.SortBy ?? "id";
        var sd = (string?)ViewBag.SortDir ?? "desc";
        // Date columns: natural direction is desc (newest first).
        // All other columns: natural direction is asc (A-Z / low-high).
        var naturalDir = col is "created" or "due" ? "desc" : "asc";
        // If already on this column → toggle; otherwise → start at natural direction.
        var newDir = sb == col ? (sd == "asc" ? "desc" : "asc") : naturalDir;
        var icon = sb == col ? (sd == "asc" ? " ↑" : " ↓") : "";
        return new HtmlString($"<a href=\"{PageUrl(1, col, newDir)}\" class=\"text-white text-decoration-none\">{label}{icon}</a>");
    }

    string PageUrl(int p, string? sb = null, string? sd = null) {
        var sortBy  = sb ?? (string?)ViewBag.SortBy  ?? "id";
        var sortDir = sd ?? (string?)ViewBag.SortDir ?? "desc";
        var ps = (int)ViewBag.PageSize;
        var qs = $"?page={p}&pageSize={ps}&sortBy={sortBy}&sortDir={sortDir}";
        var selSt = (TicketStatus[]?) ViewBag.SelectedStatuses   ?? [];
        var selCa = (TicketCategory[]?)ViewBag.SelectedCategories ?? [];
        var selPr = (TicketPriority[]?)ViewBag.SelectedPriorities ?? [];
        var selAi = (int[]?)           ViewBag.SelectedAssigneeIds ?? [];
        foreach (var s in selSt) qs += $"&statuses={s}";
        foreach (var c in selCa) qs += $"&categories={c}";
        foreach (var r in selPr) qs += $"&priorities={r}";
        foreach (var i in selAi) qs += $"&assigneeIds={i}";
        if (ViewBag.CurrentUnmatched  != null && (bool)ViewBag.CurrentUnmatched)  qs += "&unmatched=true";
        if (ViewBag.CurrentUnassigned != null && (bool)ViewBag.CurrentUnassigned) qs += "&unassigned=true";
        return qs;
    }
}
