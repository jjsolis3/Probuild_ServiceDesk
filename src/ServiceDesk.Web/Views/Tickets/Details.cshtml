@model Ticket
@using Ganss.Xss
@{
    ViewData["Title"] = $"Ticket #{Model.Id}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Tickets</a></li>
        <li class="breadcrumb-item active">Ticket #@Model.Id</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Title</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        @{
            var hasHtml    = !string.IsNullOrEmpty(Model.DescriptionHtml);
            var descIsHtml = !hasHtml && !string.IsNullOrEmpty(Model.Description)
                             && Model.Description.TrimStart().StartsWith("<");
        }
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                @if (hasHtml || descIsHtml)
                {
                    <span><i class="bi bi-envelope me-1 text-secondary"></i> Email Message</span>
                    <span class="badge bg-secondary"><i class="bi bi-envelope me-1"></i>From email</span>
                }
                else
                {
                    <span>Description</span>
                }
            </div>

            @if (hasHtml)
            {
                <!-- Email sender / date meta bar -->
                <div class="px-3 pt-2 pb-2 border-bottom d-flex flex-wrap gap-3 small text-muted bg-light">
                    @if (Model.SubmittedBy != null)
                    {
                        <span>
                            <i class="bi bi-person-fill me-1 text-primary"></i>
                            <strong>From:</strong> @Model.SubmittedBy.FullName
                            @if (!string.IsNullOrEmpty(Model.SubmittedBy.Email))
                            { <span class="text-muted">(@Model.SubmittedBy.Email)</span> }
                        </span>
                    }
                    <span>
                        <i class="bi bi-calendar3 me-1"></i>
                        <strong>Received:</strong> @Model.CreatedDate.ToString("MMM d, yyyy h:mm tt")
                    </span>
                </div>
                <!-- Quote collapse toggle — shown by JS when quoted blocks are detected -->
                <div id="quoteToggleBar" class="px-3 py-1 border-bottom bg-light" style="display:none;">
                    <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                            id="quoteToggleBtn" onclick="toggleEmailQuotes(this)">
                        <i class="bi bi-three-dots me-1"></i>Show quoted text
                    </button>
                </div>
                <!-- Sandboxed iframe for full CSS isolation -->
                <iframe id="emailBodyFrame"
                        style="width:100%;border:none;min-height:150px;max-height:600px;display:block;"
                        sandbox="allow-same-origin"
                        title="Email content"></iframe>
            }
            else
            {
                <div class="card-body">
                    @if (descIsHtml)
                    {
                        <!-- Plain-text field contains HTML fragments — sanitize and render -->
                        <div class="email-body-fallback">
                            @Html.Raw(new HtmlSanitizer().Sanitize(Model.Description))
                        </div>
                    }
                    else
                    {
                        <!-- Pure plain text — preserve whitespace -->
                        <p style="white-space:pre-wrap; word-break:break-word; margin:0;">@Model.Description</p>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
        {
            <div class="card mt-3">
                <div class="card-header bg-success text-white">Resolution Notes</div>
                <div class="card-body">
                    <p>@Model.ResolutionNotes</p>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4 d-flex flex-column gap-3">
        <div class="card">
            <div class="card-header">Details</div>
            <div class="card-body">
                <dl>
                    <dt>Status</dt>
                    <dd><span class="badge badge-@Model.Status.ToString().ToLower()">@Model.Status</span></dd>

                    <dt>Priority</dt>
                    <dd><span class="badge badge-@Model.Priority.ToString().ToLower()">@Model.Priority</span></dd>

                    <dt>Category</dt>
                    <dd>@Model.Category</dd>

                    @if (Model.SubCategory != null)
                    {
                        <dt>Sub-Category</dt>
                        <dd>@Model.SubCategory.Name</dd>
                    }

                    @if (Model.Branch != null)
                    {
                        <dt>Branch / Location</dt>
                        <dd><i class="bi bi-geo-alt me-1 text-muted"></i>@Model.Branch.Name</dd>
                    }

                    <dt>Submitted By</dt>
                    <dd>
                        @if (Model.SubmittedBy != null)
                        {
                            <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.SubmittedById">
                                @Model.SubmittedBy.FullName
                            </a>
                        }
                    </dd>

                    <dt>Assigned To</dt>
                    <dd>
                        @if (Model.AssignedTo != null)
                        {
                            <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.AssignedToId">
                                @Model.AssignedTo.FullName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Unassigned</span>
                        }
                    </dd>

                    <dt>Related Service</dt>
                    <dd>
                        @if (Model.CompanyService != null)
                        {
                            <a asp-controller="Services" asp-action="Details" asp-route-id="@Model.CompanyServiceId">
                                @Model.CompanyService.Name
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </dd>

                    <dt>Related Asset</dt>
                    <dd>
                        @if (Model.Asset != null)
                        {
                            <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId">
                                <i class="bi bi-laptop me-1"></i>@Model.Asset.AssetTag — @Model.Asset.Name
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </dd>

                    <dt>Created</dt>
                    <dd>@Model.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</dd>

                    @if (Model.UpdatedDate.HasValue)
                    {
                        <dt>Last Updated</dt>
                        <dd>@Model.UpdatedDate.Value.ToString("MMM dd, yyyy h:mm tt")</dd>
                    }

                    @if (Model.ResolvedDate.HasValue)
                    {
                        <dt>Resolved</dt>
                        <dd>@Model.ResolvedDate.Value.ToString("MMM dd, yyyy h:mm tt")</dd>
                    }

                    @if (Model.ClosedDate.HasValue)
                    {
                        <dt>Closed</dt>
                        <dd>@Model.ClosedDate.Value.ToString("MMM dd, yyyy h:mm tt")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@if (!string.IsNullOrEmpty(Model.DescriptionHtml))
{
    <script>
    (function () {
        // Safely embed the sanitized HTML as a JS string
        var rawHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DescriptionHtml));

        var frame = document.getElementById('emailBodyFrame');
        if (!frame) return;

        var baseStyles =
            'body{font-family:Arial,sans-serif;font-size:14px;line-height:1.5;margin:12px 16px;color:#212529;word-break:break-word;}' +
            'img{max-width:100%;height:auto;}a{color:#0d6efd;}' +
            '.ss-hidden-quote{display:none!important;}';

        // Populate iframe via srcdoc (avoids HTML tags in doc.write string literals)
        frame.addEventListener('load', function onLoad() {
            frame.removeEventListener('load', onLoad);
            var doc = frame.contentDocument;
            if (!doc) return;
            collapseQuotes(doc);
            autoResizeFrame();
            // Re-check height once images load
            doc.querySelectorAll('img').forEach(function(img) {
                img.addEventListener('load', autoResizeFrame);
            });
        });
        frame.setAttribute('srcdoc',
            '<!DOCTYPE html>' +
            '<html><head><meta charset="utf-8"><style>' + baseStyles + '</style></head>' +
            '<body>' + rawHtml + '</body></html>');

        // ── Quote detection & collapse ─────────────────────────────────
        function collapseQuotes(doc) {
            var selectors = [
                '.gmail_quote',
                '.gmail_attr',
                'blockquote[type="cite"]',
                'blockquote',
                '#divRplyFwdMsg',
                '#divRFW',
                '.yahoo_quoted',
                '.moz-cite-prefix',
                'div[id^="Signature"]'
            ];

            var found = false;
            selectors.forEach(function (sel) {
                var nodes;
                try { nodes = doc.querySelectorAll(sel); } catch (e) { return; }
                nodes.forEach(function (el) {
                    el.classList.add('ss-hidden-quote');
                    found = true;
                });
            });

            if (found) {
                var bar = document.getElementById('quoteToggleBar');
                if (bar) bar.style.display = '';
            }
        }

        // ── Auto-resize iframe to content height ──────────────────────
        function autoResizeFrame() {
            var doc = frame.contentDocument || frame.contentWindow.document;
            if (!doc || !doc.body) return;
            var h = doc.body.scrollHeight;
            if (h < 150) h = 150;
            if (h > 600) h = 600;
            frame.style.height = h + 'px';
        }

        window.autoResizeFrame = autoResizeFrame;

        // ── Toggle quoted content ──────────────────────────────────────
        window.toggleEmailQuotes = function (btn) {
            var doc = frame.contentDocument || frame.contentWindow.document;
            if (!doc) return;
            var hidden = doc.querySelectorAll('.ss-hidden-quote');
            var visible = doc.querySelectorAll('.ss-visible-quote');

            if (hidden.length > 0) {
                hidden.forEach(function (el) {
                    el.classList.remove('ss-hidden-quote');
                    el.classList.add('ss-visible-quote');
                });
                btn.innerHTML = '<i class="bi bi-three-dots me-1"></i>Hide quoted text';
            } else {
                visible.forEach(function (el) {
                    el.classList.remove('ss-visible-quote');
                    el.classList.add('ss-hidden-quote');
                });
                btn.innerHTML = '<i class="bi bi-three-dots me-1"></i>Show quoted text';
            }
            autoResizeFrame();
        };
    })();
    </script>
}
}
