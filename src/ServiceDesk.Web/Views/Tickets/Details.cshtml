@model Ticket
@using Ganss.Xss
@{
    ViewData["Title"] = $"Ticket #{Model.Id}";
}

<style>
    :root {
        --tk-navy: #1a3a5c;
        --tk-navy-dark: #0f2845;
        --tk-blue: #2563eb;
        --tk-amber: #f59e0b;
        --tk-green: #10b981;
        --tk-red: #ef4444;
        --tk-gray-50: #f9fafb;
        --tk-gray-100: #f3f4f6;
        --tk-gray-200: #e5e7eb;
        --tk-gray-500: #6b7280;
        --tk-gray-700: #374151;
    }
    .ticket-details .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: .75rem;
        font-size: .85rem;
    }
    .ticket-details .breadcrumb a { color: var(--tk-navy); text-decoration: none; }
    .ticket-details .breadcrumb a:hover { text-decoration: underline; }
    .ticket-details h1 {
        color: var(--tk-navy-dark);
        font-size: 1.4rem;
        font-weight: 600;
        margin: 0;
    }
    .ticket-details .card {
        border: 1px solid var(--tk-gray-200);
        border-radius: 8px;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }
    .ticket-details .card-header {
        background: linear-gradient(135deg, var(--tk-navy) 0%, var(--tk-navy-dark) 100%);
        color: #fff;
        border-bottom: none;
        font-weight: 600;
        border-radius: 8px 8px 0 0 !important;
    }
    .ticket-details .card-header .text-secondary,
    .ticket-details .card-header .text-muted { color: rgba(255,255,255,.85) !important; }
    .ticket-details .card-header .badge.bg-secondary { background: rgba(255,255,255,.2) !important; }
    .ticket-details .card-header a { color: #fff; }
    .ticket-details .card-header .btn-outline-secondary,
    .ticket-details .card-header .btn-outline-light {
        color: #fff;
        border-color: rgba(255,255,255,.4);
    }
    .ticket-details .card-header .btn-outline-secondary:hover,
    .ticket-details .card-header .btn-outline-light:hover {
        background: rgba(255,255,255,.15);
        color: #fff;
    }
    .ticket-details .status-pill {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
    }
    .ticket-details .priority-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
    }
    .ticket-details .accent-bar {
        height: 3px;
        background: linear-gradient(90deg, var(--tk-navy), var(--tk-blue));
        border-radius: 0 0 8px 8px;
        margin-bottom: 1rem;
    }
</style>

<div class="ticket-details">
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Tickets</a></li>
        <li class="breadcrumb-item active">Ticket #@Model.Id</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Title</h1>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        @if ((bool)(ViewBag.OllamaEnabled ?? false))
        {
            @if ((int)(ViewBag.NoteCount ?? 0) > 0)
            {
                <button type="button" id="btnSummarizeThread" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-journal-text me-1"></i>Summarize Thread
                </button>
            }
            <button type="button" id="btnDraftAiReply" class="btn btn-sm btn-outline-info">
                <i class="bi bi-robot me-1"></i>Draft AI Reply
            </button>
        }
        @if (Model.Status == ServiceDesk.Core.Enums.TicketStatus.Resolved || Model.Status == ServiceDesk.Core.Enums.TicketStatus.Closed)
        {
            <a asp-controller="Kb" asp-action="Create" asp-route-ticketId="@Model.Id"
               class="btn btn-sm btn-outline-success" title="Create KB article from this resolved ticket">
                <i class="bi bi-book-half me-1"></i>Promote to KB
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>
@if ((bool)(ViewBag.OllamaEnabled ?? false))
{
    <div id="aiReplyResult" class="alert alert-info alert-dismissible mb-3" style="display:none;" role="alert">
        <strong><i class="bi bi-robot me-1"></i>AI Draft Reply</strong>
        <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'"></button>
        <div id="aiReplyText" class="mt-2" style="white-space:pre-wrap;"></div>
    </div>
    <div id="aiSummaryResult" class="alert alert-secondary alert-dismissible mb-3" style="display:none;" role="alert">
        <strong><i class="bi bi-journal-text me-1"></i>Thread Summary</strong>
        <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'"></button>
        <div id="aiSummaryText" class="mt-2" style="white-space:pre-wrap;"></div>
    </div>
}

<div class="row g-3">
    <div class="col-md-8">
        @{
            var hasHtml    = !string.IsNullOrEmpty(Model.DescriptionHtml);
            var descIsHtml = !hasHtml && !string.IsNullOrEmpty(Model.Description)
                             && Model.Description.TrimStart().StartsWith("<");
        }
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                @if (hasHtml || descIsHtml)
                {
                    <span><i class="bi bi-envelope me-1 text-secondary"></i> Email Message</span>
                    <span class="badge bg-secondary"><i class="bi bi-envelope me-1"></i>From email</span>
                }
                else
                {
                    <span>Description</span>
                }
            </div>

            @if (hasHtml)
            {
                <!-- Email sender / date meta bar -->
                <div class="px-3 pt-2 pb-2 border-bottom d-flex flex-wrap gap-3 small text-muted bg-light">
                    @if (Model.SubmittedBy != null)
                    {
                        <span>
                            <i class="bi bi-person-fill me-1 text-primary"></i>
                            <strong>From:</strong> @Model.SubmittedBy.FullName
                            @if (!string.IsNullOrEmpty(Model.SubmittedBy.Email))
                            { <span class="text-muted">(@Model.SubmittedBy.Email)</span> }
                        </span>
                    }
                    <span>
                        <i class="bi bi-calendar3 me-1"></i>
                        <strong>Received:</strong> @Model.CreatedDate.ToString("MMM d, yyyy h:mm tt")
                    </span>
                </div>
                <!-- Quote collapse toggle — shown by JS when quoted blocks are detected -->
                <div id="quoteToggleBar" class="px-3 py-1 border-bottom bg-light" style="display:none;">
                    <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                            id="quoteToggleBtn" onclick="toggleEmailQuotes(this)">
                        <i class="bi bi-three-dots me-1"></i>Show quoted text
                    </button>
                </div>
                <!-- Sandboxed iframe for full CSS isolation -->
                <iframe id="emailBodyFrame"
                        style="width:100%;border:none;min-height:150px;max-height:600px;display:block;"
                        sandbox="allow-scripts allow-same-origin"
                        title="Email content"></iframe>
            }
            else
            {
                <div class="card-body">
                    @if (descIsHtml)
                    {
                        <!-- Plain-text field contains HTML fragments — sanitize and render -->
                        <div class="email-body-fallback">
                            @Html.Raw(new HtmlSanitizer().Sanitize(Model.Description))
                        </div>
                    }
                    else
                    {
                        <!-- Pure plain text — preserve whitespace -->
                        <p style="white-space:pre-wrap; word-break:break-word; margin:0;">@Model.Description</p>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
        {
            <div class="card mt-3">
                <div class="card-header bg-success text-white">Resolution Notes</div>
                <div class="card-body">
                    <p>@Model.ResolutionNotes</p>
                </div>
            </div>
        }

    </div>

    <div class="col-md-4 d-flex flex-column gap-3">
        <div class="card">
            <div class="card-header">Details</div>
            <div class="card-body">
                <dl>
                    <dt>Status</dt>
                    <dd><span class="badge badge-@Model.Status.ToString().ToLower()">@Model.Status</span></dd>

                    <dt>Priority</dt>
                    <dd><span class="badge badge-@Model.Priority.ToString().ToLower()">@Model.Priority</span></dd>

                    <dt>Category</dt>
                    <dd>@Model.Category</dd>

                    @if (Model.SubCategory != null)
                    {
                        <dt>Sub-Category</dt>
                        <dd>@Model.SubCategory.Name</dd>
                    }

                    @if (Model.Branch != null)
                    {
                        <dt>Branch / Location</dt>
                        <dd><i class="bi bi-geo-alt me-1 text-muted"></i>@Model.Branch.Name</dd>
                    }

                    <dt>Submitted By</dt>
                    <dd>
                        @if (Model.SubmittedBy != null)
                        {
                            <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.SubmittedById">
                                @Model.SubmittedBy.FullName
                            </a>
                        }
                    </dd>

                    <dt>Assigned To</dt>
                    <dd>
                        @if (Model.AssignedTo != null)
                        {
                            <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.AssignedToId">
                                @Model.AssignedTo.FullName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Unassigned</span>
                        }
                    </dd>

                    <dt>Related Service</dt>
                    <dd>
                        @if (Model.CompanyService != null)
                        {
                            <a asp-controller="Services" asp-action="Details" asp-route-id="@Model.CompanyServiceId">
                                @Model.CompanyService.Name
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </dd>

                    <dt>Related Asset</dt>
                    <dd>
                        @if (Model.Asset != null)
                        {
                            <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId">
                                <i class="bi bi-laptop me-1"></i>@Model.Asset.AssetTag — @Model.Asset.Name
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </dd>

                    <dt>Created</dt>
                    <dd>@Model.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</dd>

                    @if (Model.UpdatedDate.HasValue)
                    {
                        <dt>Last Updated</dt>
                        <dd>@Model.UpdatedDate.Value.ToString("MMM dd, yyyy h:mm tt")</dd>
                    }

                    @if (Model.ResolvedDate.HasValue)
                    {
                        <dt>Resolved</dt>
                        <dd>@Model.ResolvedDate.Value.ToString("MMM dd, yyyy h:mm tt")</dd>
                    }

                    @if (Model.ClosedDate.HasValue)
                    {
                        <dt>Closed</dt>
                        <dd>@Model.ClosedDate.Value.ToString("MMM dd, yyyy h:mm tt")</dd>
                    }
                </dl>
            </div>
        </div>

        @{
            var submitterAssets = ViewBag.SubmitterAssets as List<Asset> ?? new List<Asset>();
        }
        @if (submitterAssets.Any())
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-laptop me-1 text-primary"></i>Submitter's Assets</span>
                    <span class="badge bg-secondary">@submitterAssets.Count</span>
                </div>
                <ul class="list-group list-group-flush small">
                    @foreach (var asset in submitterAssets)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <div class="text-truncate" style="max-width: 220px;">
                                <a asp-controller="Assets" asp-action="Details" asp-route-id="@asset.Id" class="text-decoration-none">
                                    <strong>@asset.AssetTag</strong>
                                    <span class="text-muted">— @asset.Name</span>
                                </a>
                                <div class="text-muted small">@asset.AssetType</div>
                            </div>
                            @if (Model.AssetId == asset.Id)
                            {
                                <span class="badge bg-success">Linked</span>
                            }
                            else
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-presetAssetId="@asset.Id"
                                   class="btn btn-link btn-sm p-0" title="Link this asset to the ticket">
                                    <i class="bi bi-link-45deg"></i>
                                </a>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@{
    var timeEntries = Model.TimeEntries?.OrderByDescending(e => e.WorkDate).ToList()
                      ?? new List<TicketTimeEntry>();
    var totalHours = (decimal)(ViewBag.TimeTotalHours ?? 0m);
    var billableHours = (decimal)(ViewBag.TimeBillableHours ?? 0m);
}
<div class="card mt-3" id="timeTrackingCard">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-stopwatch me-1 text-primary"></i>Time Tracking</span>
        <span class="small text-muted">
            Total: <strong>@totalHours.ToString("0.##")h</strong>
            · Billable: <strong>@billableHours.ToString("0.##")h</strong>
        </span>
    </div>
    <div class="card-body">
        @{
            var showRateType = ViewBag.LoggerHasEmergencyRate is bool b && b;
        }
        <form asp-action="AddTimeEntry" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end mb-3">
            @Html.AntiForgeryToken()
            <div class="col-md-2">
                <label class="form-label small mb-1">Date</label>
                <input type="date" name="workDate" id="detailsWorkDate" class="form-control form-control-sm"
                       value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Hours</label>
                <input type="number" name="hours" id="detailsHours" step="0.25" min="0.25" max="999"
                       class="form-control form-control-sm" placeholder="0.00" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Clock In / Out <span class="text-muted small">opt.</span></label>
                <div class="d-flex gap-1">
                    <input type="time" name="startTime" id="detailsStartTime" class="form-control form-control-sm" />
                    <input type="time" name="endTime"   id="detailsEndTime"   class="form-control form-control-sm" />
                </div>
                <small id="detailsClockHint" class="text-muted d-block" style="font-size:.68rem;line-height:1.1;"></small>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Description</label>
                <input type="text" name="description" class="form-control form-control-sm"
                       maxlength="1000" placeholder="What did you work on?" />
            </div>
            <div class="col-md-2">
                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" name="isBillable" value="true" id="billableChk" />
                    <label class="form-check-label small" for="billableChk">Billable</label>
                </div>
                @if (showRateType)
                {
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="checkbox" name="isEmergency" value="true" id="detailsIsEmergency" />
                        <label class="form-check-label small text-danger" for="detailsIsEmergency">Emergency</label>
                    </div>
                    <small id="detailsRateHint" class="text-muted d-block" style="font-size:.68rem;line-height:1.1;"></small>
                }
                <button type="submit" class="btn btn-primary btn-sm w-100 mt-1">
                    <i class="bi bi-plus-lg"></i> Log
                </button>
            </div>
        </form>

        @if (timeEntries.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Hours</th>
                            <th>Rate</th>
                            <th>Description</th>
                            <th>Billable</th>
                            <th>By</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in timeEntries)
                        {
                            var clockStr = (e.StartTime.HasValue && e.EndTime.HasValue)
                                ? (e.StartTime.Value.ToString("h:mm tt") + "–" + e.EndTime.Value.ToString("h:mm tt"))
                                : "";
                            var modTooltip = e.ModifiedDate.HasValue
                                ? $"Last edited {e.ModifiedDate.Value:MMM d, yyyy h:mm tt} by {e.ModifiedByEmail} · {e.ModificationReason}"
                                : "";
                            <tr>
                                <td class="small text-nowrap">
                                    @e.WorkDate.ToString("MMM d, yyyy")
                                    @if (!string.IsNullOrEmpty(clockStr))
                                    {
                                        <div class="text-muted" style="font-size:.7rem;"><i class="bi bi-clock"></i> @clockStr</div>
                                    }
                                </td>
                                <td class="fw-semibold">@e.Hours.ToString("0.##")h</td>
                                <td>
                                    @if (e.RateType == ServiceDesk.Core.Enums.PayRateType.Emergency)
                                    {
                                        <span class="badge bg-danger" title="Emergency / weekend / after-hours">Emergency</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Standard</span>
                                    }
                                </td>
                                <td class="small">
                                    @e.Description
                                    @if (e.ModificationCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark ms-1" style="font-size:.6rem;cursor:help;"
                                              data-bs-toggle="tooltip" title="@modTooltip">edited</span>
                                    }
                                </td>
                                <td>
                                    @if (e.IsBillable)
                                    { <span class="badge bg-success">Billable</span> }
                                    else
                                    { <span class="text-muted small">—</span> }
                                </td>
                                <td class="small text-muted">@e.LoggedByEmail</td>
                                <td class="text-end">
                                    <form asp-action="DeleteTimeEntry" asp-route-id="@Model.Id" method="post"
                                          class="d-inline" onsubmit="return confirm('Delete this time entry?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="entryId" value="@e.Id" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted small mb-0">No time logged yet.</p>
        }
    </div>
</div>

</div> @* /.ticket-details *@

@section Scripts {
<script>
(function () {
    // Auto-compute Hours from Start/End times
    var startEl = document.getElementById('detailsStartTime');
    var endEl   = document.getElementById('detailsEndTime');
    var hoursEl = document.getElementById('detailsHours');
    var hintEl  = document.getElementById('detailsClockHint');
    if (!startEl || !endEl || !hoursEl) return;
    function compute() {
        if (!startEl.value || !endEl.value) {
            hoursEl.readOnly = false;
            if (hintEl) hintEl.textContent = '';
            return;
        }
        var sp = startEl.value.split(':'); var ep = endEl.value.split(':');
        var sMin = (+sp[0]) * 60 + (+sp[1]);
        var eMin = (+ep[0]) * 60 + (+ep[1]);
        if (eMin <= sMin) eMin += 24 * 60;
        var diff = (eMin - sMin) / 60;
        if (diff <= 0 || diff > 24) {
            if (hintEl) hintEl.textContent = 'Interval out of range';
            return;
        }
        var q = Math.round(diff * 4) / 4;
        hoursEl.value = q.toFixed(2);
        hoursEl.readOnly = true;
        if (hintEl) hintEl.textContent = '= ' + q + 'h (auto)';
    }
    startEl.addEventListener('change', compute);
    endEl.addEventListener('change', compute);
})();

// Enable Bootstrap tooltips for "edited" pills
document.addEventListener('DOMContentLoaded', function () {
    var els = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    els.forEach(function (el) { try { new bootstrap.Tooltip(el); } catch (e) {} });
});
</script>
@if (showRateType)
{
    <script type="application/json" id="detailsHolidayInfoData">@Html.Raw(ViewBag.HolidayJson ?? "{\"recurring\":[],\"oneTime\":[]}")</script>
    <script>
    (function () {
        var holidayInfo = JSON.parse(document.getElementById('detailsHolidayInfoData').textContent || '{"recurring":[],"oneTime":[]}');
        var dateEl = document.getElementById('detailsWorkDate');
        var rateEl = document.getElementById('detailsIsEmergency');
        var hintEl = document.getElementById('detailsRateHint');
        if (!dateEl || !rateEl) return;

        rateEl.addEventListener('change', function () { rateEl.dataset.manual = '1'; });

        function check(yyyyMmDd) {
            var parts = (yyyyMmDd || '').split('-');
            if (parts.length !== 3) return { is: false, label: '' };
            var d = new Date(+parts[0], +parts[1] - 1, +parts[2]);
            var dow = d.getDay();
            if (dow === 0) return { is: true, label: 'Sunday (weekend)' };
            if (dow === 6) return { is: true, label: 'Saturday (weekend)' };
            var mmdd = parts[1] + '-' + parts[2];
            if ((holidayInfo.recurring || []).indexOf(mmdd) !== -1) return { is: true, label: 'Company holiday' };
            if ((holidayInfo.oneTime || []).indexOf(yyyyMmDd) !== -1) return { is: true, label: 'Company holiday' };
            return { is: false, label: '' };
        }

        function apply() {
            var r = check(dateEl.value);
            if (rateEl.dataset.manual === '1') {
                if (hintEl) hintEl.textContent = '';
                return;
            }
            rateEl.checked = r.is;
            if (hintEl) hintEl.textContent = r.is ? ('Auto · ' + r.label) : '';
        }
        dateEl.addEventListener('change', apply);
        apply();
    })();
    </script>
}
@if (!string.IsNullOrEmpty(Model.DescriptionHtml))
{
    <script>
    (function () {
        // Safely embed the sanitized HTML as a JS string. Replace "</" with "<\/"
        // so the browser's HTML parser can't see a stray "<//script>" inside the email
        // body and prematurely close this script tag. JavaScript still parses "\/" as "/".
        var rawHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DescriptionHtml).Replace("</", "<\\/"));

        var frame = document.getElementById('emailBodyFrame');
        if (!frame) return;

        var baseStyles =
            'body{font-family:Arial,sans-serif;font-size:14px;line-height:1.5;margin:12px 16px;color:#212529;word-break:break-word;}' +
            'img{max-width:100%;height:auto;}a{color:#0d6efd;}' +
            '.ss-hidden-quote{display:none!important;}';

        // Populate iframe via srcdoc (avoids HTML tags in doc.write string literals)
        frame.addEventListener('load', function onLoad() {
            frame.removeEventListener('load', onLoad);
            var doc = frame.contentDocument;
            if (!doc) return;
            collapseQuotes(doc);
            autoResizeFrame();
            // Re-check height once images load
            doc.querySelectorAll('img').forEach(function(img) {
                img.addEventListener('load', autoResizeFrame);
            });
        });
        frame.setAttribute('srcdoc',
            '<!DOCTYPE html>' +
            '<html><head><meta charset="utf-8"><style>' + baseStyles + '</style></head>' +
            '<body>' + rawHtml + '</body></html>');

        // ── Quote detection & collapse ─────────────────────────────────
        function collapseQuotes(doc) {
            var selectors = [
                '.gmail_quote',
                '.gmail_attr',
                'blockquote[type="cite"]',
                'blockquote',
                '#divRplyFwdMsg',
                '#divRFW',
                '.yahoo_quoted',
                '.moz-cite-prefix',
                'div[id^="Signature"]'
            ];

            var found = false;
            selectors.forEach(function (sel) {
                var nodes;
                try { nodes = doc.querySelectorAll(sel); } catch (e) { return; }
                nodes.forEach(function (el) {
                    el.classList.add('ss-hidden-quote');
                    found = true;
                });
            });

            if (found) {
                var bar = document.getElementById('quoteToggleBar');
                if (bar) bar.style.display = '';
            }
        }

        // ── Auto-resize iframe to content height ──────────────────────
        function autoResizeFrame() {
            var doc = frame.contentDocument || frame.contentWindow.document;
            if (!doc || !doc.body) return;
            var h = doc.body.scrollHeight;
            if (h < 150) h = 150;
            if (h > 600) h = 600;
            frame.style.height = h + 'px';
        }

        window.autoResizeFrame = autoResizeFrame;

        // ── Toggle quoted content ──────────────────────────────────────
        window.toggleEmailQuotes = function (btn) {
            var doc = frame.contentDocument || frame.contentWindow.document;
            if (!doc) return;
            var hidden = doc.querySelectorAll('.ss-hidden-quote');
            var visible = doc.querySelectorAll('.ss-visible-quote');

            if (hidden.length > 0) {
                hidden.forEach(function (el) {
                    el.classList.remove('ss-hidden-quote');
                    el.classList.add('ss-visible-quote');
                });
                btn.innerHTML = '<i class="bi bi-three-dots me-1"></i>Hide quoted text';
            } else {
                visible.forEach(function (el) {
                    el.classList.remove('ss-visible-quote');
                    el.classList.add('ss-hidden-quote');
                });
                btn.innerHTML = '<i class="bi bi-three-dots me-1"></i>Show quoted text';
            }
            autoResizeFrame();
        };
    })();
    </script>
}

@if ((bool)(ViewBag.OllamaEnabled ?? false))
{
    <script>
    (function () {
        var ticketId = @Model.Id;
        var token    = document.querySelector('meta[name="RequestVerificationToken"]')?.content
                    || document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || '';

        function postAi(url, resultEl, textEl, btn, origHtml) {
            var fd = new FormData();
            fd.append('__RequestVerificationToken', token);
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Working...';
            resultEl.style.display = 'none';

            fetch(url, { method: 'POST', body: fd })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                    if (data.success) {
                        textEl.textContent = data.draft || data.summary || '';
                        resultEl.style.display = '';
                    } else {
                        alert('AI error: ' + (data.error || 'Unknown error'));
                    }
                })
                .catch(function () {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                    alert('Request failed. Check that Ollama is running.');
                });
        }

        var draftBtn = document.getElementById('btnDraftAiReply');
        if (draftBtn) {
            draftBtn.addEventListener('click', function () {
                postAi('/Tickets/DraftAiReply/' + ticketId,
                    document.getElementById('aiReplyResult'),
                    document.getElementById('aiReplyText'),
                    draftBtn,
                    '<i class="bi bi-robot me-1"></i>Draft AI Reply');
            });
        }

        var sumBtn = document.getElementById('btnSummarizeThread');
        if (sumBtn) {
            sumBtn.addEventListener('click', function () {
                postAi('/Tickets/SummarizeThread/' + ticketId,
                    document.getElementById('aiSummaryResult'),
                    document.getElementById('aiSummaryText'),
                    sumBtn,
                    '<i class="bi bi-journal-text me-1"></i>Summarize Thread');
            });
        }
    })();
    </script>
}
}
