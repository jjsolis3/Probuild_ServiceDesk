                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-1">Description</label>
                                <input type="text" name="description" id="editDescription" class="form-control form-control-sm" maxlength="1000" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Description</label>
                                <input type="text" name="description" id="editDescription" class="form-control form-control-sm" maxlength="1000" />
                            </div>
