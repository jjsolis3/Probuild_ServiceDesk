<script>
// Holiday list serialized server-side. Used to suggest the Emergency rate
// when the contractor logs time on a Saturday/Sunday OR a configured holiday.
window.__holidayInfo = @Html.Raw(ViewBag.HolidayJson ?? "{\"recurring\":[],\"oneTime\":[]}");

function isEmergencyDate(yyyyMmDd) {
    if (!yyyyMmDd) return { is: false, label: '' };
    // Parse as local date (avoid timezone shift from new Date('YYYY-MM-DD'))
    var parts = yyyyMmDd.split('-');
    if (parts.length !== 3) return { is: false, label: '' };
    var d = new Date(+parts[0], +parts[1] - 1, +parts[2]);
    var dow = d.getDay(); // 0=Sun, 6=Sat
    if (dow === 0 || dow === 6) {
        return { is: true, label: dow === 0 ? 'Sunday (weekend)' : 'Saturday (weekend)' };
    }
    var info = window.__holidayInfo || { recurring: [], oneTime: [] };
    var mmdd = (parts[1] + '-' + parts[2]);
    if ((info.recurring || []).indexOf(mmdd) !== -1) {
        return { is: true, label: 'Company holiday' };
    }
    if ((info.oneTime || []).indexOf(yyyyMmDd) !== -1) {
        return { is: true, label: 'Company holiday' };
    }
    return { is: false, label: '' };
}

// Auto-suggest Emergency when the date changes — only if the picker hasn't
// been manually overridden. We track manual override via a data attribute.
function wireRateAutoDetect(dateInputId, rateSelectId, hintId) {
    var dateEl = document.getElementById(dateInputId);
    var rateEl = document.getElementById(rateSelectId);
    if (!dateEl || !rateEl) return;
    rateEl.addEventListener('change', function () { rateEl.dataset.manual = '1'; });
    function apply() {
        var hint = hintId ? document.getElementById(hintId) : null;
        var r = isEmergencyDate(dateEl.value);
        if (rateEl.dataset.manual === '1') {
            if (hint) hint.textContent = '';
            return;
        }
        rateEl.value = r.is ? 'Emergency' : 'Standard';
        if (hint) hint.textContent = r.is ? ('Auto-set to Emergency · ' + r.label) : '';
    }
    dateEl.addEventListener('change', apply);
    apply();
}

// Auto-compute Hours when both Start and End times are entered. Once the user
// types a clock interval, we stop letting them override the computed hours.
// Clearing either time field releases the lock.
function wireClockAutoCompute(startId, endId, hoursId, hintId) {
    var startEl = document.getElementById(startId);
    var endEl   = document.getElementById(endId);
    var hoursEl = document.getElementById(hoursId);
    var hintEl  = hintId ? document.getElementById(hintId) : null;
    if (!startEl || !endEl || !hoursEl) return;

    function compute() {
        if (!startEl.value || !endEl.value) {
            hoursEl.readOnly = false;
            if (hintEl) hintEl.textContent = '';
            return;
        }
        var sp = startEl.value.split(':'); var ep = endEl.value.split(':');
        if (sp.length !== 2 || ep.length !== 2) return;
        var sMin = (+sp[0]) * 60 + (+sp[1]);
        var eMin = (+ep[0]) * 60 + (+ep[1]);
        if (eMin <= sMin) eMin += 24 * 60;  // overnight roll
        var diff = (eMin - sMin) / 60;
        if (diff <= 0 || diff > 24) {
            if (hintEl) hintEl.textContent = 'Interval out of range';
            return;
        }
        // Snap to nearest quarter-hour
        var quartered = Math.round(diff * 4) / 4;
        hoursEl.value = quartered.toFixed(2);
        hoursEl.readOnly = true;
        if (hintEl) hintEl.textContent = '= ' + quartered + 'h (auto)';
    }
    startEl.addEventListener('change', compute);
    endEl.addEventListener('change', compute);
    compute();
}

document.addEventListener('DOMContentLoaded', function () {
    wireRateAutoDetect('modalWorkDate', 'modalRateType', 'modalRateTypeHint');
    wireRateAutoDetect('editWorkDate',  'editRateType',  null);
    wireClockAutoCompute('modalStartTime', 'modalEndTime', 'modalHours', 'modalClockHint');
    wireClockAutoCompute('editStartTime',  'editEndTime',  'editHours',  'editClockHint');

    // Enable Bootstrap tooltips for "edited" pills in the entries list
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.forEach(function (el) { new bootstrap.Tooltip(el); });
});

function fillEditEntry(id, date, hours, desc, billable, rateType, startTime, endTime) {
    document.getElementById('editEntryId').value     = id;
    document.getElementById('editWorkDate').value    = date;
    document.getElementById('editHours').value       = hours;
    document.getElementById('editDescription').value = desc;
    document.getElementById('editBillable').checked  = billable;

    var rateEl = document.getElementById('editRateType');
    if (rateEl && rateType) {
        rateEl.value = rateType;
        // Mark as manual so the date-change auto-detect won't overwrite the
        // existing entry's rate while the user is editing it.
        rateEl.dataset.manual = '1';
    }

    var startEl = document.getElementById('editStartTime');
    var endEl   = document.getElementById('editEndTime');
    if (startEl) startEl.value = startTime || '';
    if (endEl)   endEl.value   = endTime   || '';
    var hoursEl = document.getElementById('editHours');
    if (hoursEl) hoursEl.readOnly = !!(startTime && endTime);

    var reasonEl = document.getElementById('editModReason');
    if (reasonEl) reasonEl.value = '';

    document.getElementById('editEntryPanel').style.display = 'block';
    document.getElementById('editEntryPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
</script>

