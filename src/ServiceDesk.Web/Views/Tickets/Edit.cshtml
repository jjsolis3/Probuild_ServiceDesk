<script>
// ── Ollama "Draft AI Reply" button — streaming via EventSource ────────────
(function () {
    var btn = document.getElementById('btnDraftAiReply');
    if (!btn) return;

    var ticketId   = parseInt(document.querySelector('input[name="Id"]')?.value || '0', 10);
    var modalEl    = document.getElementById('aiDraftModal');
    var modal      = modalEl ? new bootstrap.Modal(modalEl) : null;
    var draftText  = document.getElementById('aiDraftText');
    var draftError = document.getElementById('aiDraftError');
    var draftStatus    = document.getElementById('aiDraftStatus');
    var draftStatusTxt = document.getElementById('aiDraftStatusText');
    var draftTimer = document.getElementById('aiDraftTimer');
    var draftComplete  = document.getElementById('aiDraftComplete');
    var btnUse     = document.getElementById('btnUseDraft');
    var replyBox   = document.getElementById('newCommentText');

    var evtSource = null;
    var timerHandle = null;
    var startTime = 0;

    function stopTimer() { if (timerHandle) { clearInterval(timerHandle); timerHandle = null; } }

    function startTimer() {
        startTime = Date.now();
        timerHandle = setInterval(function () {
            var sec = Math.round((Date.now() - startTime) / 1000);
            if (draftTimer) draftTimer.textContent = '(' + sec + 's elapsed)';
        }, 1000);
    }

    function resetModal() {
        if (draftText)     { draftText.value = ''; draftText.removeAttribute('readonly'); }
        if (draftError)    { draftError.textContent = ''; draftError.classList.add('d-none'); }
        if (draftStatus)   draftStatus.classList.remove('d-none');
        if (draftStatusTxt) draftStatusTxt.textContent = 'Connecting to Ollama...';
        if (draftTimer)    draftTimer.textContent = '';
        if (draftComplete) draftComplete.classList.add('d-none');
        if (btnUse)        btnUse.disabled = true;
        if (evtSource)     { evtSource.close(); evtSource = null; }
        stopTimer();
    }

    function markComplete() {
        stopTimer();
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-robot me-1"></i>Draft AI Reply';
        if (draftStatus)   draftStatus.classList.add('d-none');
        if (draftComplete) draftComplete.classList.remove('d-none');
        if (btnUse)        btnUse.disabled = !draftText || draftText.value.trim().length === 0;
    }

    function showError(msg) {
        stopTimer();
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-robot me-1"></i>Draft AI Reply';
        if (draftStatus) draftStatus.classList.add('d-none');
        if (draftError)  { draftError.textContent = msg; draftError.classList.remove('d-none'); }
        if (btnUse)      btnUse.disabled = true;
    }

    btn.addEventListener('click', function () {
        if (!ticketId) { alert('Cannot determine ticket ID.'); return; }
        resetModal();
        if (modal) modal.show();
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generating...';

        evtSource = new EventSource('/Tickets/DraftAiReplyStream/' + ticketId);

        evtSource.onopen = function () {
            if (draftStatusTxt)
                draftStatusTxt.textContent = 'Generating\u2014this may take 30\u201360 seconds with a local model\u2026';
            startTimer();
        };

        evtSource.onmessage = function (e) {
            if (e.data === '[DONE]') {
                evtSource.close(); evtSource = null;
                if (!draftText || draftText.value.trim().length === 0) {
                    showError('Ollama returned an empty response. Check Settings → AI and confirm the configured model is loaded and able to generate text.');
                } else {
                    markComplete();
                }
                return;
            }
            try {
                var token = JSON.parse(e.data);
                if (draftText) {
                    draftText.value += token;
                    draftText.scrollTop = draftText.scrollHeight;
                }
            } catch (_) {}
        };

        evtSource.onerror = function () {
            if (evtSource) { evtSource.close(); evtSource = null; }
            if (draftText && draftText.value.trim().length > 0) {
                markComplete();
            } else {
                showError('Could not reach Ollama or the request failed. Check Settings \u2192 AI and confirm Ollama is running.');
            }
        };
    });

    if (btnUse) {
        btnUse.addEventListener('click', function () {
            if (replyBox && draftText) {
                replyBox.value = draftText.value;
                replyBox.focus();
                var commentsTab = document.getElementById('comments-tab');
                if (commentsTab && !commentsTab.classList.contains('active'))
                    commentsTab.click();
            }
            if (modal) modal.hide();
        });
    }

    if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', function () {
            if (evtSource) { evtSource.close(); evtSource = null; }
            stopTimer();
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-robot me-1"></i>Draft AI Reply';
        });
    }
})();
</script>

<script>
// ── AI triage card buttons ────────────────────────────────────────────────
(function () {
    var card = document.getElementById('aiTriageCard');
    if (!card) return;

    var recId    = parseInt(card.dataset.recId || '0', 10);
    var ticketId = parseInt(document.querySelector('input[name="Id"]')?.value || '0', 10);
    var token    = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    function postAction(url, onSuccess) {
        var fd = new FormData();
        fd.append('__RequestVerificationToken', token);
        fetch(url, { method: 'POST', body: fd })
            .then(function(r) { return r.ok ? r : Promise.reject(r.status); })
            .then(function() { onSuccess(); })
            .catch(function(err) { alert('Request failed (' + err + '). Please refresh and try again.'); });
    }

    var btnApprove = document.getElementById('btnApproveAiRec');
    if (btnApprove) {
        btnApprove.addEventListener('click', function () {
            btnApprove.disabled = true;
            btnApprove.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Applying...';
            postAction('/Tickets/ApproveAiRecommendation/' + ticketId + '?recommendationId=' + recId, function () {
                location.reload();
            });
        });
    }

    var btnDismiss = document.getElementById('btnDismissAiRec');
    if (btnDismiss) {
        btnDismiss.addEventListener('click', function () {
            btnDismiss.disabled = true;
            postAction('/Tickets/DismissAiRecommendation/' + ticketId + '?recommendationId=' + recId, function () {
                card.style.display = 'none';
            });
        });
    }

    var btnRetriage = document.getElementById('btnRetriageTicket');
    if (btnRetriage) {
        btnRetriage.addEventListener('click', function () {
            var origHtml = btnRetriage.innerHTML;
            btnRetriage.disabled = true;
            btnRetriage.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Running...';
            postAction('/Tickets/RetriageTicket/' + ticketId, function () {
                location.reload();
            });
        });
    }
})();
</script>

<script>
// ── Similar tickets (loaded via AJAX after page paint) ────────────────────
(function () {
    var ticketId = parseInt(document.querySelector('input[name="Id"]')?.value || '0', 10);
    if (!ticketId) return;

    var panel = document.getElementById('similarTicketsPanel');
    var list  = document.getElementById('similarTicketsList');
    if (!panel || !list) return;

    fetch('/Tickets/SimilarTickets/' + ticketId)
        .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function(data) {
            if (!data || data.length === 0) { panel.style.display = 'none'; return; }

            var statusClasses = {
                'Open': 'bg-primary', 'InProgress': 'bg-info text-dark',
                'OnHold': 'bg-warning text-dark', 'Resolved': 'bg-success',
                'Closed': 'bg-secondary', 'Cancelled': 'bg-secondary'
            };
            var priClasses = {
                'Critical': 'bg-danger', 'High': 'bg-warning text-dark',
                'Medium': 'bg-info text-dark', 'Low': 'bg-secondary'
            };

            var html = '<div class="d-flex flex-wrap gap-2">';
            data.forEach(function(t) {
                var sc = statusClasses[t.status] || 'bg-secondary';
                var pc = priClasses[t.priority] || 'bg-secondary';
                html += '<a href="\/Tickets\/Edit\/' + t.ticketId + '" class="text-decoration-none">' +
                    '<div class="border rounded p-2 bg-white" style="min-width:180px;max-width:240px;">' +
                    '<div class="small fw-semibold text-truncate" title="' + t.title.replace(/"/g,'&quot;') + '">' +
                    '<span class="text-muted me-1">#' + t.ticketId + '</span>' + t.title + '<\/div>' +
                    '<div class="mt-1 d-flex gap-1">' +
                    '<span class="badge ' + sc + ' small">' + t.status + '<\/span>' +
                    '<span class="badge ' + pc + ' small">' + t.priority + '<\/span>' +
                    '<span class="badge bg-light text-dark border small">' + Math.round(t.scorePct) + '% match<\/span>' +
                    '<\/div><\/div><\/a>';
            });
            html += '<\/div>';
            list.innerHTML = html;
            panel.style.display = '';
        })
        .catch(function() { panel.style.display = 'none'; });
})();
</script>

