                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('editEntryPanel').style.display='none'">Cancel</button>
                    </div>
                </form>
            </div>
