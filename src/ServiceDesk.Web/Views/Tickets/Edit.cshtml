@model Ticket
@{
    ViewData["Title"] = $"Ticket #{Model.Id}";
    // Antiforgery token rendered via hidden field in form

    // Status accent color — used for header bar border, title section left accent, title input underline
    var _statusAccent = Model.Status switch {
        TicketStatus.Open       => "#3b82f6",
        TicketStatus.InProgress => "#f59e0b",
        TicketStatus.OnHold     => "#6b7280",
        TicketStatus.Resolved   => "#10b981",
        TicketStatus.Closed     => "#374151",
        TicketStatus.Cancelled  => "#ef4444",
        _                       => "#9ca3af"
    };
}

<style>
    :root {
        --tke-navy: #1a3a5c;
        --tke-navy-dark: #0f2845;
        --tke-blue: #2563eb;
        --tke-gray-200: #e5e7eb;
    }
    /* Card polish for the Edit page — keep functional structure, refresh look */
    .ticket-edit-page .card {
        border: 1px solid var(--tke-gray-200);
        border-radius: 8px;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        margin-bottom: 14px;
    }
    .ticket-edit-page .card > .card-header,
    .ticket-edit-page .card > .card-body > .border-bottom:first-child {
        background: linear-gradient(135deg, var(--tke-navy) 0%, var(--tke-navy-dark) 100%);
        color: #fff;
        border-bottom: none;
        font-weight: 600;
        border-radius: 8px 8px 0 0 !important;
    }
    .ticket-edit-page .card > .card-header .text-muted,
    .ticket-edit-page .card > .card-header .text-secondary { color: rgba(255,255,255,.85) !important; }
    .ticket-edit-page .card > .card-header a { color: #fff; }
    .ticket-edit-page .breadcrumb { background: transparent; padding: 0; margin-bottom: .5rem; font-size: .85rem; }
    .ticket-edit-page .breadcrumb a { color: var(--tke-navy); text-decoration: none; }
    .ticket-edit-page .breadcrumb a:hover { text-decoration: underline; }
</style>
<div class="ticket-edit-page">

<!-- SolarWinds-style ticket edit page -->
<form asp-action="Edit" id="ticketEditForm" data-loading-btn="btnSaveTicket">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedDate" />
    <input type="hidden" asp-for="ResolvedDate" />
    <input type="hidden" asp-for="ClosedDate" />
    <input type="hidden" asp-for="UpdatedDate" />
    <input type="hidden" asp-for="DueDate" id="dueDateHidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <!-- ===== TOP HEADER BAR ===== -->
    <div id="ticketHeaderBar" class="ticket-header-bar bg-white shadow-sm mb-0" style="border-bottom: 3px solid @_statusAccent; transition: border-color .2s;">
        <div class="d-flex align-items-center gap-2 flex-wrap py-2 px-3">
            <!-- Back -->
            <a asp-action="Index" class="btn btn-sm btn-light border me-2" title="Back to Tickets">
                <i class="bi bi-arrow-left"></i>
            </a>
            <!-- Incident label -->
            <span class="text-muted fw-semibold text-nowrap" style="font-size:0.85rem;">INCIDENT #@Model.Id</span>

            <!-- Status -->
            <div class="ticket-header-field">
                <label class="ticket-header-label">State</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<TicketStatus>()" class="form-select form-select-sm ticket-header-select status-select" id="statusSelect"></select>
            </div>

            <!-- Group Assignment -->
            <div class="ticket-header-field">
                <label class="ticket-header-label">Group Assignment</label>
                <select asp-for="UserGroupId" class="form-select form-select-sm ticket-header-select" asp-items="@ViewBag.UserGroups">
                    <option value="">— Unassigned —</option>
                </select>
            </div>

            <!-- Assigned To -->
            <div class="ticket-header-field">
                <label class="ticket-header-label">Assigned to</label>
                <select asp-for="AssignedToId" class="form-select form-select-sm ticket-header-select" asp-items="@ViewBag.ITStaff">
                    <option value="">— Unassigned —</option>
                </select>
            </div>

            <!-- Priority -->
            <div class="ticket-header-field">
                <label class="ticket-header-label">Priority</label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TicketPriority>()" class="form-select form-select-sm ticket-header-select priority-select" id="prioritySelect"></select>
            </div>

            <!-- Category -->
            <div class="ticket-header-field">
                <label class="ticket-header-label">Category</label>
                <select asp-for="Category" asp-items="@ViewBag.CategorySelectList" class="form-select form-select-sm ticket-header-select" id="categorySelect" data-no-picker></select>
            </div>

            <!-- Sub-Category -->
            <div class="ticket-header-field" id="subCategoryField">
                <label class="ticket-header-label">Sub-Category</label>
                <select name="SubCategoryId" id="subCategorySelect" class="form-select form-select-sm ticket-header-select">
                    <option value="">— None —</option>
                </select>
            </div>

            <!-- Submitted By -->
            <div class="ticket-header-field" style="min-width:160px;">
                <label class="ticket-header-label">Submitted By</label>
                <select asp-for="SubmittedById" class="form-select form-select-sm ticket-header-select" asp-items="@ViewBag.Employees">
                    <option value="">— Select —</option>
                </select>
            </div>

            <!-- Actions right side -->
            <div class="ms-auto d-flex gap-2">
                <button type="submit" id="btnSaveTicket" class="btn btn-sm btn-primary">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
                <button type="button" class="btn btn-sm btn-outline-success"
                        data-bs-toggle="modal" data-bs-target="#timeTrackingModal"
                        title="Log Time">
                    <i class="bi bi-stopwatch"></i>
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary"
                   title="View Details">
                    <i class="bi bi-eye"></i>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="ticket-edit-body">

        <!-- Ticket Subject & Meta -->
        <div id="ticketTitleSection" class="mb-4 pb-3 border-bottom" style="border-left: 4px solid @_statusAccent !important; padding-left: 1rem; transition: border-color .2s;">
            <!-- Requester row (shown from selected SubmittedById; editable via header bar dropdown) -->
            <div class="d-flex align-items-center gap-2 mb-2" id="requesterDisplay">
                <div class="ticket-avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                     style="width:40px;height:40px;font-size:1rem;flex-shrink:0;" id="requesterInitials">
                    @(Model.SubmittedBy?.FirstName?.Substring(0,1).ToUpper() ?? "?")@(Model.SubmittedBy?.LastName?.Substring(0,1).ToUpper() ?? "")
                </div>
                <div>
                    <div class="fw-semibold" id="requesterName">@(Model.SubmittedBy?.FullName ?? "Unknown")</div>
                    <div class="text-muted small" id="requesterTitle">@(Model.SubmittedBy?.JobTitle ?? "")</div>
                    <div class="text-muted small"><i class="bi bi-pencil-square me-1"></i><span class="fst-italic">Change via "Submitted By" above</span></div>
                </div>
            </div>

            <!-- Subject -->
            <div class="mb-3">
                <input asp-for="Title" id="ticketTitleInput" class="form-control form-control-lg fw-bold border-0 border-bottom rounded-0 px-0 ticket-title-input" placeholder="Subject" style="border-bottom-color: @_statusAccent !important; border-bottom-width: 2px !important; transition: border-color .2s;" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <!-- Created date + SLA risk badge -->
            <div class="text-muted small d-flex flex-wrap align-items-center gap-3">
                <span>
                    <i class="bi bi-calendar3 me-1"></i>
                    Created: @Model.CreatedDate.ToString("MMM dd, yyyy") at @Model.CreatedDate.ToString("h:mm tt")
                    @if (Model.SubmittedBy != null)
                    {
                        <span> by <strong>@Model.SubmittedBy.FullName</strong></span>
                    }
                </span>
                @if (Model.UpdatedDate.HasValue)
                {
                    <span><i class="bi bi-pencil me-1"></i>Updated: @Model.UpdatedDate.Value.ToString("MMM dd, yyyy h:mm tt")</span>
                }
                @{
                    var slaRisk  = (ServiceDesk.Web.Services.SlaRiskLevel)(ViewBag.SlaRisk ?? ServiceDesk.Web.Services.SlaRiskLevel.None);
                    var slaLabel = (string)(ViewBag.SlaThresholdLabel ?? "");
                    var isOpen   = Model.Status != ServiceDesk.Core.Enums.TicketStatus.Resolved
                                && Model.Status != ServiceDesk.Core.Enums.TicketStatus.Closed
                                && Model.Status != ServiceDesk.Core.Enums.TicketStatus.Cancelled;
                }
                @if (isOpen && slaRisk != ServiceDesk.Web.Services.SlaRiskLevel.None)
                {
                    <span class="badge bg-@ServiceDesk.Web.Services.SlaRiskService.RiskBadgeClass(slaRisk) text-white"
                          title="Expected resolution window: @slaLabel">
                        <i class="bi bi-clock-history me-1"></i>@ServiceDesk.Web.Services.SlaRiskService.RiskLabel(slaRisk)
                        <span class="opacity-75 ms-1">(@slaLabel SLA)</span>
                    </span>
                }
                @if (Model.IsEscalated)
                {
                    <span class="badge bg-danger text-white"
                          title="Escalated @(Model.EscalatedAt.HasValue ? Model.EscalatedAt.Value.ToString("MMM dd, yyyy h:mm tt") : ""): @(Model.EscalationReason ?? "")">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i>ESCALATED
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.ResolutionType))
                {
                    <span class="badge bg-success ms-1" title="Resolution Type">
                        <i class="bi bi-check-circle me-1"></i>@Model.ResolutionType
                    </span>
                }
                @if (isOpen && !Model.IsEscalated)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger py-0"
                            data-bs-toggle="modal" data-bs-target="#escalateModal"
                            title="Escalate this ticket">
                        <i class="bi bi-arrow-up-circle me-1"></i>Escalate
                    </button>
                }
            </div>
        </div>

        @if (Context.Request.Query["suggestKb"] == "1" && !string.IsNullOrWhiteSpace(Model.ResolutionNotes))
        {
            <div class="alert alert-success alert-dismissible border-0 shadow-sm mb-3 py-2" role="alert">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-journal-plus text-success flex-shrink-0" style="font-size:1.1rem;"></i>
                    <span class="flex-grow-1 small fw-medium">This ticket has resolution notes — turn it into a Knowledge Base article?</span>
                    <form asp-action="SuggestToKb" asp-route-id="@Model.Id" method="post" class="flex-shrink-0">
                        <button type="submit" class="btn btn-sm btn-success py-0 px-2">
                            <i class="bi bi-plus-lg me-1"></i>Create KB Article
                        </button>
                    </form>
                    <button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        <!-- ===== AI TRIAGE CARD ===== -->
        @{
            var aiRec       = ViewBag.AiRecommendation as ServiceDesk.Core.Models.AiRecommendation;
            var ollamaOn    = (bool)(ViewBag.OllamaEnabled ?? false);
        }
        @if (aiRec != null)
        {
            <!-- AI card uses data-* attributes + AJAX so no nested <form> inside the outer Edit form -->
            <div class="alert alert-info border-start border-4 border-primary shadow-sm mb-3 py-2 px-3" id="aiTriageCard"
                 data-rec-id="@aiRec.Id"
                 style="background: linear-gradient(135deg, #f0f7ff 0%, #e8f4ff 100%);">
                <div class="d-flex align-items-start gap-3">
                    <div class="flex-shrink-0 pt-1">
                        <span class="fs-4" title="AI Triage">&#129302;</span>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold mb-1" style="color:#1a56db;">
                            AI Triage Suggestion
                            <span class="fw-normal text-muted small ms-2">ML.NET classification</span>
                        </div>
                        <div class="d-flex flex-wrap gap-3 small mb-2">
                            @if (aiRec.SuggestedCategory.HasValue)
                            {
                                var aiCatById = ViewBag.CategoriesById as Dictionary<int, string> ?? new Dictionary<int, string>();
                                var catName = aiCatById.TryGetValue(aiRec.SuggestedCategory.Value, out var aiCn) ? aiCn : aiRec.SuggestedCategory.Value.ToString();
                                var catPct  = (int)(aiRec.CategoryConfidence * 100);
                                <span>
                                    <i class="bi bi-tag me-1 text-primary"></i>
                                    <strong>Category:</strong> @catName
                                    <span class="badge bg-primary ms-1">@catPct%</span>
                                </span>
                            }
                            @if (aiRec.SuggestedPriority.HasValue)
                            {
                                var priName = ((ServiceDesk.Core.Enums.TicketPriority)aiRec.SuggestedPriority.Value).ToString();
                                var priPct  = (int)(aiRec.PriorityConfidence * 100);
                                <span>
                                    <i class="bi bi-flag me-1 text-warning"></i>
                                    <strong>Priority:</strong> @priName
                                    <span class="badge bg-warning text-dark ms-1">@priPct%</span>
                                </span>
                            }
                            @if (aiRec.SuggestedSubCategory != null)
                            {
                                <span>
                                    <i class="bi bi-diagram-3 me-1 text-info"></i>
                                    <strong>Sub-Category:</strong> @aiRec.SuggestedSubCategory.Name
                                </span>
                            }
                            @if (aiRec.SuggestedAssignee != null)
                            {
                                <span>
                                    <i class="bi bi-person-check me-1 text-success"></i>
                                    <strong>Assignee:</strong> @aiRec.SuggestedAssignee.FullName
                                </span>
                            }
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-primary" id="btnApproveAiRec">
                                <i class="bi bi-check-lg me-1"></i>Apply Suggestions
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnDismissAiRec">
                                <i class="bi bi-x-lg me-1"></i>Dismiss
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnRetriageTicket">
                                <i class="bi bi-arrow-repeat me-1"></i>Re-run AI
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ===== SIMILAR TICKETS PANEL ===== -->
        <div id="similarTicketsPanel" class="mb-3" style="display:none;">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg,#f8fff8 0%,#edfaed 100%);">
                <div class="card-header bg-transparent d-flex align-items-center justify-content-between py-2">
                    <span class="fw-semibold small" style="color:#146c43;">
                        <i class="bi bi-diagram-2 me-1"></i>Similar Tickets
                        <span class="text-muted fw-normal ms-1">— these may be related or duplicates</span>
                    </span>
                    <button type="button" class="btn-close btn-sm" onclick="document.getElementById('similarTicketsPanel').style.display='none';"></button>
                </div>
                <div class="card-body py-2 px-3" id="similarTicketsList">
                    <div class="text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Finding similar tickets…</div>
                </div>
            </div>
        </div>

        <!-- Ollama "Draft AI Reply" floating hint (visible when Ollama is enabled) -->
        @{
            var noteCountForOllama = (int)(ViewBag.NoteCount ?? 0);
        }
        @if (ollamaOn)
        {
            <div class="d-flex justify-content-end gap-2 mb-2">
                @if (noteCountForOllama > 0)
                {
                    <button type="button" id="btnSummarizeThread" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-journal-text me-1"></i>Summarize Thread
                    </button>
                }
                <button type="button" id="btnSuggestSolution" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-tools me-1"></i>AI Solution
                </button>
                <button type="button" id="btnDraftAiReply" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-robot me-1"></i>Draft AI Reply
                </button>
            </div>
        }

        <!-- ===== TABS ===== -->
        <ul class="nav nav-tabs mb-3" id="ticketTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="comments-tab" data-bs-toggle="tab" data-bs-target="#tab-comments" type="button" role="tab">
                    <i class="bi bi-chat-left-text me-1"></i> Comments
                    @if (Model.Notes.Any())
                    {
                        <span class="badge bg-secondary ms-1">@Model.Notes.Count(n => !n.IsInternal)</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="details-tab" data-bs-toggle="tab" data-bs-target="#tab-details" type="button" role="tab">
                    <i class="bi bi-info-circle me-1"></i> Details
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="related-tab" data-bs-toggle="tab" data-bs-target="#tab-related" type="button" role="tab">
                    <i class="bi bi-link-45deg me-1"></i> Related
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tasks-tab" data-bs-toggle="tab" data-bs-target="#tab-tasks" type="button" role="tab">
                    <i class="bi bi-check2-square me-1"></i> Tasks
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="attachments-tab" data-bs-toggle="tab" data-bs-target="#tab-attachments" type="button" role="tab">
                    <i class="bi bi-paperclip me-1"></i> Attachments
                    @if (Model.Attachments.Any())
                    {
                        <span class="badge bg-secondary ms-1">@Model.Attachments.Count</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="audit-tab" data-bs-toggle="tab" data-bs-target="#tab-audit" type="button" role="tab">
                    <i class="bi bi-clock-history me-1"></i> Audit
                </button>
            </li>
        </ul>

        <div class="tab-content" id="ticketTabContent">

            <!-- ===== COMMENTS TAB ===== -->
            <div class="tab-pane fade show active" id="tab-comments" role="tabpanel">
                <!-- Existing comments -->
                @{
                    // srcdoc prefix/suffix — Razor HTML-encodes the full expression when placed in an
                    // attribute, and the browser HTML-decodes it to reconstruct the exact document.
                    var _noteDocPrefix = "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>"
                        + "body{font-family:Arial,sans-serif;font-size:13px;line-height:1.5;margin:10px 14px;color:#212529;word-break:break-word;}"
                        + "img{max-width:100%;height:auto;}a{color:#0d6efd;}.ss-hidden-quote{display:none!important;}"
                        + "</style></head><body>";
                    var _noteDocSuffix = "</body></html>";
                }
                <div id="commentsContainer">
                    @if (!Model.Notes.Any(n => !n.IsInternal))
                    {
                        <div class="text-muted text-center py-4" id="noCommentsMsg">
                            <i class="bi bi-chat-left fs-3 d-block mb-2"></i>
                            No comments yet.
                        </div>
                    }
                    @foreach (var note in Model.Notes.Where(n => !n.IsInternal))
                    {
                        <div class="comment-item d-flex gap-3 mb-3">
                            <div class="ticket-avatar rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                 style="width:36px;height:36px;font-size:0.85rem;">
                                @note.AuthorName.Substring(0, Math.Min(2, note.AuthorName.Length)).ToUpper()
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold">@note.AuthorName</span>
                                    <span class="text-muted small">@note.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</span>
                                </div>
                                <div class="comment-body bg-light rounded @(note.Source == "Email" && !string.IsNullOrEmpty(note.ContentHtml) ? "p-0 overflow-hidden" : "p-3")">
                                    @if (note.Source == "Email" && !string.IsNullOrEmpty(note.ContentHtml))
                                    {
                                        <iframe id="note-frame-@note.Id"
                                                srcdoc="@(_noteDocPrefix + note.ContentHtml + _noteDocSuffix)"
                                                style="width:100%;border:none;min-height:80px;max-height:500px;display:block;"
                                                sandbox="allow-scripts allow-same-origin"
                                                title="Email comment"
                                                onload="(function(f){var d=f.contentDocument;if(!d||!d.body)return;['.gmail_quote','.gmail_attr','blockquote[type=&quot;cite&quot;]','#divRplyFwdMsg','#divRFW','.yahoo_quoted'].forEach(function(s){try{d.querySelectorAll(s).forEach(function(e){e.style.display='none'});}catch(x){}});function r(){f.style.height=Math.min(500,Math.max(80,d.body.scrollHeight))+'px';}r();d.querySelectorAll('img').forEach(function(i){i.addEventListener('load',r);});})(this)"></iframe>
                                    }
                                    else if (note.Source == "Email")
                                    {
                                        <span style="white-space:pre-wrap;word-break:break-word;">@note.Content</span>
                                    }
                                    else
                                    {
                                        <span style="white-space:pre-line;">@note.Content</span>
                                    }
                                </div>
                                @if (note.Source != "Portal")
                                {
                                    <div class="text-muted small mt-1"><i class="bi bi-envelope me-1"></i>via @note.Source</div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- New comment editor -->
                <div class="comment-editor-area mt-4 border-top pt-3">
                    <div class="d-flex gap-3">
                        <div class="ticket-avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                             style="width:36px;height:36px;font-size:0.85rem;">AG</div>
                        <div class="flex-grow-1">
                            <div class="border rounded">
                                <textarea id="newCommentText" class="form-control border-0 rounded-top"
                                          rows="4" placeholder="Type your comment here..."></textarea>
                                <div class="d-flex align-items-center justify-content-between px-2 py-1 bg-light border-top rounded-bottom">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="internalToggle">
                                        <label class="form-check-label small text-muted" for="internalToggle">
                                            <i class="bi bi-lock me-1"></i> Public
                                        </label>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <div class="dropdown">
                                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" id="btnCannedResponses" title="Insert canned response">
                                                <i class="bi bi-chat-square-text me-1"></i> Templates
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end" id="cannedResponsesMenu" style="max-height:320px;overflow-y:auto;min-width:280px;">
                                                <li><span class="dropdown-item text-muted small">Loading...</span></li>
                                            </ul>
                                        </div>
                                        <label class="btn btn-sm btn-outline-secondary mb-0" id="btnAttach" title="Attach file (max 10 MB)">
                                            <i class="bi bi-paperclip"></i> Attach
                                            <input type="file" id="attachFileInput" style="display:none;" />
                                        </label>
                                        <button type="button" class="btn btn-sm btn-primary" id="btnPostComment">
                                            Post
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== DETAILS TAB ===== -->
            <div class="tab-pane fade" id="tab-details" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Description</label>
                        @if (!string.IsNullOrEmpty(Model.DescriptionHtml))
                        {
                            @* Email-originated ticket: show rendered HTML, keep Description value via hidden input *@
                            <input type="hidden" asp-for="Description" />
                            <div class="border rounded overflow-hidden" style="min-height:120px;">
                                <iframe srcdoc="@(_noteDocPrefix + Model.DescriptionHtml + _noteDocSuffix)"
                                        style="width:100%;border:none;min-height:120px;max-height:600px;display:block;"
                                        sandbox="allow-scripts allow-same-origin"
                                        title="Email description"
                                        onload="(function(f){var d=f.contentDocument;if(!d||!d.body)return;function r(){f.style.height=Math.min(600,Math.max(120,d.body.scrollHeight))+'px';}r();d.querySelectorAll('img').forEach(function(i){i.addEventListener('load',r);});})(this)"></iframe>
                            </div>
                        }
                        else
                        {
                            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Submitted By</label>
                                <input type="text" class="form-control form-control-sm mb-1 requester-search"
                                       placeholder="Search employee…" data-target="SubmittedById"
                                       oninput="filterSelectOptions(this)"
                                       autocomplete="off">
                                <select asp-for="SubmittedById" class="form-select" asp-items="@ViewBag.Employees"></select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Related Service</label>
                                <select asp-for="CompanyServiceId" class="form-select" asp-items="@ViewBag.Services">
                                    <option value="">— None —</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Related Asset</label>
                                <select asp-for="AssetId" class="form-select" asp-items="@ViewBag.Assets">
                                    <option value="">— None —</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Due Date <span class="text-muted fw-normal">(SLA)</span></label>
                                <input type="datetime-local" id="dueDatePicker"
                                       class="form-control @(Model.IsOverdue ? "border-danger" : "")"
                                       value="@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
                                       onchange="document.getElementById('dueDateHidden').value = this.value;" />
                                @if (Model.IsOverdue)
                                {
                                    <div class="text-danger small mt-1"><i class="bi bi-exclamation-triangle me-1"></i>Overdue since @Model.DueDate!.Value.ToString("MMM dd, yyyy")</div>
                                }
                            </div>
                            @if (Model.ResolvedDate.HasValue)
                            {
                                <div class="col-12">
                                    <label class="form-label fw-semibold text-success">Resolved Date</label>
                                    <div class="form-control-plaintext">@Model.ResolvedDate.Value.ToString("MMM dd, yyyy h:mm tt")</div>
                                </div>
                            }
                            @if (Model.ClosedDate.HasValue)
                            {
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Closed Date</label>
                                    <div class="form-control-plaintext">@Model.ClosedDate.Value.ToString("MMM dd, yyyy h:mm tt")</div>
                                </div>
                            }
                        </div>
                    </div>

                    @if (Model.Status == TicketStatus.Resolved || Model.Status == TicketStatus.Closed)
                    {
                        <div class="col-12">
                            <label asp-for="ResolutionNotes" class="form-label fw-semibold">Resolution Notes</label>
                            <textarea asp-for="ResolutionNotes" class="form-control" rows="3" placeholder="Describe how this ticket was resolved"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-2 p-3 bg-light rounded border">
                                <i class="bi bi-book-half text-primary fs-4 flex-shrink-0"></i>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Promote to Knowledge Base</div>
                                    <div class="text-muted small">Share this solution so other users can find it.</div>
                                </div>
                                <a asp-controller="Kb" asp-action="Create" asp-route-ticketId="@Model.Id"
                                   class="btn btn-sm btn-outline-primary flex-shrink-0">
                                    <i class="bi bi-plus-lg me-1"></i> Add to KB
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="ResolutionNotes" />
                    }
                </div>
            </div>

            <!-- ===== RELATED TAB ===== -->
            <div class="tab-pane fade" id="tab-related" role="tabpanel">
                <div class="py-3">
                    @if (Model.CompanyService != null)
                    {
                        <div class="card mb-3" style="max-width:400px;">
                            <div class="card-body">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-gear-fill text-primary fs-4"></i>
                                    <div>
                                        <div class="fw-semibold">@Model.CompanyService.Name</div>
                                        <div class="text-muted small">Related Service</div>
                                    </div>
                                    <a asp-controller="Services" asp-action="Details" asp-route-id="@Model.CompanyServiceId" class="btn btn-sm btn-outline-primary ms-auto">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted text-center py-4">
                            <i class="bi bi-link-45deg fs-3 d-block mb-2"></i>
                            No related items. Use the <strong>Details</strong> tab to link a service.
                        </div>
                    }
                </div>
            </div>

            <!-- ===== TASKS TAB ===== -->
            <div class="tab-pane fade" id="tab-tasks" role="tabpanel">
                <div class="text-muted text-center py-5">
                    <i class="bi bi-check2-square fs-2 d-block mb-2"></i>
                    <p>Task tracking coming soon.</p>
                    <p class="small">You will be able to create and assign sub-tasks to this ticket.</p>
                </div>
            </div>

            <!-- ===== ATTACHMENTS TAB ===== -->
            <div class="tab-pane fade" id="tab-attachments" role="tabpanel">
                <div class="mt-2">
                    <!-- Upload area -->
                    <div class="border rounded p-3 bg-light mb-3 text-center attachment-drop-zone" id="attachDropZone">
                        <i class="bi bi-cloud-upload fs-3 text-muted d-block mb-1"></i>
                        <p class="mb-1 text-muted small">Drag &amp; drop files here, or</p>
                        <label class="btn btn-sm btn-outline-primary mb-0">
                            <i class="bi bi-folder2-open me-1"></i> Browse Files
                            <input type="file" id="attachTabFileInput" style="display:none;" multiple />
                        </label>
                        <p class="text-muted small mt-1 mb-0">Maximum file size: 10 MB</p>
                    </div>

                    <!-- Upload progress -->
                    <div id="attachUploadProgress" style="display:none;" class="mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                            <span class="small text-muted">Uploading...</span>
                        </div>
                    </div>

                    <!-- Existing attachments list -->
                    <div id="attachmentsList">
                        @if (!Model.Attachments.Any())
                        {
                            <div class="text-muted text-center py-3" id="noAttachmentsMsg">
                                <i class="bi bi-paperclip fs-3 d-block mb-2"></i>
                                No attachments yet.
                            </div>
                        }
                        else
                        {
                            foreach (var att in Model.Attachments.OrderByDescending(a => a.UploadedDate))
                            {
                                <div class="attachment-item d-flex align-items-center gap-3 p-2 border rounded mb-2" data-att-id="@att.Id">
                                    <i class="bi bi-file-earmark fs-4 text-muted flex-shrink-0"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-semibold text-truncate">@att.FileName</div>
                                        <div class="text-muted small">@att.FileSizeDisplay &mdash; uploaded @att.UploadedDate.ToString("MMM dd, yyyy") by @att.UploadedBy</div>
                                    </div>
                                    <a href="/uploads/tickets/@Model.Id/@att.StoredFileName" download="@att.FileName" class="btn btn-sm btn-outline-secondary flex-shrink-0">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- ===== AUDIT TAB ===== -->
            <div class="tab-pane fade" id="tab-audit" role="tabpanel">
                <div class="audit-timeline mt-2">
                    <!-- Ticket created event -->
                    <div class="audit-entry d-flex gap-3">
                        <div class="audit-icon-col text-center" style="width:32px;flex-shrink:0;">
                            <div class="audit-dot bg-primary rounded-circle mx-auto" style="width:12px;height:12px;margin-top:4px;"></div>
                            <div class="audit-line bg-secondary mx-auto" style="width:2px;flex:1;min-height:30px;"></div>
                        </div>
                        <div class="pb-3">
                            <div class="fw-semibold text-primary small">Ticket Created</div>
                            <div class="text-muted small">@Model.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</div>
                            @if (Model.SubmittedBy != null)
                            {
                                <div class="small">Submitted by <strong>@Model.SubmittedBy.FullName</strong></div>
                            }
                        </div>
                    </div>

                    <!-- Field changes + notes merged and sorted by date -->
                    @{
                        // Build a unified timeline: notes + field changes
                        var auditNotes = Model.Notes
                            .Select(n => new { Time = n.CreatedDate, Kind = "note", Note = n, History = (TicketHistory?)null })
                            .ToList();
                        var auditHistory = Model.History
                            .Select(h => new { Time = h.ChangedDate, Kind = "change", Note = (TicketNote?)null, History = h })
                            .ToList();
                        var auditEntries = auditNotes
                            .Cast<dynamic>()
                            .Concat(auditHistory.Cast<dynamic>())
                            .OrderBy(e => (DateTime)e.Time)
                            .ToList();
                    }
                    @foreach (var entry in auditEntries)
                    {
                        if (entry.Kind == "note")
                        {
                            var note = (TicketNote)entry.Note;
                            <div class="audit-entry d-flex gap-3">
                                <div class="audit-icon-col text-center" style="width:32px;flex-shrink:0;">
                                    <div class="audit-dot @(note.Source == "Email" ? "bg-info" : note.IsInternal ? "bg-warning" : "bg-success") rounded-circle mx-auto" style="width:12px;height:12px;margin-top:4px;"></div>
                                    <div class="audit-line bg-secondary mx-auto" style="width:2px;flex:1;min-height:30px;"></div>
                                </div>
                                <div class="pb-3">
                                    <div class="fw-semibold small @(note.IsInternal ? "text-warning" : "text-success")">
                                        @(note.IsInternal ? "Internal Note" : "Comment") — @note.Source
                                    </div>
                                    <div class="text-muted small">@note.CreatedDate.ToString("MMM dd, yyyy h:mm tt") by @note.AuthorName</div>
                                    <div class="small text-truncate" style="max-width:500px;">@note.Content</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            var hist = (TicketHistory)entry.History;
                            <div class="audit-entry d-flex gap-3">
                                <div class="audit-icon-col text-center" style="width:32px;flex-shrink:0;">
                                    <div class="audit-dot bg-primary rounded-circle mx-auto" style="width:12px;height:12px;margin-top:4px;"></div>
                                    <div class="audit-line bg-secondary mx-auto" style="width:2px;flex:1;min-height:30px;"></div>
                                </div>
                                <div class="pb-3">
                                    <div class="fw-semibold small text-primary">Field Changed: @hist.FieldName</div>
                                    <div class="text-muted small">@hist.ChangedDate.ToString("MMM dd, yyyy h:mm tt") by @hist.ChangedBy</div>
                                    <div class="small">
                                        <span class="text-muted">@(hist.OldValue ?? "—")</span>
                                        <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                        <span class="fw-semibold">@(hist.NewValue ?? "—")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <!-- Resolved event -->
                    @if (Model.ResolvedDate.HasValue)
                    {
                        <div class="audit-entry d-flex gap-3">
                            <div class="audit-icon-col text-center" style="width:32px;flex-shrink:0;">
                                <div class="audit-dot bg-success rounded-circle mx-auto" style="width:12px;height:12px;margin-top:4px;"></div>
                                <div class="audit-line bg-secondary mx-auto" style="width:2px;flex:1;min-height:30px;"></div>
                            </div>
                            <div class="pb-3">
                                <div class="fw-semibold text-success small">Ticket Resolved</div>
                                <div class="text-muted small">@Model.ResolvedDate.Value.ToString("MMM dd, yyyy h:mm tt")</div>
                            </div>
                        </div>
                    }

                    <!-- Closed event -->
                    @if (Model.ClosedDate.HasValue)
                    {
                        <div class="audit-entry d-flex gap-3">
                            <div class="audit-icon-col text-center" style="width:32px;flex-shrink:0;">
                                <div class="audit-dot bg-secondary rounded-circle mx-auto" style="width:12px;height:12px;margin-top:4px;"></div>
                            </div>
                            <div class="pb-3">
                                <div class="fw-semibold text-secondary small">Ticket Closed</div>
                                <div class="text-muted small">@Model.ClosedDate.Value.ToString("MMM dd, yyyy h:mm tt")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div><!-- /.tab-content -->
    </div><!-- /.ticket-edit-body -->
</form>

<!-- Toast for comment post feedback -->
<!-- ── Log Time Modal ──────────────────────────────────────────── -->
@{
    // Hoisted so both the AddTimeEntry form AND the sibling EditEntry panel
    // can see it — the original @{ } block lives inside <form>/modal-body so
    // its scope doesn't reach the edit panel below.
    var modalShowRateType = ViewBag.LoggerHasEmergencyRate is bool mShowRate && mShowRate;
    var modalTimeEntries  = Model.TimeEntries?.OrderByDescending(e => e.WorkDate).ToList()
                            ?? new List<ServiceDesk.Core.Models.TicketTimeEntry>();
    var modalTotalHours    = (decimal)(ViewBag.TimeTotalHours ?? 0m);
    var modalBillableHours = (decimal)(ViewBag.TimeBillableHours ?? 0m);
}
<div class="modal fade" id="timeTrackingModal" tabindex="-1" aria-labelledby="timeTrackingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="timeTrackingModalLabel">
                    <i class="bi bi-stopwatch me-1 text-primary"></i>Log Time — Ticket #@Model.Id
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddTimeEntry" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="Edit" />
                <div class="modal-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold mb-1">Date</label>
                            <input type="date" name="workDate" id="modalWorkDate" class="form-control form-control-sm"
                                   value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold mb-1">Hours</label>
                            <input type="number" name="hours" id="modalHours" step="0.25" min="0.25" max="999"
                                   class="form-control form-control-sm" placeholder="0.00" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Clock In / Out <span class="text-muted small">opt.</span></label>
                            <div class="d-flex gap-1">
                                <input type="time" name="startTime" id="modalStartTime" class="form-control form-control-sm" />
                                <input type="time" name="endTime"   id="modalEndTime"   class="form-control form-control-sm" />
                            </div>
                            <small id="modalClockHint" class="text-muted d-block" style="font-size:.68rem;line-height:1.1;"></small>
                        </div>
                        @if (modalShowRateType)
                        {
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold mb-1">Rate Type</label>
                                <select name="rateType" id="modalRateType" class="form-select form-select-sm">
                                    <option value="Standard" selected>Standard</option>
                                    <option value="Emergency">Emergency / Weekend</option>
                                </select>
                                <small id="modalRateTypeHint" class="text-muted d-block" style="font-size:.68rem;line-height:1.1;"></small>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold mb-1">Description</label>
                                <input type="text" name="description" class="form-control form-control-sm"
                                       maxlength="1000" placeholder="Notes" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold mb-1">Description</label>
                                <input type="text" name="description" class="form-control form-control-sm"
                                       maxlength="1000" placeholder="What did you work on?" />
                            </div>
                        }
                        <div class="col-md-1">
                            <label class="form-label small fw-semibold d-block mb-1">&nbsp;</label>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" name="isBillable" value="true" id="modalBillableChk" />
                                <label class="form-check-label small" for="modalBillableChk">Bill.</label>
                            </div>
                        </div>
                    </div>

                    @if (modalTimeEntries.Any())
                    {
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-muted">Logged so far</span>
                            <span class="small text-muted">
                                Total: <strong>@modalTotalHours.ToString("0.##")h</strong>
                                · Billable: <strong>@modalBillableHours.ToString("0.##")h</strong>
                            </span>
                        </div>
                        <div class="table-responsive" style="max-height:220px;overflow-y:auto;">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Date</th>
                                        <th>Hours</th>
                                        @if (modalShowRateType) { <th>Rate</th> }
                                        <th>Description</th>
                                        <th>Billable</th>
                                        <th>By</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in modalTimeEntries)
                                    {
                                        var claimed = e.PayrollReceiptId != null;
                                        var clockStr = (e.StartTime.HasValue && e.EndTime.HasValue)
                                            ? (e.StartTime.Value.ToString("h:mm tt") + "–" + e.EndTime.Value.ToString("h:mm tt"))
                                            : "";
                                        var startStr = e.StartTime?.ToString("HH:mm") ?? "";
                                        var endStr   = e.EndTime?.ToString("HH:mm")   ?? "";
                                        var modTooltip = e.ModifiedDate.HasValue
                                            ? $"Last edited {e.ModifiedDate.Value:MMM d, yyyy h:mm tt} by {e.ModifiedByEmail} · {e.ModificationReason}"
                                            : "";
                                        <tr>
                                            <td class="small text-nowrap">
                                                @e.WorkDate.ToString("MMM d, yyyy")
                                                @if (!string.IsNullOrEmpty(clockStr))
                                                {
                                                    <div class="text-muted" style="font-size:.7rem;"><i class="bi bi-clock"></i> @clockStr</div>
                                                }
                                            </td>
                                            <td class="fw-semibold">@e.Hours.ToString("0.##")h</td>
                                            @if (modalShowRateType)
                                            {
                                                <td>
                                                    @if (e.RateType == ServiceDesk.Core.Enums.PayRateType.Emergency)
                                                    {
                                                        <span class="badge bg-danger" title="Emergency / weekend / after-hours">Emergency</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Standard</span>
                                                    }
                                                </td>
                                            }
                                            <td class="small">
                                                @e.Description
                                                @if (e.ModificationCount > 0)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1" style="font-size:.6rem;cursor:help;"
                                                          data-bs-toggle="tooltip" title="@modTooltip">edited</span>
                                                }
                                            </td>
                                            <td>
                                                @if (e.IsBillable)
                                                { <span class="badge bg-success">Billable</span> }
                                                else
                                                { <span class="text-muted small">—</span> }
                                            </td>
                                            <td class="small text-muted">@e.LoggedByEmail</td>
                                            <td>
                                                @if (!claimed)
                                                {
                                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1"
                                                            title="Edit entry"
                                                            onclick="fillEditEntry(@e.Id,'@e.WorkDate.ToString("yyyy-MM-dd")',@e.Hours.ToString("0.##"),'@Html.Raw((e.Description ?? "").Replace("'","\\'" ).Replace("\r","").Replace("\n","\\n"))',@(e.IsBillable ? "true" : "false"),'@e.RateType','@startStr','@endStr')">
                                                        <i class="bi bi-pencil" style="font-size:.7rem;"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary" style="font-size:.65rem;" title="Claimed on a payroll receipt">Claimed</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No time logged yet on this ticket.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Log Time
                    </button>
                </div>
            </form>

            <!-- Edit existing entry form (hidden until pencil clicked) -->
            <div id="editEntryPanel" class="border-top px-4 py-3" style="display:none;background:#f8f9fb;">
                <form asp-action="EditTimeEntry" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="entryId" id="editEntryId" />
                    <input type="hidden" name="returnAction" value="Edit" />
                    <div class="fw-semibold small mb-2 text-primary"><i class="bi bi-pencil me-1"></i>Edit Entry</div>
                    <div class="row g-2">
                        <div class="col-md-2">
                            <label class="form-label small mb-1">Date</label>
                            <input type="date" name="workDate" id="editWorkDate" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-1">Hours</label>
                            <input type="number" name="hours" id="editHours" step="0.25" min="0.25" max="999" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-1">Clock In / Out <span class="text-muted small">opt.</span></label>
                            <div class="d-flex gap-1">
                                <input type="time" name="startTime" id="editStartTime" class="form-control form-control-sm" />
                                <input type="time" name="endTime"   id="editEndTime"   class="form-control form-control-sm" />
                            </div>
                            <small id="editClockHint" class="text-muted d-block" style="font-size:.68rem;line-height:1.1;"></small>
                        </div>
                        @if (modalShowRateType)
                        {
                            <div class="col-md-2">
                                <label class="form-label small mb-1">Rate Type</label>
                                <select name="rateType" id="editRateType" class="form-select form-select-sm">
