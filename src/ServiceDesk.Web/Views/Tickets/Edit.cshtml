            .catch(function() {
                btn.disabled = false;
                btn.innerHTML = origHtml;
                alert('Failed to reach the server. Please try again.');
            });
    });
})();
</script>

<script>
// ── Ticket Resolution modal ───────────────────────────────────────────────
(function () {
    var resolveModalEl = document.getElementById('resolveModal');
    if (!resolveModalEl) return;

    var resolveModal   = new bootstrap.Modal(resolveModalEl, { backdrop: 'static', keyboard: false });
    var statusSelect   = document.getElementById('statusSelect');
    var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    var ticketId       = parseInt(document.querySelector('input[name="Id"]')?.value || '0', 10);
    var pendingStatus  = '';
    var previousStatus = statusSelect ? statusSelect.value : '';

    // Intercept status dropdown — show modal when user picks Resolved or Closed
    if (statusSelect) {
        statusSelect.addEventListener('change', function () {
            var val = this.value;
            var selectedText = (this.options[this.selectedIndex] ? this.options[this.selectedIndex].text : '').trim();
            if (selectedText === 'Resolved' || selectedText === 'Closed') {
                pendingStatus = selectedText;  // must be text ("Resolved"/"Closed") for Enum.TryParse in controller
                document.getElementById('resolveModalStatusLabel').textContent = '— ' + selectedText;
                document.getElementById('resolveTypeSelect').value = '';
                document.getElementById('resolveNotesTextarea').value = '';
                document.getElementById('resolveTypeError').style.display = 'none';
                // Revert dropdown until modal is confirmed
                this.value = previousStatus;
                resolveModal.show();
            } else {
                previousStatus = val;
            }
        });
        resolveModalEl.addEventListener('hidden.bs.modal', function () {
            // If modal dismissed without confirming, keep status reverted
        });
    }

    document.getElementById('btnResolveDismiss')?.addEventListener('click', function () {
        resolveModal.hide();
    });
    document.getElementById('btnResolveCancelModal')?.addEventListener('click', function () {
        resolveModal.hide();
    });

    document.getElementById('btnResolveConfirm')?.addEventListener('click', function () {
        var resType  = document.getElementById('resolveTypeSelect').value;
        var resNotes = (document.getElementById('resolveNotesTextarea')?.value || '').trim();

        if (!resType) {
            document.getElementById('resolveTypeError').style.display = '';
            return;
        }
        document.getElementById('resolveTypeError').style.display = 'none';

        var btn = this;
        var origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"><\/span>Resolving…';

        var fd = new FormData();
        fd.append('__RequestVerificationToken', antiForgeryToken);
        fd.append('resolutionType', resType);
        fd.append('resolutionNotes', resNotes);
        fd.append('targetStatus', pendingStatus || 'Resolved');

        fetch('/Tickets/ResolveTicket/' + ticketId, { method: 'POST', body: fd })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    resolveModal.hide();
                    // If there are resolution notes, reload with a flag that triggers the KB suggestion banner
                    var reloadUrl = window.location.pathname
                        + (data.suggestKb ? '?suggestKb=1' : '');
                    window.location.href = reloadUrl;
                } else {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                    alert(data.error || 'Resolution failed. Please try again.');
                }
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = origHtml;
                alert('Failed to reach the server. Please try again.');
            });
    });
})();
</script>
}
