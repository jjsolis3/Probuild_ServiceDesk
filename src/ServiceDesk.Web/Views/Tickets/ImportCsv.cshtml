@{
    ViewData["Title"] = "Import Tickets";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Tickets</a></li>
        <li class="breadcrumb-item active">Import Tickets</li>
    </ol>
</nav>

<div class="d-flex align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-upload text-primary me-2"></i>Import Tickets</h1>
</div>

<div class="row g-4">

    <!-- LEFT: Download + Upload -->
    <div class="col-lg-6">

        <!-- Download template -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="flex-grow-1">
                    <div class="fw-semibold mb-1">Step 1 — Download the Template</div>
                    <div class="text-muted small">Fill in your ticket data, then upload below. Delete the first two rows before importing.</div>
                </div>
                <a href="/templates/tickets-import-template.csv" download="tickets-import-template.csv" class="btn btn-success btn-sm flex-shrink-0">
                    <i class="bi bi-file-earmark-arrow-down me-1"></i> Download Template
                </a>
            </div>
        </div>

        <!-- Upload form -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-spreadsheet text-primary me-2"></i>
                    Step 2 — Upload Your CSV File
                </h5>
            </div>
            <div class="card-body">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3"></div>
                <form asp-action="ImportCsv" method="post" enctype="multipart/form-data" data-loading-btn="btnUpload">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select CSV File <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control" accept=".csv,.tsv,.txt" required />
                        <div class="form-text">
                            Works with the ServiceSphere template <em>or</em> a SolarWinds export (.csv or .tsv).
                        </div>
                    </div>
                    <button type="submit" id="btnUpload" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i> Parse &amp; Preview Import
                    </button>
                </form>
            </div>
        </div>

        <!-- Collapsible instructions -->
        <div class="card border-0 shadow-sm">
            <button class="btn btn-link text-start text-decoration-none px-3 py-2 d-flex align-items-center justify-content-between w-100"
                    type="button" data-bs-toggle="collapse" data-bs-target="#importInstructions">
                <span class="fw-semibold text-body small"><i class="bi bi-info-circle me-2 text-muted"></i>Field rules &amp; valid values</span>
                <i class="bi bi-chevron-down text-muted small"></i>
            </button>
            <div class="collapse" id="importInstructions">
                <div class="card-body pt-0">
                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-1"><strong>Requester</strong> — employee email (e.g. <code>jim@@seamlessflooring.com</code>). Row is skipped if email not found in Employees.</li>
                        <li class="mb-1"><strong>Assignee Email</strong> — same rule. Leave blank if unassigned.</li>
                        <li class="mb-1"><strong>State</strong> — <code>Open</code> | <code>In Progress</code> | <code>On Hold</code> | <code>Resolved</code> | <code>Closed</code> | <code>Cancelled</code></li>
                        <li class="mb-1"><strong>Priority</strong> — <code>Low</code> | <code>Medium</code> | <code>High</code> | <code>Critical</code></li>
                        <li class="mb-1"><strong>Category</strong> — <code>Hardware</code> | <code>Applications</code> | <code>Network</code> | <code>Employee</code> | <code>Security</code> | <code>Service Request</code></li>
                        <li class="mb-1"><strong>Site</strong> — must match a Branch name or city (e.g. <code>Las Vegas</code>). Leave blank if unknown.</li>
                        <li class="mb-1"><strong>Dates</strong> — <code>M/D/YYYY</code> format (e.g. <code>3/24/2026</code>). Leave blank if not applicable.</li>
                        <li class="mb-1"><strong>Title</strong> max 200 chars — <strong>Description</strong> max 2000 chars. Both are required.</li>
                    </ul>
                    <div class="alert alert-info py-2 small mt-3 mb-0">
                        <i class="bi bi-lightbulb-fill me-1"></i>
                        <strong>Before importing:</strong> go to <strong>Employees</strong> and confirm everyone who submitted or was assigned a ticket has an account with the correct email address.
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- RIGHT: Column reference -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0"><i class="bi bi-table me-2 text-muted"></i>Template Columns</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Column</th>
                            <th>Required</th>
                            <th class="pe-3">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td class="ps-3"><code>Title</code></td><td><span class="text-danger fw-semibold">Yes</span></td><td class="pe-3 text-muted">Max 200 characters</td></tr>
                        <tr><td class="ps-3"><code>Description</code></td><td><span class="text-danger fw-semibold">Yes</span></td><td class="pe-3 text-muted">Max 2000 characters</td></tr>
                        <tr><td class="ps-3"><code>State</code></td><td>No</td><td class="pe-3 text-muted">Defaults to Open</td></tr>
                        <tr><td class="ps-3"><code>Priority</code></td><td>No</td><td class="pe-3 text-muted">Defaults to Medium</td></tr>
                        <tr><td class="ps-3"><code>Category</code></td><td>No</td><td class="pe-3 text-muted">Defaults to Other</td></tr>
                        <tr><td class="ps-3"><code>Subcategory</code></td><td>No</td><td class="pe-3 text-muted">Must match an existing sub-category name</td></tr>
                        <tr class="table-warning"><td class="ps-3"><code>Requester</code></td><td><span class="text-danger fw-semibold">Yes</span></td><td class="pe-3 text-muted">Employee email — row skipped if not found</td></tr>
                        <tr><td class="ps-3"><code>Assignee Email</code></td><td>No</td><td class="pe-3 text-muted">Employee email, leave blank if none</td></tr>
                        <tr><td class="ps-3"><code>Site</code></td><td>No</td><td class="pe-3 text-muted">Branch name or city</td></tr>
                        <tr><td class="ps-3"><code>Created At</code></td><td>No</td><td class="pe-3 text-muted">Defaults to today if blank</td></tr>
                        <tr><td class="ps-3"><code>Due Date</code></td><td>No</td><td class="pe-3 text-muted">M/D/YYYY</td></tr>
                        <tr><td class="ps-3"><code>Resolved At</code></td><td>No</td><td class="pe-3 text-muted">M/D/YYYY</td></tr>
                        <tr><td class="ps-3"><code>Resolution</code></td><td>No</td><td class="pe-3 text-muted">Resolution notes text</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-light py-2 small text-muted">
                <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                The <strong>Requester</strong> column is the only reason rows get skipped — make sure employee emails are loaded first.
            </div>
        </div>
    </div>

</div>
