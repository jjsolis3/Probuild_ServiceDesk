@{
    ViewData["Title"] = "Import Tickets";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Tickets</a></li>
        <li class="breadcrumb-item active">Import from SolarWinds</li>
    </ol>
</nav>

<div class="d-flex align-items-center mb-4 gap-3">
    <h1 class="mb-0"><i class="bi bi-upload text-primary me-2"></i>Import Tickets</h1>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0"><i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>Upload SolarWinds Export</h5>
            </div>
            <div class="card-body">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

                <form asp-action="ImportCsv" method="post" enctype="multipart/form-data" data-loading-btn="btnUpload">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Select Export File <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control" accept=".csv,.tsv,.txt" required />
                        <div class="form-text">Supported formats: <strong>.tsv</strong> (tab-separated) or <strong>.csv</strong> — the standard SolarWinds export format.</div>
                    </div>
                    <button type="submit" id="btnUpload" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i> Parse & Preview
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-1"></i>How the import works</h6>
                <ol class="small text-muted ps-3 mb-3">
                    <li class="mb-1">Export tickets from SolarWinds as a <strong>TSV or CSV</strong> file (all fields).</li>
                    <li class="mb-1">Upload the file here — a <strong>preview</strong> will show what will be imported.</li>
                    <li class="mb-1">Review the preview and click <strong>Confirm Import</strong> to save.</li>
                </ol>
                <hr class="my-2" />
                <h6 class="fw-bold mb-2 small">Field mapping</h6>
                <table class="table table-sm table-borderless small mb-0">
                    <tbody>
                        <tr><td class="text-muted">Title</td><td>→ Title</td></tr>
                        <tr><td class="text-muted">Description</td><td>→ Description</td></tr>
                        <tr><td class="text-muted">State</td><td>→ Status</td></tr>
                        <tr><td class="text-muted">Priority</td><td>→ Priority</td></tr>
                        <tr><td class="text-muted">Category</td><td>→ Category</td></tr>
                        <tr><td class="text-muted">Subcategory</td><td>→ Sub-Category</td></tr>
                        <tr><td class="text-muted">Requester</td><td>→ Submitted By <span class="text-danger">*</span></td></tr>
                        <tr><td class="text-muted">Assignee Email</td><td>→ Assigned To</td></tr>
                        <tr><td class="text-muted">Site</td><td>→ Branch</td></tr>
                        <tr><td class="text-muted">Created At</td><td>→ Created Date</td></tr>
                        <tr><td class="text-muted">Resolved At</td><td>→ Resolved Date</td></tr>
                        <tr><td class="text-muted">Resolution</td><td>→ Resolution Notes</td></tr>
                    </tbody>
                </table>
                <div class="small text-muted mt-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                    Tickets whose <strong>Requester email</strong> doesn't match an existing Employee will be skipped.
                </div>
            </div>
        </div>
    </div>
</div>
