@model Ticket
@{
    ViewData["Title"] = "Delete Ticket";
}

<h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Ticket</h1>
<h3>Are you sure you want to delete this ticket?</h3>

<div class="card mt-3" style="max-width: 600px;">
    <div class="card-body">
        <dl>
            <dt>ID</dt>
            <dd>@Model.Id</dd>
            <dt>Title</dt>
            <dd>@Model.Title</dd>
            <dt>Category</dt>
            <dd>@Model.Category</dd>
            <dt>Status</dt>
            <dd>@Model.Status</dd>
            <dt>Submitted By</dt>
            <dd>@Model.SubmittedBy?.FullName</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
