@model Ticket
@using ServiceDesk.Web.Helpers
@{
    var _catById = ViewBag.CategoriesById as Dictionary<int, string> ?? new Dictionary<int, string>();
    var _mdPrefix = "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>"
        + "body{font-family:Arial,sans-serif;font-size:13px;line-height:1.5;margin:10px 14px;color:#212529;word-break:break-word;}"
        + "img{max-width:100%;height:auto;}a{color:#0d6efd;}"
        + "</style></head><body>";
    var _mdSuffix = "</body></html>";
    var _mStatusAccent = Model.Status switch {
        TicketStatus.Open       => "#3b82f6",
        TicketStatus.InProgress => "#f59e0b",
        TicketStatus.OnHold     => "#6b7280",
        TicketStatus.Resolved   => "#10b981",
        TicketStatus.Closed     => "#374151",
        TicketStatus.Cancelled  => "#ef4444",
        _                       => "#9ca3af"
    };
}

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <h5 class="mb-1">#@Model.Id - @Model.Title</h5>
        <div class="text-muted small">Created @Model.CreatedDate.ToOrgDisplay((string?)ViewBag.OrgTz, "MMM dd, yyyy h:mm tt")</div>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
        <i class="bi bi-pencil me-1"></i>Edit
    </a>
</div>
<div style="height:3px;background:@_mStatusAccent;border-radius:2px;margin-bottom:1rem;"></div>

<div class="row g-3" style="min-height:300px;">
    <div class="col-md-7 d-flex flex-column">
        <div class="card flex-grow-1">
            <div class="card-header">Description</div>
            @if (!string.IsNullOrEmpty(Model.DescriptionHtml))
            {
                <div class="card-body p-0 flex-grow-1">
                    <iframe srcdoc="@(_mdPrefix + Model.DescriptionHtml + _mdSuffix)"
                            style="width:100%;border:none;min-height:180px;max-height:600px;display:block;"
                            sandbox="allow-same-origin"
                            title="Email description"
                            onload="(function(f){var d=f.contentDocument;if(!d||!d.body)return;var h=d.body.scrollHeight;f.style.height=Math.min(600,Math.max(180,h))+'px';})(this)"></iframe>
                </div>
            }
            else
            {
                <div class="card-body flex-grow-1" style="min-height:180px;">
                    <p class="mb-0" style="white-space:pre-wrap; word-break:break-word;">@Model.Description</p>
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ResolutionNotes))
        {
            <div class="card mt-3">
                <div class="card-header bg-success text-white">Resolution Notes</div>
                <div class="card-body">
                    <p class="mb-0" style="white-space:pre-wrap; word-break:break-word;">@Model.ResolutionNotes</p>
                </div>
            </div>
        }
    </div>
    <div class="col-md-5 d-flex flex-column">
        <div class="card h-100">
            <div class="card-header">Details</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Status</dt>
                    <dd><span class="badge badge-@Model.Status.ToString().ToLower()">@Model.Status</span></dd>
                    <dt>Priority</dt>
                    <dd><span class="badge badge-@Model.Priority.ToString().ToLower()">@Model.Priority</span></dd>
                    <dt>Category</dt>
                    <dd>@(_catById.TryGetValue(Model.Category, out var _cn) ? _cn : $"Category {Model.Category}")</dd>
                    <dt>Submitted By</dt>
                    <dd>@(Model.SubmittedBy?.FullName ?? "—")</dd>
                    <dt>Assigned To</dt>
                    <dd>@(Model.AssignedTo?.FullName ?? "Unassigned")</dd>
                    <dt>Due Date</dt>
                    <dd>@(Model.DueDate?.ToString("MMM dd, yyyy") ?? "—")</dd>
                    @if (!string.IsNullOrEmpty(Model.ResolutionType))
                    {
                        <dt>Resolution Type</dt>
                        <dd><span class="badge bg-success">@Model.ResolutionType</span></dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>
