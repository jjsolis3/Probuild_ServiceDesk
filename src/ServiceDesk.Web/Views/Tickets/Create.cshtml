@model Ticket
@{
    ViewData["Title"] = "Create Ticket";
    var templates = ViewBag.TicketTemplates as IEnumerable<ServiceDesk.Core.Models.TicketTemplate>
                    ?? Enumerable.Empty<ServiceDesk.Core.Models.TicketTemplate>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Tickets</a></li>
        <li class="breadcrumb-item active">New Ticket</li>
    </ol>
</nav>

<h1><i class="bi bi-plus-lg"></i> Create New Ticket</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" data-loading-btn="btnCreateTicket">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (templates.Any())
            {
                <div class="mb-3 p-3 rounded" style="background:#f5f8ff; border:1px solid #cfdcff;">
                    <label for="ticketTemplatePicker" class="form-label fw-semibold mb-1">
                        <i class="bi bi-stars me-1 text-primary"></i>Start from a template
                        <span class="text-muted fw-normal small ms-1">(optional — pre-fills Title, Description, Category & Priority)</span>
                    </label>
                    <select id="ticketTemplatePicker" class="form-select form-select-sm">
                        <option value="">— No template —</option>
                        @foreach (var t in templates)
                        {
                            <option value="@t.Id" data-desc="@t.Description">@t.Name</option>
                        }
                    </select>
                    <div id="ticketTemplateHint" class="form-text small mt-1" style="min-height:1.1em;"></div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Title" class="form-label"><span class="text-danger ms-1">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="Brief description of the issue"
                       data-autosave="ticket-new-title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"><span class="text-danger ms-1">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="5"
                          placeholder="Provide detailed information about the issue"
                          data-autosave="ticket-new-description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label asp-for="Category" class="form-label"><span class="text-danger ms-1">*</span></label>
                    <select asp-for="Category" asp-items="@ViewBag.CategorySelectList" class="form-select" id="createCategorySelect">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sub-Category</label>
                    <select name="SubCategoryId" id="createSubCategorySelect" class="form-select">
                        <option value="">— None —</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Priority" class="form-label"><span class="text-danger ms-1">*</span></label>
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TicketPriority>()" class="form-select"></select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="SubmittedById" class="form-label"><span class="text-danger ms-1">*</span>Submitted By</label>
                    <select asp-for="SubmittedById" class="form-select" asp-items="@ViewBag.Employees">
                        <option value="">-- Select Employee --</option>
                    </select>
                    <span asp-validation-for="SubmittedById" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="AssignedToId" class="form-label">Assign To (IT Staff)</label>
                    <select asp-for="AssignedToId" class="form-select" asp-items="@ViewBag.ITStaff">
                        <option value="">-- Unassigned --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="CompanyServiceId" class="form-label">Related Service</label>
                    <select asp-for="CompanyServiceId" class="form-select" asp-items="@ViewBag.Services">
                        <option value="">-- None --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AssetId" class="form-label">Related Asset</label>
                    <select asp-for="AssetId" class="form-select" asp-items="@ViewBag.Assets">
                        <option value="">-- None --</option>
                    </select>
                    <div class="form-text">Link this ticket to a specific asset.</div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" id="btnCreateTicket" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Ticket</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const catSel = document.getElementById('createCategorySelect');
    const subSel = document.getElementById('createSubCategorySelect');
    if (!catSel || !subSel) return;

    catSel.addEventListener('change', function () {
        subSel.innerHTML = '<option value="">— None —</option>';
        if (!this.value) return;
        fetch(`/Tickets/SubCategories?category=${encodeURIComponent(this.value)}`)
            .then(r => r.json())
            .then(items => {
                items.forEach(function (item) {
                    const opt = document.createElement('option');
                    opt.value = item.id;
                    opt.textContent = item.name;
                    subSel.appendChild(opt);
                });
            });
    });

    // ── Ticket template picker ────────────────────────────────────────────
    // Fetches the chosen template's pre-fill payload and applies it to the
    // form. Sub-category is loaded asynchronously since it depends on
    // Category; we trigger the category change handler then select the
    // template's sub-category id once the options arrive.
    const tplPicker = document.getElementById('ticketTemplatePicker');
    const tplHint   = document.getElementById('ticketTemplateHint');
    if (tplPicker) {
        tplPicker.addEventListener('change', function () {
            const id = this.value;
            const selected = this.options[this.selectedIndex];
            tplHint.textContent = selected ? (selected.getAttribute('data-desc') || '') : '';
            if (!id) return;

            fetch('/Tickets/TemplateJson/' + encodeURIComponent(id))
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (!data) return;
                    const titleEl    = document.querySelector('input[name="Title"]');
                    const bodyEl     = document.querySelector('textarea[name="Description"]');
                    const priorityEl = document.querySelector('select[name="Priority"]');
                    if (titleEl)    titleEl.value = data.title;
                    if (bodyEl)     bodyEl.value  = data.body;
                    if (priorityEl) priorityEl.value = data.priority;

                    // Apply Category first; it triggers SubCategory reload.
                    catSel.value = data.category;
                    catSel.dispatchEvent(new Event('change'));

                    // Once sub-categories have loaded, select the template's
                    // sub-category if it's present in the new options.
                    if (data.subCategoryId) {
                        const subTarget = String(data.subCategoryId);
                        const tryPick = function (retries) {
                            const opt = subSel.querySelector('option[value="' + subTarget + '"]');
                            if (opt) { subSel.value = subTarget; return; }
                            if (retries > 0) setTimeout(function () { tryPick(retries - 1); }, 120);
                        };
                        tryPick(8);
                    }
                });
        });
    }
})();
</script>
}
