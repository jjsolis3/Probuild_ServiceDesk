@model IEnumerable<KbArticle>
@{
    ViewData["Title"] = "Manage Knowledge Base";
    var q = ViewBag.SearchQuery as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1><i class="bi bi-book-half me-2"></i>Manage Knowledge Base</h1>
        <p class="text-muted mb-0">All articles — including unpublished drafts.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye me-1"></i>Public View</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Article</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search -->
<form method="get" class="mb-3">
    <div class="input-group" style="max-width:500px;">
        <input type="text" name="q" value="@q" class="form-control" placeholder="Search title or problem..." />
        <button class="btn btn-primary" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <a asp-action="All" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Author</th>
                <th>Published</th>
                <th>Views</th>
                <th>Last Updated</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in Model)
            {
                <tr>
                    <td>@article.Id</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@article.Id">@article.Title</a>
                        @if (article.SourceTicketId.HasValue)
                        {
                            <span class="badge bg-light text-dark border ms-1" title="Promoted from ticket #@article.SourceTicketId">
                                <i class="bi bi-ticket me-1"></i>#@article.SourceTicketId
                            </span>
                        }
                    </td>
                    <td>@article.Category</td>
                    <td>@article.CreatedBy</td>
                    <td>
                        @if (article.IsPublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Draft</span>
                        }
                    </td>
                    <td><i class="bi bi-eye me-1 text-muted"></i>@article.ViewCount</td>
                    <td>@(article.LastUpdated?.ToString("MMM dd, yyyy") ?? article.CreatedDate.ToString("MMM dd, yyyy"))</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="TogglePublish" asp-route-id="@article.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(article.IsPublished ? "btn-outline-warning" : "btn-outline-success")"
                                        title="@(article.IsPublished ? "Unpublish" : "Publish")">
                                    <i class="bi @(article.IsPublished ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="Delete" asp-route-id="@article.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this KB article permanently?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-4">
        <i class="bi bi-journal-x display-1"></i>
        <p class="mt-3">No KB articles yet. <a asp-action="Create">Create the first one.</a></p>
    </div>
}
