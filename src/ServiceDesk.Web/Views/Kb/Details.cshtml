@model KbArticle
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Knowledge Base</a></li>
        <li class="breadcrumb-item active text-truncate" style="max-width:400px;">@Model.Title</li>
    </ol>
</nav>

<div class="row g-4">
    <!-- Article content -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex align-items-start justify-content-between gap-2">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-book-half text-primary me-2"></i>@Model.Title</h4>
                    @if (User.IsInRole("Admin") || User.IsInRole("IT Agent"))
                    {
                        <div class="d-flex gap-2 flex-shrink-0">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="card-body">
                <!-- Problem / Symptom -->
                <div class="mb-4">
                    <h5 class="fw-semibold text-danger mb-2">
                        <i class="bi bi-exclamation-circle me-1"></i> Problem / Symptom
                    </h5>
                    <div class="bg-light rounded p-3 border-start border-3 border-danger">
                        @Model.Problem
                    </div>
                </div>

                <!-- Solution -->
                <div>
                    <h5 class="fw-semibold text-success mb-2">
                        <i class="bi bi-check-circle me-1"></i> Solution
                    </h5>
                    <div class="bg-light rounded p-3 border-start border-3 border-success" style="white-space:pre-wrap;">@Model.Solution</div>
                </div>
            </div>
        </div>

        <!-- Was this helpful? -->
        <div class="card border-0 shadow-sm text-center py-4 mb-3">
            <div class="card-body">
                <p class="fw-semibold mb-3">Was this article helpful?</p>
                <div class="d-flex justify-content-center gap-3">
                    <button class="btn btn-outline-success" onclick="markHelpful(true, this)">
                        <i class="bi bi-hand-thumbs-up me-1"></i> Yes, it helped
                    </button>
                    <button class="btn btn-outline-danger" onclick="markHelpful(false, this)">
                        <i class="bi bi-hand-thumbs-down me-1"></i> Not really
                    </button>
                </div>
                <p id="helpfulFeedback" class="text-muted small mt-2" style="display:none;">Thanks for your feedback!</p>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-light fw-semibold"><i class="bi bi-info-circle me-1"></i>Article Info</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted">Category</dt>
                    <dd class="col-7"><span class="badge bg-light text-dark border">@Model.Category</span></dd>
                    <dt class="col-5 text-muted">Author</dt>
                    <dd class="col-7">@Model.CreatedBy</dd>
                    <dt class="col-5 text-muted">Published</dt>
                    <dd class="col-7">@Model.CreatedDate.ToString("MMM dd, yyyy")</dd>
                    @if (Model.LastUpdated.HasValue)
                    {
                        <dt class="col-5 text-muted">Last Updated</dt>
                        <dd class="col-7">@Model.LastUpdated.Value.ToString("MMM dd, yyyy")</dd>
                    }
                    <dt class="col-5 text-muted">Views</dt>
                    <dd class="col-7"><i class="bi bi-eye me-1"></i>@Model.ViewCount</dd>
                    @if (Model.SourceTicket != null && (User.IsInRole("Admin") || User.IsInRole("IT Agent")))
                    {
                        <dt class="col-5 text-muted">Source Ticket</dt>
                        <dd class="col-7">
                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@Model.SourceTicketId">
                                #@Model.SourceTicketId
                            </a>
                        </dd>
                    }
                </dl>
            </div>
        </div>

        <!-- Still need help? -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <i class="bi bi-headset fs-2 text-primary d-block mb-2"></i>
                <p class="fw-semibold mb-1">Still need help?</p>
                <p class="text-muted small mb-3">Our IT team is here for you.</p>
                @if (User.IsInRole("End User") || !(User.IsInRole("Admin") || User.IsInRole("IT Agent")))
                {
                    <a asp-controller="Portal" asp-action="SubmitTicket" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>Submit a Ticket
                    </a>
                }
                else
                {
                    <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>New Ticket
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function markHelpful(helpful, btn) {
    document.querySelectorAll('.card button').forEach(b => b.disabled = true);
    document.getElementById('helpfulFeedback').style.display = '';
}
</script>
}
