@model KbArticle
@{
    ViewData["Title"] = "Edit KB Article";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="All">Knowledge Base</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>

<h1 class="mb-4"><i class="bi bi-pencil me-2 text-primary"></i>Edit Article</h1>

<form asp-action="Edit" method="post" data-loading-btn="btnSaveArticle">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SourceTicketId" />
    <input type="hidden" asp-for="CreatedBy" />
    <input type="hidden" asp-for="CreatedDate" />
    <input type="hidden" asp-for="ViewCount" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Category" class="form-label fw-semibold">Category</label>
                    <select asp-for="Category" asp-items="@ViewBag.CategorySelectList" class="form-select"></select>
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="isPublished" />
                        <label class="form-check-label fw-semibold" for="isPublished">Published</label>
                        <div class="text-muted small">Uncheck to hide from users.</div>
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="Problem" class="form-label fw-semibold">
                        <i class="bi bi-exclamation-circle text-danger me-1"></i>Problem / Symptom <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Problem" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Problem" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Solution" class="form-label fw-semibold">
                        <i class="bi bi-check-circle text-success me-1"></i>Solution / Resolution Steps <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Solution" class="form-control" rows="8"></textarea>
                    <span asp-validation-for="Solution" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white d-flex gap-2 justify-content-end">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" id="btnSaveArticle" class="btn btn-primary">
                <i class="bi bi-save me-1"></i>Save Changes
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
