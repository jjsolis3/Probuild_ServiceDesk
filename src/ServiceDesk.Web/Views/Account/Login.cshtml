@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_LoginLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4 p-sm-5">
        <!-- Branding -->
        <div class="text-center mb-4">
            <img src="~/images/logo.png" alt="ServiceSphere" class="mb-3" style="max-height:200px;object-fit:contain;" />
            <h4 class="fw-bold mb-0">ServiceSphere</h4>
            <p class="text-muted small">IT Service Desk Portal</p>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0"
                           placeholder="you@company.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label fw-semibold mb-0">Password</label>
                    <a asp-action="ForgotPassword" class="text-muted small">Forgot password?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-lock text-muted"></i>
                    </span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0"
                           placeholder="••••••••" autocomplete="current-password" id="passwordInput" />
                    <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePassword" tabindex="-1">
                        <i class="fas fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small">Keep me signed in</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="fas fa-sign-in-alt me-2"></i>Sign In
            </button>
        </form>

        <hr class="my-4" />
        <div class="text-center text-muted small">
            <p class="mb-1">
                <i class="fas fa-headset me-1"></i>
                IT Staff: use your IT portal credentials
            </p>
            <p class="mb-0">
                <i class="fas fa-user me-1"></i>
                Employees: contact IT to get portal access
            </p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('togglePassword')?.addEventListener('click', function () {
        const input = document.getElementById('passwordInput');
        const icon = document.getElementById('toggleIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    });
</script>
}
