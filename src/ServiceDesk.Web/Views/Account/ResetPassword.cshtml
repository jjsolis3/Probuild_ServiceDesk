@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
    Layout = "_LoginLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4 p-sm-5">
        <!-- Branding -->
        <div class="text-center mb-4">
            <img src="~/images/logo.png" alt="ServiceSphere" class="mb-3" style="max-height:56px;object-fit:contain;" />
            <h4 class="fw-bold mb-0">Set New Password</h4>
            <p class="text-muted small">Choose a strong password for <strong>@Model.Email</strong></p>
        </div>

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-lock text-muted"></i>
                    </span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0"
                           placeholder="Minimum 8 characters" id="passwordInput" />
                    <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePassword" tabindex="-1">
                        <i class="fas fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-lock text-muted"></i>
                    </span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0"
                           placeholder="Repeat your new password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="fas fa-check me-2"></i>Set New Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('togglePassword')?.addEventListener('click', function () {
        const input = document.getElementById('passwordInput');
        const icon = document.getElementById('toggleIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    });
</script>
}
