@model IEnumerable<Subscription>
@{
    ViewData["Title"] = "Subscriptions";
    var currentStatus = ViewBag.CurrentStatus as SubscriptionStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-credit-card"></i> Subscriptions</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Subscription
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <div class="form-label small mb-1">Status</div>
            <input type="hidden" id="subStatusInput" name="status" value="@(currentStatus?.ToString() ?? "")" />
            <div class="dropdown">
                <button type="button" id="subStatusBtn" class="btn btn-outline-secondary btn-sm dropdown-toggle @(currentStatus != null ? "active" : "")" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @(currentStatus?.ToString() ?? "All Statuses")
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:180px;">
                    <button type="button" class="dropdown-item small single-filter-option @(currentStatus == null ? "active" : "")" data-input-id="subStatusInput" data-button-id="subStatusBtn" data-value="" data-label="All Statuses">All Statuses</button>
                    @foreach (var s in Enum.GetValues<SubscriptionStatus>())
                    {
                        <button type="button" class="dropdown-item small single-filter-option @(currentStatus == s ? "active" : "")"
                                data-input-id="subStatusInput" data-button-id="subStatusBtn" data-value="@s" data-label="@s">@s</button>
                    }
                    <hr class="my-2"><button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
                </div>
            </div>
        </div>
        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Clear Filters</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener('click', function (e) {
    const opt = e.target.closest('.single-filter-option');
    if (!opt) return;
    e.preventDefault();
    const input = document.getElementById(opt.dataset.inputId);
    const btn = document.getElementById(opt.dataset.buttonId);
    if (!input || !btn) return;
    input.value = opt.dataset.value ?? '';
    btn.textContent = opt.dataset.label ?? '';
    btn.classList.toggle('active', input.value !== '');
    opt.closest('.dropdown-menu')?.querySelectorAll('.single-filter-option').forEach(x => x.classList.remove('active'));
    opt.classList.add('active');
});
</script>
}

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Subscriptions Report">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Provider</th>
                <th>Status</th>
                <th>License Count</th>
                <th>Licenses Used</th>
                <th>Monthly Cost</th>
                <th>Renewal Date</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sub in Model)
            {
                var badgeClass = sub.Status switch
                {
                    SubscriptionStatus.Active => "bg-success",
                    SubscriptionStatus.Expiring => "bg-warning text-dark",
                    SubscriptionStatus.Expired => "bg-danger",
                    SubscriptionStatus.Cancelled => "bg-secondary",
                    SubscriptionStatus.PendingRenewal => "bg-info text-dark",
                    _ => "bg-secondary"
                };

                var usagePercent = (sub.LicenseCount.HasValue && sub.LicenseCount.Value > 0)
                    ? (int)Math.Round((double)(sub.LicensesUsed ?? 0) / sub.LicenseCount.Value * 100)
                    : 0;

                var progressClass = usagePercent switch
                {
                    >= 90 => "bg-danger",
                    >= 75 => "bg-warning",
                    _ => "bg-success"
                };

                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@sub.Id">@sub.Name</a>
                    </td>
                    <td>@sub.Provider</td>
                    <td><span class="badge @badgeClass">@sub.Status</span></td>
                    <td>@(sub.LicenseCount?.ToString() ?? "N/A")</td>
                    <td>
                        @if (sub.LicenseCount.HasValue && sub.LicenseCount.Value > 0)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 20px; min-width: 80px;">
                                    <div class="progress-bar @progressClass" role="progressbar"
                                         style="width: @(usagePercent)%"
                                         aria-valuenow="@usagePercent" aria-valuemin="0" aria-valuemax="100">
                                        @(sub.LicensesUsed ?? 0) / @sub.LicenseCount
                                    </div>
                                </div>
                                <small class="text-muted">@(usagePercent)%</small>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </td>
                    <td>@sub.MonthlyCost.ToString("C")</td>
                    <td>@(sub.RenewalDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-credit-card display-1"></i>
        <p class="mt-3">No subscriptions found matching the current filters.</p>
    </div>
}
