@model IEnumerable<Subscription>
@{
    ViewData["Title"] = "Subscriptions";
    var selStatuses = (SubscriptionStatus[])(ViewBag.SelectedStatuses ?? Array.Empty<SubscriptionStatus>());

    string FilterLabel(string singular, string plural, int count) =>
        count == 0 ? $"All {plural}" : count == 1 ? $"1 {singular}" : $"{count} {plural}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-credit-card"></i> Subscriptions</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Subscription
    </a>
</div>

<!-- Filters -->
<div class="filter-bar">
    <div class="d-flex flex-wrap gap-2 align-items-end">

        <!-- Status -->
        <div>
            <div class="form-label small mb-1">Status</div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle @(selStatuses.Length > 0 ? "active" : "")"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    @FilterLabel("Status", "Statuses", selStatuses.Length)
                </button>
                <div class="dropdown-menu p-2 shadow" style="min-width:180px;">
                    @foreach (var s in Enum.GetValues<SubscriptionStatus>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="statuses"
                                   value="@s" id="fs_@s" @(selStatuses.Contains(s) ? "checked" : "")>
                            <label class="form-check-label small" for="fs_@s">@s</label>
                        </div>
                    }
                    <hr class="my-2"><button type="button" class="btn btn-primary btn-sm w-100" onclick="applyFilters()">Apply</button>
                </div>
            </div>
        </div>

        <div class="align-self-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </a>
        </div>

        <div class="align-self-end ms-auto">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="subscriptionKeywordSearch" class="form-control" placeholder="Search subscriptions..."
                       value="@((string?)ViewBag.CurrentQuery ?? "")"
                       onkeydown="if(event.key==='Enter'){event.preventDefault();applyFilters();}">
                <button type="button" class="btn btn-outline-primary" onclick="applyFilters()">Search</button>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover ss-datatable" data-export-title="Subscriptions Report">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Provider</th>
                <th>Status</th>
                <th>License Count</th>
                <th>Licenses Used</th>
                <th>Monthly Cost</th>
                <th>Renewal Date</th>
                <th class="no-sort no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sub in Model)
            {
                var badgeClass = sub.Status switch
                {
                    SubscriptionStatus.Active => "bg-success",
                    SubscriptionStatus.Expiring => "bg-warning text-dark",
                    SubscriptionStatus.Expired => "bg-danger",
                    SubscriptionStatus.Cancelled => "bg-secondary",
                    SubscriptionStatus.PendingRenewal => "bg-info text-dark",
                    _ => "bg-secondary"
                };

                var usagePercent = (sub.LicenseCount.HasValue && sub.LicenseCount.Value > 0)
                    ? (int)Math.Round((double)(sub.LicensesUsed ?? 0) / sub.LicenseCount.Value * 100)
                    : 0;

                var progressClass = usagePercent switch
                {
                    >= 90 => "bg-danger",
                    >= 75 => "bg-warning",
                    _ => "bg-success"
                };

                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@sub.Id">@sub.Name</a>
                    </td>
                    <td>@sub.Provider</td>
                    <td><span class="badge @badgeClass">@sub.Status</span></td>
                    <td>@(sub.LicenseCount?.ToString() ?? "N/A")</td>
                    <td>
                        @if (sub.LicenseCount.HasValue && sub.LicenseCount.Value > 0)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 20px; min-width: 80px;">
                                    <div class="progress-bar @progressClass" role="progressbar"
                                         style="width: @(usagePercent)%"
                                         aria-valuenow="@usagePercent" aria-valuemin="0" aria-valuemax="100">
                                        @(sub.LicensesUsed ?? 0) / @sub.LicenseCount
                                    </div>
                                </div>
                                <small class="text-muted">@(usagePercent)%</small>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </td>
                    <td>@sub.MonthlyCost.ToString("C")</td>
                    <td>@(sub.RenewalDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-credit-card display-1"></i>
        <p class="mt-3">No subscriptions found matching the current filters.</p>
    </div>
}

<script>
function applyFilters() {
    const params = new URLSearchParams();
    document.querySelectorAll('input[name="statuses"]:checked').forEach(cb => params.append('statuses', cb.value));
    const q = document.getElementById('subscriptionKeywordSearch').value.trim();
    if (q) params.set('q', q);
    window.location.href = '@Url.Action("Index", "Subscriptions")?' + params.toString();
}
</script>
