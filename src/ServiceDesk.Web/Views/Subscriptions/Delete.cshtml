@model Subscription
@{
    ViewData["Title"] = "Delete Subscription";

    var badgeClass = Model.Status switch
    {
        SubscriptionStatus.Active => "bg-success",
        SubscriptionStatus.Expiring => "bg-warning text-dark",
        SubscriptionStatus.Expired => "bg-danger",
        SubscriptionStatus.Cancelled => "bg-secondary",
        SubscriptionStatus.PendingRenewal => "bg-info text-dark",
        _ => "bg-secondary"
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Subscriptions</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></li>
        <li class="breadcrumb-item active">Delete</li>
    </ol>
</nav>

<h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Subscription</h1>
<h3>Are you sure you want to delete this subscription?</h3>

<div class="card mt-3" style="max-width: 600px;">
    <div class="card-body">
        <dl>
            <dt>Name</dt>
            <dd>@Model.Name</dd>

            <dt>Provider</dt>
            <dd>@Model.Provider</dd>

            <dt>Status</dt>
            <dd><span class="badge @badgeClass">@Model.Status</span></dd>

            <dt>Monthly Cost</dt>
            <dd>@Model.MonthlyCost.ToString("C")</dd>

            <dt>License Count</dt>
            <dd>@(Model.LicenseCount?.ToString() ?? "N/A")</dd>

            <dt>Start Date</dt>
            <dd>@Model.StartDate.ToString("MMM dd, yyyy")</dd>

            <dt>Renewal Date</dt>
            <dd>@(Model.RenewalDate?.ToString("MMM dd, yyyy") ?? "N/A")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
