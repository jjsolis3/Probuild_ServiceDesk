@model IEnumerable<EmployeeTaskTemplate>
@using ServiceDesk.Core.Enums
@{
    ViewData["Title"] = "Employee Checklist Templates";
    var onboarding = Model.Where(t => t.TaskType == EmployeeTaskType.Onboarding).ToList();
    var offboarding = Model.Where(t => t.TaskType == EmployeeTaskType.Offboarding).ToList();
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Settings" asp-action="Index">Settings</a></li>
        <li class="breadcrumb-item active">Employee Checklist Templates</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="fs-3 fw-bold mb-1"><i class="bi bi-list-check text-primary me-2"></i>Employee Checklists</h1>
        <div class="text-muted small">
            Reusable checklist items that can be applied to any employee's onboarding or offboarding workflow.
        </div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newTemplateModal">
        <i class="bi bi-plus-lg"></i> New Template
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-3">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-3">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@{
    async Task RenderGroup(string title, string icon, string badge, List<EmployeeTaskTemplate> list)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi @icon me-2"></i>@title</span>
                <span class="badge @badge">@list.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!list.Any())
                {
                    <p class="text-muted small m-3 mb-0">No templates yet. Click "New Template" to add one.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">Order</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Default Assignee</th>
                                    <th>Due (days)</th>
                                    <th>Active</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in list)
                                {
                                    <tr>
                                        <td class="text-muted">@t.SortOrder</td>
                                        <td>
                                            <div class="fw-semibold">@t.Title</div>
                                            @if (!string.IsNullOrEmpty(t.Description))
                                            { <div class="small text-muted">@t.Description</div> }
                                        </td>
                                        <td class="small">@(t.Category ?? "—")</td>
                                        <td class="small">@(t.DefaultAssigneeEmail ?? "—")</td>
                                        <td class="small">@(t.DueInDays?.ToString() ?? "—")</td>
                                        <td>
                                            @if (t.IsActive)
                                            { <span class="badge bg-success">Active</span> }
                                            else
                                            { <span class="badge bg-secondary">Inactive</span> }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-link btn-sm p-0 me-2" data-bs-toggle="modal" data-bs-target="#editTemplate_@t.Id" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form asp-action="DeleteTemplate" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this template?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}

@{ await RenderGroup("Onboarding", "bi-person-plus", "bg-primary", onboarding); }
@{ await RenderGroup("Offboarding", "bi-person-dash", "bg-warning text-dark", offboarding); }

<!-- New Template Modal -->
<div class="modal fade" id="newTemplateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateTemplate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-lg me-2"></i>New Checklist Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Checklist Type</label>
                        <select name="TaskType" class="form-select" required>
                            <option value="@EmployeeTaskType.Onboarding">Onboarding</option>
                            <option value="@EmployeeTaskType.Offboarding">Offboarding</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Title</label>
                        <input name="Title" class="form-control" maxlength="200" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="2" maxlength="1000"></textarea>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Category</label>
                            <input name="Category" class="form-control" maxlength="100" placeholder="IT, HR, Facilities…" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Default Assignee Email</label>
                            <input name="DefaultAssigneeEmail" class="form-control" maxlength="200" type="email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Due In (days from hire/termination)</label>
                            <input name="DueInDays" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Sort Order</label>
                            <input name="SortOrder" class="form-control" type="number" value="100" />
                        </div>
                    </div>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="newTplActive" />
                        <label class="form-check-label small" for="newTplActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create Template</button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var t in Model)
{
    <div class="modal fade" id="editTemplate_@t.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="UpdateTemplate" asp-route-id="@t.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Template</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Checklist Type</label>
                            <select name="TaskType" class="form-select">
                                <option value="@EmployeeTaskType.Onboarding" selected="@(t.TaskType == EmployeeTaskType.Onboarding)">Onboarding</option>
                                <option value="@EmployeeTaskType.Offboarding" selected="@(t.TaskType == EmployeeTaskType.Offboarding)">Offboarding</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Title</label>
                            <input name="Title" class="form-control" maxlength="200" value="@t.Title" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Description</label>
                            <textarea name="Description" class="form-control" rows="2" maxlength="1000">@t.Description</textarea>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Category</label>
                                <input name="Category" class="form-control" maxlength="100" value="@t.Category" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Default Assignee Email</label>
                                <input name="DefaultAssigneeEmail" class="form-control" type="email" maxlength="200" value="@t.DefaultAssigneeEmail" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Due In (days)</label>
                                <input name="DueInDays" class="form-control" type="number" min="0" value="@t.DueInDays" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Sort Order</label>
                                <input name="SortOrder" class="form-control" type="number" value="@t.SortOrder" />
                            </div>
                        </div>
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(t.IsActive ? "checked" : "") id="tplActive_@t.Id" />
                            <label class="form-check-label small" for="tplActive_@t.Id">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
