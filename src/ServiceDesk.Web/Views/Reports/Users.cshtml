@model ServiceDesk.Web.Models.UserReportViewModel
@{
    ViewData["Title"] = "User Reports";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active">User Reports</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0"><i class="bi bi-people"></i> User Reports</h1>
    <button onclick="ssExport.show('ss-export-target','User Reports')" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-file-earmark-pdf me-1"></i>Export / Print
    </button>
</div>

<div id="ss-export-target">
<!-- User Stats Table -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-person-lines-fill"></i> User Ticket Statistics
    </div>
    <div class="card-body p-0">
        @if (Model.UserStats.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 ss-datatable-compact">
                    <thead class="table-dark">
                        <tr>
                            <th>Employee Name</th>
                            <th>Branch / Location</th>
                            <th>Department</th>
                            <th class="text-end">Tickets Submitted</th>
                            <th class="text-end">Open</th>
                            <th class="text-end">Resolved</th>
                            <th class="text-end">Assets Assigned</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.UserStats)
                        {
                            <tr>
                                <td>@user.EmployeeName</td>
                                <td><span class="badge bg-light text-dark border">@user.Branch</span></td>
                                <td>@user.Department</td>
                                <td class="text-end">@user.TicketsSubmitted</td>
                                <td class="text-end">
                                    @if (user.TicketsOpen > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@user.TicketsOpen</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (user.TicketsResolved > 0)
                                    {
                                        <span class="badge bg-success">@user.TicketsResolved</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td class="text-end">@user.AssetsAssigned</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-people display-4"></i>
                <p class="mt-2">No user data available.</p>
            </div>
        }
    </div>
</div>

<!-- Tickets by Department -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-building"></i> Tickets by Department
    </div>
    <div class="card-body">
        @if (Model.TicketsByDepartment.Any())
        {
            var maxDept = Model.TicketsByDepartment.Values.Max();
            @foreach (var item in Model.TicketsByDepartment)
            {
                var percent = maxDept > 0 ? (int)((double)item.Value / maxDept * 100) : 0;
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>@item.Key</span>
                        <span class="fw-bold">@item.Value</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-info" role="progressbar" style="width: @(percent)%"
                             aria-valuenow="@item.Value" aria-valuemin="0" aria-valuemax="@maxDept"></div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted text-center">No department data available.</p>
        }
    </div>
</div>
<!-- Tickets by Branch -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-geo-alt"></i> Tickets by Branch / Location
    </div>
    <div class="card-body">
        @if (Model.TicketsByBranch.Any())
        {
            var maxBranch = Model.TicketsByBranch.Values.Max();
            @foreach (var item in Model.TicketsByBranch.OrderByDescending(x => x.Value))
            {
                var percent = maxBranch > 0 ? (int)((double)item.Value / maxBranch * 100) : 0;
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="bi bi-building me-1 text-muted"></i>@item.Key</span>
                        <span class="fw-bold">@item.Value</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(percent)%"
                             aria-valuenow="@item.Value" aria-valuemin="0" aria-valuemax="@maxBranch"></div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted text-center">No branch data available. Assign branches to employees in their profile.</p>
        }
    </div>
</div>
</div><!-- /ss-export-target -->
