@model ServiceDesk.Web.Models.AssetReportViewModel
@{
    ViewData["Title"] = "Asset Reports";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active">Asset Reports</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0"><i class="bi bi-laptop"></i> Asset Reports</h1>
    <button onclick="ssExport.show('ss-export-target','Asset Reports')" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-file-earmark-pdf me-1"></i>Export / Print
    </button>
</div>

<div id="ss-export-target">
<!-- Summary Row -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Total Assets</div>
                <div class="report-stat text-primary">@Model.TotalAssets</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Total Value</div>
                <div class="report-stat text-success">@Model.TotalValue.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- By Type -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-grid"></i> Assets by Type
            </div>
            <div class="card-body p-0">
                @if (Model.ByType.Any())
                {
                    <table class="table table-striped table-hover mb-0 ss-datatable-compact">
                        <thead class="table-light">
                            <tr>
                                <th>Type</th>
                                <th class="text-end">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ByType)
                            {
                                <tr>
                                    <td>@item.Key</td>
                                    <td class="text-end fw-bold">@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center text-muted py-4">No data available.</div>
                }
            </div>
        </div>
    </div>

    <!-- By Status -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-check2-circle"></i> Assets by Status
            </div>
            <div class="card-body p-0">
                @if (Model.ByStatus.Any())
                {
                    <table class="table table-striped table-hover mb-0 ss-datatable-compact">
                        <thead class="table-light">
                            <tr>
                                <th>Status</th>
                                <th class="text-end">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ByStatus)
                            {
                                var badgeClass = item.Key switch
                                {
                                    AssetStatus.Available => "bg-success",
                                    AssetStatus.Assigned => "bg-primary",
                                    AssetStatus.InRepair => "bg-warning text-dark",
                                    AssetStatus.Retired => "bg-secondary",
                                    AssetStatus.Lost => "bg-danger",
                                    AssetStatus.Disposed => "bg-dark",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td><span class="badge @badgeClass">@item.Key</span></td>
                                    <td class="text-end fw-bold">@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center text-muted py-4">No data available.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Expiring Warranties -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-exclamation-triangle text-warning"></i> Expiring Warranties
    </div>
    <div class="card-body p-0">
        @if (Model.ExpiringWarranties.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 ss-datatable-compact">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Asset Tag</th>
                            <th>Warranty Expiry</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in Model.ExpiringWarranties)
                        {
                            var isExpired = asset.WarrantyExpiry.HasValue && asset.WarrantyExpiry.Value < DateTime.Today;
                            <tr class="@(isExpired ? "table-danger" : "")">
                                <td>
                                    <a asp-controller="Assets" asp-action="Details" asp-route-id="@asset.Id">
                                        @asset.Name
                                    </a>
                                </td>
                                <td><code>@asset.AssetTag</code></td>
                                <td>
                                    @if (asset.WarrantyExpiry.HasValue)
                                    {
                                        @asset.WarrantyExpiry.Value.ToString("MMM dd, yyyy")
                                        @if (isExpired)
                                        {
                                            <span class="badge bg-danger ms-1">Expired</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <p>No warranties expiring soon.</p>
            </div>
        }
    </div>
</div>

<!-- By Department -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-building"></i> Assets by Department
    </div>
    <div class="card-body p-0">
        @if (Model.ByDepartment.Any())
        {
            <table class="table table-striped table-hover mb-0 ss-datatable-compact">
                <thead class="table-light">
                    <tr>
                        <th>Department</th>
                        <th class="text-end">Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ByDepartment)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td class="text-end fw-bold">@item.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center text-muted py-4">No data available.</div>
        }
    </div>
</div>
</div><!-- /ss-export-target -->
