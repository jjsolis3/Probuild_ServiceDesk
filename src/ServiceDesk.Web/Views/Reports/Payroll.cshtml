@model IEnumerable<ServiceDesk.Core.Models.PayrollReceipt>
@{
    ViewData["Title"] = "Payroll Report";
    var fromDate = (DateTime)ViewBag.FilterFrom;
    var toDate   = (DateTime)ViewBag.FilterTo;
    var contractors = ViewBag.Contractors as IEnumerable<ServiceDesk.Core.Models.Employee>
                      ?? Enumerable.Empty<ServiceDesk.Core.Models.Employee>();
    var byContractor = ((dynamic)ViewBag.ByContractor) as System.Collections.IEnumerable;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active">Payroll</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1><i class="bi bi-cash-stack text-warning"></i> Contractor Payroll Report</h1>
        <p class="text-muted mb-0">Aggregated view of contractor receipts within the selected window. Shows Standard vs. Emergency breakdown plus retainer burn-down.</p>
    </div>
    <a asp-action="PayrollExport"
       asp-route-from="@fromDate.ToString("yyyy-MM-dd")"
       asp-route-to="@toDate.ToString("yyyy-MM-dd")"
       asp-route-contractorId="@ViewBag.FilterContractorId"
       asp-route-rateType="@ViewBag.FilterRateType"
       asp-route-status="@ViewBag.FilterStatus"
       class="btn btn-success">
        <i class="bi bi-file-earmark-excel"></i> Export to Excel
    </a>
</div>

<!-- Filter form -->
<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Payroll" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">From</label>
                <input type="date" name="from" class="form-control form-control-sm"
                       value="@fromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">To</label>
                <input type="date" name="to" class="form-control form-control-sm"
                       value="@toDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Contractor</label>
                <select name="contractorId" class="form-select form-select-sm">
                    <option value="">All Contractors</option>
                    @foreach (var c in contractors)
                    {
                        var sel = (ViewBag.FilterContractorId as int?) == c.Id;
                        <option value="@c.Id" selected="@sel">@c.FirstName @c.LastName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Rate Type</label>
                <select name="rateType" class="form-select form-select-sm">
                    <option value="">Any</option>
                    <option value="StandardOnly" selected="@((ViewBag.FilterRateType as string) == "StandardOnly")">Standard Only</option>
                    <option value="HasEmergency" selected="@((ViewBag.FilterRateType as string) == "HasEmergency")">Has Emergency</option>
                    <option value="HasRetainer"  selected="@((ViewBag.FilterRateType as string) == "HasRetainer")">Has Retainer</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="Submitted" selected="@((ViewBag.FilterStatus as string) == "Submitted")">Submitted</option>
                    <option value="Approved"  selected="@((ViewBag.FilterStatus as string) == "Approved")">Approved</option>
                    <option value="Paid"      selected="@((ViewBag.FilterStatus as string) == "Paid")">Paid</option>
                    <option value="Draft"     selected="@((ViewBag.FilterStatus as string) == "Draft")">Draft</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel"></i> Apply
                </button>
            </div>
        </form>
    </div>
</div>

<!-- KPI tiles -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Receipts in Window</div>
                <div class="h3 mb-0 text-primary">@ViewBag.TotalReceipts</div>
                <div class="small text-muted">@ViewBag.TotalContractors contractor(s)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Total Hours</div>
                <div class="h3 mb-0">
                    @(((decimal)ViewBag.TotalStandardHours + (decimal)ViewBag.TotalEmergencyHours).ToString("0.##"))h
                </div>
                <div class="small text-muted">
                    Std @(((decimal)ViewBag.TotalStandardHours).ToString("0.##"))h
                    · <span class="text-danger">Emerg @(((decimal)ViewBag.TotalEmergencyHours).ToString("0.##"))h</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Retainer Applied</div>
                <div class="h3 mb-0 text-info">@(((decimal)ViewBag.TotalRetainerAmount).ToString("C"))</div>
                <div class="small text-muted">@(((decimal)ViewBag.TotalRetainerHours).ToString("0.##"))h covered</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Total Amount</div>
                <div class="h3 mb-0 text-success">@(((decimal)ViewBag.TotalAmount).ToString("C"))</div>
                <div class="small text-muted">
                    Paid @(((decimal)ViewBag.PaidAmount).ToString("C"))
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status breakdown -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-warning shadow-sm h-100">
            <div class="card-body">
                <div class="text-warning small fw-semibold"><i class="bi bi-hourglass-split"></i> Pending (Submitted)</div>
                <div class="h4 mb-0">@(((decimal)ViewBag.PendingAmount).ToString("C"))</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-info shadow-sm h-100">
            <div class="card-body">
                <div class="text-info small fw-semibold"><i class="bi bi-check2-circle"></i> Approved (Unpaid)</div>
                <div class="h4 mb-0">@(((decimal)ViewBag.ApprovedAmount).ToString("C"))</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-success shadow-sm h-100">
            <div class="card-body">
                <div class="text-success small fw-semibold"><i class="bi bi-cash"></i> Paid</div>
                <div class="h4 mb-0">@(((decimal)ViewBag.PaidAmount).ToString("C"))</div>
            </div>
        </div>
    </div>
</div>

<!-- Per-contractor roll-up -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <strong>By Contractor</strong>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Contractor</th>
                    <th class="text-end">Receipts</th>
                    <th class="text-end">Std Hrs</th>
                    <th class="text-end">Emerg Hrs</th>
                    <th class="text-end">Retainer</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Paid</th>
                </tr>
            </thead>
            <tbody>
                @if (byContractor != null)
                {
                    foreach (dynamic c in byContractor)
                    {
                        <tr>
                            <td>@c.ContractorName</td>
                            <td class="text-end">@c.ReceiptCount</td>
                            <td class="text-end">@(((decimal)c.StandardHours).ToString("0.##"))h</td>
                            <td class="text-end text-danger">@(((decimal)c.EmergencyHours).ToString("0.##"))h</td>
                            <td class="text-end text-info">@(((decimal)c.RetainerApplied).ToString("C"))</td>
                            <td class="text-end fw-semibold">@(((decimal)c.TotalAmount).ToString("C"))</td>
                            <td class="text-end text-success">@(((decimal)c.PaidAmount).ToString("C"))</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-4">
            <i class="bi bi-inbox display-4 opacity-25 d-block mb-2"></i>
            No receipts match the current filters.
        </div>
    }
</div>

<!-- Receipt detail -->
@if (Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <strong>Receipts</strong>
            <span class="small text-muted">@Model.Count() receipt(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Contractor</th>
                        <th>Period</th>
                        <th>Status</th>
                        <th class="text-end">Std h × $</th>
                        <th class="text-end">Emerg h × $</th>
                        <th class="text-end">Retainer</th>
                        <th class="text-end">Total</th>
                        <th>Approver</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.Id</td>
                            <td>@r.Contractor?.FirstName @r.Contractor?.LastName</td>
                            <td class="small text-nowrap">
                                @r.PeriodStart.ToString("MMM d") – @r.PeriodEnd.ToString("MMM d, yyyy")
                            </td>
                            <td>
                                @if (r.Status == "Paid")
                                { <span class="badge bg-success">Paid</span> }
                                else if (r.Status == "Approved")
                                { <span class="badge bg-info text-dark">Approved</span> }
                                else if (r.Status == "Submitted")
                                { <span class="badge bg-warning text-dark">Submitted</span> }
                                else
                                { <span class="badge bg-secondary">@r.Status</span> }
                            </td>
                            <td class="text-end small">
                                @r.TotalStandardHours.ToString("0.##")h × @r.HourlyRateSnapshot.ToString("C0")
                            </td>
                            <td class="text-end small text-danger">
                                @if (r.TotalEmergencyHours > 0)
                                {
                                    @($"{r.TotalEmergencyHours:0.##}h × {(r.EmergencyRateSnapshot ?? 0):C0}")
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end small text-info">
                                @if (r.TotalRetainerAmountApplied > 0)
                                {
                                    @r.TotalRetainerAmountApplied.ToString("C")
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@r.TotalAmount.ToString("C")</td>
                            <td class="small text-muted">
                                @if (r.ApprovedBy != null)
                                {
                                    @($"{r.ApprovedBy.FirstName} {r.ApprovedBy.LastName}")
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
