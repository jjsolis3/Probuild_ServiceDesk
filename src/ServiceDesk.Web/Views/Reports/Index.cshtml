@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-graph-up"></i> Reports</h1>
</div>

<div class="row g-4">
    <!-- Executive Dashboard -->
    <div class="col-md-12 col-lg-12 mb-2">
        <div class="card h-100 shadow-sm border-0" style="background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);color:#fff;">
            <div class="card-body d-flex align-items-center gap-4 py-4">
                <i class="bi bi-speedometer2 display-4 opacity-75"></i>
                <div class="flex-grow-1">
                    <h4 class="card-title mb-1 fw-bold">Executive Dashboard</h4>
                    <p class="card-text mb-0" style="opacity:.85;">
                        Key performance metrics for leadership: MTTR, MTTA, SLA compliance, backlog aging, agent workload, and AI triage effectiveness — all in one view.
                    </p>
                </div>
                <a asp-action="Executive" class="btn btn-light fw-semibold text-primary px-4 flex-shrink-0">
                    <i class="bi bi-arrow-right-circle me-1"></i> Open Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-0">
    <!-- Ticket Reports -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-ticket-detailed display-3 text-primary mb-3"></i>
                <h4 class="card-title">Ticket Reports</h4>
                <p class="card-text text-muted">
                    View ticket statistics including volume by status, category, priority, and assignee performance metrics.
                </p>
            </div>
            <div class="card-footer bg-transparent border-top-0 text-center pb-3">
                <a asp-action="Tickets" class="btn btn-primary">
                    <i class="bi bi-arrow-right-circle"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Asset Reports -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-laptop display-3 text-success mb-3"></i>
                <h4 class="card-title">Asset Reports</h4>
                <p class="card-text text-muted">
                    Review asset inventory summaries, total valuation, warranty expiration tracking, and distribution by department.
                </p>
            </div>
            <div class="card-footer bg-transparent border-top-0 text-center pb-3">
                <a asp-action="Assets" class="btn btn-success">
                    <i class="bi bi-arrow-right-circle"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- User Reports -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-people display-3 text-info mb-3"></i>
                <h4 class="card-title">User Reports</h4>
                <p class="card-text text-muted">
                    Analyze user activity including tickets submitted, resolution rates, and department-level ticket breakdowns.
                </p>
            </div>
            <div class="card-footer bg-transparent border-top-0 text-center pb-3">
                <a asp-action="Users" class="btn btn-info text-white">
                    <i class="bi bi-arrow-right-circle"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Store Orders Report -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-bag-check display-3 mb-3" style="color:#0dcaf0;"></i>
                <h4 class="card-title">Store Orders</h4>
                <p class="card-text text-muted">
                    View and manage quarterly store orders, see product totals by quarter, update order status, and export a CSV for the operations team.
                </p>
            </div>
            <div class="card-footer bg-transparent border-top-0 text-center pb-3">
                <a asp-action="StoreOrders" class="btn text-white" style="background-color:#0dcaf0;">
                    <i class="bi bi-arrow-right-circle"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Contractor Payroll Report -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-cash-stack display-3 text-warning mb-3"></i>
                <h4 class="card-title">Contractor Payroll</h4>
                <p class="card-text text-muted">
                    Aggregate contractor pay across a date range — Standard vs. Emergency hours, retainer burn-down, and Paid/Approved/Pending totals. Excel export for AP review.
                </p>
            </div>
            <div class="card-footer bg-transparent border-top-0 text-center pb-3">
                <a asp-action="Payroll" class="btn btn-warning">
                    <i class="bi bi-arrow-right-circle"></i> View Report
                </a>
            </div>
        </div>
    </div>
</div>
