@model ServiceDesk.Web.Models.TicketReportViewModel
@{
    ViewData["Title"] = "Ticket Reports";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active">Ticket Reports</li>
    </ol>
</nav>

<h1><i class="bi bi-ticket-detailed"></i> Ticket Reports</h1>

<!-- Summary Row -->
<div class="row g-3">
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 kpi-clickable" data-kpi-type="total" role="button" title="View all tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Total Tickets</div>
                <div class="report-stat text-primary" style="font-size: x-large">@Model.TotalTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 kpi-clickable" data-kpi-type="open" role="button" title="View Open tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Open</div>
                <div class="report-stat text-info" style="font-size: x-large">@Model.OpenTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 kpi-clickable" data-kpi-type="inprogress" role="button" title="View In Progress tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">In Progress</div>
                <div class="report-stat text-warning" style="font-size: x-large">@Model.InProgressTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 kpi-clickable" data-kpi-type="resolved" role="button" title="View Resolved tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Resolved</div>
                <div class="report-stat text-success" style="font-size: x-large">@Model.ResolvedTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 kpi-clickable" data-kpi-type="closed" role="button" title="View Closed tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Closed</div>
                <div class="report-stat text-secondary" style="font-size: x-large">@Model.ClosedTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 kpi-clickable" data-kpi-type="avgresolution" role="button" title="Average time to resolve a ticket">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Avg Resolution <i class="bi bi-info-circle" data-bs-toggle="tooltip" data-bs-placement="top" title="Average hours from ticket creation to resolution"></i></div>
                <div class="report-stat text-dark" style="font-size: x-large">@Model.AverageResolutionHours.ToString("F1")h</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <!-- Monthly Trend Line -->
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header fw-semibold"><i class="bi bi-graph-up me-1"></i> Monthly Ticket Volume</div>
            <div class="card-body">
                <div id="chartMonthlyTrend"></div>
            </div>
        </div>
    </div>
    <!-- Category Donut -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold"><i class="bi bi-tag me-1"></i> By Category</div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="chartCategoryDonut" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- By Category -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-tag"></i> Tickets by Category
            </div>
            <div class="card-body">
                @if (Model.ByCategory.Any())
                {
                    var maxCategory = Model.ByCategory.Values.Max();
                    @foreach (var item in Model.ByCategory)
                    {
                        var percent = maxCategory > 0 ? (int)((double)item.Value / maxCategory * 100) : 0;
                        <div class="mb-3 row-clickable" data-category="@item.Key" data-category-label="@item.Key.GetDisplayName()" role="button" title="View @item.Key.GetDisplayName() tickets">
                            <div class="d-flex justify-content-between mb-1">
                                <span>@item.Key.GetDisplayName()</span>
                                <span class="fw-bold">@item.Value</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @(percent)%"
                                     aria-valuenow="@item.Value" aria-valuemin="0" aria-valuemax="@maxCategory"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center">No data available.</p>
                }
            </div>
        </div>
    </div>

    <!-- By Priority -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-flag"></i> Tickets by Priority
            </div>
            <div class="card-body">
                @if (Model.ByPriority.Any())
                {
                    <table class="table table-hover mb-0 ss-datatable-compact">
                        <thead class="table-light">
                            <tr>
                                <th>Priority</th>
                                <th class="text-end">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ByPriority)
                            {
                                var badgeClass = item.Key switch
                                {
                                    TicketPriority.Low => "bg-info",
                                    TicketPriority.Medium => "bg-primary",
                                    TicketPriority.High => "bg-warning text-dark",
                                    TicketPriority.Critical => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                <tr class="row-clickable" data-priority="@item.Key" role="button" title="View @item.Key priority tickets">
                                    <td><span class="badge @badgeClass">@item.Key</span></td>
                                    <td class="text-end fw-bold">@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted text-center">No data available.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Top Assignees -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-person-badge"></i> Top Assignees
    </div>
    <div class="card-body p-0">
        @if (Model.TopAssignees.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 ss-datatable-compact">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th class="text-end">Total Assigned</th>
                            <th class="text-end">Resolved</th>
                            <th class="text-end">Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignee in Model.TopAssignees)
                        {
                            <tr class="row-clickable" data-assignee="@assignee.Name"
                                role="button" title="View tickets assigned to @assignee.Name">
                                <td><i class="bi bi-person-circle text-muted me-1"></i>@assignee.Name</td>
                                <td class="text-end fw-bold">@assignee.TotalAssigned</td>
                                <td class="text-end"><span class="text-success fw-bold">@assignee.Resolved</span></td>
                                <td class="text-end"><span class="text-warning fw-bold">@assignee.Open</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <p>No assignee data available.</p>
            </div>
        }
    </div>
</div>

<!-- Reusable Report Detail Modal -->
<div class="modal fade" id="reportDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reportModalTitle">...</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-4" id="reportModalLoading">
                    <div class="spinner-border text-primary"></div><p class="mt-2">Loading...</p>
                </div>
                <div class="table-responsive" id="reportModalTable" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <a id="reportModalLink" href="/Tickets" class="btn btn-primary"><i class="bi bi-box-arrow-up-right"></i> View All Tickets</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.css" />
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    // Monthly Trend Line
    var trendEl = document.getElementById('chartMonthlyTrend');
    if (trendEl) {
        var monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByMonth.Keys.ToList()));
        var monthlyCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByMonth.Values.ToList()));
        new ApexCharts(trendEl, {
            series: [{ name: 'Tickets', data: monthlyCounts }],
            chart: { type: 'area', height: 220, toolbar: { show: false } },
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 2 },
            fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.0 } },
            xaxis: { categories: monthlyLabels, labels: { rotate: -35, style: { fontSize: '10px' } } },
            yaxis: { min: 0, labels: { style: { fontSize: '11px' } } },
            colors: ['#2f4cdd'],
            grid: { borderColor: '#f1f1f1' },
            tooltip: { y: { formatter: function(val) { return val + ' tickets'; } } }
        }).render();
    }

    // Category Donut — segments clickable to open modal
    var donutEl = document.getElementById('chartCategoryDonut');
    if (donutEl) {
        var catLabels  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByCategory.Keys.Select(k => k.GetDisplayName()).ToList()));
        var catKeys    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByCategory.Keys.Select(k => k.ToString()).ToList()));
        var catCounts  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByCategory.Values.ToList()));
        var hasData = catCounts.some(function(v) { return v > 0; });
        if (hasData) {
            var donutChart = new ApexCharts(donutEl, {
                series: catCounts,
                chart: {
                    type: 'donut', height: 250,
                    events: {
                        dataPointSelection: function (event, chartCtx, opts) {
                            var idx = opts.dataPointIndex;
                            if (idx < 0 || idx >= catKeys.length) return;
                            showModal(
                                catLabels[idx] + ' Tickets',
                                '/Reports/TicketsByCategory?category=' + encodeURIComponent(catKeys[idx]),
                                '/Tickets?category=' + encodeURIComponent(catKeys[idx])
                            );
                        }
                    }
                },
                labels: catLabels,
                legend: { position: 'bottom', fontSize: '11px' },
                dataLabels: { enabled: false },
                plotOptions: { pie: { donut: { size: '60%' } } },
                tooltip: { y: { formatter: function(val) { return val + ' tickets'; } } }
            });
            donutChart.render();
            donutEl.style.cursor = 'pointer';
        } else {
            donutEl.innerHTML = '<p class="text-muted text-center py-4 small">No ticket data yet.</p>';
        }
    }
});
</script>
<style>
    .kpi-clickable {
        cursor: pointer;
        transition: box-shadow 0.2s, transform 0.15s;
    }
    .kpi-clickable:hover {
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
        transform: translateY(-2px);
    }
    .row-clickable {
        cursor: pointer;
        transition: background-color 0.15s;
    }
    .row-clickable:hover {
        background-color: rgba(var(--bs-primary-rgb), 0.08);
    }
    tr.row-clickable:hover > td {
        background-color: rgba(var(--bs-primary-rgb), 0.08);
    }
</style>
<script>
(function () {
    // Initialize Bootstrap tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.forEach(function (el) {
        new bootstrap.Tooltip(el);
    });

    var modalEl = document.getElementById('reportDetailModal');
    var modal = new bootstrap.Modal(modalEl);
    var modalTitle = document.getElementById('reportModalTitle');
    var modalLoading = document.getElementById('reportModalLoading');
    var modalTable = document.getElementById('reportModalTable');
    var modalLink = document.getElementById('reportModalLink');

    // Priority badge mapping
    var priorityBadges = {
        'Low': 'bg-info',
        'Medium': 'bg-primary',
        'High': 'bg-warning text-dark',
        'Critical': 'bg-danger'
    };

    // Status badge mapping
    var statusBadges = {
        'Open': 'bg-primary',
        'InProgress': 'bg-warning text-dark',
        'Resolved': 'bg-success',
        'Closed': 'bg-secondary'
    };

    function getPriorityBadge(priority) {
        var cls = priorityBadges[priority] || 'bg-secondary';
        return '<span class="badge ' + cls + '">' + escapeHtml(priority) + '</span>';
    }

    function getStatusBadge(status) {
        var cls = statusBadges[status] || 'bg-secondary';
        var display = status === 'InProgress' ? 'In Progress' : status;
        return '<span class="badge ' + cls + '">' + escapeHtml(display) + '</span>';
    }

    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    function formatDate(dateStr) {
        if (!dateStr) return '';
        var d = new Date(dateStr);
        if (isNaN(d.getTime())) return escapeHtml(dateStr);
        return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function buildTicketTable(tickets) {
        if (!tickets || tickets.length === 0) {
            return '<p class="text-muted text-center py-3">No tickets found.</p>';
        }
        var html = '<table class="table table-sm table-striped table-hover mb-0">';
        html += '<thead class="table-light"><tr>';
        html += '<th>ID</th><th>Title</th><th>Category</th><th>Priority</th><th>Status</th><th>Submitted By</th><th>Assigned To</th><th>Created</th>';
        html += '</tr></thead><tbody>';
        tickets.forEach(function (t) {
            html += '<tr>';
            html += '<td><a href="/Tickets/Details/' + t.id + '">#' + t.id + '</a></td>';
            html += '<td>' + escapeHtml(t.title) + '</td>';
            html += '<td>' + escapeHtml(t.category) + '</td>';
            html += '<td>' + getPriorityBadge(t.priority) + '</td>';
            html += '<td>' + getStatusBadge(t.status) + '</td>';
            html += '<td>' + escapeHtml(t.submittedBy) + '</td>';
            html += '<td>' + escapeHtml(t.assignedTo || 'Unassigned') + '</td>';
            html += '<td>' + formatDate(t.created) + '</td>';
            html += '</tr>';
        });
        html += '</tbody></table>';
        return html;
    }

    function showModal(title, fetchUrl, linkUrl) {
        modalTitle.textContent = title;
        modalLoading.style.display = '';
        modalTable.style.display = 'none';
        modalTable.innerHTML = '';
        modalLink.href = linkUrl || '/Tickets';
        modal.show();

        fetch(fetchUrl)
            .then(function (res) {
                if (!res.ok) throw new Error('Failed to load data');
                return res.json();
            })
            .then(function (data) {
                modalLoading.style.display = 'none';
                modalTable.innerHTML = buildTicketTable(data);
                modalTable.style.display = '';
            })
            .catch(function (err) {
                modalLoading.style.display = 'none';
                modalTable.innerHTML = '<p class="text-danger text-center py-3"><i class="bi bi-exclamation-triangle"></i> ' + escapeHtml(err.message) + '</p>';
                modalTable.style.display = '';
            });
    }

    // KPI card click handlers
    document.querySelectorAll('.kpi-clickable').forEach(function (card) {
        card.addEventListener('click', function () {
            var type = this.getAttribute('data-kpi-type');

            if (type === 'total') {
                window.location.href = '/Tickets';
                return;
            }

            if (type === 'avgresolution') {
                // No modal for avg resolution; tooltip handles info
                return;
            }

            var statusMap = {
                'open': 'Open',
                'inprogress': 'InProgress',
                'resolved': 'Resolved',
                'closed': 'Closed'
            };

            var statusName = statusMap[type];
            if (!statusName) return;

            var displayName = type === 'inprogress' ? 'In Progress' : statusName;
            showModal(
                displayName + ' Tickets',
                '/Reports/TicketsByStatus?status=' + encodeURIComponent(statusName),
                '/Tickets?status=' + encodeURIComponent(statusName)
            );
        });
    });

    // Category row click handlers
    document.querySelectorAll('.row-clickable[data-category]').forEach(function (row) {
        row.addEventListener('click', function () {
            var category = this.getAttribute('data-category');
            var categoryLabel = this.getAttribute('data-category-label') || category;
            showModal(
                categoryLabel + ' Tickets',
                '/Reports/TicketsByCategory?category=' + encodeURIComponent(category),
                '/Tickets?category=' + encodeURIComponent(category)
            );
        });
    });

    // Priority row click handlers
    document.querySelectorAll('.row-clickable[data-priority]').forEach(function (row) {
        row.addEventListener('click', function () {
            var priority = this.getAttribute('data-priority');
            showModal(
                priority + ' Priority Tickets',
                '/Reports/TicketsByPriority?priority=' + encodeURIComponent(priority),
                '/Tickets?priority=' + encodeURIComponent(priority)
            );
        });
    });

    // Assignee row click handlers
    document.querySelectorAll('.row-clickable[data-assignee]').forEach(function (row) {
        row.addEventListener('click', function () {
            var assignee = this.getAttribute('data-assignee');
            showModal(
                assignee + ' — Assigned Tickets',
                '/Reports/TicketsByAssignee?assignee=' + encodeURIComponent(assignee),
                '/Tickets'
            );
        });
    });
})();
</script>
}
