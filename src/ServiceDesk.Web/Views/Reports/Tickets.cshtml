@model ServiceDesk.Web.Models.TicketReportViewModel
@{
    ViewData["Title"] = "Ticket Reports";
    var catById = ViewBag.CategoriesById as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active">Ticket Reports</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0"><i class="bi bi-ticket-detailed"></i> Ticket Reports</h1>
    <button onclick="ssExport.show('ss-export-target','Ticket Reports')" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-file-earmark-pdf me-1"></i>Export / Print
    </button>
</div>

<div id="ss-export-target">
<!-- Summary Row -->
<div class="row g-3">
    <div class="col-md-4 col-lg-2">
        <a href="/Tickets" class="card h-75 text-decoration-none text-reset ss-drill-card" title="View all tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Total Tickets</div>
                <div class="report-stat text-primary" style="font-size: x-large">@Model.TotalTickets</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 ss-drill-card"
             data-ssdrill-url="/Reports/TicketsByStatus?status=Open"
             data-ssdrill-title="Open Tickets"
             data-ssdrill-type="tickets"
             data-ssdrill-link="/Tickets?status=Open"
             title="View Open tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Open</div>
                <div class="report-stat text-info" style="font-size: x-large">@Model.OpenTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 ss-drill-card"
             data-ssdrill-url="/Reports/TicketsByStatus?status=InProgress"
             data-ssdrill-title="In Progress Tickets"
             data-ssdrill-type="tickets"
             data-ssdrill-link="/Tickets?status=InProgress"
             title="View In Progress tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">In Progress</div>
                <div class="report-stat text-warning" style="font-size: x-large">@Model.InProgressTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 ss-drill-card"
             data-ssdrill-url="/Reports/TicketsByStatus?status=Resolved"
             data-ssdrill-title="Resolved Tickets"
             data-ssdrill-type="tickets"
             data-ssdrill-link="/Tickets?status=Resolved"
             title="View Resolved tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Resolved</div>
                <div class="report-stat text-success" style="font-size: x-large">@Model.ResolvedTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75 ss-drill-card"
             data-ssdrill-url="/Reports/TicketsByStatus?status=Closed"
             data-ssdrill-title="Closed Tickets"
             data-ssdrill-type="tickets"
             data-ssdrill-link="/Tickets?status=Closed"
             title="View Closed tickets">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Closed</div>
                <div class="report-stat text-secondary" style="font-size: x-large">@Model.ClosedTickets</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-75" title="Average time to resolve a ticket">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase">Avg Resolution <i class="bi bi-info-circle" data-bs-toggle="tooltip" data-bs-placement="top" title="Average hours from ticket creation to resolution"></i></div>
                <div class="report-stat text-dark" style="font-size: x-large">@Model.AverageResolutionHours.ToString("F1")h</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <!-- Monthly Trend Line -->
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header fw-semibold"><i class="bi bi-graph-up me-1"></i> Monthly Ticket Volume</div>
            <div class="card-body">
                <div id="chartMonthlyTrend"></div>
            </div>
        </div>
    </div>
    <!-- Category Donut -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold"><i class="bi bi-tag me-1"></i> By Category</div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="chartCategoryDonut" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- By Category -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-tag"></i> Tickets by Category
            </div>
            <div class="card-body">
                @if (Model.ByCategory.Any())
                {
                    var maxCategory = Model.ByCategory.Values.Max();
                    @foreach (var item in Model.ByCategory)
                    {
                        var percent = maxCategory > 0 ? (int)((double)item.Value / maxCategory * 100) : 0;
                        var catLabel = catById.TryGetValue(item.Key, out var catNameRpt) ? catNameRpt : $"Category {item.Key}";
                        <div class="mb-3 ss-drill-row"
                             data-ssdrill-url="/Reports/TicketsByCategory?category=@item.Key"
                             data-ssdrill-title="@catLabel Tickets"
                             data-ssdrill-type="tickets"
                             data-ssdrill-link="/Tickets?category=@item.Key"
                             title="View @catLabel tickets">
                            <div class="d-flex justify-content-between mb-1">
                                <span>@catLabel</span>
                                <span class="fw-bold">@item.Value</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @(percent)%"
                                     aria-valuenow="@item.Value" aria-valuemin="0" aria-valuemax="@maxCategory"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center">No data available.</p>
                }
            </div>
        </div>
    </div>

    <!-- By Priority -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-flag"></i> Tickets by Priority
            </div>
            <div class="card-body">
                @if (Model.ByPriority.Any())
                {
                    <table class="table table-hover mb-0 ss-datatable-compact">
                        <thead class="table-light">
                            <tr>
                                <th>Priority</th>
                                <th class="text-end">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ByPriority)
                            {
                                var badgeClass = item.Key switch
                                {
                                    TicketPriority.Low => "bg-info",
                                    TicketPriority.Medium => "bg-primary",
                                    TicketPriority.High => "bg-warning text-dark",
                                    TicketPriority.Critical => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                <tr class="ss-drill-row"
                                    data-ssdrill-url="/Reports/TicketsByPriority?priority=@item.Key"
                                    data-ssdrill-title="@item.Key Priority Tickets"
                                    data-ssdrill-type="tickets"
                                    data-ssdrill-link="/Tickets?priority=@item.Key"
                                    title="View @item.Key priority tickets">
                                    <td><span class="badge @badgeClass">@item.Key</span></td>
                                    <td class="text-end fw-bold">@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted text-center">No data available.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Top Assignees -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-person-badge"></i> Top Assignees
    </div>
    <div class="card-body p-0">
        @if (Model.TopAssignees.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 ss-datatable-compact">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th class="text-end">Total Assigned</th>
                            <th class="text-end">Resolved</th>
                            <th class="text-end">Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignee in Model.TopAssignees)
                        {
                            <tr class="ss-drill-row"
                                data-ssdrill-url="/Reports/TicketsByAssignee?assignee=@Uri.EscapeDataString(assignee.Name)"
                                data-ssdrill-title="Tickets assigned to @assignee.Name"
                                data-ssdrill-type="tickets"
                                title="View tickets assigned to @assignee.Name">
                                <td><i class="bi bi-person-circle text-muted me-1"></i>@assignee.Name</td>
                                <td class="text-end fw-bold">@assignee.TotalAssigned</td>
                                <td class="text-end"><span class="text-success fw-bold">@assignee.Resolved</span></td>
                                <td class="text-end"><span class="text-warning fw-bold">@assignee.Open</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <p>No assignee data available.</p>
            </div>
        }
    </div>
</div>

</div><!-- /ss-export-target -->

@await Html.PartialAsync("_DrillDownModal")

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.css" />
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    // Monthly Trend Line
    var trendEl = document.getElementById('chartMonthlyTrend');
    if (trendEl) {
        var monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByMonth.Keys.ToList()));
        var monthlyCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByMonth.Values.ToList()));
        new ApexCharts(trendEl, {
            series: [{ name: 'Tickets', data: monthlyCounts }],
            chart: { type: 'area', height: 220, toolbar: { show: false } },
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 2 },
            fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.0 } },
            xaxis: { categories: monthlyLabels, labels: { rotate: -35, style: { fontSize: '10px' } } },
            yaxis: { min: 0, labels: { style: { fontSize: '11px' } } },
            colors: ['#2f4cdd'],
            grid: { borderColor: '#f1f1f1' },
            tooltip: { y: { formatter: function(val) { return val + ' tickets'; } } }
        }).render();
    }

    // Category Donut — segments clickable to open modal
    var donutEl = document.getElementById('chartCategoryDonut');
    if (donutEl) {
        var catLabels  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByCategory.Keys.Select(k => catById.TryGetValue(k, out var ln) ? ln : k.ToString()).ToList()));
        var catKeys    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByCategory.Keys.Select(k => k.ToString()).ToList()));
        var catCounts  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByCategory.Values.ToList()));
        var hasData = catCounts.some(function(v) { return v > 0; });
        if (hasData) {
            var donutChart = new ApexCharts(donutEl, {
                series: catCounts,
                chart: {
                    type: 'donut', height: 250,
                    events: {
                        dataPointSelection: function (event, chartCtx, opts) {
                            var idx = opts.dataPointIndex;
                            if (idx < 0 || idx >= catKeys.length || !window.ssDrill) return;
                            window.ssDrill.show({
                                title:   catLabels[idx] + ' Tickets',
                                url:     '/Reports/TicketsByCategory?category=' + encodeURIComponent(catKeys[idx]),
                                type:    'tickets',
                                linkUrl: '/Tickets?category=' + encodeURIComponent(catKeys[idx])
                            });
                        }
                    }
                },
                labels: catLabels,
                legend: { position: 'bottom', fontSize: '11px' },
                dataLabels: { enabled: false },
                plotOptions: { pie: { donut: { size: '60%' } } },
                tooltip: { y: { formatter: function(val) { return val + ' tickets'; } } }
            });
            donutChart.render();
            donutEl.style.cursor = 'pointer';
        } else {
            donutEl.innerHTML = '<p class="text-muted text-center py-4 small">No ticket data yet.</p>';
        }
    }
});
</script>
<script>
(function () {
    // Initialize Bootstrap tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.forEach(function (el) {
        new bootstrap.Tooltip(el);
    });

})();
</script>
}
