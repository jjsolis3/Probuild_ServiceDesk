@model ServiceDesk.Web.Models.ExecReportViewModel
@using ServiceDesk.Core.Enums
@{
    ViewData["Title"] = "Executive Dashboard";
    var catById = ViewBag.CategoriesById as Dictionary<int, string> ?? new Dictionary<int, string>();

    string FormatHours(double h)
    {
        if (h <= 0) return "—";
        if (h >= 24) return $"{Math.Floor(h / 24):0}d {h % 24:0}h";
        return $"{h:F1}h";
    }
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active">Executive Dashboard</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="fs-3 fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Executive Dashboard</h1>
        <p class="text-muted mb-0">IT service desk performance at a glance &middot; all-time unless noted</p>
    </div>
    <div class="text-end">
        <div class="small text-muted mb-1">Generated <strong>@DateTime.Now.ToString("MMM d, yyyy h:mm tt")</strong></div>
        <button onclick="ssExport.show('ss-export-target','Executive Dashboard')" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-file-earmark-pdf me-1"></i>Export / Print
        </button>
    </div>
</div>

<div id="ss-export-target">
<!-- ── KPI Row ──────────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm text-center h-100 exec-kpi">
            <div class="card-body py-3 px-2">
                <div class="small text-muted text-uppercase fw-semibold mb-1">MTTR</div>
                <div class="fs-4 fw-bold text-primary">@FormatHours(Model.MttrHours)</div>
                <div class="small text-muted mt-1">Mean time to resolve</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm text-center h-100 exec-kpi">
            <div class="card-body py-3 px-2">
                <div class="small text-muted text-uppercase fw-semibold mb-1">MTTA</div>
                <div class="fs-4 fw-bold @(Model.MttaHours > 4 ? "text-warning" : Model.MttaHours > 0 ? "text-success" : "text-muted")">
                    @FormatHours(Model.MttaHours)
                </div>
                <div class="small text-muted mt-1">Mean time to 1st response</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm text-center h-100 exec-kpi">
            <div class="card-body py-3 px-2">
                <div class="small text-muted text-uppercase fw-semibold mb-1">SLA</div>
                <div class="fs-4 fw-bold @(Model.SlaCompliancePct >= 90 ? "text-success" : Model.SlaCompliancePct >= 70 ? "text-warning" : Model.SlaCompliancePct > 0 ? "text-danger" : "text-muted")">
                    @(Model.SlaCompliancePct > 0 ? $"{Model.SlaCompliancePct:F0}%" : "—")
                </div>
                <div class="small text-muted mt-1">On-time resolution</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm text-center h-100 exec-kpi">
            <div class="card-body py-3 px-2">
                <div class="small text-muted text-uppercase fw-semibold mb-1">Open</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalOpen</div>
                <div class="small text-muted mt-1">Active tickets</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm text-center h-100 exec-kpi">
            <div class="card-body py-3 px-2">
                <div class="small text-muted text-uppercase fw-semibold mb-1">Resolved</div>
                <div class="fs-4 fw-bold text-success">@Model.ResolvedLast30Days</div>
                <div class="small text-muted mt-1">Last 30 days</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm text-center h-100 exec-kpi">
            <div class="card-body py-3 px-2">
                <div class="small text-muted text-uppercase fw-semibold mb-1">AI Acceptance</div>
                <div class="fs-4 fw-bold @(Model.AiHasData && Model.AiAcceptanceRate >= 75 ? "text-success" : Model.AiHasData ? "text-warning" : "text-muted")">
                    @(Model.AiHasData ? $"{Model.AiAcceptanceRate:F0}%" : "—")
                </div>
                <div class="small text-muted mt-1">AI triage accepted</div>
            </div>
        </div>
    </div>
</div>

<!-- ── Charts Row 1 ─────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold bg-transparent border-bottom-0 pt-3 pb-0">
                <i class="bi bi-graph-up me-2 text-primary"></i>Weekly Ticket Volume
                <span class="text-muted small fw-normal">&mdash; last 12 weeks</span>
            </div>
            <div class="card-body pt-2">
                <div id="chartWeekly"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold bg-transparent border-bottom-0 pt-3 pb-0">
                <i class="bi bi-tag me-2 text-primary"></i>By Category
                <span class="text-muted small fw-normal">&mdash; last 30 days</span>
            </div>
            <div class="card-body pt-2 d-flex align-items-center justify-content-center">
                <div id="chartCategory" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- ── SLA + Backlog Row ─────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <!-- SLA by Priority -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold bg-transparent border-bottom-0 pt-3 pb-0">
                <i class="bi bi-shield-check me-2 text-primary"></i>SLA Compliance by Priority
            </div>
            <div class="card-body">
                @if (Model.SlaByPriority.Any())
                {
                    foreach (var row in Model.SlaByPriority)
                    {
                        var badgeColor = row.Priority switch
                        {
                            TicketPriority.Critical => "#dc3545",
                            TicketPriority.High     => "#fd7e14",
                            TicketPriority.Medium   => "#0d6efd",
                            _                       => "#6c757d"
                        };
                        var barClass = row.CompliancePct >= 90 ? "bg-success"
                                     : row.CompliancePct >= 70 ? "bg-warning"
                                     : "bg-danger";
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge" style="background-color:@badgeColor">@row.Priority</span>
                                <span class="small text-muted">@row.Met / @row.Total on time</span>
                                <span class="fw-bold small @(row.CompliancePct >= 90 ? "text-success" : row.CompliancePct >= 70 ? "text-warning" : "text-danger")">
                                    @row.CompliancePct.ToString("F0")%
                                </span>
                            </div>
                            <div class="progress" style="height:8px;">
                                <div class="progress-bar @barClass" role="progressbar"
                                     style="width:@row.CompliancePct%"
                                     aria-valuenow="@row.CompliancePct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">No resolved tickets yet to calculate SLA compliance.</p>
                }
            </div>
        </div>
    </div>

    <!-- Backlog Aging -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold bg-transparent border-bottom-0 pt-3 pb-0">
                <i class="bi bi-hourglass-split me-2 text-warning"></i>Backlog Aging
                <span class="text-muted small fw-normal">&mdash; open tickets by age</span>
            </div>
            <div class="card-body">
                <div class="row g-0 text-center mb-4">
                    <div class="col-4">
                        <div class="fs-1 fw-bold @(Model.BacklogOver7Days > 0 ? "text-warning" : "text-success")">
                            @Model.BacklogOver7Days
                        </div>
                        <div class="small text-muted">Over 7 days</div>
                    </div>
                    <div class="col-4 border-start border-end">
                        <div class="fs-1 fw-bold @(Model.BacklogOver14Days > 0 ? "text-danger" : "text-success")">
                            @Model.BacklogOver14Days
                        </div>
                        <div class="small text-muted">Over 14 days</div>
                    </div>
                    <div class="col-4">
                        <div class="fs-1 fw-bold @(Model.BacklogOver30Days > 0 ? "text-danger" : "text-success")">
                            @Model.BacklogOver30Days
                        </div>
                        <div class="small text-muted">Over 30 days</div>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between border-top pt-3">
                    <span class="text-muted small">@Model.TotalOpen total open tickets</span>
                    <a asp-controller="Tickets" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i>View All Open
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Agent Workload ────────────────────────────────────────────────────────── -->
@if (Model.AgentWorkload.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header fw-semibold bg-transparent border-bottom-0 pt-3 pb-0">
            <i class="bi bi-person-badge me-2 text-primary"></i>Agent Workload
            <span class="text-muted small fw-normal">&mdash; active tickets &amp; resolved in last 30 days</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Agent</th>
                            <th class="text-center">Open</th>
                            <th class="text-center">In Progress</th>
                            <th class="text-center">Resolved (30d)</th>
                            <th class="text-end pe-3">Avg Resolution</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in Model.AgentWorkload)
                        {
                            <tr>
                                <td class="ps-3"><i class="bi bi-person-circle text-muted me-2"></i>@agent.AgentName</td>
                                <td class="text-center">
                                    @if (agent.OpenTickets > 0)
                                    { <span class="badge bg-primary">@agent.OpenTickets</span> }
                                    else
                                    { <span class="text-muted small">—</span> }
                                </td>
                                <td class="text-center">
                                    @if (agent.InProgressTickets > 0)
                                    { <span class="badge bg-warning text-dark">@agent.InProgressTickets</span> }
                                    else
                                    { <span class="text-muted small">—</span> }
                                </td>
                                <td class="text-center">
                                    @if (agent.ResolvedLast30Days > 0)
                                    { <span class="badge bg-success">@agent.ResolvedLast30Days</span> }
                                    else
                                    { <span class="text-muted small">—</span> }
                                </td>
                                <td class="text-end pe-3 text-muted small">@FormatHours(agent.AvgResolutionHours)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ── AI Effectiveness ──────────────────────────────────────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom-0 pt-3 pb-0">
        <i class="bi bi-robot me-2 text-info"></i>AI Triage Effectiveness
    </div>
    <div class="card-body">
        @if (Model.AiHasData)
        {
            <div class="row g-3 mb-3">
                <div class="col-6 col-md-3">
                    <div class="text-center p-3 border rounded h-100">
                        <div class="fs-2 fw-bold text-info">@Model.AiAcceptanceRate.ToString("F0")%</div>
                        <div class="small fw-semibold">Acceptance Rate</div>
                        <div class="text-muted" style="font-size:.72rem;">Approved ÷ (Approved + Dismissed)</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-center p-3 border rounded h-100">
                        <div class="fs-2 fw-bold @(Model.AiCategoryAccuracyPct >= 80 ? "text-success" : Model.AiCategoryAccuracyPct >= 60 ? "text-warning" : "text-muted")">
                            @(Model.AiCategoryAccuracyPct > 0 ? $"{Model.AiCategoryAccuracyPct:F0}%" : "—")
                        </div>
                        <div class="small fw-semibold">Category Accuracy</div>
                        <div class="text-muted" style="font-size:.72rem;">Verified on resolved tickets</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-center p-3 border rounded h-100">
                        <div class="fs-2 fw-bold @(Model.AiPriorityAccuracyPct >= 80 ? "text-success" : Model.AiPriorityAccuracyPct >= 60 ? "text-warning" : "text-muted")">
                            @(Model.AiPriorityAccuracyPct > 0 ? $"{Model.AiPriorityAccuracyPct:F0}%" : "—")
                        </div>
                        <div class="small fw-semibold">Priority Accuracy</div>
                        <div class="text-muted" style="font-size:.72rem;">Verified on resolved tickets</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-center p-3 border rounded h-100">
                        <div class="fs-2 fw-bold text-primary">@Model.AiRecsLast30Days</div>
                        <div class="small fw-semibold">Tickets Triaged</div>
                        <div class="text-muted" style="font-size:.72rem;">AI recommendations last 30 days</div>
                    </div>
                </div>
            </div>
            @if (Model.LatestTrainingRun != null)
            {
                <div class="small text-muted border-top pt-3">
                    <i class="bi bi-cpu me-1"></i>
                    Last model training: <strong>@Model.LatestTrainingRun.RunDate.ToString("MMM d, yyyy h:mm tt")</strong>
                    &nbsp;&bull;&nbsp; @Model.LatestTrainingRun.TrainingTicketCount tickets used
                    &nbsp;&bull;&nbsp;
                    <span class="@(Model.LatestTrainingRun.Success ? "text-success" : "text-danger")">
                        @(Model.LatestTrainingRun.Success ? "✓ Success" : "✗ Failed")
                    </span>
                    @if (!string.IsNullOrEmpty(Model.LatestTrainingRun.ModelVersion))
                    {
                        <span class="ms-2 badge bg-light text-dark border">v@Model.LatestTrainingRun.ModelVersion</span>
                    }
                    &nbsp;&bull;&nbsp;
                    <a asp-controller="Settings" asp-action="AiDashboard" class="text-info">View full AI dashboard</a>
                </div>
            }
        }
        else
        {
            <div class="text-center py-4">
                <i class="bi bi-robot text-muted fs-1 d-block mb-2"></i>
                <p class="text-muted mb-2">No AI triage data yet. Enable it in Settings to start auto-categorizing tickets.</p>
                <a asp-controller="Settings" asp-action="Ai" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-gear me-1"></i>Configure AI Triage
                </a>
            </div>
        }
    </div>
</div>

<!-- ── CSAT ───────────────────────────────────────────────────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
        <span><i class="bi bi-star me-2 text-warning"></i>Customer Satisfaction (CSAT)</span>
        <span class="badge @(Model.CsatEnabled ? "bg-success" : "bg-secondary")">
            @(Model.CsatEnabled ? "Enabled" : "Disabled")
        </span>
    </div>
    <div class="card-body">
        @if (!Model.CsatEnabled)
        {
            <div class="text-center py-3">
                <i class="bi bi-toggle-off text-muted fs-2 d-block mb-2"></i>
                <p class="text-muted mb-2">CSAT surveys are currently off. Enable them when you want post-resolution feedback from users.</p>
                <a asp-controller="Settings" asp-action="Csat" class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-gear me-1"></i>CSAT Settings
                </a>
            </div>
        }
        else if (Model.CsatResponseCount == 0)
        {
            <p class="text-muted text-center py-3 mb-0">CSAT surveys are enabled. No responses recorded yet.</p>
        }
        else
        {
            <div class="row g-3 align-items-center">
                <div class="col-6 col-md-4 text-center">
                    <div class="mb-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Math.Round(Model.CsatAvgScore ?? 0) ? "bi-star-fill" : "bi-star") text-warning fs-5"></i>
                        }
                    </div>
                    <div class="fs-4 fw-bold">@Model.CsatAvgScore?.ToString("F1") <span class="text-muted small fw-normal">/ 5</span></div>
                    <div class="small text-muted">Average Score</div>
                </div>
                <div class="col-6 col-md-4 text-center border-start">
                    <div class="fs-2 fw-bold text-primary">@Model.CsatResponseCount</div>
                    <div class="small text-muted">Responses Received</div>
                </div>
                <div class="col-6 col-md-4 text-center border-start">
                    <div class="fs-2 fw-bold @(Model.CsatResponseRate >= 50 ? "text-success" : "text-warning")">
                        @Model.CsatResponseRate?.ToString("F0")%
                    </div>
                    <div class="small text-muted">Response Rate</div>
                </div>
            </div>
        }
    </div>
</div>
</div><!-- /ss-export-target -->

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.css" />
<style>
.exec-kpi {
    transition: box-shadow 0.2s, transform 0.15s;
}
.exec-kpi:hover {
    box-shadow: 0 4px 14px rgba(0,0,0,.12) !important;
    transform: translateY(-2px);
}
@@media print {
    .btn, nav.breadcrumb, button { display: none !important; }
    .card { break-inside: avoid; box-shadow: none !important; border: 1px solid #dee2e6 !important; }
}
</style>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.35.3/dist/apexcharts.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var weeklyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyVolume.Select(w => w.Label).ToList()));
    var weeklyCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyVolume.Select(w => w.Count).ToList()));

    // Weekly volume area chart
    var weekEl = document.getElementById('chartWeekly');
    if (weekEl) {
        new ApexCharts(weekEl, {
            series: [{ name: 'Tickets Created', data: weeklyCounts }],
            chart: { type: 'area', height: 220, toolbar: { show: false }, zoom: { enabled: false } },
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 2 },
            fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.0 } },
            xaxis: { categories: weeklyLabels, labels: { rotate: -35, style: { fontSize: '10px' } }, axisBorder: { show: false } },
            yaxis: { min: 0, labels: { style: { fontSize: '11px' } }, tickAmount: 4 },
            colors: ['#2f4cdd'],
            grid: { borderColor: '#f1f1f1', padding: { left: 0, right: 0 } },
            tooltip: { y: { formatter: function(v) { return v + ' tickets'; } } }
        }).render();
    }

    // Category donut chart
    var catEl = document.getElementById('chartCategory');
    var catNameMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(catById.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value)));
    var catKeys   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByCategory.Keys.ToList()));
    var catCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByCategory.Values.ToList()));
    var catLabels = catKeys.map(function(k) { return catNameMap[String(k)] || ('Category ' + k); });

    if (catEl) {
        if (catCounts.length > 0 && catCounts.some(function(v) { return v > 0; })) {
            new ApexCharts(catEl, {
                series: catCounts,
                chart: { type: 'donut', height: 250 },
                labels: catLabels,
                legend: { position: 'bottom', fontSize: '11px' },
                dataLabels: { enabled: false },
                plotOptions: { pie: { donut: { size: '62%' } } },
                tooltip: { y: { formatter: function(v) { return v + ' tickets'; } } }
            }).render();
        } else {
            catEl.innerHTML = '<p class="text-muted text-center py-5 small">No ticket data in the last 30 days.</p>';
        }
    }
});
</script>
}
